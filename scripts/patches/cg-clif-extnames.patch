+/// clifv (eth-act/clifv, `scripts/patches/cg-clif-extnames.patch`): after the function, the
+/// identities the text leaves implicit, as comment lines (`docs/contracts/frontend.md`):
+///
+/// ```text
+/// ; clifv-extnames 1
+/// ; userextnameJ = uNS:IDX               (the function's external-name table, every entry)
+/// ; decl u0:IDX func LINKAGE "SYMBOL"    (the module's declaration of every FuncId the
+/// ; decl u1:IDX data LINKAGE rw|ro tls|notls "SYMBOL"   function names, its own included,
+///                                          and of every DataId)
+/// ; libcall %NAME "SYMBOL"               (every libcall the function declares)
+/// ; end clifv-extnames
+/// ```
+///
+/// `SYMBOL` is the declaration's linkage name (`.Lfn<hex>`/`.Ldata<hex>` for anonymous ones),
+/// written with Rust's `{:?}`; the libcall symbols are `cranelift_module::default_libcall_names`,
+/// the names `driver::aot::make_module` gives the object module.
+fn write_ext_names(
+    w: &mut String,
+    func: &cranelift_codegen::ir::Function,
+    decls: &cranelift_module::ModuleDeclarations,
+) {
+    use std::fmt::Write;
+
+    use cranelift_codegen::ir::{ExternalName, UserExternalName, UserFuncName};
+
+    fn linkage(l: Linkage) -> &'static str {
+        match l {
+            Linkage::Import => "import",
+            Linkage::Local => "local",
+            Linkage::Preemptible => "preemptible",
+            Linkage::Hidden => "hidden",
+            Linkage::Export => "export",
+        }
+    }
+
+    writeln!(w, "\n; clifv-extnames 1").unwrap();
+    let mut ids: Vec<UserExternalName> = Vec::new();
+    if let UserFuncName::User(n) = &func.name {
+        ids.push(n.clone());
+    }
+    for (r, n) in func.params.user_named_funcs().iter() {
+        writeln!(w, "; {} = u{}:{}", r, n.namespace, n.index).unwrap();
+        ids.push(n.clone());
+    }
+    ids.sort_by_key(|n| (n.namespace, n.index));
+    ids.dedup();
+    for n in ids {
+        match n.namespace {
+            0 => {
+                let id = FuncId::from_u32(n.index);
+                let d = decls.get_function_decl(id);
+                writeln!(
+                    w,
+                    "; decl u0:{} func {} {:?}",
+                    n.index,
+                    linkage(d.linkage),
+                    d.linkage_name(id)
+                )
+                .unwrap();
+            }
+            1 => {
+                let id = cranelift_module::DataId::from_u32(n.index);
+                let d = decls.get_data_decl(id);
+                writeln!(
+                    w,
+                    "; decl u1:{} data {} {} {} {:?}",
+                    n.index,
+                    linkage(d.linkage),
+                    if d.writable { "rw" } else { "ro" },
+                    if d.tls { "tls" } else { "notls" },
+                    d.linkage_name(id)
+                )
+                .unwrap();
+            }
+            ns => writeln!(w, "; decl u{}:{} unknown", ns, n.index).unwrap(),
+        }
+    }
+    let names = cranelift_module::default_libcall_names();
+    let mut libcalls: Vec<String> = Vec::new();
+    for (_, ext) in func.dfg.ext_funcs.iter() {
+        if let ExternalName::LibCall(lc) = &ext.name {
+            let line = format!("; libcall %{} {:?}", lc, names(*lc));
+            if !libcalls.contains(&line) {
+                libcalls.push(line);
+            }
+        }
+    }
+    for l in libcalls {
+        writeln!(w, "{l}").unwrap();
+    }
+    writeln!(w, "; end clifv-extnames").unwrap();
+}
