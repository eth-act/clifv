+// Enforce the export boundary: allocating or finalizing JIT memory is a bug.
+struct NoJitAllocation;
+impl cranelift_jit::JITMemoryProvider for NoJitAllocation {
+    fn allocate(
+        &mut self,
+        _: usize,
+        _: u64,
+        _: cranelift_jit::JITMemoryKind,
+    ) -> std::io::Result<*mut u8> {
+        panic!("pre-JIT export attempted a JIT allocation")
+    }
+    unsafe fn free_memory(&mut self) {}
+    fn finalize(
+        &mut self,
+        _: cranelift_jit::BranchProtection,
+    ) -> cranelift_module::ModuleResult<()> {
+        panic!("pre-JIT export attempted memory finalization")
+    }
+}
