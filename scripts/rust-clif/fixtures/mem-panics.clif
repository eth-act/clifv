; Data-image and extern demo (rust-route steps 1–2): functions that read/write the
; recovered `; data:` objects and call the trusted externs `memcpy`/`memset`/`memcmp`
; and a diverging panic entry. Under `Clif.run --rust-env` (the `Clif.Rust.env`
; contracts) and natively with `scripts/rust-clif/rust-runtime.sh` linked.
;
; The commands share memory in clif-native (one process per file) and run freshly in
; `Clif.run`; these expectations are for `Clif.run --rust-env` (fresh state per command)
; and hold natively for the same order: copyfirst copies 4 bytes of src into dst, fill
; then sets 8 bytes of dst to 0xaa, so cmp3 compares `11 22 33` with `aa aa aa` = -1.

; data: %src_buf = 1122334455667788
; data: %dst_buf writable = 00000000000000000000000000000000

function %cmp3() -> i32 system_v {
    gv0 = symbol colocated %src_buf
    gv1 = symbol colocated %dst_buf
    fn0 = %memcmp(i64, i64, i64) -> i32

block0:
    v0 = symbol_value.i64 gv0
    v1 = symbol_value.i64 gv1
    v2 = iconst.i64 3
    v9 = call fn0(v0, v1, v2)
    return v9
}

; run: %cmp3() == 1

function %copyfirst() -> i8 system_v {
    gv0 = symbol colocated %src_buf
    gv1 = symbol colocated %dst_buf
    fn0 = %memcpy(i64, i64, i64) -> i64

block0:
    v0 = symbol_value.i64 gv0
    v1 = symbol_value.i64 gv1
    v2 = iconst.i64 4
    v9 = call fn0(v1, v0, v2)
    v3 = load.i8 notrap aligned v1
    return v3
}

; run: %copyfirst() == 17

function %fill() -> i8 system_v {
    gv0 = symbol colocated %dst_buf
    fn0 = %memset(i64, i64, i64) -> i64

block0:
    v0 = symbol_value.i64 gv0
    v1 = iconst.i64 8
    v2 = iconst.i64 170
    v9 = call fn0(v0, v2, v1)
    v3 = load.i8 notrap aligned v0
    return v3
}

; run: %fill() == -86

function %panics(i32) -> i32 system_v {
    fn0 = %_RNvNtCsdWkcC71lE0a_4core9panicking5panic(i64) system_v

block0(v0: i32):
    v1 = icmp eq v0, v0
    brif v1, block1(v0), block2(v0)

block1(v2: i32):
    v3 = iconst.i64 0
    call fn0(v3)
    trap user1

block2(v4: i32):
    return v4
}

; print: %panics(0)
