import Lake
open Lake DSL

/-! Lean extraction of the stock Cranelift AArch64 compile path (see `extract/`).
The generated code (`Generated/`, by `extract/scripts/extract.sh`) uses the Aeneas library of
the pinned fork (`extract/pins.json`). -/

require aeneas from git
  "https://github.com/codygunton/aeneas" @ "7b0ff5473a381f3354b4660a0562ad7b74000a61" / "backends/lean"

package clifvExtract where
  leanOptions := #[⟨`weak.linter.dupNamespace, false⟩]

/-- The code generated by Aeneas, and the external declarations generated from its templates
(`extract/scripts/externals.py`: the items without a model stay axioms). -/
lean_lib ClifvGen where
  srcDir := "Generated"
  roots := #[`ClifvGen.TypesExternal, `ClifvGen.Types, `ClifvGen.FunsExternal, `ClifvGen.Funs]

/-- Handwritten models of the external definitions: `ClifvModels.Types.*` (imported by
`ClifvGen.TypesExternal`) and `ClifvModels.Funs.*` (imported by `ClifvGen.FunsExternal`). -/
lean_lib ClifvModels where
  srcDir := "Models"
  globs := #[.submodules `ClifvModels]

/-- The driver. -/
lean_lib ClifvExtract where
  roots := #[`ClifvExtract.Driver]

/-- Same CLI and request/result schemas as `clifv-extract-native`. -/
lean_exe «clifv-extract-lean» where
  root := `ClifvExtract.Driver
