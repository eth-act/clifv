                    | ExtResult.ok (v, st') => do
                      set (st', trace)
                      pure (some v)
                    | ExtResult.fail => throw (Err.infallibleFailed "emit")
                    | ExtResult.unmodeled w => throw (Err.unmodeled w))
                    ({ base := (st.base.fresh RegClass.int).snd, demand := st.demand, uses := st.uses,
                        instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor,
                        tryRegs := st.tryRegs, current := st.current, color := st.color, sunk := st.sunk,
                        opportunistic := st.opportunistic, alias := st.alias },
                      trace)
              StateT.run
                  (match p_1.fst with
                  | none => pure none
                  | some v =>
                    evalBinds p (sem ctx) cfg (fuel + 16) []
                      (((((Array.replicate 4 none).setIfInBounds 0 (some address)).setIfInBounds 1
                                (some flags)).setIfInBounds
                            2 (some (V.reg (st.base.fresh RegClass.int).fst))).setIfInBounds
                        3 (some v)))
                  p_1.snd
          StateT.run
              (match p_1.fst with
              | some env' => evalExpr p (sem ctx) cfg (fuel + 18) (Expr.term 27 201 [Expr.var 28 2]) env'
              | none => pure none)
              p_1.snd
      StateT.run
          (match p.fst with
          | some v => do
            fire 303
            pure (some v)
          | none => pure none)
          p.snd) =
    Except.ok
      (some (V.reg (st.base.fresh RegClass.int).fst),
        { base := (st.base.fresh RegClass.int).snd.emit instruction, demand := st.demand, uses := st.uses,
          instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor, tryRegs := st.tryRegs,
          current := st.current, color := st.color, sunk := st.sunk, opportunistic := st.opportunistic,
          alias := st.alias },
        trace.push 303)

