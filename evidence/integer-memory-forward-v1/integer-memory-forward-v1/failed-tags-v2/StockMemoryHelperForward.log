lower✝ : p.termByName? "lower" = some T.lower
⊢ (do
      let p ←
        do
          let p_1 ←
            do
              let p_1 ←
                StateT.run
                    (match
                      externCtor ctx T.emit [V.data 58 12 [V.reg (st.base.fresh RegClass.int).fst, address, flags]]
                        { base := (st.base.fresh RegClass.int).snd, demand := st.demand, uses := st.uses,
                          instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor,
                          tryRegs := st.tryRegs, current := st.current, color := st.color, sunk := st.sunk,
                          opportunistic := st.opportunistic, alias := st.alias } with
                    | ExtResult.ok (v, st') => do
                      set (st', trace)
                      pure (some v)
                    | ExtResult.fail => throw (Err.infallibleFailed "emit")
                    | ExtResult.unmodeled w => throw (Err.unmodeled w))
                    ({ base := (st.base.fresh RegClass.int).snd, demand := st.demand, uses := st.uses,
                        instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor,
                        tryRegs := st.tryRegs, current := st.current, color := st.color, sunk := st.sunk,
                        opportunistic := st.opportunistic, alias := st.alias },
                      trace)
              StateT.run
                  (match p_1.fst with
                  | none => pure none
                  | some v =>
                    evalBinds p (sem ctx) cfg (fuel + 16) []
                      (((((Array.replicate 4 none).setIfInBounds 0 (some address)).setIfInBounds 1
                                (some flags)).setIfInBounds
                            2 (some (V.reg (st.base.fresh RegClass.int).fst))).setIfInBounds
                        3 (some v)))
                  p_1.snd
          StateT.run
              (match p_1.fst with
              | some env' => evalExpr p (sem ctx) cfg (fuel + 18) (Expr.term 27 201 [Expr.var 28 2]) env'
              | none => pure none)
              p_1.snd
      StateT.run
          (match p.fst with
          | some v => do
            fire 300
            pure (some v)
          | none => pure none)
          p.snd) =
    Except.ok
      (some (V.reg (st.base.fresh RegClass.int).fst),
        { base := (st.base.fresh RegClass.int).snd.emit instruction, demand := st.demand, uses := st.uses,
          instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor, tryRegs := st.tryRegs,
          current := st.current, color := st.color, sunk := st.sunk, opportunistic := st.opportunistic,
          alias := st.alias },
        trace.push 300)

case signed16.mk
p : Program
ctx : Ctx
cfg : Config
overlap : cfg.checkOverlap = false
st : State
trace : Array RuleId
fuel : Nat
address flags : V
instruction : MInst
temp :
  ∀ (s : State),
    externCtor ctx T.temp_writable_reg [V.ty (CTy.int 64)] s =
      ExtResult.ok
        (V.reg (s.base.fresh RegClass.int).fst,
          { base := (s.base.fresh RegClass.int).snd, demand := s.demand, uses := s.uses, instBlock := s.instBlock,
            entryColor := s.entryColor, endColor := s.endColor, tryRegs := s.tryRegs, current := s.current,
            color := s.color, sunk := s.sunk, opportunistic := s.opportunistic, alias := s.alias })
reg : ∀ (r : Reg) (s : State), externCtor ctx T.writable_reg_to_reg [V.reg r] s = ExtResult.ok (V.reg r, s)
decoded :
  MInst.ofV (V.data 58 IntegerLoad.signed16.tag [V.reg (st.base.fresh RegClass.int).fst, address, flags]) =
    some instruction
emit :
  ∀ (s : State),
    externCtor ctx T.emit [V.data 58 IntegerLoad.signed16.tag [V.reg (st.base.fresh RegClass.int).fst, address, flags]]
        s =
      ExtResult.ok
        (V.op Opnd.unit,
          { base := s.base.emit instruction, demand := s.demand, uses := s.uses, instBlock := s.instBlock,
            entryColor := s.entryColor, endColor := s.endColor, tryRegs := s.tryRegs, current := s.current,
            color := s.color, sunk := s.sunk, opportunistic := s.opportunistic, alias := s.alias })
