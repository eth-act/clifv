  ∀ (s : State),
    externCtor ctx T.emit
        [V.data 58 IntegerLoad.unsigned64.tag [V.reg (st.base.fresh RegClass.int).fst, address, flags]] s =
      ExtResult.ok
        (V.op Opnd.unit,
