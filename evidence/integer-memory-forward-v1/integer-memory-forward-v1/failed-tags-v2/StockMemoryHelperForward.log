                        { base := (st.base.fresh RegClass.int).snd, demand := st.demand, uses := st.uses,
                          instBlock := st.instBlock, entryColor := st.entryColor, endColor := st.endColor,
                          tryRegs := st.tryRegs, current := st.current, color := st.color, sunk := st.sunk,
