trace : Array RuleId
fuel : Nat
address flags : V
instruction : MInst
temp :
  ∀ (s : State),
    externCtor ctx T.temp_writable_reg [V.ty (CTy.int 64)] s =
      ExtResult.ok
        (V.reg (s.base.fresh RegClass.int).fst,
          { base := (s.base.fresh RegClass.int).snd, demand := s.demand, uses := s.uses, instBlock := s.instBlock,
            entryColor := s.entryColor, endColor := s.endColor, tryRegs := s.tryRegs, current := s.current,
            color := s.color, sunk := s.sunk, opportunistic := s.opportunistic, alias := s.alias })
reg : ∀ (r : Reg) (s : State), externCtor ctx T.writable_reg_to_reg [V.reg r] s = ExtResult.ok (V.reg r, s)
decoded :
  MInst.ofV (V.data 58 IntegerLoad.signed8.tag [V.reg (st.base.fresh RegClass.int).fst, address, flags]) =
    some instruction
emit :
  ∀ (s : State),
    externCtor ctx T.emit [V.data 58 IntegerLoad.signed8.tag [V.reg (st.base.fresh RegClass.int).fst, address, flags]]
        s =
      ExtResult.ok
        (V.op Opnd.unit,
