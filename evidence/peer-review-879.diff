--- /dev/null
+++ b/FV/E2E/StockCodeStageContract.lean
@@ -0,0 +1,24 @@
+import FV.E2E.StockArithmeticStageContract
+
+/-! The checked Stock artifact contract over any emitted code, without the provenance field. -/
+namespace E2E
+open Backend Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `CompiledStockArithmeticStage` for the emitted code `vc`. -/
+structure CompiledStockCodeStage (cleanup : Bool) (k : Nat) (vc vcp : VCode) (rf : RFunc)
+    (af : AFunc) (fa : FnAsm) (fb : FnBin) : Prop where
+  prepare : Backend.prepare (Stock.Arithmetic.stage cleanup vc) = .ok vcp
+  prepOk : prepCheck (Stock.Arithmetic.stage cleanup vc) vcp = true
+  check : checkAlloc vcp rf = .ok ()
+  alloc : lowerRFunc vcp rf = .ok af
+  emit : emitFunc k af = .ok fa
+  layout : fa.layout = .ok fb
+
+theorem CompiledStockArithmeticStage.code {f : Clif.Function} {cleanup : Bool} {k : Nat}
+    {result : Stock.Result} {vcp : VCode} {rf : RFunc} {af : AFunc} {fa : FnAsm} {fb : FnBin}
+    (h : CompiledStockArithmeticStage f cleanup k result vcp rf af fa fb) :
+    CompiledStockCodeStage cleanup k result.code vcp rf af fa fb :=
+  ⟨h.prepare,h.prepOk,h.check,h.alloc,h.emit,h.layout⟩
+
+end E2E
diff --git a/FV/E2E/StockCodeWorldX.lean b/FV/E2E/StockCodeWorldX.lean
new file mode 100644
index 000000000..014404f99
--- /dev/null
+++ b/FV/E2E/StockCodeWorldX.lean
@@ -0,0 +1,94 @@
+import FV.E2E.StockCodeStageContract
+import FV.Backend.Proof.StockScalarCodeDomain
+import FV.E2E.LinkWorld
+import FV.E2E.StockArithmeticStage
+import FV.E2E.DeadCleanupRegLevelX
+import FV.E2E.DeadCleanupGot
+
+/-! The scalar source-to-machine theorem over any emitted code covered by a `CodeDomain`. -/
+
+namespace E2E
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof Backend.DeadCleanup
+set_option autoImplicit false
+set_option Elab.async false
+
+/-- Any emitted code covered by a `CodeDomain`, with both production cleanup settings,
+original source entry, linked ABI returns, post-call trace and per-state guarantees. -/
+theorem backend_correct_worldX_stock_code {p : Clif.Program} {f : Clif.Function} {k : Nat} {vc vcp : VCode}
+    {rf : RFunc} {af : AFunc} {fa : FnAsm} {fb : FnBin}
+    (domain : Stock.Scalar.CodeDomain f vc) {cleanup : Bool}
+    (hc : CompiledStockCodeStage cleanup k vc vcp rf af fa fb)
+    {X : ExtSem} {syms : String → Option Nat} {slotOff : Nat} {env : Clif.Env} {K : Nat}
+    {F : BitVec 64 → Prop} {c : BitVec 64}
+    (hcov : FormsCovered ⟨fa.k, af.slotBase⟩ vcp)
+    (hsym : ∀ n b, syms n = some b → X.sym n 0 = BitVec.ofNat 64 b)
+    (hslot : af.slotBase = slotOff)
+    {w₀ : Arm.ArmState} {args : List Clif.Val} {cs : Clif.State}
+    (hcs : ClifEntry f args cs)
+    (hrel : RelW ⟨F, syms, slotOff, (RAFrame.compute vcp rf).intBase⟩ f c cs.frame.slots cs.mem w₀)
+    (hargs : ArgsAtEntry F f.sig args w₀)
+    (fuel : Nat) :
+    (∀ vals cm, Clif.runLoop env p fuel cs = .returned vals cm →
+      ∃ (us : List (Reg × Reg)) (outs : List CV) (w : Arm.ArmState),
+        us.map (·.2) = (List.range us.length).map Reg.x ∧ us.length = outs.length ∧
+        PrefixHold vals outs ∧ MemRel F syms cm w ∧ vc.RetsSite us ∧
+        ∀ (H : ArmHooks) (G : BitVec 64 → Prop) (base ra : BitVec 64) (s : Arm.ArmState),
+          ActEntry vcp rf af fa fb K F G X H base ra s w₀ →
+          ∃ n, ActRet ra F G us outs w s (runX (ArmStepX X H fa) n s) ∧
+            PostTrace fa af base (ArmStepX X H fa) s n ∧
+            ∀ i < n, actGoodX vcp rf af fa fb base s X H K G (GotV vcp)
+              (runX (ArmStepX X H fa) i s)) ∧
+    (∀ c', Clif.runLoop env p fuel cs = .trapped c' →
+      ∀ (H : ArmHooks) (G : BitVec 64 → Prop) (base ra : BitVec 64) (s : Arm.ArmState),
+        ActEntry vcp rf af fa fb K F G X H base ra s w₀ →
+        ∃ n, TrapAt fb base c' (runX (ArmStepX X H fa) n s) ∧
+          (∀ i < n, actGoodX vcp rf af fa fb base s X H K G (GotV vcp)
+            (runX (ArmStepX X H fa) i s)) ∧
+          ∀ m, Arm.r .ERR (runX (ArmStepX X H fa) (n + m + 1) s) ≠ .None) := by
+  have state : (⟨cs.frame,[],cs.mem⟩ : Clif.State) = cs := by
+    have callers := hcs.callers
+    cases cs
+    cases callers
+    rfl
+  refine ⟨fun vals cm returned => ?_, fun code trapped H G base ra s he => ?_⟩
+  · obtain ⟨ρ,source⟩ := domain.returns hcs.stockSourceEntry
+      (by rwa [state]) (refines_valueSem F ⟨fa.k,af.slotBase⟩ X)
+      (driverSem_valueSem F ⟨fa.k,af.slotBase⟩ X)
+      (memRefines_valueSem F ⟨fa.k,af.slotBase⟩ X hslot hsym)
+      (mrStable_relW ⟨F,syms,slotOff,(RAFrame.compute vcp rf).intBase⟩ f c) hrel hargs
+    obtain ⟨us,outs,w,cm0,reached,pins,arity,values,memory,freed⟩ := source
+    have reached' := StockArithmeticStage_returns hc.prepOk reached
+    have site : vc.RetsSite us := by
+      obtain ⟨b,k,ρ,w₁,vb,ops,outs',_,hvb,hk,_⟩ := reached
+      exact ⟨b,vb,k,hvb,hk⟩
+    have mem : MemRel F syms cm w := by
+      rw [freed]
+      exact memRel_leave (memRel_free memory.1.1 _)
+    refine ⟨us,outs,w,pins.ordinary domain.ordinary,arity,values,mem,site,?_⟩
+    intro H G base ra s he
+    have machine := regLevelCorrect_worldX_value hc.check hc.alloc hc.emit hc.layout
+      (X := X) (H := H) (K := K) (G := G) (gv := GotV vcp)
+      hcov he.abi he.stack he.gfree (by rw [he.hF]; exact he.calls)
+      (by rw [he.hF]; exact he.tries) (by rw [he.hF]; exact he.tls)
+      (by rw [he.hF]; exact he.body) ρ
+    rw [he.hF] at machine
+    obtain ⟨n,⟨h1,h2,h3,h4,h5,h6,h7⟩,h8⟩ :=
+      machine.1 us outs w (vReturns_gotV_value reached')
+    exact ⟨n,⟨h1,h2,h3,h4,h5,h6⟩,h7,h8⟩
+  · obtain ⟨ρ,source⟩ := domain.traps hcs.stockSourceEntry
+      (by rwa [state]) (refines_valueSem F ⟨fa.k,af.slotBase⟩ X)
+      (driverSem_valueSem F ⟨fa.k,af.slotBase⟩ X)
+      (memRefines_valueSem F ⟨fa.k,af.slotBase⟩ X hslot hsym)
+      (mrStable_relW ⟨F,syms,slotOff,(RAFrame.compute vcp rf).intBase⟩ f c) hrel hargs
+    have staged := StockArithmeticStage_return (f := f)
+      (MR := RelW ⟨F,syms,slotOff,(RAFrame.compute vcp rf).intBase⟩ f c)
+      (slots := cs.frame.slots) hc.prepOk (outcome := .trapped code) source
+    have machine := regLevelCorrect_worldX_value hc.check hc.alloc hc.emit hc.layout
+      (X := X) (H := H) (K := K) (G := G) (gv := GotV vcp)
+      hcov he.abi he.stack he.gfree (by rw [he.hF]; exact he.calls)
+      (by rw [he.hF]; exact he.tries) (by rw [he.hF]; exact he.tls)
+      (by rw [he.hF]; exact he.body) ρ
+    rw [he.hF] at machine
+    exact machine.2 code (vTraps_gotV_value staged)
+
+end E2E
diff --git a/scripts/audit/stock-code-domain.lean b/scripts/audit/stock-code-domain.lean
new file mode 100644
index 000000000..c53ff00a1
--- /dev/null
+++ b/scripts/audit/stock-code-domain.lean
@@ -0,0 +1,8 @@
+import FV.E2E.StockCodeSplitWitness
+
