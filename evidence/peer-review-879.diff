diff --git a/FV/Backend/Proof/StockScalarCodeDomain.lean b/FV/Backend/Proof/StockScalarCodeDomain.lean
new file mode 100644
index 000000000..8917fbe75
--- /dev/null
+++ b/FV/Backend/Proof/StockScalarCodeDomain.lean
@@ -0,0 +1,57 @@
+import FV.Backend.Proof.StockScalarDomainAt
+
+/-! The scalar production domain stated over one emitted code. Both the legacy domain (for
+the actual lowered code) and the per-successor domain (for the actual split code) give it,
+so a consumer of `CodeDomain` serves routes that publish either code. -/
+
+namespace Backend.Stock.Scalar
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- `Domain` over the emitted code `vc` instead of the actual Stock lowering. -/
+structure CodeDomain (f : Clif.Function) (vc : VCode) : Prop where
+  scope : LowerScope f
+  dominated : Dominated f
+  abi : sigAbiOk f.sig = true
+  ordinary : (sigRets f.sig).any (·.purpose == .sret) = false
+  returns : ∀ {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {vals : List Clif.Val} {mem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals mem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w),
+    ∃ ρ,RunOkABI f vc isem MR fr.slots ⟨0,0,ρ,w⟩ (.returned vals mem)
+  traps : ∀ {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w),
+    ∃ ρ,VTrapFrom vc isem ⟨0,0,ρ,w⟩ code
+
+/-- The legacy domain covers the actual lowered code. -/
+theorem Domain.code {f : Clif.Function} (domain : Domain f) {result : Stock.Result}
+    (run : Stock.lower f = .ok result) : CodeDomain f result.code :=
+  ⟨domain.scope,domain.dominated,domain.abi,domain.ordinary,
+    fun {_ _ _} entered {_ _ _ _ _} returned {_ _} refines driver {_ _} memorySem {_} stable {_} memory arguments =>
+      domain.returns run entered returned refines driver memorySem stable memory arguments,
+    fun {_ _ _} entered {_ _ _ _} trapped {_ _} refines driver {_ _} memorySem {_} stable {_} memory arguments =>
+      domain.traps run entered trapped refines driver memorySem stable memory arguments⟩
+
+/-- The per-successor domain covers the actual split code. -/
+theorem DomainAt.code {f : Clif.Function} (domain : DomainAt f) {result : Stock.Result}
+    (run : Stock.lower f = .ok result) {split : EdgeVCode}
+    (splitRun : splitEdgesChecked result.code result.edgeArgs = .ok split) : CodeDomain f split.code :=
+  ⟨domain.scope,domain.dominated,domain.abi,domain.ordinary,
+    fun {_ _ _} entered {_ _ _ _ _} returned {_ _} refines driver {_ _} memorySem {_} stable {_} memory arguments =>
+      domain.split_returns run splitRun entered returned refines driver memorySem stable memory arguments,
+    fun {_ _ _} entered {_ _ _ _} trapped {_ _} refines driver {_ _} memorySem {_} stable {_} memory arguments =>
+      domain.split_traps run splitRun entered trapped refines driver memorySem stable memory arguments⟩
+
+end Backend.Stock.Scalar
diff --git a/FV/E2E/StockCodeCfgNI.lean b/FV/E2E/StockCodeCfgNI.lean
new file mode 100644
index 000000000..157a9d84a
--- /dev/null
+++ b/FV/E2E/StockCodeCfgNI.lean
@@ -0,0 +1,83 @@
+import FV.E2E.StockCodeStageContract
+import FV.Backend.Proof.StockScalarCodeDomain
+import FV.E2E.ABIReadOnlyMachine
+import FV.E2E.ABIReadCfg
+
+/-! The CFG non-interference theorem over any emitted code covered by a `CodeDomain`. -/
+
+namespace E2E
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof Backend.DeadCleanup
+set_option autoImplicit false
+set_option Elab.async false
+
+/-- Complete source-to-machine non-interference for any emitted CFG code covered by a `CodeDomain`.
+The runtime ABI-read check derives the read boundary; no legacy lowering verdict,
+second chosen virtual file or extra source-value assumption is needed. -/
+theorem backend_correct_world_niX_stock_code_cfg {p : Clif.Program} {f : Clif.Function} {k : Nat} {vc vcp : VCode}
+    {rf : RFunc} {af : AFunc} {fa : FnAsm} {fb : FnBin}
+    (domain : Stock.Scalar.CodeDomain f vc) {cleanup : Bool}
+    (readOnly : E2E.CfgBoundary.check f.sig vc = true)
+    (hc : CompiledStockCodeStage cleanup k vc vcp rf af fa fb)
+    {X : ExtSem} {syms : String → Option Nat} {slotOff : Nat} {env : Clif.Env} {K : Nat}
+    {F : BitVec 64 → Prop} {c : BitVec 64}
+    (hcov : FormsCovered ⟨fa.k, af.slotBase⟩ vcp)
+    (hsym : ∀ n b, syms n = some b → X.sym n 0 = BitVec.ofNat 64 b)
+    (hslot : af.slotBase = slotOff)
+    {w₀ : Arm.ArmState} {args : List Clif.Val} {cs : Clif.State}
+    (hcs : ClifEntry f args cs)
+    (hrel : RelW ⟨F, syms, slotOff, (RAFrame.compute vcp rf).intBase⟩ f c cs.frame.slots cs.mem w₀)
+    (hargs : ArgsAtEntry F f.sig args w₀)
+    (fuel : Nat) :
+    ∀ vals cm, Clif.runLoop env p fuel cs = .returned vals cm →
+      ∃ (us : List (Reg × Reg)) (outs : List CV) (w : Arm.ArmState),
+        us.map (·.2) = (List.range us.length).map Reg.x ∧ us.length = outs.length ∧
+        PrefixHold vals outs ∧ MemRel F syms cm w ∧ vc.RetsSite us ∧
+        (∀ (H : ArmHooks) (G : BitVec 64 → Prop) (base ra : BitVec 64) (s : Arm.ArmState),
+          ActEntry vcp rf af fa fb K F G X H base ra s w₀ →
+          ∃ n, ActRet ra F G us outs w s (runX (ArmStepX X H fa) n s) ∧
+            PostTrace fa af base (ArmStepX X H fa) s n ∧
+            ∀ i < n, actGoodX vcp rf af fa fb base s X H K G (GotV vcp)
+              (runX (ArmStepX X H fa) i s)) ∧
+        (∀ (D : BitVec 64 → Prop) (w₀' : Arm.ArmState),
+          RelW ⟨F, syms, slotOff, (RAFrame.compute vcp rf).intBase⟩ f c cs.frame.slots cs.mem w₀' →
+          SameWorld (fun b => F b ∨ D b) w₀ w₀' →
+          (∀ r v, (ArgLoc.reg r, v) ∈ (locsOf f.sig).zip args → regVal w₀' r = regVal w₀ r) →
+          (∀ off v, (ArgLoc.stack off, v) ∈ (locsOf f.sig).zip args → ∀ k < v.ty.bytes,
+            w₀'.mem (Arm.r (.GPR 29#5) w₀ + BitVec.ofInt 64 (16 + (off : Int)) + BitVec.ofNat 64 k) =
+              w₀.mem (Arm.r (.GPR 29#5) w₀ + BitVec.ofInt 64 (16 + (off : Int)) + BitVec.ofNat 64 k)) →
+          ∀ (H : ArmHooks) (G : BitVec 64 → Prop) (base ra : BitVec 64) (s : Arm.ArmState),
+            ActEntry vcp rf af fa fb K F G X H base ra s w₀' →
+            ∃ n, ActRet ra (fun a => F a ∨ D a) G us outs w s (runX (ArmStepX X H fa) n s) ∧
+              PostTrace fa af base (ArmStepX X H fa) s n ∧
+              ∀ i < n, actGoodX vcp rf af fa fb base s X H K G (GotV vcp)
+                (runX (ArmStepX X H fa) i s)) := by
+  intro vals cm returned
+  have state : (⟨cs.frame,[],cs.mem⟩ : Clif.State) = cs := by
+    have callers := hcs.callers
+    cases cs
+    cases callers
+    rfl
+  obtain ⟨ρ,source⟩ := domain.returns hcs.stockSourceEntry
+    (by rwa [state]) (CfgBoundary.refines F ⟨fa.k,af.slotBase⟩ X)
+    (CfgBoundary.driver F ⟨fa.k,af.slotBase⟩ X)
+    (CfgBoundary.memory F ⟨fa.k,af.slotBase⟩ X hslot hsym)
+    (mrStable_relW ⟨F,syms,slotOff,(RAFrame.compute vcp rf).intBase⟩ f c) hrel hargs
+  obtain ⟨us,outs,w,cm0,reached,pins,arity,values,memory,freed⟩ := source
+  have site : vc.RetsSite us := by
+    obtain ⟨b,k,ρ,w₁,vb,ops,outs',_,hvb,hk,_⟩ := reached
+    exact ⟨b,vb,k,hvb,hk⟩
+  have mem : MemRel F syms cm w := by
+    rw [freed]
+    exact memRel_leave (memRel_free memory.1.1 _)
+  refine ⟨us,outs,w,pins.ordinary domain.ordinary,arity,values,mem,site,?_,?_⟩
+  · intro H G base ra s he
+    exact CfgBoundary.machine_return (f := f) hcs.sig readOnly hc.prepOk hc.check hc.alloc hc.emit hc.layout
+      (fun _ h => h) hcov hargs (SameWorld.refl F w) reached H G base ra s he
+  · intro D w₀' hrel' hsw hreg hstk H G base ra s he
+    have arguments := ABIReadOnly.arguments_transport hargs hsw hreg hstk
+    obtain ⟨otherWorld,other,relatedWorlds⟩ :=
+      CfgBoundary.return_transport hcs.sig readOnly hsw hreg hstk reached
+    exact CfgBoundary.machine_return (f := f) hcs.sig readOnly hc.prepOk hc.check hc.alloc hc.emit hc.layout
+      (fun _ h => Or.inl h) hcov arguments relatedWorlds.symm other H G base ra s he
+
+end E2E
diff --git a/FV/E2E/StockCodeSplitWitness.lean b/FV/E2E/StockCodeSplitWitness.lean
new file mode 100644
index 000000000..1b8fe66da
--- /dev/null
+++ b/FV/E2E/StockCodeSplitWitness.lean
@@ -0,0 +1,94 @@
+import FV.E2E.StockCodeWorldX
+import FV.E2E.StockCodeCfgNI
+import FV.Backend.Proof.StockConditionalArgsWitness
+import FV.Backend.LinearScan
+import FV.Backend.Proof.RegallocCover
+
+/-! Non-vacuity of the code-level consumers on split code: the argument-passing conditional
+fixture's actual split code has the code domain, passes the CFG read check, and has the full
+checked stage (preparation, checked allocation, physical lowering, emission, layout) in both
+cleanup modes. -/
+
+namespace E2E.StockCodeSplitWitness
+open Backend Backend.Proof Backend.Proof.Driver
+set_option autoImplicit false
+
+private abbrev function := Backend.Stock.ConditionalArgsCfg.Fixture.function
+
+def checks (cleanup : Bool) : Bool :=
+  match Stock.lower function with
+  | .error _ => false
+  | .ok result =>
+    match splitEdgesChecked result.code result.edgeArgs with
+    | .error _ => false
+    | .ok split =>
+      CfgBoundary.check function.sig split.code &&
+      match Backend.prepare (Stock.Arithmetic.stage cleanup split.code) with
+      | .error _ => false
+      | .ok vcp =>
+        prepCheck (Stock.Arithmetic.stage cleanup split.code) vcp &&
+        match leanAlloc vcp with
+        | .error _ => false
+        | .ok rf =>
+          (checkAlloc vcp rf).isOk &&
+          match lowerRFunc vcp rf with
+          | .error _ => false
+          | .ok af =>
+            match emitFunc 0 af with
+            | .error _ => false
+            | .ok fa => formsCoveredB ⟨fa.k,af.slotBase⟩ vcp && fa.layout.isOk
+
+-- witness: native_decide (the fixed function's lowering, split and checked pipeline only)
+theorem checks_true : (checks false && checks true) = true := by native_decide
+
+theorem split_code_stage_witness (cleanup : Bool) :
+    ∃ result split vcp rf af fa fb,Stock.lower function = .ok result ∧
+      splitEdgesChecked result.code result.edgeArgs = .ok split ∧
+      Stock.Scalar.CodeDomain function split.code ∧
+      CfgBoundary.check function.sig split.code = true ∧
+      CompiledStockCodeStage cleanup 0 split.code vcp rf af fa fb ∧
+      FormsCovered ⟨fa.k,af.slotBase⟩ vcp := by
+  have fixed := checks_true
+  simp only [Bool.and_eq_true] at fixed
+  have h : checks cleanup = true := by cases cleanup <;> first | exact fixed.1 | exact fixed.2
+  unfold checks at h
+  cases lowered : Stock.lower function with
+  | error message => simp [lowered] at h
+  | ok result =>
+    simp only [lowered] at h
+    cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+    | error message => simp [splitRun] at h
+    | ok split =>
+      simp only [splitRun,Bool.and_eq_true] at h
+      obtain ⟨reads,h⟩ := h
+      have domain := Backend.Stock.ConditionalArgsCfg.Fixture.conditional_args_witness.1.code lowered splitRun
+      cases prepared : Backend.prepare (Stock.Arithmetic.stage cleanup split.code) with
+      | error message => simp [prepared] at h
+      | ok vcp =>
+        simp only [prepared,Bool.and_eq_true] at h
+        obtain ⟨prepOk,h⟩ := h
+        cases allocated : leanAlloc vcp with
+        | error message => simp [allocated] at h
+        | ok rf =>
+          simp only [allocated,Bool.and_eq_true] at h
+          obtain ⟨checked,h⟩ := h
+          cases physical : lowerRFunc vcp rf with
+          | error message => simp [physical] at h
+          | ok af =>
+            cases emitted : emitFunc 0 af with
+            | error message => simp [physical,emitted] at h
+            | ok fa =>
+              simp only [physical,emitted,Bool.and_eq_true] at h
+              obtain ⟨covered,layoutOk⟩ := h
+              cases emittedLayout : fa.layout with
+              | error message => rw [emittedLayout] at layoutOk; change false = true at layoutOk; cases layoutOk
+              | ok fb =>
+                have check : checkAlloc vcp rf = .ok () := by
+                  cases check : checkAlloc vcp rf with
+                  | error message => rw [check] at checked; change false = true at checked; cases checked
+                  | ok value => cases value; rfl
+                exact ⟨result,split,vcp,rf,af,fa,fb,rfl,splitRun,domain,reads,
+                  ⟨prepared,prepOk,check,physical,emitted,emittedLayout⟩,
+                  (formsCoveredB_iff _ _).mp covered⟩
+
+end E2E.StockCodeSplitWitness
