+import FV.Backend.Proof.StockPlainConditionCores
+import FV.Backend.Proof.StockComparisonGeneralLoopCarry
+
+/-! Branches on a plain computed condition or a comparison, with carry sets (#140, CB-11).
+
+`PlainMetadata` is the context metadata of a plain wide condition (`PlainSource` and an `i32` or
+`i64` type). It contains every wide parameter (`PlainMetadata.of_parameter`). `CondMetadata`
+adds it to the six comparison forms of `ComputedArgsMetadata` (CB-9). A branch on a condition in
+any form of `CondMetadata` has the named call packet (`cond_branch_calls`) and the carry cores
+`returning/trapping_cond_any_carry_core`. With them a branch composes below the fuel whose
+selected successor may take block arguments (`returning/trapping_selected_cond_carry_below`) or
+whose successors take none (`returning/trapping_empty_cond_carry_below`). -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.LoopCarry Backend.Stock.Proof.PlainBranch
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Context metadata of a plain wide condition: no lowering rule looks through its definition,
+and it has type `i32` or `i64`. -/
+def PlainMetadata (ctx : Ctx) (c : Nat) : Prop :=
+  PlainSource ctx c ∧ (ctx.valueType? c = some (.int 32) ∨ ctx.valueType? c = some (.int 64))
+
+/-- A wide parameter is a plain wide condition. -/
+theorem PlainMetadata.of_parameter {ctx : Ctx} {c : Nat} (parameter : ctx.defInst? c = none)
+    (conditionTy : ctx.valueType? c = some (.int 32) ∨ ctx.valueType? c = some (.int 64)) :
+    PlainMetadata ctx c :=
+  ⟨plain_of_parameter parameter,conditionTy⟩
+
+/-- Context metadata of a branch condition: a plain wide condition (which includes a wide
+parameter), or a comparison in one of the six forms of `ComputedArgsMetadata`. -/
+def CondMetadata (ctx : Ctx) (c : Nat) : Prop :=
+  PlainMetadata ctx c ∨ ComputedArgsMetadata ctx c
+
+/-- A branch on a condition in any form of `CondMetadata` has the named call packet. -/
+theorem ConditionalBodySpec.cond_branch_calls {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c) :
+    spec.BranchCalls := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  rcases condition with ⟨plain,_⟩ | comparison
+  · obtain ⟨calls,_⟩ := spec.plain_calls run scope block termShape plain
+    exact ⟨calls⟩
+  · exact spec.computed_args_branch_calls run scope termShape comparison
+
+/-- The carry return core of a branch on a condition in any form of `CondMetadata`. -/
+theorem ConditionalBodySpec.returning_cond_any_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    ReturningCarryCore spec needed fuel s vals cm ρ world := by
+  rcases condition with ⟨plain,conditionTy⟩ | comparison
+  · exact spec.returning_plain_carry_core run scope dominated family refines driver stable termShape plain
+      conditionTy available remaining atTerm defined returned held
+  · exact spec.returning_computed_args_any_carry_core run scope dominated family refines driver stable termShape
+      comparison available remaining atTerm defined returned held
+
+/-- The carry first-trap core of a branch on a condition in any form of `CondMetadata`. -/
+theorem ConditionalBodySpec.trapping_cond_any_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    TrappingCarryCore spec needed fuel s code ρ world := by
+  rcases condition with ⟨plain,conditionTy⟩ | comparison
+  · exact spec.trapping_plain_carry_core run scope dominated family refines driver stable termShape plain
+      conditionTy available remaining atTerm defined trapped held
+  · exact spec.trapping_computed_args_any_carry_core run scope dominated family refines driver stable termShape
+      comparison available remaining atTerm defined trapped held
+
+/-- **A branch on a condition in any form of `CondMetadata`, with block arguments, composes below
+the fuel, for returns.** The selected successor may take arguments, through an original or a
+critical-edge successor. -/
+theorem ConditionalBodySpec.returning_selected_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_selected_carry_below_of_core run scope dominated driver tag termShape
+    (spec.cond_branch_calls run scope termShape condition) successors callers
+    (spec.returning_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `CondMetadata`, with block arguments, composes below
+the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_selected_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_selected_carry_below_of_core run scope dominated driver tag termShape
+    (spec.cond_branch_calls run scope termShape condition) successors callers
+    (spec.trapping_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
+/-- **A branch on a condition in any form of `CondMetadata`, with empty block arguments, composes
+below the fuel, for returns.** -/
+theorem ConditionalBodySpec.returning_empty_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.returning_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `CondMetadata`, with empty block arguments, composes
+below the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_empty_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : CondMetadata result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.trapping_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
+end Backend.Stock.Proof.ConditionalValues
diff --git a/FV/Backend/Proof/StockGeneralLoopCheck2.lean b/FV/Backend/Proof/StockGeneralLoopCheck2.lean
new file mode 100644
index 000000000..c3b6d9b77
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopCheck2.lean
@@ -0,0 +1,106 @@
+import FV.Backend.Proof.StockGeneralLoopDomain2
+import FV.Backend.Proof.StockScalarCodeDomain
+import FV.Backend.Proof.StockScalarCheck
+
+/-! The selectors and checkers of the two loop classes with plain computed conditions are sound
+(#140, CB-11).
+
+`GeneralArgsLoopCfg2.sourceOk` derives the facts of `domainAt_of_general_args_loop_cfg`
+(`source_leaf_eligible_facts`), and its checker accepts the edge split of the actual lowering, so
+it derives the code domain of the published split code, as
+`ComparisonComputedArgsLoopCfg.check_sound`. `GeneralLoopCfg2.sourceOk` derives the facts of
+`domain_of_general_loop_cfg`, and its checker accepts the unsplit code of the actual lowering, as
+`ComparisonGeneralLoopCfg.check_sound`. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg2
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem ordinary_params {params : List Clif.AbiParam}
+    (all : params.all Scalar.narrowAbiEligible = true) : ∀ p ∈ params,p.purpose = .normal := by
+  intro p member
+  have good := List.all_eq_true.mp all p member
+  simp only [Scalar.narrowAbiEligible,Bool.and_eq_true] at good
+  exact beq_iff_eq.mp good.1
+
+/-- An ABI of narrow-eligible parameters and returns has no `sret` return. -/
+theorem ordinary_of_narrow {f : Clif.Function} (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) :
+    (sigRets f.sig).any (·.purpose == .sret) = false := by
+  have noSret : f.sig.params.find? (·.purpose == .sret) = none := by
+    apply List.find?_eq_none.mpr
+    intro p member
+    simp [(ordinary_params params) p member]
+  rw [sigRets,noSret]
+  apply Bool.eq_false_iff.mpr
+  intro any
+  obtain ⟨p,member,sret⟩ := List.any_eq_true.mp any
+  simpa [(ordinary_params returns) p member] using sret
+
+/-- Original input conditions and the split selector derive the per-successor production
+domain. -/
+theorem domainAt_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.DomainAt f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg2.domainAt_of_general_args_loop_cfg scope dominated abi
+    (ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The split selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.DomainAt f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domainAt_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The split checker is sound.** The executable check derives the code domain of the published
+split code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    Scalar.CodeDomain f vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run] at lowered
+    cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+    | error message => simp [splitRun] at lowered
+    | ok split =>
+      simp only [splitRun,decide_eq_true_eq] at lowered
+      subst vc
+      exact (source_ok_sound source).code run splitRun
+
+end Backend.Stock.GeneralArgsLoopCfg2
+
+namespace Backend.Stock.GeneralLoopCfg2
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original input conditions and the legacy selector derive the unchanged production domain. -/
+theorem domain_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.Domain f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg2.domain_of_general_loop_cfg scope dominated abi
+    (GeneralArgsLoopCfg2.ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The legacy selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.Domain f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domain_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The legacy checker is sound.** The executable check derives the unchanged production domain
+of the published unsplit code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    ∃ result,Scalar.Domain f ∧ Stock.lower f = .ok result ∧ result.code = vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run,decide_eq_true_eq] at lowered
+    exact ⟨result,source_ok_sound source,rfl,lowered⟩
+
+end Backend.Stock.GeneralLoopCfg2
diff --git a/FV/Backend/Proof/StockGeneralLoopDomain2.lean b/FV/Backend/Proof/StockGeneralLoopDomain2.lean
new file mode 100644
index 000000000..e023e6c79
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopDomain2.lean
@@ -0,0 +1,181 @@
+import FV.Backend.Proof.StockParameterCompatibility
+import FV.Backend.Proof.StockGeneralArgsLoopDomain2
+
+/-! The legacy loop class with plain computed conditions satisfies the unchanged production domain
+(#140, CB-11).
+
+The CB-10 transport with the condition `GeneralCondition`. A branch on a condition of the class
+has two successors in the actual block order: its named call packet (`cond_branch_calls`) names
+them (`branch_target_count`). Its arguments are empty, so its original and critical-edge vectors
+are empty, and the actual code keeps exact per-edge/single-vector agreement
+(`general_loop_legacy_compatible`). The class is the split class `GeneralArgsLoopCfg2` with empty
+`brif` arguments (`GeneralTerms.args`), so its returns and first traps hold over the actual
+per-successor vectors (`domainAt_of_general_args_loop_cfg`), and `RunOkABIAt.legacyCompatible` and
+`EdgeLegacyCompatible.star` transport them to the legacy observations of the unsplit code
+(`domain_of_general_loop_cfg`, `Scalar.Domain`). -/
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg2
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+  Backend.Stock.Proof.ForwardSource Backend.Stock.Proof.ParameterCfg
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem selected_empty {b : Clif.Block} {c index id : Nat} {yes no : Clif.BlockCall} {args : List Clif.TryArg}
+    (term : b.term = .brif c yes no) (yesEmpty : yes.args = []) (noEmpty : no.args = [])
+    (selected : (destinations b.term)[index]? = some (id,args)) :
+    ∃ bc,(dests b.term)[index]? = some bc ∧ bc.args = [] := by
+  cases index with
+  | zero => exact ⟨yes,by simp [term,dests],yesEmpty⟩
+  | succ index =>
+    cases index with
+    | zero => exact ⟨no,by simp [term,dests],noEmpty⟩
+    | succ index => simp [term,destinations] at selected
+
+private theorem assembled_arguments {ctx : Ctx} {f : Clif.Function} {b : Clif.Block}
+    {bi label : Nat} {targets : Array Nat} {outgoing : Array (Array Reg)}
+    {params : List Nat} {uses : Array UseState} {code : Array MInst} {block : VBlock}
+    (run : assembleOriginalBlock ctx f b bi label targets outgoing params uses code = .ok block) :
+    block.branchArgs = (if targets.size == 1 then outgoing[0]! else #[]) := by
+  unfold assembleOriginalBlock at run
+  dsimp only at run
+  repeat' first
+    | (solve | cases run)
+    | simp only [bind,Except.bind,pure,Except.pure] at run
+    | split at run
+  all_goals cases run; simp_all
+
+/-- A branch on a condition of the class has two successors in the actual block order. -/
+theorem branch_target_count {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (term : b.term = .brif c yes no) (condition : GeneralCondition f c) :
+    result.order.successors[label]!.size = 2 := by
+  obtain ⟨calls⟩ := spec.cond_branch_calls run scope term (condition_metadata condition scope dominated spec.build)
+  have size := congrArg List.length calls.labels_eq
+  simpa only [Array.length_toList,List.length_cons,List.length_nil] using size
+
+/-- **The legacy loop class with plain computed conditions keeps exact per-edge/single-vector
+agreement** of the actual code: jumps carry their arguments, branches carry none, and returns and
+traps have no outgoing edge. -/
+theorem general_loop_legacy_compatible {f : Clif.Function} {result : Result}
+    (terms : GeneralTerms f) (run : Stock.lower f = .ok result)
+    (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR) (env : Clif.Env) (cp : Clif.Program) :
+    EdgeLegacyCompatible result.code result.edgeArgs := by
+  have built : ∃ ranges,Stock.buildCtx f = .ok (result.ctx,ranges,result.initial) := by
+    unfold Stock.lower at run
+    dsimp only at run
+    repeat' first
+      | (solve | cases run)
+      | simp only [bind,Except.bind,pure,Except.pure] at run
+      | split at run
+    cases run
+    exact ⟨_,by assumption⟩
+  obtain ⟨ranges,build⟩ := built
+  have inv := buildCtx_mappedInv scope build
+  obtain ⟨ps,cfg⟩ := stock_lower_computed_cfg run scope
+  have sizes := (stock_lower_graph_bounds run).1
+  have nodes : result.code.blocks.size = result.order.nodes.size :=
+    (stock_prepare_dimensions run).1.symm.trans (stock_prepare_dimensions run).2.1
+  intro label index target selected
+  simp only [succOf,cfg] at selected
+  cases row : result.order.successors[label]? with
+  | none => simp only [row,Option.bind_none] at selected; cases selected
+  | some ss =>
+    simp only [row,Option.bind_some] at selected
+    have labelBound : label < result.order.nodes.size := by
+      have bound := (Array.getElem?_eq_some_iff.mp row).1
+      omega
+    cases tag : result.order.nodes[label]? with
+    | none => have absent := Array.getElem?_eq_none_iff.mp tag; omega
+    | some node =>
+      cases node with
+      | original bi =>
+        obtain ⟨b,id,args,ti,source,destination,found,targetNode⟩ := stock_lower_indexed_successor_origin run tag row selected
+        rcases terms bi b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ | ⟨leafCode,trap⟩
+        · have only : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [jump,destinations] at destination
+          subst index
+          obtain ⟨tl,targetLabel,identified,nonentry,successors,targetTag⟩ := CriticalOwners.jump_successor run scope tag source jump
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have sameTarget : targetLabel = target := by simpa [sameRow] using selected
+          subst targetLabel
+          have successorsBang : result.order.successors[label]! = #[target] := by simp only [getElem!_def,successors,Option.getD_some]
+          obtain ⟨vb,placed,labelled,arguments⟩ := stock_lower_original_jump_args run scope tag source jump successorsBang targetTag
+          have vector := stock_lower_selected_outgoing run scope tag source (bc := bc) (index := 0)
+            (by simp [jump,dests]) (by simpa only [getElem!_def,row,Option.getD_some] using selected) targetTag
+          exact ⟨vb,placed,by simpa only [outgoingAt,arguments] using vector⟩
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term refines driver stable env cp
+          have targetCount := branch_target_count run scope dominated spec term condition
+          have rawArgs : spec.raw.branchArgs = #[] := by
+            have args := assembled_arguments spec.assembled
+            simpa only [targetCount,show (2 == 1) = false from rfl,Bool.false_eq_true,ite_false] using args
+          obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          have successor : result.order.successors[label]![index]? = some target := by
+            simpa only [getElem!_def,row,Option.getD_some] using selected
+          have vector : outgoingAt result label index = some #[] := by
+            rcases targetNode with original | synthetic
+            · have actual := stock_lower_selected_outgoing run scope tag source selectedBc successor original
+              simpa only [edgeArgumentNumbers,empty,List.map_nil] using actual
+            · exact stock_lower_deferred_outgoing run tag successor synthetic
+          refine ⟨_,spec.placed,?_⟩
+          simpa only [outgoingAt,rawArgs,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+      | edge pred k ti =>
+        obtain ⟨b,id,args,source,destination,found⟩ := stock_lower_critical_source run tag
+        rcases terms pred b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ | ⟨leafCode,trap⟩
+        · exact False.elim (CriticalOwners.jump_no_edge (stock_lower_order run) source jump k ti
+            (Array.mem_toList_iff.mpr (Array.mem_of_getElem? tag)))
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          obtain ⟨input,next,registers,targetLabel,call,successors,targetTag,placed⟩ := stock_lower_critical_code run tag
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have zero : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [sameRow] at selected
+          subst index
+          have mapping := stock_branchArgs_selected_mapping inv.func source selectedBc call
+          have noRegisters : registers = #[] := by
+            rw [empty] at mapping
+            simp only [List.mapM_nil,Option.pure_def,Option.some.injEq] at mapping
+            exact Array.toList_inj.mp mapping.symm
+          have vector := stock_lower_critical_argument_vector run scope tag source selectedBc
+          refine ⟨_,placed,?_⟩
+          simpa only [outgoingAt,edgeArgumentNumbers,empty,List.map_nil,noRegisters,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+
+/-- **The legacy loop class with plain computed conditions satisfies the unchanged production
+domain.** Every block jumps (with any arguments), returns, branches with empty arguments on a wide
+parameter, on a comparison (`ComputedArgsCondition`), or on a plain condition (`PlainCondition`:
+a wide result of a statement that is not an `icmp`, a `band` or a `uextend`), or, outside the
+entry, ends in `trap`. No rank: jump and branch targets may be loop headers. -/
+theorem domain_of_general_loop_cfg {f : Clif.Function}
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false)
+    (terms : GeneralTerms f)
+    (entryKind : ∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) : Scalar.Domain f := by
+  have domainAt := domainAt_of_general_args_loop_cfg scope dominated abi ordinary terms.args entryKind family
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,simulation⟩ := domainAt.returns run entered returned refines driver memorySem stable memory arguments
+    exact ⟨ρ,simulation.legacyCompatible compatible⟩
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',path,tail⟩ :=
+      domainAt.traps run entered trapped refines driver memorySem stable memory arguments
+    exact ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',compatible.star path,tail⟩
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg2
diff --git a/FV/Backend/Proof/StockGeneralLoopWitness2.lean b/FV/Backend/Proof/StockGeneralLoopWitness2.lean
new file mode 100644
index 000000000..c92c783e5
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopWitness2.lean
@@ -0,0 +1,134 @@
+import FV.Clif.Parse
+import FV.Backend.Proof.StockGeneralLoopCheck2
+import FV.Backend.Proof.StockGeneralSubsumption2
+
+/-! Non-vacuity of the legacy loop class with plain computed conditions (#140, CB-11) on a loop
+whose header branches on a computed `iadd` value and whose branch passes no block arguments:
+
+```
+function %countdown_plain(i64) -> i64 {
+block0(v0: i64):
+    jump block1(v0)
+
+block1(v1: i64):
+    v2 = iconst.i64 -1
+    v3 = iadd v1, v2
+    brif v3, block2, block3
+
+block2:
+    jump block1(v3)
+
+block3:
+    return v1
+}
+```
+
+The header `block1` counts down until `v1 - 1 = 0`. Its condition is the computed value `v3`
+itself, not a comparison: the lowering is `sub` and one `cbnz` on `v3` (`lower_brif` 3231,
+`is_nonzero` 4979). The back edge `block2 → block1` is a jump with an argument. The CB-10 legacy
+class `ComparisonGeneralLoopCfg` and the CB-9 split class `ComparisonComputedArgsLoopCfg` reject the
+function (`earlier_classes_reject`): an `iadd` result is not one of their conditions. The new
+selector accepts it, and the checker accepts the actual unsplit code, whose per-edge vectors agree
+with the legacy branch arguments.
+
+The source run from `3` takes the back edge twice and returns `1` with fuel `13`. -/
+
+namespace Backend.Stock.GeneralLoopCfg2.Fixture
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- The text of `%countdown_plain`. -/
+def countdownSource : String := "function %countdown_plain(i64) -> i64 {
+block0(v0: i64):
+    jump block1(v0)
+
+block1(v1: i64):
+    v2 = iconst.i64 -1
+    v3 = iadd v1, v2
+    brif v3, block2, block3
+
+block2:
+    jump block1(v3)
+
+block3:
+    return v1
+}
+"
+
+/-- `%countdown_plain` as a `Clif.Function` literal. -/
+def countdownPlain : Clif.Function := {
+  name := "countdown_plain"
+  sig := { params := [⟨.i64,.none,.normal⟩], returns := [⟨.i64,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i64)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(1,.i64)],
+      body := [⟨[2],.iconst .i64 (-1)⟩,⟨[3],.binary .iadd .i64 1 2⟩],
+      term := .brif 3 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [], term := .jump ⟨1,[3]⟩ },
+    { id := 3, params := [], body := [], term := .ret [1] }] }
+
+/-- The CB-10 legacy class and the CB-9 split class reject `%countdown_plain`; the CB-11 split
+class accepts it. -/
+theorem earlier_classes_reject :
+    ComparisonGeneralLoopCfg.sourceOk countdownPlain = false ∧
+    ComparisonComputedArgsLoopCfg.sourceOk countdownPlain = false ∧
+    GeneralArgsLoopCfg2.plainEligible countdownPlain 3 = true := by
+  decide
+
+/-- The source outcome from the entry with fuel `fuel`, for the argument `start`. -/
+def sourceOutcome (fuel : Nat) (start : BitVec 64) : Option Clif.Outcome :=
+  match Clif.enterFunc countdownPlain [⟨.i64,start⟩] Clif.Mem.empty with
+  | .ok (fr,cm) => some (Clif.runLoop Clif.Env.empty {funcs := []} fuel ⟨fr,[],cm⟩)
+  | _ => none
+
+private def checks : Bool :=
+  decide ((Clif.parseFile countdownSource).funcs.map (·.func.toOption) = [some countdownPlain]) &&
+  (match sourceOutcome 13 3 with | some (.returned vals _) => decide (vals = [⟨.i64,1⟩]) | _ => false) &&
+  match Stock.lower countdownPlain with
+  | .error _ => false
+  | .ok result => edgeLegacyCompatibleB result.code result.edgeArgs && check countdownPlain result.code
+
+-- witness: native_decide (the fixed function's parse, source run, lowering, compatibility check and checker only)
+private theorem checks_true : checks = true := by native_decide
+
+/-- **`%countdown_plain` is in the checked legacy loop class with plain computed conditions.** The
+literal is the parse of the text; the source run from `3` returns `1`; its actual unsplit
+lowering keeps the legacy per-edge vectors and passes the checker, which derives `Scalar.Domain`;
+and the CB-10 legacy checker rejects it (`earlier_classes_reject`). -/
+theorem countdown_plain_witness :
+    (Clif.parseFile countdownSource).funcs.map (·.func.toOption) = [some countdownPlain] ∧
+    Scalar.Domain countdownPlain ∧
+    (∃ mem,sourceOutcome 13 3 = some (.returned [⟨.i64,1⟩] mem)) ∧
+    ∃ result,Stock.lower countdownPlain = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check countdownPlain result.code = true ∧
+      ComparisonGeneralLoopCfg.check countdownPlain result.code = false := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨parsed,returns⟩,lowered⟩ := h
+  refine ⟨of_decide_eq_true parsed,?_,?_,?_⟩
+  · cases run : Stock.lower countdownPlain with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      obtain ⟨result',domain,_,_⟩ := check_sound lowered.2
+      exact domain
+  · cases outcome : sourceOutcome 13 3 with
+    | none => rw [outcome] at returns; cases returns
+    | some o =>
+      rw [outcome] at returns
+      cases o with
+      | returned vals mem =>
+        simp only [decide_eq_true_eq] at returns
+        exact ⟨mem,by rw [returns]⟩
+      | _ => cases returns
+  · cases run : Stock.lower countdownPlain with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      refine ⟨result,rfl,lowered.1,lowered.2,?_⟩
+      simp [ComparisonGeneralLoopCfg.check,earlier_classes_reject.1]
+
+end Backend.Stock.GeneralLoopCfg2.Fixture
