+    defZ,foundZ,dataZ,zero⟩ := data
+  have e0 := ext_inst_data_value ctx st.base slot
+  have e1 := ext_def_inst_some ctx st.base defC
+  have e2 := ext_inst_data_value ctx st.base foundC
+  rw [dataC] at e2
