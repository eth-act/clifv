index 000000000..feceb3f3d
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopWitness5.lean
@@ -0,0 +1,301 @@
+import FV.Clif.Parse
+import FV.Backend.Proof.StockGeneralLoopCheck5
+import FV.Backend.Proof.StockGeneralSubsumption5
+
+/-! Non-vacuity of the legacy loop class with one-bit tests and zero extensions as conditions
+(#140, CB-13): one loop per new condition form, each with a header branch that passes no block
+arguments and a back edge that is a jump with an argument.
+
+```
+function %bit_loop(i32) -> i32 {          ; tbnz: band v1, (iconst 1)
+block0(v0: i32):
+    jump block1(v0)
+block1(v1: i32):
+    v2 = iconst.i32 1
+    v3 = band v1, v2
+    brif v3, block2, block3
+block2:
+    v4 = iadd v1, v1
+    jump block1(v4)
+block3:
+    return v1
+}
+```
+
+`%zero_bit_loop` branches on `icmp eq (band v1, (iconst 4)), (iconst 0)` (`tbz v1, #2`),
+`%uext_cmp_loop` on `uextend.i32 (icmp slt v2, v1)` of two `i32` parameters (`subs` and `b.lt`
+through `maybe_uextend`), and `%uext_plain_loop` on `uextend.i32 v1` of an `i8` parameter (`uxtb`
+and `cbnz`). The CB-12b classes `GeneralLoopCfg4` and `GeneralArgsLoopCfg4` reject each function
+(`earlier_classes_reject`): none of these conditions is one of theirs. The new selector accepts
+each, and the checker accepts the actual unsplit code, whose per-edge vectors agree with the legacy
+branch arguments. The source runs return `6` from `3`, `4` from `1`, `2` from `(0,2)` and `0` from
+`3`. -/
+
+namespace Backend.Stock.GeneralLoopCfg5.Fixture
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- The text of `%bit_loop`. -/
+def bitSource : String := "function %bit_loop(i32) -> i32 {
+block0(v0: i32):
+    jump block1(v0)
+
+block1(v1: i32):
+    v2 = iconst.i32 1
+    v3 = band v1, v2
+    brif v3, block2, block3
+
+block2:
+    v4 = iadd v1, v1
+    jump block1(v4)
+
+block3:
+    return v1
+}
+"
+
+/-- `%bit_loop` as a `Clif.Function` literal. -/
+def bitLoop : Clif.Function := {
+  name := "bit_loop"
+  sig := { params := [⟨.i32,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i32)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(1,.i32)],
+      body := [⟨[2],.iconst .i32 1⟩,⟨[3],.binary .band .i32 1 2⟩],
+      term := .brif 3 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [⟨[4],.binary .iadd .i32 1 1⟩], term := .jump ⟨1,[4]⟩ },
+    { id := 3, params := [], body := [], term := .ret [1] }] }
+
+/-- The text of `%zero_bit_loop`. -/
+def zeroBitSource : String := "function %zero_bit_loop(i64) -> i64 {
+block0(v0: i64):
+    jump block1(v0)
+
+block1(v1: i64):
+    v2 = iconst.i64 4
+    v3 = band v1, v2
+    v4 = iconst.i64 0
+    v5 = icmp eq v3, v4
+    brif v5, block2, block3
+
+block2:
+    v6 = iadd v1, v1
+    jump block1(v6)
+
+block3:
+    return v1
+}
+"
+
+/-- `%zero_bit_loop` as a `Clif.Function` literal. -/
+def zeroBitLoop : Clif.Function := {
+  name := "zero_bit_loop"
+  sig := { params := [⟨.i64,.none,.normal⟩], returns := [⟨.i64,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i64)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(1,.i64)],
+      body := [⟨[2],.iconst .i64 4⟩,⟨[3],.binary .band .i64 1 2⟩,⟨[4],.iconst .i64 0⟩,
+        ⟨[5],.icmp .eq .i64 3 4⟩],
+      term := .brif 5 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [⟨[6],.binary .iadd .i64 1 1⟩], term := .jump ⟨1,[6]⟩ },
+    { id := 3, params := [], body := [], term := .ret [1] }] }
+
+/-- The text of `%uext_cmp_loop`. -/
+def uextComparisonSource : String := "function %uext_cmp_loop(i32, i32) -> i32 {
+block0(v0: i32, v1: i32):
+    jump block1(v0)
+
+block1(v2: i32):
+    v3 = icmp slt v2, v1
+    v4 = uextend.i32 v3
+    brif v4, block2, block3
+
+block2:
+    v5 = iconst.i32 1
+    v6 = iadd v2, v5
+    jump block1(v6)
+
+block3:
+    return v2
+}
+"
+
+/-- `%uext_cmp_loop` as a `Clif.Function` literal. -/
+def uextComparisonLoop : Clif.Function := {
+  name := "uext_cmp_loop"
+  sig := { params := [⟨.i32,.none,.normal⟩,⟨.i32,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i32),(1,.i32)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(2,.i32)],
+      body := [⟨[3],.icmp .slt .i32 2 1⟩,⟨[4],.extend .uextend .i32 3⟩],
+      term := .brif 4 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [⟨[5],.iconst .i32 1⟩,⟨[6],.binary .iadd .i32 2 5⟩],
+      term := .jump ⟨1,[6]⟩ },
+    { id := 3, params := [], body := [], term := .ret [2] }] }
+
+/-- The text of `%uext_plain_loop`. -/
+def uextPlainSource : String := "function %uext_plain_loop(i8) -> i32 {
+block0(v0: i8):
+    jump block1(v0)
+
+block1(v1: i8):
+    v2 = uextend.i32 v1
+    brif v2, block2, block3
+
+block2:
+    v3 = iconst.i8 -1
+    v4 = iadd v1, v3
+    jump block1(v4)
+
+block3:
+    return v2
+}
+"
+
+/-- `%uext_plain_loop` as a `Clif.Function` literal. -/
+def uextPlainLoop : Clif.Function := {
+  name := "uext_plain_loop"
+  sig := { params := [⟨.i8,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i8)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(1,.i8)], body := [⟨[2],.extend .uextend .i32 1⟩],
+      term := .brif 2 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [⟨[3],.iconst .i8 (-1)⟩,⟨[4],.binary .iadd .i8 1 3⟩],
+      term := .jump ⟨1,[4]⟩ },
+    { id := 3, params := [], body := [], term := .ret [2] }] }
+
+/-- The CB-12b legacy and split classes reject the four functions; their conditions are a one-bit
+test, a zero test of a one-bit mask, a zero extension of a wide comparison and a plain zero
+extension of the CB-13 classes. -/
+theorem earlier_classes_reject :
+    GeneralLoopCfg4.sourceOk bitLoop = false ∧ GeneralArgsLoopCfg4.sourceOk bitLoop = false ∧
+    GeneralArgsLoopCfg5.testBitEligible bitLoop 3 = true ∧
+    GeneralLoopCfg4.sourceOk zeroBitLoop = false ∧ GeneralArgsLoopCfg4.sourceOk zeroBitLoop = false ∧
+    GeneralArgsLoopCfg5.testBitZeroEligible zeroBitLoop 5 = true ∧
+    GeneralLoopCfg4.sourceOk uextComparisonLoop = false ∧ GeneralArgsLoopCfg4.sourceOk uextComparisonLoop = false ∧
+    GeneralArgsLoopCfg5.uextComparisonEligible uextComparisonLoop 4 = true ∧
+    GeneralLoopCfg4.sourceOk uextPlainLoop = false ∧ GeneralArgsLoopCfg4.sourceOk uextPlainLoop = false ∧
+    GeneralArgsLoopCfg5.uextPlainEligible uextPlainLoop 2 = true := by
+  decide
+
+/-- The source outcome of `f` from the entry with fuel `fuel`, for the arguments `args`. -/
+def sourceOutcome (f : Clif.Function) (fuel : Nat) (args : List Clif.Val) : Option Clif.Outcome :=
+  match Clif.enterFunc f args Clif.Mem.empty with
+  | .ok (fr,cm) => some (Clif.runLoop Clif.Env.empty {funcs := []} fuel ⟨fr,[],cm⟩)
+  | _ => none
+
+/-- The executable facts of one fixture: the literal is the parse of the text, the source run
+returns `expected`, and the actual unsplit lowering keeps the legacy per-edge vectors and passes
+the checker. -/
+def fixtureChecks (source : String) (f : Clif.Function) (fuel : Nat) (args expected : List Clif.Val) : Bool :=
+  decide ((Clif.parseFile source).funcs.map (·.func.toOption) = [some f]) &&
+  (match sourceOutcome f fuel args with | some (.returned vals _) => decide (vals = expected) | _ => false) &&
+  match Stock.lower f with
+  | .error _ => false
+  | .ok result => edgeLegacyCompatibleB result.code result.edgeArgs && check f result.code
+
+/-- The executable facts of a fixture give its witness: the parse, `Scalar.Domain` (by
+`check_sound`), the source return, and the accepted actual lowering. -/
+theorem fixture_witness {source : String} {f : Clif.Function} {fuel : Nat} {args expected : List Clif.Val}
+    (checked : fixtureChecks source f fuel args expected = true) :
+    (Clif.parseFile source).funcs.map (·.func.toOption) = [some f] ∧ Scalar.Domain f ∧
+    (∃ mem,sourceOutcome f fuel args = some (.returned expected mem)) ∧
+    ∃ result,Stock.lower f = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check f result.code = true := by
+  unfold fixtureChecks at checked
+  simp only [Bool.and_eq_true] at checked
+  obtain ⟨⟨parsed,returns⟩,lowered⟩ := checked
+  refine ⟨of_decide_eq_true parsed,?_,?_,?_⟩
+  · cases run : Stock.lower f with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      obtain ⟨result',domain,_,_⟩ := check_sound lowered.2
+      exact domain
+  · cases outcome : sourceOutcome f fuel args with
+    | none => rw [outcome] at returns; cases returns
+    | some o =>
+      rw [outcome] at returns
+      cases o with
+      | returned vals mem =>
+        simp only [decide_eq_true_eq] at returns
+        exact ⟨mem,by rw [returns]⟩
+      | _ => cases returns
+  · cases run : Stock.lower f with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      exact ⟨result,rfl,lowered.1,lowered.2⟩
+
+private def checks : Bool :=
+  fixtureChecks bitSource bitLoop 40 [⟨.i32,3⟩] [⟨.i32,6⟩] &&
+  fixtureChecks zeroBitSource zeroBitLoop 40 [⟨.i64,1⟩] [⟨.i64,4⟩] &&
+  fixtureChecks uextComparisonSource uextComparisonLoop 40 [⟨.i32,0⟩,⟨.i32,2⟩] [⟨.i32,2⟩] &&
+  fixtureChecks uextPlainSource uextPlainLoop 40 [⟨.i8,3⟩] [⟨.i32,0⟩]
+
+-- witness: native_decide (the four fixed functions' parses, source runs, lowerings, compatibility checks and checkers only)
+private theorem checks_true : checks = true := by native_decide -- witness: native_decide
+
+private theorem all_checks :
+    fixtureChecks bitSource bitLoop 40 [⟨.i32,3⟩] [⟨.i32,6⟩] = true ∧
+    fixtureChecks zeroBitSource zeroBitLoop 40 [⟨.i64,1⟩] [⟨.i64,4⟩] = true ∧
+    fixtureChecks uextComparisonSource uextComparisonLoop 40 [⟨.i32,0⟩,⟨.i32,2⟩] [⟨.i32,2⟩] = true ∧
+    fixtureChecks uextPlainSource uextPlainLoop 40 [⟨.i8,3⟩] [⟨.i32,0⟩] = true := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨⟨bit,zero⟩,comparison⟩,plain⟩ := h
+  exact ⟨bit,zero,comparison,plain⟩
+
+private theorem earlier_check {f : Clif.Function} {vc : VCode} (rejected : GeneralLoopCfg4.sourceOk f = false) :
+    GeneralLoopCfg4.check f vc = false := by
+  simp [GeneralLoopCfg4.check,rejected]
+
+/-- **`%bit_loop` (a `tbnz` condition) is in the checked legacy loop class.** -/
+theorem bit_loop_witness :
+    (Clif.parseFile bitSource).funcs.map (·.func.toOption) = [some bitLoop] ∧ Scalar.Domain bitLoop ∧
+    (∃ mem,sourceOutcome bitLoop 40 [⟨.i32,3⟩] = some (.returned [⟨.i32,6⟩] mem)) ∧
+    ∃ result,Stock.lower bitLoop = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check bitLoop result.code = true ∧
+      GeneralLoopCfg4.check bitLoop result.code = false := by
+  obtain ⟨parsed,domain,returns,result,run,compatible,checked⟩ := fixture_witness all_checks.1
+  exact ⟨parsed,domain,returns,result,run,compatible,checked,earlier_check earlier_classes_reject.1⟩
+
+/-- **`%zero_bit_loop` (a `tbz` condition) is in the checked legacy loop class.** -/
+theorem zero_bit_loop_witness :
+    (Clif.parseFile zeroBitSource).funcs.map (·.func.toOption) = [some zeroBitLoop] ∧ Scalar.Domain zeroBitLoop ∧
+    (∃ mem,sourceOutcome zeroBitLoop 40 [⟨.i64,1⟩] = some (.returned [⟨.i64,4⟩] mem)) ∧
+    ∃ result,Stock.lower zeroBitLoop = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check zeroBitLoop result.code = true ∧
+      GeneralLoopCfg4.check zeroBitLoop result.code = false := by
+  obtain ⟨parsed,domain,returns,result,run,compatible,checked⟩ := fixture_witness all_checks.2.1
+  exact ⟨parsed,domain,returns,result,run,compatible,checked,earlier_check earlier_classes_reject.2.2.2.1⟩
+
+/-- **`%uext_cmp_loop` (a zero extension of a wide comparison) is in the checked legacy loop
+class.** -/
+theorem uext_comparison_loop_witness :
+    (Clif.parseFile uextComparisonSource).funcs.map (·.func.toOption) = [some uextComparisonLoop] ∧
+    Scalar.Domain uextComparisonLoop ∧
+    (∃ mem,sourceOutcome uextComparisonLoop 40 [⟨.i32,0⟩,⟨.i32,2⟩] = some (.returned [⟨.i32,2⟩] mem)) ∧
+    ∃ result,Stock.lower uextComparisonLoop = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check uextComparisonLoop result.code = true ∧
+      GeneralLoopCfg4.check uextComparisonLoop result.code = false := by
+  obtain ⟨parsed,domain,returns,result,run,compatible,checked⟩ := fixture_witness all_checks.2.2.1
+  exact ⟨parsed,domain,returns,result,run,compatible,checked,
+    earlier_check earlier_classes_reject.2.2.2.2.2.2.1⟩
+
+/-- **`%uext_plain_loop` (a plain zero extension) is in the checked legacy loop class.** -/
+theorem uext_plain_loop_witness :
+    (Clif.parseFile uextPlainSource).funcs.map (·.func.toOption) = [some uextPlainLoop] ∧
+    Scalar.Domain uextPlainLoop ∧
+    (∃ mem,sourceOutcome uextPlainLoop 40 [⟨.i8,3⟩] = some (.returned [⟨.i32,0⟩] mem)) ∧
+    ∃ result,Stock.lower uextPlainLoop = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check uextPlainLoop result.code = true ∧
+      GeneralLoopCfg4.check uextPlainLoop result.code = false := by
+  obtain ⟨parsed,domain,returns,result,run,compatible,checked⟩ := fixture_witness all_checks.2.2.2
+  exact ⟨parsed,domain,returns,result,run,compatible,checked,
+    earlier_check earlier_classes_reject.2.2.2.2.2.2.2.2.2.1⟩
+
+end Backend.Stock.GeneralLoopCfg5.Fixture
diff --git a/FV/Backend/Proof/StockGeneralSubsumption5.lean b/FV/Backend/Proof/StockGeneralSubsumption5.lean
new file mode 100644
index 000000000..e734dd021
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralSubsumption5.lean
@@ -0,0 +1,189 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg5
+
+/-! Subsumption of the CB-12b classes by the two classes of CB-13 (#140).
+
+The legacy class `GeneralLoopCfg5` accepts every function of the legacy class `GeneralLoopCfg4`
+(CB-12b), and the split class `GeneralArgsLoopCfg5` accepts every function of the split class
+`GeneralArgsLoopCfg4` (CB-12b) and of `GeneralLoopCfg5`. The legacy checkers publish the unsplit
+code of the actual Stock lowering and the split checkers its edge split, so the subsumption also
+holds for the checkers. With the earlier subsumption lemmas (`StockGeneralSubsumption2`,
+`StockGeneralSubsumption3` and `StockGeneralSubsumption4`), every earlier legacy loop and branch
+class is in `GeneralLoopCfg5`, and every earlier split class is in `GeneralArgsLoopCfg5`.
+
+All proofs are Boolean reasoning over the `all`/`any` structure of the selectors. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg5
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- The conditions of `GeneralArgsLoopCfg4` are conditions of the class. -/
+theorem condition_of_general_args4 {f : Clif.Function} {b : Clif.Block} {c : Nat}
+    (computed : GeneralArgsLoopCfg4.conditionEligible f b c = true) :
+    conditionEligible f b c = true := by
+  simp only [conditionEligible,computed,Bool.true_or]
+
+/-- A one-bit test is a condition of the class. -/
+theorem condition_of_test_bit {f : Clif.Function} {b : Clif.Block} {c : Nat}
+    (testBit : testBitEligible f c = true) : conditionEligible f b c = true := by
+  simp only [conditionEligible,testBit,Bool.or_true,Bool.true_or]
+
+/-- A zero extension of a wide comparison is a condition of the class. -/
+theorem condition_of_uext_comparison {f : Clif.Function} {b : Clif.Block} {c : Nat}
+    (uext : uextComparisonEligible f c = true) : conditionEligible f b c = true := by
+  simp only [conditionEligible,uext,Bool.or_true,Bool.true_or]
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **`GeneralArgsLoopCfg4` (CB-12) is in the class at the selector level.** -/
+theorem source_leaf_eligible_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg4.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralArgsLoopCfg4.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralArgsLoopCfg4.controlLeafEligible,GeneralArgsLoopCfg4.controlEligible,
+      Bool.and_eq_true] at old
+    obtain ⟨⟨condition,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,condition_of_general_args4 condition,yesNonentry,noNonentry,
+      Bool.and_self]
+  all_goals
+    simp only [GeneralArgsLoopCfg4.controlLeafEligible,GeneralArgsLoopCfg4.controlEligible] at old
+    cases old
+
+/-- **`GeneralArgsLoopCfg4` (CB-12) is in the class.** -/
+theorem source_ok_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg4.sourceOk f = true) : sourceOk f = true := by
+  simp only [GeneralArgsLoopCfg4.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_args_loop leaf) scope dominated abi
+
+/-- **The legacy class `GeneralLoopCfg5` is in the class at the selector level**: it is this class
+with empty `brif` arguments. -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg5.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg5.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg5.controlLeafEligible,GeneralLoopCfg5.controlEligible,Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,_⟩,_⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,condition,yesNonentry,noNonentry,Bool.and_self]
+  all_goals
+    simp only [GeneralLoopCfg5.controlLeafEligible,GeneralLoopCfg5.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg5` is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg5.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg5.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-! ### Split checkers -/
+
+private theorem check_of_source {f : Clif.Function} {vc : VCode} (source : sourceOk f = true)
+    (lowered : (match Stock.lower f with
+      | .error _ => false
+      | .ok result => match splitEdgesChecked result.code result.edgeArgs with
+        | .ok split => decide (split.code = vc)
+        | .error _ => false) = true) :
+    check f vc = true := by
+  simp only [check,source,Bool.true_and]
+  exact lowered
+
+/-- **The checker of `GeneralArgsLoopCfg4` (CB-12) is in the checker of the class**: both
+publish the edge split of the actual Stock lowering. -/
+theorem check_of_general_args_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralArgsLoopCfg4.check f vc = true) : check f vc = true := by
+  simp only [GeneralArgsLoopCfg4.check,Bool.and_eq_true] at checked
+  exact check_of_source (source_ok_of_general_args_loop checked.1) checked.2
+
+end Backend.Stock.GeneralArgsLoopCfg5
+
+namespace Backend.Stock.GeneralLoopCfg5
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **The legacy class `GeneralLoopCfg4` (CB-12) is in the class at the selector
+level.** -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg4.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg4.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg4.controlLeafEligible,GeneralLoopCfg4.controlEligible,
+      Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,yesEmpty⟩,noEmpty⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg5.condition_of_general_args4 condition,
+      yesEmpty,noEmpty,yesNonentry,noNonentry,Bool.and_self]
+  all_goals
+    simp only [GeneralLoopCfg4.controlLeafEligible,GeneralLoopCfg4.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg4` (CB-12) is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg4.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg4.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-- **The checker of `GeneralLoopCfg4` (CB-12) is in the checker of the class**: both
+publish the unsplit code of the actual Stock lowering. -/
+theorem check_of_general_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralLoopCfg4.check f vc = true) : check f vc = true := by
+  simp only [GeneralLoopCfg4.check,Bool.and_eq_true] at checked
+  simp only [check,source_ok_of_general_loop checked.1,Bool.true_and]
+  exact checked.2
+
+end Backend.Stock.GeneralLoopCfg5
diff --git a/FV/Backend/Proof/StockTestBitCondCarry.lean b/FV/Backend/Proof/StockTestBitCondCarry.lean
new file mode 100644
index 000000000..f62bff5a2
--- /dev/null
+++ b/FV/Backend/Proof/StockTestBitCondCarry.lean
@@ -0,0 +1,224 @@
+import FV.Backend.Proof.StockTestBitConditionCores
+import FV.Backend.Proof.StockBranchLabelsCarry
+
+/-! Branches on a one-bit condition or a condition of `GeneralCondMetadata4`, with carry sets
+(#140, CB-13).
+
+`GeneralCondMetadata5` adds the one-bit conditions (`TestBitCondMetadata`: `tbnz` and `tbz`) to
+the forms of `GeneralCondMetadata4` (CB-12b). A branch on a condition in any form has two
+successor labels (`general_cond5_labels`: from the actual `tbnz`/`tbz` or from the named call
+packet of ordinary `brif`) and the carry cores `returning/trapping_general_cond5_carry_core`. With
+them a branch composes below the fuel whose selected successor may take block arguments
+(`returning/trapping_selected_general_cond5_carry_below`, by the label compositions of
+`StockBranchLabelsCarry`) or whose successors take none
+(`returning/trapping_empty_general_cond5_carry_below`). -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.LoopCarry
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Context metadata of a branch condition: a one-bit condition, or a condition in a form of
+`GeneralCondMetadata4` (a plain `i16`, plain `i8` or plain wide condition, or a comparison in one
+of the six forms). -/
+def GeneralCondMetadata5 (ctx : Ctx) (c : Nat) : Prop :=
+  TestBitCondMetadata ctx c ∨ GeneralCondMetadata4 ctx c
+
+/-- A branch on a condition in any form of `GeneralCondMetadata5` has two successor labels. -/
+theorem ConditionalBodySpec.general_cond5_labels {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata5 result.ctx c) :
+    ∃ yesLabel noLabel,result.order.successors[label]!.toList = [yesLabel,noLabel] := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  rcases condition with testBit | condition
+  · obtain ⟨_,_,_,_,yesLabel,noLabel,labels,_⟩ := spec.test_bit_origin run scope block termShape testBit
+    exact ⟨yesLabel,noLabel,labels⟩
+  · obtain ⟨calls⟩ := spec.general_cond4_branch_calls run scope termShape condition
+    exact ⟨calls.yes,calls.no,calls.labels_eq⟩
+
+/-- The carry return core of a branch on a condition in any form of `GeneralCondMetadata5`. -/
+theorem ConditionalBodySpec.returning_general_cond5_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata5 result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    ReturningCarryCore spec needed fuel s vals cm ρ world := by
+  rcases condition with testBit | condition
+  · exact spec.returning_test_bit_carry_core run scope dominated family refines driver stable termShape testBit
+      available remaining atTerm defined returned held
+  · exact spec.returning_general_cond4_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held
+
+/-- The carry first-trap core of a branch on a condition in any form of `GeneralCondMetadata5`. -/
+theorem ConditionalBodySpec.trapping_general_cond5_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata5 result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    TrappingCarryCore spec needed fuel s code ρ world := by
+  rcases condition with testBit | condition
+  · exact spec.trapping_test_bit_carry_core run scope dominated family refines driver stable termShape testBit
+      available remaining atTerm defined trapped held
+  · exact spec.trapping_general_cond4_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata5`, with block arguments, composes below
+the fuel, for returns.** The selected successor may take arguments, through an original or a
+critical-edge successor. -/
+theorem ConditionalBodySpec.returning_selected_general_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata5 result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_selected_carry_below_of_labels run scope dominated driver tag termShape
+    (spec.general_cond5_labels run scope termShape condition) successors callers
+    (spec.returning_general_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata5`, with block arguments, composes below
+the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_selected_general_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
