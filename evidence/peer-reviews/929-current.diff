+  case jump bc => exact Or.inl ⟨bc,rfl⟩
+  case ret xs => exact Or.inr (Or.inl ⟨xs,rfl⟩)
+  case brif c yes no =>
+    simp only [controlLeafEligible,controlEligible,Bool.and_eq_true] at checked
