diff --git a/FV/Backend/Lowering/StockGeneralArgsLoopCfg5.lean b/FV/Backend/Lowering/StockGeneralArgsLoopCfg5.lean
new file mode 100644
index 000000000..8410bb6e4
--- /dev/null
+++ b/FV/Backend/Lowering/StockGeneralArgsLoopCfg5.lean
@@ -0,0 +1,146 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg4
+
+/-! The loop class with one-bit tests and zero extensions as conditions, with block arguments
+(#140, CB-13).
+
+`GeneralArgsLoopCfg4` (CB-12b) admits a `brif` on a parameter, a comparison in six forms, or a
+plain wide, `i8` or `i16` value; a plain value is not an `icmp`, a `band` or a `uextend`, because
+three lowering rules look through such a definition. Here a `brif` condition may also be
+
+* a one-bit test `band x k` with `k = iconst n` and `n` one set bit below the width of `x`
+  (`testBitEligible`), lowered by `tbnz x, #bit` (rule 3251);
+* a zero test `icmp eq (band x k) 0` of such a mask (`testBitZeroEligible`), lowered by
+  `tbz x, #bit` (rule 3257);
+* a zero extension `uextend (icmp cc x, y)` of a comparison of two wide parameters of one width
+  (`uextComparisonEligible`), lowered by `subs` and `b.cond` through the `maybe_uextend` look-through
+  of `is_nonzero_cmp` (rule 4966);
+* a plain zero extension: an `i16`, `i32` or `i64` result of `uextend x` where `x` is a parameter or
+  a result of a statement that is not an `icmp` (`uextPlainEligible`), lowered as a plain value.
+
+The successors may take block arguments, and every edge enters an existing nonentry block, as in
+`GeneralArgsLoopCfg4`. The checker publishes the edge split of the actual Stock lowering. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg5
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `x` is declared with type `ty`: a parameter of type `ty` of some block, or a result of type `ty`
+of a statement of some block. -/
+def declaredOf (f : Clif.Function) (x : Nat) (ty : Clif.Ty) : Bool :=
+  ComparisonLoopCfg.parameterOf f x ty ||
+    ComparisonLoopCfg.statementOf f fun stm =>
+      (stm.results.zip (ComparisonComputedLoopCfg.resultTypesOf f stm)).contains (x,ty)
+
+/-- The single set bit of `n` below `width`, as `test_and_compare_bit_const` computes it. -/
+def singleBit (width : Nat) (n : Int) : Option Nat :=
+  match (List.range 64).filter ((u64 n).testBit ·) with
+  | [bit] => if bit < width then some bit else none
+  | _ => none
+
+/-- The integer types of the source. -/
+def intTypes : List Clif.Ty := [.i8,.i16,.i32,.i64]
+
+/-- `stm` defines `k` by an `iconst` whose value has one set bit below the width of a declared
+type of `x`. -/
+def maskEligible (f : Clif.Function) (x k : Nat) (stm : Clif.Stmt) : Bool :=
+  stm.results.contains k && match stm.inst with
+    | .iconst ty imm => intTypes.any fun tx =>
+      declaredOf f x tx && (singleBit tx.width ((u64 (imm64OfIconst ty imm) : Nat) : Int)).isSome
+    | _ => false
+
+/-- `stm` defines `c` by a one-bit test `band x k`. -/
+def testBitStatement (f : Clif.Function) (c : Nat) (stm : Clif.Stmt) : Bool :=
+  stm.results.contains c && match stm.inst with
+    | .binary .band _ x k => ComparisonLoopCfg.statementOf f (maskEligible f x k)
+    | _ => false
+
+/-- `c` is a one-bit test: a result of `band x k` with `k` a one-bit mask of `x`. -/
+def testBitEligible (f : Clif.Function) (c : Nat) : Bool :=
+  ComparisonLoopCfg.statementOf f (testBitStatement f c)
+
+/-- `stm` defines `c` by a zero test `icmp eq y z` of a one-bit test `y`, with `z = iconst 0`. -/
+def testBitZeroStatement (f : Clif.Function) (c : Nat) (stm : Clif.Stmt) : Bool :=
+  stm.results.contains c && match stm.inst with
+    | .icmp .eq _ y z => testBitEligible f y && ComparisonLoopCfg.statementOf f (ComparisonZeroCfg.constantEligible z)
+    | _ => false
+
+/-- `c` is a zero test of a one-bit mask. -/
+def testBitZeroEligible (f : Clif.Function) (c : Nat) : Bool :=
+  ComparisonLoopCfg.statementOf f (testBitZeroStatement f c)
+
+/-- `stm` defines `z` by a comparison of two parameters of one wide type. -/
+def wideComparisonStatement (f : Clif.Function) (z : Nat) (stm : Clif.Stmt) : Bool :=
+  stm.results.contains z && match stm.inst with
+    | .icmp _ _ x y =>
+      (ComparisonLoopCfg.parameterOf f x .i32 && ComparisonLoopCfg.parameterOf f y .i32) ||
+        (ComparisonLoopCfg.parameterOf f x .i64 && ComparisonLoopCfg.parameterOf f y .i64)
+    | _ => false
+
+/-- `stm` defines `c` by `uextend z` of such a comparison. -/
+def uextComparisonStatement (f : Clif.Function) (c : Nat) (stm : Clif.Stmt) : Bool :=
+  stm.results.contains c && match stm.inst with
+    | .extend .uextend _ z => ComparisonLoopCfg.statementOf f (wideComparisonStatement f z)
+    | _ => false
+
+/-- `c` is a zero extension of a comparison of two wide parameters of one width. -/
+def uextComparisonEligible (f : Clif.Function) (c : Nat) : Bool :=
+  ComparisonLoopCfg.statementOf f (uextComparisonStatement f c)
+
+/-- `x` is a parameter of some block, or a result of a statement that is not an `icmp`. -/
+def nonComparisonOperand (f : Clif.Function) (x : Nat) : Bool :=
+  (f.blocks.any fun b => b.params.any fun (value,_) => value == x) ||
+    ComparisonLoopCfg.statementOf f fun stm => stm.results.contains x && match stm.inst with
+      | .icmp .. => false
+      | _ => true
+
+/-- `stm` defines `c` as an `i16`, `i32` or `i64` result of `uextend x` with `x` not a comparison. -/
+def uextPlainStatement (f : Clif.Function) (c : Nat) (stm : Clif.Stmt) : Bool :=
+  match stm.inst with
+  | .extend .uextend _ x =>
+    [Clif.Ty.i16,.i32,.i64].any (fun ty => (stm.results.zip (ComparisonComputedLoopCfg.resultTypesOf f stm)).contains (c,ty)) &&
+      nonComparisonOperand f x
+  | _ => false
+
+/-- `c` is a plain zero extension. -/
+def uextPlainEligible (f : Clif.Function) (c : Nat) : Bool :=
+  ComparisonLoopCfg.statementOf f (uextPlainStatement f c)
+
+/-- A `brif` condition of block `b`: a condition of `GeneralArgsLoopCfg4`, a one-bit test, a zero
+test of a one-bit mask, a zero extension of a wide comparison, or a plain zero extension. -/
+def conditionEligible (f : Clif.Function) (b : Clif.Block) (c : Nat) : Bool :=
+  GeneralArgsLoopCfg4.conditionEligible f b c || testBitEligible f c || testBitZeroEligible f c ||
+    uextComparisonEligible f c || uextPlainEligible f c
+
+/-- `GeneralArgsLoopCfg4.controlEligible` with `conditionEligible`: jumps with any arguments,
+returns, and branches with any arguments, each target an existing nonentry block. -/
+def controlEligible (f : Clif.Function) (b : Clif.Block) : Clif.Terminator → Bool
+  | .jump bc => ParameterLoopCfg.targetNonentry f bc
+  | .ret _ => true
+  | .brif c yes no => conditionEligible f b c &&
+    ParameterLoopCfg.targetNonentry f yes && ParameterLoopCfg.targetNonentry f no
+  | _ => false
+
+/-- As `controlEligible`, and a nonentry block may also end in `trap`. -/
+def controlLeafEligible (f : Clif.Function) (bi : Nat) (b : Clif.Block) : Clif.Terminator → Bool
+  | .trap _ => bi != 0
+  | term => controlEligible f b term
+
+/-- `GeneralArgsLoopCfg4.sourceLeafEligible` with the conditions of `conditionEligible`. Bodies
+and ABI are as there. -/
+def sourceLeafEligible (f : Clif.Function) : Bool :=
+  f.blocks.zipIdx.all (fun (b,bi) => controlLeafEligible f bi b b.term) &&
+  f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) &&
+  f.sig.params.all Scalar.narrowAbiEligible && f.sig.returns.all Scalar.narrowAbiEligible
+
+def sourceOk (f : Clif.Function) : Bool :=
+  sourceLeafEligible f && lowerScopeB f && dominatedB f && sigAbiOk f.sig
+
+/-- The published code is the actual edge split of the actual Stock lowering. -/
+def check (f : Clif.Function) (vc : VCode) : Bool :=
+  sourceOk f && match Stock.lower f with
+  | .error _ => false
+  | .ok result => match splitEdgesChecked result.code result.edgeArgs with
+    | .ok split => decide (split.code = vc)
+    | .error _ => false
+
+end Backend.Stock.GeneralArgsLoopCfg5
diff --git a/FV/Backend/Lowering/StockGeneralLoopCfg5.lean b/FV/Backend/Lowering/StockGeneralLoopCfg5.lean
new file mode 100644
index 000000000..467e1be8a
--- /dev/null
+++ b/FV/Backend/Lowering/StockGeneralLoopCfg5.lean
@@ -0,0 +1,48 @@
+import FV.Backend.Lowering.StockGeneralArgsLoopCfg5
+
+/-! The legacy loop class with one-bit tests and zero extensions as conditions (#140, CB-13).
+
+`GeneralLoopCfg4` (CB-12b) is the legacy (unsplit-code, empty `brif` arguments) class of the
+conditions of `GeneralArgsLoopCfg4`. Here a `brif` condition is any condition of
+`GeneralArgsLoopCfg5.conditionEligible`: a condition of `GeneralArgsLoopCfg4`, a one-bit test, a
+zero test of a one-bit mask, a zero extension of a wide comparison, or a plain zero extension. Its
+successors take no arguments. Every edge enters an existing nonentry block, so back edges and self
+loops are selected. Jumps may pass any arguments. The checker publishes the unsplit code of the
+actual Stock lowering, so the class keeps the legacy single-vector interface (`Scalar.Domain`). -/
+
+namespace Backend.Stock.GeneralLoopCfg5
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `GeneralLoopCfg4.controlEligible` with `GeneralArgsLoopCfg5.conditionEligible`: jumps with
+any arguments, returns, and branches with empty arguments, each target an existing nonentry
+block. -/
+def controlEligible (f : Clif.Function) (b : Clif.Block) : Clif.Terminator → Bool
+  | .jump bc => ParameterLoopCfg.targetNonentry f bc
+  | .ret _ => true
+  | .brif c yes no => GeneralArgsLoopCfg5.conditionEligible f b c && yes.args.isEmpty &&
+    no.args.isEmpty && ParameterLoopCfg.targetNonentry f yes && ParameterLoopCfg.targetNonentry f no
+  | _ => false
+
+/-- As `controlEligible`, and a nonentry block may also end in `trap`. -/
+def controlLeafEligible (f : Clif.Function) (bi : Nat) (b : Clif.Block) : Clif.Terminator → Bool
+  | .trap _ => bi != 0
+  | term => controlEligible f b term
+
+/-- `GeneralLoopCfg4.sourceLeafEligible` with the conditions of
+`GeneralArgsLoopCfg5.conditionEligible`. Bodies and ABI are as there. -/
+def sourceLeafEligible (f : Clif.Function) : Bool :=
+  f.blocks.zipIdx.all (fun (b,bi) => controlLeafEligible f bi b b.term) &&
+  f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) &&
+  f.sig.params.all Scalar.narrowAbiEligible && f.sig.returns.all Scalar.narrowAbiEligible
+
+def sourceOk (f : Clif.Function) : Bool :=
+  sourceLeafEligible f && lowerScopeB f && dominatedB f && sigAbiOk f.sig
+
+/-- The published code is the unsplit code of the actual Stock lowering. -/
+def check (f : Clif.Function) (vc : VCode) : Bool :=
+  sourceOk f && match Stock.lower f with
+  | .error _ => false
+  | .ok result => decide (result.code = vc)
+
+end Backend.Stock.GeneralLoopCfg5
diff --git a/FV/Backend/Proof/StockBranchCond5Carry.lean b/FV/Backend/Proof/StockBranchCond5Carry.lean
new file mode 100644
index 000000000..3b5354886
--- /dev/null
+++ b/FV/Backend/Proof/StockBranchCond5Carry.lean
@@ -0,0 +1,220 @@
+import FV.Backend.Proof.StockTestBitCondCarry
+import FV.Backend.Proof.StockUextComparisonCores
+
+/-! Branches on a zero extension of a comparison or a condition of `GeneralCondMetadata5`, with
+carry sets (#140, CB-13).
+
+`BranchCondMetadata5` adds the zero extensions of comparisons (`UextComparisonMetadata`) to the
+forms of `GeneralCondMetadata5` (one-bit conditions and the forms of `GeneralCondMetadata4`). A
+branch on a condition in any form has two successor labels (`branch_cond5_labels`) and the carry
+cores `returning/trapping_branch_cond5_carry_core`; with them it composes below the fuel with or
+without block arguments (`returning/trapping_selected_branch_cond5_carry_below`,
+`returning/trapping_empty_branch_cond5_carry_below`). -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.LoopCarry
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Context metadata of a branch condition: a zero extension of a comparison of two wide source
+parameters, or a condition in a form of `GeneralCondMetadata5`. -/
+def BranchCondMetadata5 (ctx : Ctx) (c : Nat) : Prop :=
+  UextComparisonMetadata ctx c ∨ GeneralCondMetadata5 ctx c
+
+/-- A branch on a condition in any form of `BranchCondMetadata5` has two successor labels. -/
+theorem ConditionalBodySpec.branch_cond5_labels {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c) :
+    ∃ yesLabel noLabel,result.order.successors[label]!.toList = [yesLabel,noLabel] := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  rcases condition with ⟨target,z,cc,ty,x,y,wide,extended,_⟩ | condition
+  · obtain ⟨calls,_⟩ := spec.uext_comparison_calls run scope block termShape extended
+    exact ⟨calls.yes,calls.no,calls.labels_eq⟩
+  · exact spec.general_cond5_labels run scope termShape condition
+
+/-- The carry return core of a branch on a condition in any form of `BranchCondMetadata5`. -/
+theorem ConditionalBodySpec.returning_branch_cond5_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    ReturningCarryCore spec needed fuel s vals cm ρ world := by
+  rcases condition with uext | condition
+  · exact spec.returning_uext_comparison_carry_core run scope dominated family refines driver stable termShape uext
+      available remaining atTerm defined returned held
+  · exact spec.returning_general_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held
+
+/-- The carry first-trap core of a branch on a condition in any form of `BranchCondMetadata5`. -/
+theorem ConditionalBodySpec.trapping_branch_cond5_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    TrappingCarryCore spec needed fuel s code ρ world := by
+  rcases condition with uext | condition
+  · exact spec.trapping_uext_comparison_carry_core run scope dominated family refines driver stable termShape uext
+      available remaining atTerm defined trapped held
+  · exact spec.trapping_general_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held
+
+/-- **A branch on a condition in any form of `BranchCondMetadata5`, with block arguments, composes below
+the fuel, for returns.** The selected successor may take arguments, through an original or a
+critical-edge successor. -/
+theorem ConditionalBodySpec.returning_selected_branch_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_selected_carry_below_of_labels run scope dominated driver tag termShape
+    (spec.branch_cond5_labels run scope termShape condition) successors callers
+    (spec.returning_branch_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `BranchCondMetadata5`, with block arguments, composes below
+the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_selected_branch_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_selected_carry_below_of_labels run scope dominated driver tag termShape
+    (spec.branch_cond5_labels run scope termShape condition) successors callers
+    (spec.trapping_branch_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
+/-- **A branch on a condition in any form of `BranchCondMetadata5`, with empty block arguments, composes
+below the fuel, for returns.** -/
+theorem ConditionalBodySpec.returning_empty_branch_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.returning_branch_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `BranchCondMetadata5`, with empty block arguments, composes
+below the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_empty_branch_cond5_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : BranchCondMetadata5 result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.trapping_branch_cond5_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
+end Backend.Stock.Proof.ConditionalValues
diff --git a/FV/Backend/Proof/StockBranchLabelsCarry.lean b/FV/Backend/Proof/StockBranchLabelsCarry.lean
