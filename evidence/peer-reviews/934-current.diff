+/-- Instruction-zero ABI return simulation of a function of the class whose entry branches on a
+condition of the class, with any block arguments. -/
+theorem general_args_loop_branch_entry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (term : entry.term = .brif c yes no) (condition : GeneralCondition f c)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {vals : List Clif.Val} {outMem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals outMem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.returned vals outMem) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := branch_entry_prelude run scope dominated spec
+    term condition entered driver memorySem stable memory arguments
+  have finished := branch_args_carry_returns run scope dominated family refines driver stable spec tag
+    term condition
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_returns_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    returned (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI first-trap simulation of a function of the class whose entry branches
+on a condition of the class, with any block arguments. -/
+theorem general_args_loop_branch_entry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (term : entry.term = .brif c yes no) (condition : GeneralCondition f c)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.trapped code) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := branch_entry_prelude run scope dominated spec
+    term condition entered driver memorySem stable memory arguments
+  have finished := branch_args_carry_traps run scope dominated family refines driver stable spec tag
+    term condition
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_traps_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    trapped (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI return simulation of a function of the class whose entry ends in a
+`br_table` of the class, with any block arguments. -/
+theorem general_args_loop_table_entry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {x : Nat} {dc : Clif.BlockCall} {tbl : List Clif.BlockCall}
+    (source : f.blocks[0]? = some entry) (term : entry.term = .brTable x dc tbl)
+    (declared : GeneralArgsLoopCfg5.Declared f x .i32) (small : tbl.length < 4096)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {vals : List Clif.Val} {outMem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals outMem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.returned vals outMem) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_table_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := table_entry_prelude run scope dominated spec
+    term (GeneralArgsLoopCfg6.TableBranch.index_type declared scope dominated spec.build) small entered driver memorySem stable
+    memory arguments
+  have finished := GeneralArgsLoopCfg6.table_args_carry_returns run scope dominated family refines driver stable spec tag
+    term declared small
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_returns_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    returned (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI first-trap simulation of a function of the class whose entry ends in a
+`br_table` of the class, with any block arguments. -/
+theorem general_args_loop_table_entry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {x : Nat} {dc : Clif.BlockCall} {tbl : List Clif.BlockCall}
+    (source : f.blocks[0]? = some entry) (term : entry.term = .brTable x dc tbl)
+    (declared : GeneralArgsLoopCfg5.Declared f x .i32) (small : tbl.length < 4096)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.trapped code) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_table_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := table_entry_prelude run scope dominated spec
+    term (GeneralArgsLoopCfg6.TableBranch.index_type declared scope dominated spec.build) small entered driver memorySem stable
+    memory arguments
+  have finished := GeneralArgsLoopCfg6.table_args_carry_traps run scope dominated family refines driver stable spec tag
+    term declared small
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_traps_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    trapped (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- **The loop class with plain `band` conditions, with block arguments, satisfies the
+per-successor production domain.** Every block jumps (with any arguments), returns, branches with
+any arguments on a condition of `GeneralArgsLoopCfg5` or a plain `band` (`GeneralCondition`), ends in
+a `br_table` on an `i32` index with fewer than 4096 table entries and any arguments
+(`TableBranch`), or, outside the entry, ends in `trap`. No rank:
+targets may be loop headers, and back edges and self loops are allowed, also when a branch or a
+table passes block arguments on them. -/
+theorem domainAt_of_general_args_loop_cfg {f : Clif.Function}
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false)
+    (terms : GeneralArgsTerms f)
+    (entryKind : ∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) : Scalar.DomainAt f := by
+  have entry : ∃ (b : Clif.Block),f.blocks[0]? = some b := by
+    cases blocks : f.blocks with
+    | nil => exact False.elim (scope.nonempty blocks)
+    | cons b rest => exact ⟨b,by simp only [List.getElem?_cons_zero]⟩
+  obtain ⟨b,source⟩ := entry
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    rcases terms 0 b source with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨x,dc,tbl,term,declared,small⟩ | ⟨leafCode,trap⟩
+    · exact general_args_loop_jump_entry_returns run scope dominated abi terms family source jump
+        entered returned refines driver memorySem stable memory arguments
+    · exact parameter_return_entry_frame run scope dominated abi family source ret
+        entered returned refines driver memorySem stable memory arguments
+    · exact general_args_loop_branch_entry_returns run scope dominated abi terms family
+        source term condition entered returned refines driver memorySem stable memory arguments
+    · exact general_args_loop_table_entry_returns run scope dominated abi terms family
+        source term declared small entered returned refines driver memorySem stable memory arguments
+    · exact False.elim (entryKind b source leafCode trap)
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    rcases terms 0 b source with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨x,dc,tbl,term,declared,small⟩ | ⟨leafCode,trap⟩
+    · exact general_args_loop_jump_entry_traps run scope dominated abi terms family source jump
+        entered trapped refines driver memorySem stable memory arguments
+    · exact parameter_return_entry_trap_frame run scope dominated abi family source ret
+        entered trapped refines driver memorySem stable memory arguments
+    · exact general_args_loop_branch_entry_traps run scope dominated abi terms family
+        source term condition entered trapped refines driver memorySem stable memory arguments
+    · exact general_args_loop_table_entry_traps run scope dominated abi terms family
+        source term declared small entered trapped refines driver memorySem stable memory arguments
+    · exact False.elim (entryKind b source leafCode trap)
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg7
diff --git a/FV/Backend/Proof/StockGeneralLoopCheck7.lean b/FV/Backend/Proof/StockGeneralLoopCheck7.lean
new file mode 100644
index 000000000..a7d130e70
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopCheck7.lean
@@ -0,0 +1,83 @@
+import FV.Backend.Proof.StockGeneralLoopCheck6
+import FV.Backend.Proof.StockGeneralLoopDomain7
+
+/-! The selectors and checkers of the two loop classes with plain `band` conditions are sound
+(#140, CB-15).
+
+`GeneralArgsLoopCfg7.sourceOk` derives the facts of `domainAt_of_general_args_loop_cfg`
+(`source_leaf_eligible_facts`), and its checker accepts the edge split of the actual lowering, so
+it derives the code domain of the published split code, as `GeneralArgsLoopCfg6.check_sound`.
+`GeneralLoopCfg7.sourceOk` derives the facts of `domain_of_general_loop_cfg`, and its checker
+accepts the unsplit code of the actual lowering, as `GeneralLoopCfg6.check_sound`. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg7
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original input conditions and the split selector derive the per-successor production
+domain. -/
+theorem domainAt_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.DomainAt f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg7.domainAt_of_general_args_loop_cfg scope dominated abi
+    (GeneralArgsLoopCfg2.ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The split selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.DomainAt f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domainAt_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The split checker is sound.** The executable check derives the code domain of the published
+split code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    Scalar.CodeDomain f vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run] at lowered
+    cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+    | error message => simp [splitRun] at lowered
+    | ok split =>
+      simp only [splitRun,decide_eq_true_eq] at lowered
+      subst vc
+      exact (source_ok_sound source).code run splitRun
+
+end Backend.Stock.GeneralArgsLoopCfg7
+
+namespace Backend.Stock.GeneralLoopCfg7
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original input conditions and the legacy selector derive the unchanged production domain. -/
+theorem domain_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.Domain f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg7.domain_of_general_loop_cfg scope dominated abi
+    (GeneralArgsLoopCfg2.ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The legacy selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.Domain f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domain_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The legacy checker is sound.** The executable check derives the unchanged production domain
+of the published unsplit code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    ∃ result,Scalar.Domain f ∧ Stock.lower f = .ok result ∧ result.code = vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run,decide_eq_true_eq] at lowered
+    exact ⟨result,source_ok_sound source,rfl,lowered⟩
+
+end Backend.Stock.GeneralLoopCfg7
diff --git a/FV/Backend/Proof/StockGeneralLoopDomain7.lean b/FV/Backend/Proof/StockGeneralLoopDomain7.lean
new file mode 100644
index 000000000..29aed4f22
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopDomain7.lean
@@ -0,0 +1,232 @@
+import FV.Backend.Proof.StockGeneralLoopDomain6
+import FV.Backend.Proof.StockGeneralArgsLoopDomain7
+
+/-! The legacy loop class with plain `band` conditions satisfies the unchanged production domain
+(#140, CB-15).
+
+The CB-14c transport (`StockGeneralLoopDomain6`) with the `GeneralTerms` of `GeneralLoopCfg7`. A
+branch on a condition of the classes has two successors (`branch_target_count`, from
+`branch_cond7_labels`); its successors take no arguments, so its assembled block passes none, and
+its critical-edge vectors are empty. `br_table` successors take no arguments either. So the actual
+code keeps exact per-edge/single-vector agreement (`general_loop_legacy_compatible`). The class is
+the split class `GeneralArgsLoopCfg7` with empty `brif` and `br_table` arguments
+(`GeneralTerms.args`), so `domainAt_of_general_args_loop_cfg` and the legacy transport give
+`domain_of_general_loop_cfg` (`Scalar.Domain`). -/
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg7
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+  Backend.Stock.Proof.ForwardSource Backend.Stock.Proof.ParameterCfg
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- A branch on a condition of the classes has two successor labels. -/
+theorem branch_target_count {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (term : b.term = .brif c yes no) (condition : GeneralCondition f c) :
+    result.order.successors[label]!.size = 2 := by
+  obtain ⟨yesLabel,noLabel,labels⟩ :=
+    spec.branch_cond7_labels run scope term (condition_metadata condition scope dominated spec.build)
+  have size := congrArg List.length labels
+  simpa only [Array.length_toList,List.length_cons,List.length_nil] using size
+
+private theorem selected_empty {b : Clif.Block} {c index id : Nat} {yes no : Clif.BlockCall} {args : List Clif.TryArg}
+    (term : b.term = .brif c yes no) (yesEmpty : yes.args = []) (noEmpty : no.args = [])
+    (selected : (destinations b.term)[index]? = some (id,args)) :
+    ∃ bc,(dests b.term)[index]? = some bc ∧ bc.args = [] := by
+  cases index with
+  | zero => exact ⟨yes,by simp [term,dests],yesEmpty⟩
+  | succ index =>
+    cases index with
+    | zero => exact ⟨no,by simp [term,dests],noEmpty⟩
+    | succ index => simp [term,destinations] at selected
+
+private theorem assembled_arguments {ctx : Ctx} {f : Clif.Function} {b : Clif.Block}
+    {bi label : Nat} {targets : Array Nat} {outgoing : Array (Array Reg)}
+    {params : List Nat} {uses : Array UseState} {code : Array MInst} {block : VBlock}
+    (run : assembleOriginalBlock ctx f b bi label targets outgoing params uses code = .ok block) :
+    block.branchArgs = (if targets.size == 1 then outgoing[0]! else #[]) := by
+  unfold assembleOriginalBlock at run
+  dsimp only at run
+  repeat' first
+    | (solve | cases run)
+    | simp only [bind,Except.bind,pure,Except.pure] at run
+    | split at run
+  all_goals cases run; simp_all
+
+private theorem table_selected_empty {b : Clif.Block} {x index id : Nat} {dc : Clif.BlockCall}
+    {tbl : List Clif.BlockCall} {args : List Clif.TryArg}
+    (term : b.term = .brTable x dc tbl) (empty : ∀ bc ∈ dc :: tbl,bc.args = [])
+    (selected : (destinations b.term)[index]? = some (id,args)) :
+    ∃ bc,(dests b.term)[index]? = some bc ∧ bc.args = [] := by
+  have bound : index < (dc :: tbl).length := by
+    have inside := (List.getElem?_eq_some_iff.mp selected).1
+    simpa [term,destinations] using inside
+  refine ⟨(dc :: tbl)[index],?_,empty _ (List.getElem_mem _)⟩
+  simp only [term,dests]
+  exact List.getElem?_eq_getElem _
+
+/-- **The legacy loop class with plain `band` conditions keeps exact per-edge/single-vector
+agreement** of the actual code: jumps carry their arguments, branches and tables carry none, and
+returns and traps have no outgoing edge. -/
+theorem general_loop_legacy_compatible {f : Clif.Function} {result : Result}
+    (terms : GeneralTerms f) (run : Stock.lower f = .ok result)
+    (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR) (env : Clif.Env) (cp : Clif.Program) :
+    EdgeLegacyCompatible result.code result.edgeArgs := by
+  have built : ∃ ranges,Stock.buildCtx f = .ok (result.ctx,ranges,result.initial) := by
+    unfold Stock.lower at run
+    dsimp only at run
+    repeat' first
+      | (solve | cases run)
+      | simp only [bind,Except.bind,pure,Except.pure] at run
+      | split at run
+    cases run
+    exact ⟨_,by assumption⟩
+  obtain ⟨ranges,build⟩ := built
+  have inv := buildCtx_mappedInv scope build
+  obtain ⟨ps,cfg⟩ := stock_lower_computed_cfg run scope
+  have sizes := (stock_lower_graph_bounds run).1
+  have nodes : result.code.blocks.size = result.order.nodes.size :=
+    (stock_prepare_dimensions run).1.symm.trans (stock_prepare_dimensions run).2.1
+  intro label index target selected
+  simp only [succOf,cfg] at selected
+  cases row : result.order.successors[label]? with
+  | none => simp only [row,Option.bind_none] at selected; cases selected
+  | some ss =>
+    simp only [row,Option.bind_some] at selected
+    have labelBound : label < result.order.nodes.size := by
+      have bound := (Array.getElem?_eq_some_iff.mp row).1
+      omega
+    cases tag : result.order.nodes[label]? with
+    | none => have absent := Array.getElem?_eq_none_iff.mp tag; omega
+    | some node =>
+      cases node with
+      | original bi =>
+        obtain ⟨b,id,args,ti,source,destination,found,targetNode⟩ := stock_lower_indexed_successor_origin run tag row selected
+        rcases terms bi b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ |
+          ⟨x,dc,tbl,term,declared,small,emptyArgs⟩ | ⟨leafCode,trap⟩
+        · have only : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [jump,destinations] at destination
+          subst index
+          obtain ⟨tl,targetLabel,identified,nonentry,successors,targetTag⟩ := CriticalOwners.jump_successor run scope tag source jump
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have sameTarget : targetLabel = target := by simpa [sameRow] using selected
+          subst targetLabel
+          have successorsBang : result.order.successors[label]! = #[target] := by simp only [getElem!_def,successors,Option.getD_some]
+          obtain ⟨vb,placed,labelled,arguments⟩ := stock_lower_original_jump_args run scope tag source jump successorsBang targetTag
+          have vector := stock_lower_selected_outgoing run scope tag source (bc := bc) (index := 0)
+            (by simp [jump,dests]) (by simpa only [getElem!_def,row,Option.getD_some] using selected) targetTag
+          exact ⟨vb,placed,by simpa only [outgoingAt,arguments] using vector⟩
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term refines driver stable env cp
+          have targetCount := branch_target_count run scope dominated spec term condition
+          have rawArgs : spec.raw.branchArgs = #[] := by
+            have args := assembled_arguments spec.assembled
+            simpa only [targetCount,show (2 == 1) = false from rfl,Bool.false_eq_true,ite_false] using args
+          obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          have successor : result.order.successors[label]![index]? = some target := by
+            simpa only [getElem!_def,row,Option.getD_some] using selected
+          have vector : outgoingAt result label index = some #[] := by
+            rcases targetNode with original | synthetic
+            · have actual := stock_lower_selected_outgoing run scope tag source selectedBc successor original
+              simpa only [edgeArgumentNumbers,empty,List.map_nil] using actual
+            · exact stock_lower_deferred_outgoing run tag successor synthetic
+          refine ⟨_,spec.placed,?_⟩
+          simpa only [outgoingAt,rawArgs,Array.map_empty] using vector
+        · obtain ⟨spec⟩ := stock_lower_table_body_spec run scope dominated family tag source term refines driver stable env cp
+          have emptyOutgoing := spec.outgoing_empty run scope tag term emptyArgs
+          have rawArgs : spec.raw.branchArgs = #[] := by
+            rw [assembled_arguments spec.assembled]
+            split
+            · cases first : spec.core.outgoing[0]? with
+              | none => simp only [getElem!_def,first,Option.getD_none]; rfl
+              | some v =>
+                simp only [getElem!_def,first,Option.getD_some]
+                exact emptyOutgoing v (Array.mem_of_getElem? first)
+            · rfl
+          obtain ⟨bc,selectedBc,empty⟩ := table_selected_empty term emptyArgs destination
+          have successor : result.order.successors[label]![index]? = some target := by
+            simpa only [getElem!_def,row,Option.getD_some] using selected
+          have vector : outgoingAt result label index = some #[] := by
+            rcases targetNode with original | synthetic
+            · have actual := stock_lower_selected_outgoing run scope tag source selectedBc successor original
+              simpa only [edgeArgumentNumbers,empty,List.map_nil] using actual
+            · exact stock_lower_deferred_outgoing run tag successor synthetic
+          refine ⟨_,spec.placed,?_⟩
+          simpa only [outgoingAt,rawArgs,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+      | edge pred k ti =>
+        obtain ⟨b,id,args,source,destination,found⟩ := stock_lower_critical_source run tag
+        rcases terms pred b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ |
+          ⟨x,dc,tbl,term,declared,small,emptyArgs⟩ | ⟨leafCode,trap⟩
+        · exact False.elim (CriticalOwners.jump_no_edge (stock_lower_order run) source jump k ti
+            (Array.mem_toList_iff.mpr (Array.mem_of_getElem? tag)))
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          obtain ⟨input,next,registers,targetLabel,call,successors,targetTag,placed⟩ := stock_lower_critical_code run tag
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have zero : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [sameRow] at selected
+          subst index
+          have mapping := stock_branchArgs_selected_mapping inv.func source selectedBc call
+          have noRegisters : registers = #[] := by
+            rw [empty] at mapping
+            simp only [List.mapM_nil,Option.pure_def,Option.some.injEq] at mapping
+            exact Array.toList_inj.mp mapping.symm
+          have vector := stock_lower_critical_argument_vector run scope tag source selectedBc
+          refine ⟨_,placed,?_⟩
+          simpa only [outgoingAt,edgeArgumentNumbers,empty,List.map_nil,noRegisters,Array.map_empty] using vector
+        · obtain ⟨bc,selectedBc,empty⟩ := table_selected_empty term emptyArgs destination
+          obtain ⟨input,next,registers,targetLabel,call,successors,targetTag,placed⟩ := stock_lower_critical_code run tag
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have zero : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [sameRow] at selected
+          subst index
+          have mapping := stock_branchArgs_selected_mapping inv.func source selectedBc call
+          have noRegisters : registers = #[] := by
+            rw [empty] at mapping
+            simp only [List.mapM_nil,Option.pure_def,Option.some.injEq] at mapping
+            exact Array.toList_inj.mp mapping.symm
+          have vector := stock_lower_critical_argument_vector run scope tag source selectedBc
+          refine ⟨_,placed,?_⟩
+          simpa only [outgoingAt,edgeArgumentNumbers,empty,List.map_nil,noRegisters,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+
+/-- **The legacy loop class with plain `band` conditions satisfies the unchanged production
+domain.** Every block jumps (with any arguments), returns, branches with empty arguments on a
+condition of `GeneralArgsLoopCfg5` or a plain `band` (`GeneralCondition`), ends in a `br_table` on an `i32` index with fewer than 4096
+table entries and empty arguments (`EmptyTableBranch`), or, outside the entry, ends in `trap`. No
+rank: jump, branch and table targets may be loop headers. -/
+theorem domain_of_general_loop_cfg {f : Clif.Function}
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false)
+    (terms : GeneralTerms f)
+    (entryKind : ∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) : Scalar.Domain f := by
+  have domainAt := domainAt_of_general_args_loop_cfg scope dominated abi ordinary terms.args entryKind family
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,simulation⟩ := domainAt.returns run entered returned refines driver memorySem stable memory arguments
+    exact ⟨ρ,simulation.legacyCompatible compatible⟩
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',path,tail⟩ :=
+      domainAt.traps run entered trapped refines driver memorySem stable memory arguments
+    exact ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',compatible.star path,tail⟩
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg7
diff --git a/FV/Backend/Proof/StockGeneralLoopWitness7.lean b/FV/Backend/Proof/StockGeneralLoopWitness7.lean
new file mode 100644
index 000000000..9e88b9e98
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopWitness7.lean
@@ -0,0 +1,195 @@
+import FV.Clif.Parse
+import FV.Backend.Proof.StockGeneralLoopCheck7
+import FV.Backend.Proof.StockGeneralSubsumption7
+
+/-! Non-vacuity of the loop classes with plain `band` conditions (#140, CB-15).
+
+The split class: a loop whose branches test a `band` with a register mask and a `band` with the
+mask `300` (three set bits), and pass block arguments, on the back edge too.
+
+```
+function %band_loop(i32, i32) -> i32 {
+block0(v0: i32, v1: i32):
+    jump block1(v0)
+block1(v2: i32):
+    v3 = band v2, v1
+    brif v3, block2(v2), block3(v2)
+block2(v4: i32):
+    v5 = iconst.i32 300
+    v6 = band v4, v5
+    v7 = iconst.i32 1
+    v8 = isub v4, v7
+    brif v6, block1(v8), block3(v8)
+block3(v9: i32):
+    return v9
+}
+```
+
+From `(7,4)` the loop runs while bit 2 of the counter is set and returns `3`. The legacy class:
+`%br_and_immediate` of `x64/branches.clif`, a branch on `band v0, 300` without block arguments; from
+`301` it returns `100`. The CB-14c classes `GeneralArgsLoopCfg6` and `GeneralLoopCfg6` reject both
+functions (`other_classes_reject`): their only `band` condition is the one-bit test of `tbnz`.
+The new selectors accept them, and the actual code passes the new checkers, which derive the code
+domain (split) and the production domain (legacy). -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg7.Fixture
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- The text of `%band_loop`. -/
+def bandLoopSource : String := "function %band_loop(i32, i32) -> i32 {
+block0(v0: i32, v1: i32):
+    jump block1(v0)
+
+block1(v2: i32):
+    v3 = band v2, v1
+    brif v3, block2(v2), block3(v2)
+
+block2(v4: i32):
+    v5 = iconst.i32 300
+    v6 = band v4, v5
+    v7 = iconst.i32 1
+    v8 = isub v4, v7
+    brif v6, block1(v8), block3(v8)
+
+block3(v9: i32):
+    return v9
+}
+"
+
+/-- `%band_loop` as a `Clif.Function` literal. -/
+def bandLoop : Clif.Function := {
+  name := "band_loop"
+  sig := { params := [⟨.i32,.none,.normal⟩,⟨.i32,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i32),(1,.i32)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(2,.i32)], body := [⟨[3],.binary .band .i32 2 1⟩],
+      term := .brif 3 ⟨2,[2]⟩ ⟨3,[2]⟩ },
+    { id := 2, params := [(4,.i32)],
+      body := [⟨[5],.iconst .i32 300⟩,⟨[6],.binary .band .i32 4 5⟩,⟨[7],.iconst .i32 1⟩,
+        ⟨[8],.binary .isub .i32 4 7⟩],
+      term := .brif 6 ⟨1,[8]⟩ ⟨3,[8]⟩ },
+    { id := 3, params := [(9,.i32)], body := [], term := .ret [9] }] }
+
+/-- The text of `%br_and_immediate` (`x64/branches.clif`). -/
+def andImmediateSource : String := "function %br_and_immediate(i32) -> i32 {
+block0(v0: i32):
+  v1 = iconst.i32 300
+  v2 = band v0, v1
+
+  brif v2, block1, block2
+
+block1:
+  v3 = iconst.i32 100
+  return v3
+
+block2:
+  v4 = iconst.i32 200
+  return v4
+}
+"
+
+/-- `%br_and_immediate` as a `Clif.Function` literal. -/
+def andImmediate : Clif.Function := {
+  name := "br_and_immediate"
+  sig := { params := [⟨.i32,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i32)], body := [⟨[1],.iconst .i32 300⟩,⟨[2],.binary .band .i32 0 1⟩],
+      term := .brif 2 ⟨1,[]⟩ ⟨2,[]⟩ },
+    { id := 1, params := [], body := [⟨[3],.iconst .i32 100⟩], term := .ret [3] },
+    { id := 2, params := [], body := [⟨[4],.iconst .i32 200⟩], term := .ret [4] }] }
+
+/-- The CB-14c classes reject both functions. -/
+theorem other_classes_reject :
+    GeneralArgsLoopCfg6.sourceOk bandLoop = false ∧ GeneralLoopCfg6.sourceOk bandLoop = false ∧
+    GeneralArgsLoopCfg6.sourceOk andImmediate = false ∧ GeneralLoopCfg6.sourceOk andImmediate = false := by
+  decide
+
+/-- The source outcome of `f` from the entry with fuel `fuel`, for the arguments `args`. -/
+def sourceOutcome (f : Clif.Function) (fuel : Nat) (args : List Clif.Val) : Option Clif.Outcome :=
+  match Clif.enterFunc f args Clif.Mem.empty with
+  | .ok (fr,cm) => some (Clif.runLoop Clif.Env.empty {funcs := []} fuel ⟨fr,[],cm⟩)
+  | _ => none
+
+private def checks : Bool :=
+  decide ((Clif.parseFile bandLoopSource).funcs.map (·.func.toOption) = [some bandLoop]) &&
+  (match sourceOutcome bandLoop 40 [⟨.i32,7⟩,⟨.i32,4⟩] with
+    | some (.returned vals _) => decide (vals = [⟨.i32,3⟩]) | _ => false) &&
+  sourceOk bandLoop &&
+  (match Stock.lower bandLoop with
+    | .error _ => false
+    | .ok result =>
+      match splitEdgesChecked result.code result.edgeArgs with
+      | .ok split => check bandLoop split.code
+      | .error _ => false) &&
+  decide ((Clif.parseFile andImmediateSource).funcs.map (·.func.toOption) = [some andImmediate]) &&
+  (match sourceOutcome andImmediate 20 [⟨.i32,301⟩] with
+    | some (.returned vals _) => decide (vals = [⟨.i32,100⟩]) | _ => false) &&
+  GeneralLoopCfg7.sourceOk andImmediate &&
+  (match Stock.lower andImmediate with
+    | .error _ => false
+    | .ok result => GeneralLoopCfg7.check andImmediate result.code)
+
+-- witness: native_decide (the two fixed functions' parses, source runs, selectors, input checks, lowering, split and checkers only)
+private theorem checks_true : checks = true := by native_decide -- witness: native_decide
+
+private theorem returned_of {f : Clif.Function} {fuel : Nat} {args : List Clif.Val} {expected : List Clif.Val}
+    (returns : (match sourceOutcome f fuel args with
+      | some (.returned vals _) => decide (vals = expected) | _ => false) = true) :
+    ∃ mem,sourceOutcome f fuel args = some (.returned expected mem) := by
+  cases outcome : sourceOutcome f fuel args with
+  | none => rw [outcome] at returns; cases returns
+  | some o =>
+    rw [outcome] at returns
+    cases o with
+    | returned vals mem =>
+      simp only [decide_eq_true_eq] at returns
+      exact ⟨mem,by rw [returns]⟩
+    | _ => cases returns
+
+/-- **`%band_loop` (a loop whose branches test a `band` with a register mask and a `band` with a
+three-bit constant mask, with block arguments) is in the checked split loop class, and
+`%br_and_immediate` (a branch on `band v0, 300`) is in the checked legacy loop class.** The literals
+are the parses of the texts; the selectors derive `Scalar.DomainAt` and `Scalar.Domain`; the source
+runs return `3` and `100`; the actual split code of `%band_loop` passes the split checker, which
+derives the code domain; the actual code of `%br_and_immediate` passes the legacy checker, which
+derives the production domain of that code; the CB-14c classes reject both functions. -/
+theorem band_loop_witness :
+    (Clif.parseFile bandLoopSource).funcs.map (·.func.toOption) = [some bandLoop] ∧
+    Scalar.DomainAt bandLoop ∧
+    (∃ mem,sourceOutcome bandLoop 40 [⟨.i32,7⟩,⟨.i32,4⟩] = some (.returned [⟨.i32,3⟩] mem)) ∧
+    GeneralArgsLoopCfg6.sourceOk bandLoop = false ∧ GeneralLoopCfg6.sourceOk bandLoop = false ∧
+    (∃ result split,Stock.lower bandLoop = .ok result ∧
+      splitEdgesChecked result.code result.edgeArgs = .ok split ∧
+      check bandLoop split.code = true ∧ Scalar.CodeDomain bandLoop split.code) ∧
+    (Clif.parseFile andImmediateSource).funcs.map (·.func.toOption) = [some andImmediate] ∧
+    Scalar.Domain andImmediate ∧
+    (∃ mem,sourceOutcome andImmediate 20 [⟨.i32,301⟩] = some (.returned [⟨.i32,100⟩] mem)) ∧
+    GeneralArgsLoopCfg6.sourceOk andImmediate = false ∧ GeneralLoopCfg6.sourceOk andImmediate = false ∧
+    ∃ result,Stock.lower andImmediate = .ok result ∧ GeneralLoopCfg7.check andImmediate result.code = true ∧
+      Scalar.Domain andImmediate := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨⟨⟨⟨⟨⟨parsed,returns⟩,source⟩,lowered⟩,parsedLegacy⟩,returnsLegacy⟩,sourceLegacy⟩,loweredLegacy⟩ := h
+  refine ⟨of_decide_eq_true parsed,source_ok_sound source,returned_of returns,other_classes_reject.1,
+    other_classes_reject.2.1,?_,of_decide_eq_true parsedLegacy,GeneralLoopCfg7.source_ok_sound sourceLegacy,
+    returned_of returnsLegacy,other_classes_reject.2.2.1,other_classes_reject.2.2.2,?_⟩
+  · cases run : Stock.lower bandLoop with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      dsimp only at lowered
+      cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+      | error message => rw [splitRun] at lowered; cases lowered
+      | ok split =>
+        rw [splitRun] at lowered
+        exact ⟨result,split,rfl,splitRun,lowered,check_sound lowered⟩
+  · cases run : Stock.lower andImmediate with
+    | error message => rw [run] at loweredLegacy; cases loweredLegacy
+    | ok result =>
+      rw [run] at loweredLegacy
+      obtain ⟨result',domain,run',code⟩ := GeneralLoopCfg7.check_sound loweredLegacy
+      exact ⟨result,rfl,loweredLegacy,domain⟩
+
+end Backend.Stock.GeneralArgsLoopCfg7.Fixture
diff --git a/FV/Backend/Proof/StockGeneralSubsumption7.lean b/FV/Backend/Proof/StockGeneralSubsumption7.lean
new file mode 100644
index 000000000..cde76d619
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralSubsumption7.lean
@@ -0,0 +1,170 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg7
+
+/-! Subsumption of the CB-14c classes by the two classes of CB-15 (#140).
+
+The split class `GeneralArgsLoopCfg7` accepts every function of the split class
+`GeneralArgsLoopCfg6` (CB-14c) and of the legacy class `GeneralLoopCfg7`; the legacy class
+`GeneralLoopCfg7` accepts every function of the legacy class `GeneralLoopCfg6` (CB-14c). The split
+checkers publish the edge split of the actual Stock lowering and the legacy checkers its unsplit
+code, so the subsumption also holds for the checkers. With the earlier subsumption lemmas, every
+earlier split class is in `GeneralArgsLoopCfg7`, and every earlier legacy loop and branch class is
+in `GeneralLoopCfg7`.
+
+All proofs are Boolean reasoning over the `all`/`any` structure of the selectors. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg7
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **`GeneralArgsLoopCfg6` (CB-14c) is in the class at the selector level.** -/
+theorem source_leaf_eligible_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg6.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralArgsLoopCfg6.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralArgsLoopCfg6.controlLeafEligible,GeneralArgsLoopCfg6.controlEligible,
+      GeneralArgsLoopCfg5.controlEligible,Bool.and_eq_true] at old
+    obtain ⟨⟨condition,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,conditionEligible,condition,yesNonentry,noNonentry,
+      Bool.true_or,Bool.and_self]
+  case brTable x dc tbl => exact old
+  all_goals
+    simp only [GeneralArgsLoopCfg6.controlLeafEligible,GeneralArgsLoopCfg6.controlEligible,
+      GeneralArgsLoopCfg5.controlEligible] at old
+    cases old
+
+/-- **`GeneralArgsLoopCfg6` (CB-14c) is in the class.** -/
+theorem source_ok_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg6.sourceOk f = true) : sourceOk f = true := by
+  simp only [GeneralArgsLoopCfg6.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_args_loop leaf) scope dominated abi
+
+/-- **The legacy class `GeneralLoopCfg7` is in the class at the selector level**: it is this class
+with empty `brif` and `br_table` arguments. -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg7.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg7.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg7.controlLeafEligible,GeneralLoopCfg7.controlEligible,Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,_⟩,_⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,condition,yesNonentry,noNonentry,Bool.and_self]
+  case brTable x dc tbl =>
+    simp only [GeneralLoopCfg7.controlLeafEligible,GeneralLoopCfg7.controlEligible,
+      GeneralLoopCfg6.controlEligible,Bool.and_eq_true] at old
+    simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg6.controlEligible,old.1]
+  all_goals
+    simp only [GeneralLoopCfg7.controlLeafEligible,GeneralLoopCfg7.controlEligible,
+      GeneralLoopCfg6.controlEligible,GeneralLoopCfg5.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg7` is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg7.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg7.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-- **The checker of `GeneralArgsLoopCfg6` (CB-14c) is in the checker of the class**: both
+publish the edge split of the actual Stock lowering. -/
+theorem check_of_general_args_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralArgsLoopCfg6.check f vc = true) : check f vc = true := by
+  simp only [GeneralArgsLoopCfg6.check,Bool.and_eq_true] at checked
+  simp only [check,source_ok_of_general_args_loop checked.1,Bool.true_and]
+  exact checked.2
+
+end Backend.Stock.GeneralArgsLoopCfg7
+
+namespace Backend.Stock.GeneralLoopCfg7
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **The legacy class `GeneralLoopCfg6` (CB-14c) is in the class at the selector level.** -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg6.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg6.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg6.controlLeafEligible,GeneralLoopCfg6.controlEligible,
+      GeneralLoopCfg5.controlEligible,Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,yesEmpty⟩,noEmpty⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg7.conditionEligible,condition,yesEmpty,
+      noEmpty,yesNonentry,noNonentry,Bool.true_or,Bool.and_self]
+  case brTable x dc tbl => exact old
+  all_goals
+    simp only [GeneralLoopCfg6.controlLeafEligible,GeneralLoopCfg6.controlEligible,
+      GeneralLoopCfg5.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg6` (CB-14c) is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg6.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg6.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-- **The checker of `GeneralLoopCfg6` (CB-14c) is in the checker of the class**: both publish the
+unsplit code of the actual Stock lowering. -/
+theorem check_of_general_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralLoopCfg6.check f vc = true) : check f vc = true := by
+  simp only [GeneralLoopCfg6.check,Bool.and_eq_true] at checked
+  simp only [check,source_ok_of_general_loop checked.1,Bool.true_and]
+  exact checked.2
+
+end Backend.Stock.GeneralLoopCfg7
