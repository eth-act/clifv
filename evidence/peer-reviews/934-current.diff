+import FV.Backend.Proof.StockPlainBandValues
+import FV.Backend.Proof.StockComparisonLoopCarry
+import FV.Backend.Proof.StockTermAvailability
+import FV.Backend.Proof.StockArithmeticTerminalDefined
+
+/-! Branches on a `PlainSource'` condition: source cores and carry cores (#140, CB-15).
+
+The CB-11 cores (`StockPlainConditionCores`) with `PlainSource'` in place of `PlainSource`: the
+body runs, and the branch uses `plain_branch_values_last'`. The `cbnz` defines no virtual registers
+(`plain_branch_no_defs'`), so `branch_carry_of_no_defs` gives the carry cores
+`returning/trapping_plain_carry_core'` (`ReturningCarryCore`, `TrappingCarryCore`). -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.PlainBranch
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem local_family {b : Clif.Block}
+    (family : ∀ stm ∈ b.body,MaskBody.Family stm.inst) : ∀ stm ∈ b.body,LocalBody.LocalInst stm.inst := by
+  intro stm member
+  rcases family stm member with (scalar | ⟨op,ty,x,y,shape⟩) | ⟨ty,x,shape⟩ | shape
+  · exact LocalBody.LocalInst.of_pure (HighMulBody.family_pure scalar)
+  all_goals simp [LocalBody.LocalInst,shape]
+
+private theorem returned_choice {env : Clif.Env} {cp : Clif.Program} {left : Nat} {t : Clif.State}
+    {c : Nat} {yes no : Clif.BlockCall} {vals : List Clif.Val} {cm : Clif.Mem}
+    (empty : t.frame.body = []) (term : t.frame.term = .brif c yes no)
+    (returned : Clif.runLoop env cp left t = .returned vals cm) :
+    ∃ fuel value fr,left = fuel+1 ∧ t.frame.get c = .ok value ∧
+      Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) = .ok fr ∧
+      Clif.runLoop env cp fuel {t with frame := fr} = .returned vals cm := by
+  cases left with
+  | zero => cases returned
+  | succ fuel =>
+    rw [Clif.runLoop_succ] at returned
+    simp only [Clif.step,empty,term,Clif.stepTerm] at returned
+    cases read : t.frame.get c with
+    | trap code => simp only [read,Clif.StepResult.ofRes] at returned; cases returned
+    | stuck message => simp only [read,Clif.StepResult.ofRes] at returned; cases returned
+    | ok value =>
+      simp only [read,Clif.StepResult.ofRes] at returned
+      cases crossed : Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) with
+      | trap code => simp only [crossed,Clif.StepResult.ofRes] at returned; cases returned
+      | stuck message => simp only [crossed,Clif.StepResult.ofRes] at returned; cases returned
+      | ok fr =>
+        simp only [crossed,Clif.StepResult.ofRes] at returned
+        exact ⟨fuel,value,fr,rfl,rfl,crossed,returned⟩
+
+private theorem trapped_choice {env : Clif.Env} {cp : Clif.Program} {left : Nat} {t : Clif.State}
+    {c : Nat} {yes no : Clif.BlockCall} {code : Clif.TrapCode}
+    (empty : t.frame.body = []) (term : t.frame.term = .brif c yes no)
+    (trapped : Clif.runLoop env cp left t = .trapped code) :
+    ∃ fuel value fr,left = fuel+1 ∧ t.frame.get c = .ok value ∧
+      Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) = .ok fr ∧
+      Clif.runLoop env cp fuel {t with frame := fr} = .trapped code := by
+  cases left with
+  | zero => cases trapped
+  | succ fuel =>
+    rw [Clif.runLoop_succ] at trapped
+    simp only [Clif.step,empty,term,Clif.stepTerm] at trapped
+    cases read : t.frame.get c with
+    | trap readCode =>
+      have impossible : t.frame.get c ≠ .trap readCode := by
+        intro bad
+        unfold Clif.Frame.get Clif.Res.ofOption at bad
+        split at bad <;> cases bad
+      exact False.elim (impossible read)
+    | stuck message => simp only [read,Clif.StepResult.ofRes] at trapped; cases trapped
+    | ok value =>
+      simp only [read,Clif.StepResult.ofRes] at trapped
+      cases crossed : Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) with
+      | trap enteredCode => exact False.elim (enterBlock_ne_trap crossed)
+      | stuck message => simp only [crossed,Clif.StepResult.ofRes] at trapped; cases trapped
+      | ok fr =>
+        simp only [crossed,Clif.StepResult.ofRes] at trapped
+        exact ⟨fuel,value,fr,rfl,rfl,crossed,trapped⟩
+
+private theorem integer_width {ty : Clif.Ty} {width : Nat}
+    (same : CTy.int width = CTy.ofClif ty) : ty.width = width := by
+  cases ty <;> simp [CTy.ofClif,Clif.Ty.width] at same ⊢ <;> omega
+
+/-- The source value of a wide condition has width 32 or 64. -/
+private theorem condition_width {f : Clif.Function} {result : Result}
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (conditionTy : result.ctx.valueType? c = some (.int 32) ∨ result.ctx.valueType? c = some (.int 64))
+    {fr : Clif.Frame} {cm : Clif.Mem} {cty : Clif.Ty} {test : BitVec cty.width}
+    (getC : (restrict fr (availOf f (availIn f result.ctx) spec.core.scan.block b.body.length)).getAs c cty = .ok test)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (post : GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.term.output.state
+      (b.body.length,fr,cm) ρ world) : cty.width = 32 ∨ cty.width = 64 := by
+  have ctxEq := (stock_lowerBlockCore_scanOrigin spec.coreRun).2.1
+  rcases conditionTy with narrow | wide
+  · have typed : spec.core.scan.ctx.valueType? c = some (.int 32) := by rw [ctxEq]; exact narrow
+    exact Or.inl (integer_width (getAs_typed post.2.1 typed getC))
+  · have typed : spec.core.scan.ctx.valueType? c = some (.int 64) := by rw [ctxEq]; exact wide
+    exact Or.inr (integer_width (getAs_typed post.2.1 typed getC))
+
+/-- A successful original source return executes the complete retained scalar body and the
+actual `cbnz` branch on a wide `PlainSource'` condition, preserving its source continuation,
+original fuel/definedness and guarded frame. The machine stops on the edge of the source truth of the
+condition. Source getters, width, rule selection and machine execution are derived; only source
+class metadata is required. -/
+theorem ConditionalBodySpec.returning_plain_core' {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (plain : PlainSource' result.ctx c)
+    (conditionTy : result.ctx.valueType? c = some (.int 32) ∨ result.ctx.valueType? c = some (.int 64))
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ world) :
+    ∃ (t : Clif.State) (left : Nat) (value : Clif.Val) (fr : Clif.Frame),
+      ∃ index inst ops regs prefixWorld endWorld,
+      left+1+b.body.length = fuel ∧ t.frame.body = [] ∧ LocalBody.SourceFrameEq s t ∧
+      SourceSteps (IndexedSourceInst env cp f spec.core.scan.ctx spec.core.scan.block)
+        (List.range' (blockStart f spec.core.scan.block) b.body.length)
+        (0,s.frame,s.mem) (b.body.length,t.frame,t.mem) ∧
+      t.frame.get c = .ok value ∧
+      Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) = .ok fr ∧
+      Clif.runLoop env cp left {t with frame := fr} = .returned vals cm ∧
+      SourceDefinedAt f result.ctx spec.core.scan.block b.body.length t.frame ∧
+      index+1 = spec.origin.emission.code.size ∧
+      seqRun isem (spec.core.code.toList.map
+        (·.mapRegs (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ world =
+        some (.stop (spec.body.code.size+index) inst ops regs prefixWorld [] endWorld
+          (.goto (if Clif.Sem.truthy value.bits then 0 else 1))) ∧
+      GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.term.output.state
+        (b.body.length,t.frame,t.mem) regs endWorld ∧
+      inst.targets = result.order.successors[label]!.toList ∧ inst.isTerminator = true := by
+  have block := spec.split.block
+  have originalBlock : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using block
+  obtain ⟨otherTerm,otherBody,otherSplit,normal,trapping⟩ := MaskBody.actual_body_refines_at_block
+    run scope dominated family spec.events block refines driver stable (env := env) (cp := cp)
+  have termEq : spec.term = otherTerm := (List.cons.inj (spec.split.records.symm.trans otherSplit.records)).1
+  have buffers := congrArg Array.toList (spec.split.code.symm.trans otherSplit.code)
+  rw [termEq] at buffers
+  simp only [Array.toList_append] at buffers
+  have codeEq : spec.body.code = otherBody.code := Array.toList_inj.mp (List.append_cancel_right buffers)
+  obtain ⟨t,left,total,continued,empty,steps,frame⟩ := LocalBody.actual_local_source_execution_frame
+    run spec.events spec.split (local_family (family b (List.mem_of_getElem? block)))
+    (j := 0) (by omega) (by simpa using remaining) returned
+  have tDefined : SourceDefinedAt f result.ctx spec.core.scan.block b.body.length t.frame := by
+    apply ArithmeticBody.arithmetic_steps_defined run scope dominated spec.events block
+      (env := env) (cp := cp) (s := (0,s.frame,s.mem)) (t := (b.body.length,t.frame,t.mem))
+      (j := 0) (n := b.body.length) (by omega) rfl ?_ defined
+    simpa only [Nat.add_zero,Nat.sub_zero] using steps
+  obtain ⟨middle,bodyWorld,bodyRun,post⟩ := normal (0,s.frame,s.mem) (b.body.length,t.frame,t.mem)
+    (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range] using steps) ρ world held
+  rw [← codeEq] at bodyRun
+  rw [← termEq] at post
+  have atBranch : t.frame.term = .brif c yes no := frame.2.2.2.trans (atTerm.trans termShape)
+  obtain ⟨after,value,fr,leftEq,read,crossed,nextReturned⟩ := returned_choice empty atBranch continued
+  have av0 := buildCtx_term_available spec.build dominated originalBlock c
+    (by simp [termShape,abiTerm,Backend.Proof.Driver.termArgs])
+  have available : c ∈ availOf f (availIn f result.ctx) spec.core.scan.block b.body.length := by
+    simpa only [spec.atBlock] using av0
+  have rawGet : t.frame.getAs c value.ty = .ok value.bits := by
+    simp [Clif.Frame.getAs,read,Clif.Val.as?]
+  have getC := (getAs_congr (fr := t.frame) (ty := value.ty) (restrict_regs_of_mem available)).trans rawGet
+  have width := condition_width spec conditionTy getC post
+  obtain ⟨index,inst,ops,regs,prefixWorld,endWorld,branchRun,branchLast,branchPost,targets,terminal⟩ :=
+    spec.plain_branch_values_last' run scope refines stable originalBlock termShape plain getC width post
+  refine ⟨t,after,value,fr,index,inst,ops,regs,prefixWorld,endWorld,?_,empty,frame,?_,read,crossed,
+    nextReturned,tDefined,branchLast,?_,branchPost,targets,terminal⟩
+  · simpa only [leftEq,Nat.sub_zero] using total
+  · simpa only [Nat.add_zero,Nat.sub_zero] using steps
+  · rw [spec.bodyCode,Array.toList_append,List.map_append]
+    have combined := seqRun_append_fall_stop isem bodyRun branchRun
+    by_cases zero : value.bits = 0
+    · simpa [List.length_map,Array.length_toList,Clif.Sem.truthy,zero,Nat.add_comm] using combined
+    · simpa [List.length_map,Array.length_toList,Clif.Sem.truthy,zero,Nat.add_comm] using combined
+
+/-- Original source trapping either executes the first body trap or executes its actual retained
+body and `cbnz` branch on a wide `PlainSource'` condition and preserves the later source trap. -/
+theorem ConditionalBodySpec.trapping_plain_core' {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (plain : PlainSource' result.ctx c)
+    (conditionTy : result.ctx.valueType? c = some (.int 32) ∨ result.ctx.valueType? c = some (.int 64))
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ world) :
+    TrapRun isem (spec.core.code.toList.map
+      (·.mapRegs (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ world code ∨
+    ∃ (t : Clif.State) (left : Nat) (value : Clif.Val) (fr : Clif.Frame),
+      ∃ index inst ops regs prefixWorld endWorld,
+      left+1+b.body.length = fuel ∧ t.frame.body = [] ∧ LocalBody.SourceFrameEq s t ∧
+      SourceSteps (IndexedSourceInst env cp f spec.core.scan.ctx spec.core.scan.block)
+        (List.range' (blockStart f spec.core.scan.block) b.body.length)
+        (0,s.frame,s.mem) (b.body.length,t.frame,t.mem) ∧
+      t.frame.get c = .ok value ∧
+      Clif.enterBlock t.frame (if Clif.Sem.truthy value.bits then yes else no) = .ok fr ∧
+      Clif.runLoop env cp left {t with frame := fr} = .trapped code ∧
+      SourceDefinedAt f result.ctx spec.core.scan.block b.body.length t.frame ∧
+      index+1 = spec.origin.emission.code.size ∧
+      seqRun isem (spec.core.code.toList.map
+        (·.mapRegs (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ world =
+        some (.stop (spec.body.code.size+index) inst ops regs prefixWorld [] endWorld
+          (.goto (if Clif.Sem.truthy value.bits then 0 else 1))) ∧
+      GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.term.output.state
+        (b.body.length,t.frame,t.mem) regs endWorld ∧
+      inst.targets = result.order.successors[label]!.toList ∧ inst.isTerminator = true := by
+  have block := spec.split.block
+  have originalBlock : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using block
+  obtain ⟨otherTerm,otherBody,otherSplit,normal,trapping⟩ := MaskBody.actual_body_refines_at_block
+    run scope dominated family spec.events block refines driver stable (env := env) (cp := cp)
+  have termEq : spec.term = otherTerm := (List.cons.inj (spec.split.records.symm.trans otherSplit.records)).1
+  have buffers := congrArg Array.toList (spec.split.code.symm.trans otherSplit.code)
+  rw [termEq] at buffers
+  simp only [Array.toList_append] at buffers
+  have codeEq : spec.body.code = otherBody.code := Array.toList_inj.mp (List.append_cancel_right buffers)
+  rcases LocalBody.actual_local_source_trap_or_continue run spec.events spec.split
+      (local_family (family b (List.mem_of_getElem? block)))
+      (j := 0) (by omega) (by simpa using remaining) trapped with failed | ⟨t,left,total,continued,empty,steps,frame⟩
+  · left
+    have failedRun := trapping (0,s.frame,s.mem) code
+      (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range] using failed) ρ world held
+    obtain ⟨offset,inst,ops,regs,prefixWorld,outs,endWorld,execution,coded⟩ := failedRun
+    rw [← codeEq] at execution
+    refine ⟨offset,inst,ops,regs,prefixWorld,outs,endWorld,?_,coded⟩
+    rw [spec.bodyCode,Array.toList_append,List.map_append]
+    exact seqRun_append_stop isem execution
+  · right
+    have tDefined : SourceDefinedAt f result.ctx spec.core.scan.block b.body.length t.frame := by
+      apply ArithmeticBody.arithmetic_steps_defined run scope dominated spec.events block
+        (env := env) (cp := cp) (s := (0,s.frame,s.mem)) (t := (b.body.length,t.frame,t.mem))
+        (j := 0) (n := b.body.length) (by omega) rfl ?_ defined
+      simpa only [Nat.add_zero,Nat.sub_zero] using steps
+    obtain ⟨middle,bodyWorld,bodyRun,post⟩ := normal (0,s.frame,s.mem) (b.body.length,t.frame,t.mem)
+      (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range] using steps) ρ world held
+    rw [← codeEq] at bodyRun
+    rw [← termEq] at post
+    have atBranch : t.frame.term = .brif c yes no := frame.2.2.2.trans (atTerm.trans termShape)
+    obtain ⟨after,value,fr,leftEq,read,crossed,nextTrapped⟩ := trapped_choice empty atBranch continued
+    have av0 := buildCtx_term_available spec.build dominated originalBlock c
+      (by simp [termShape,abiTerm,Backend.Proof.Driver.termArgs])
+    have available : c ∈ availOf f (availIn f result.ctx) spec.core.scan.block b.body.length := by
+      simpa only [spec.atBlock] using av0
+    have rawGet : t.frame.getAs c value.ty = .ok value.bits := by
+      simp [Clif.Frame.getAs,read,Clif.Val.as?]
+    have getC := (getAs_congr (fr := t.frame) (ty := value.ty) (restrict_regs_of_mem available)).trans rawGet
+    have width := condition_width spec conditionTy getC post
+    obtain ⟨index,inst,ops,regs,prefixWorld,endWorld,branchRun,branchLast,branchPost,targets,terminal⟩ :=
+      spec.plain_branch_values_last' run scope refines stable originalBlock termShape plain getC width post
+    refine ⟨t,after,value,fr,index,inst,ops,regs,prefixWorld,endWorld,?_,empty,frame,?_,read,crossed,
+      nextTrapped,tDefined,branchLast,?_,branchPost,targets,terminal⟩
+    · simpa only [leftEq,Nat.sub_zero] using total
+    · simpa only [Nat.add_zero,Nat.sub_zero] using steps
+    · rw [spec.bodyCode,Array.toList_append,List.map_append]
+      have combined := seqRun_append_fall_stop isem bodyRun branchRun
+      by_cases zero : value.bits = 0
+      · simpa [List.length_map,Array.length_toList,Clif.Sem.truthy,zero,Nat.add_comm] using combined
+      · simpa [List.length_map,Array.length_toList,Clif.Sem.truthy,zero,Nat.add_comm] using combined
+
+/-- `returning_plain_core'` with a carry set: the body and the `cbnz` keep `CarryRel` of every set
+that is available at the block entry. -/
+theorem ConditionalBodySpec.returning_plain_carry_core' {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (plain : PlainSource' result.ctx c)
+    (conditionTy : result.ctx.valueType? c = some (.int 32) ∨ result.ctx.valueType? c = some (.int 64))
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    ReturningCarryCore spec needed fuel s vals cm ρ world := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  have noDefs := spec.plain_branch_no_defs' run scope block termShape plain conditionTy
+  obtain ⟨t,left,value,fr,index,inst,ops,regs,prefixWorld,endWorld,
+    total,empty,frame,steps,read,crossed,nextReturned,tDefined,last,machine,post,targets,terminal⟩ :=
+    spec.returning_plain_core' run scope dominated family refines driver stable termShape plain conditionTy
+      remaining atTerm defined returned held.1
+  exact ⟨t,left,value,fr,index,inst,ops,regs,prefixWorld,endWorld,total,empty,frame,steps,read,crossed,
+    nextReturned,tDefined,last,machine,⟨post,spec.branch_carry_of_no_defs run scope dominated family refines
+      driver stable noDefs available steps held machine⟩,targets,terminal⟩
+
+/-- `trapping_plain_core'` with a carry set. -/
+theorem ConditionalBodySpec.trapping_plain_carry_core' {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (plain : PlainSource' result.ctx c)
+    (conditionTy : result.ctx.valueType? c = some (.int 32) ∨ result.ctx.valueType? c = some (.int 64))
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    TrappingCarryCore spec needed fuel s code ρ world := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  have noDefs := spec.plain_branch_no_defs' run scope block termShape plain conditionTy
+  rcases spec.trapping_plain_core' run scope dominated family refines driver stable termShape plain conditionTy
+      remaining atTerm defined trapped held.1 with
+    failed | ⟨t,left,value,fr,index,inst,ops,regs,prefixWorld,endWorld,
+      total,empty,frame,steps,read,crossed,nextTrapped,tDefined,last,machine,post,targets,terminal⟩
+  · exact Or.inl failed
+  · exact Or.inr ⟨t,left,value,fr,index,inst,ops,regs,prefixWorld,endWorld,total,empty,frame,steps,read,
+      crossed,nextTrapped,tDefined,last,machine,⟨post,spec.branch_carry_of_no_defs run scope dominated family
+        refines driver stable noDefs available steps held machine⟩,targets,terminal⟩
+
+end Backend.Stock.Proof.ConditionalValues
diff --git a/FV/Backend/Proof/StockPlainBandSelection.lean b/FV/Backend/Proof/StockPlainBandSelection.lean
new file mode 100644
index 000000000..6362e3d62
--- /dev/null
+++ b/FV/Backend/Proof/StockPlainBandSelection.lean
@@ -0,0 +1,207 @@
+import FV.Backend.Proof.StockPlainConditionSelection
+import FV.Backend.Proof.StockTestBitSelection
+
+/-! Branches on a plain computed condition that may be a `band`: rule selection (#140, CB-15).
+
+`PlainSource` (CB-11) excludes every `band` condition (`NonBandSource`). Only one `band` form is
+looked through by a `lower_branch` rule before ordinary `brif` (3231): the `tbnz` rule 3251 needs
+`c = band _ x k`, `k = iconst n` and `test_and_compare_bit_const (value_type x) n` (`tcbc`), and
+this is exactly `TestBitMetadata` (CB-13). `test_bit_metadata_of_match` derives it from an actual
+match of rule 3251, including its `if-let`. So `PlainSource'` excludes only that form: `c` is
+not a one-bit test (`¬TestBitMetadata`), and `c` is not a comparison origin, which excludes the
+`tbz` rule 3257 and the comparison rules of `is_nonzero_cmp`. A `band` with a register mask, or
+with a constant mask that does not have exactly one set bit below the width of `x`, is plain.
+`PlainSource.weak` shows that `PlainSource` implies `PlainSource'`. `plain_selected'` is
+`plain_selected` under `PlainSource'`. -/
+
+namespace Backend.Stock.Proof.PlainBranch
+open Backend.Proof Backend.Proof.Driver Backend.Proof.Cov Isle Isle.Interp Isle.Aarch64
+open Backend.Stock.Proof.ComparisonBranch Backend.Stock.Proof.TestBitBranch
+set_option autoImplicit false
+set_option maxRecDepth 20000
+set_option maxHeartbeats 8000000
+
+/-- `c` is not a one-bit test of rule 3251 (`TestBitMetadata`), and is neither an `icmp` result
+nor a `uextend` of one. A `band` whose mask is not such a one-bit constant is allowed. -/
+def PlainSource' (ctx : Ctx) (c : Nat) : Prop :=
+  ¬TestBitMetadata ctx c ∧ ∀ cc ty a b,¬ScalarSelect.SelectComparisonOrigin ctx c cc ty a b
+
+/-- A condition that is not a `band` result is not a one-bit test. -/
+theorem not_test_bit_of_nonband {ctx : Ctx} {c : Nat} (nonband : NonBandSource ctx c) :
+    ¬TestBitMetadata ctx c := by
+  rintro ⟨ty,x,k,ty',imm,t,bit,band,_,_,_⟩
+  cases defined : ctx.defInst? c with
+  | none => simp [Ctx.defClif?,defined] at band
+  | some j =>
+    cases found : ctx.insts[j]? with
+    | none => simp [Ctx.defClif?,defined,found] at band
+    | some info =>
+      have clif : info.clif = some (.binary .band ty x k) := by
+        simpa [Ctx.defClif?,defined,found] using band
+      exact nonband j info defined found ty x k clif
+
+/-- **`PlainSource` implies `PlainSource'`.** -/
+theorem PlainSource.weak {ctx : Ctx} {c : Nat} (plain : PlainSource ctx c) : PlainSource' ctx c :=
+  ⟨not_test_bit_of_nonband plain.1,plain.2⟩
+
+attribute [local irreducible] Isle.Aarch64.program Stock.runTerm
+
+private theorem sem_ctor (ctx : Ctx) (t : Term) (vs : List V) (st : State) :
+    (Stock.sem ctx).ctor t vs st = Stock.externCtor ctx t vs st := rfl
+
+/-- The Stock `test_and_compare_bit_const` constructor is `tcbc` and keeps the state. -/
+theorem stock_ctor_tcbc_iff (ctx : Ctx) (st : State) (t : CTy) (n : Int) (v : V) (st' : State) :
+    Stock.externCtor ctx T.test_and_compare_bit_const [.ty t,.int n] st = .ok (v,st') ↔
+      ∃ bit,tcbc t n = some bit ∧ v = .int bit ∧ st' = st := by
+  rw [stock_ctor_baseOnly ctx _ _ st (by decide)]
+  constructor
+  · intro h
+    split at h
+    · rename_i v' base legacy
+      obtain ⟨bit,bitEq,rfl,rfl⟩ := (ctor_tcbc_iff st.base t n v' base).mp legacy
+      cases h
+      exact ⟨bit,bitEq,rfl,rfl⟩
+    · cases h
+    · cases h
+  · intro ⟨bit,bitEq,hv,hs⟩
+    rw [hv,hs]
+    have legacy := (ctor_tcbc_iff (ctx := ctx) st.base t n (.int bit) st.base).mpr ⟨bit,bitEq,rfl,rfl⟩
+    simp only [legacy]
+
+/-- **An actual match of the `tbnz` rule (3251) is a one-bit test.** The match of the arguments
+gives `c = band _ x k`, `k = iconst imm` and the type of `x`; the `if-let` gives `tcbc`. -/
+theorem test_bit_metadata_of_match {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i c : Nat} {targets : V} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨.data 152 5 [.data 151 1 [],.value c,targets],[],[],none⟩)
+    {fuel : Nat} (enough : 100 ≤ fuel) {before next : State × Array RuleId} {env : Isle.Interp.Env V}
+    (matched : (matchRule program (Stock.sem ctx) {} fuel rule_lower_3251 [.inst i,.labels labels]).run before =
+        .ok (some env,next)) : TestBitMetadata ctx c := by
+  obtain ⟨fuel,rfl⟩ : ∃ m,fuel = m+100 := ⟨fuel-100,by omega⟩
+  rw [show fuel+100 = (fuel+99)+1 by omega] at matched
+  obtain ⟨env0,args,iflets⟩ := matchRule_some_inv matched
+  clear matched
+  rw [stock_matchArgs] at args
+  have hp := data_program
+  isel_inv' hp [rule_lower_3251,slot] at args
+  obtain ⟨hj1⟩ : Nonempty (ctx.defInst? c = some _) := ⟨‹_›⟩
+  obtain ⟨hi1⟩ : Nonempty (ctx.insts[_]? = some _) := ⟨‹ctx.insts[_]? = some _›⟩
+  obtain ⟨cl1,hcl1,hdat1⟩ := ctxInv_clif inv.identityView hj1 hi1
+  obtain ⟨hd1⟩ : Nonempty (V.data 152 2 _ = _) := ⟨‹_›⟩
+  rw [← hd1] at hdat1
+  obtain ⟨ty1,a,b,rfl,he1,hfs1⟩ := instData_binary_inv (cop := .band) variantNames_Band rfl hdat1
+  simp only [List.cons.injEq,and_true] at hfs1
+  subst hfs1
+  repeat (isel_inv_simp [] at * <;> isel_destruct <;> subst_vars)
+  obtain ⟨hj2⟩ : Nonempty (ctx.defInst? b = some _) := ⟨‹_›⟩
+  obtain ⟨hd2⟩ : Nonempty (V.data 152 35 _ = _) := ⟨‹_›⟩
+  obtain ⟨hi2⟩ : Nonempty (ctx.insts[_]? = some _) := ⟨‹ctx.insts[_]? = some _›⟩
+  obtain ⟨ty2,imm,rfl,he2,hcl2⟩ := iconst_data_inv inv.identityView hj2 hi2 hd2
+  repeat (isel_inv_simp [sem_ctor,stock_ctor_tcbc_iff] at * <;> isel_destruct <;> subst_vars)
+  obtain ⟨hta⟩ : Nonempty (ctx.valueType? a = some _) := ⟨‹_›⟩
+  obtain ⟨htc⟩ : Nonempty (tcbc _ _ = some _) := ⟨‹_›⟩
+  exact ⟨ty1,a,b,ty2,imm,_,_,by simp [Ctx.defClif?,hj1,hi1,hcl1],by simp [Ctx.defClif?,hj2,hi2,hcl2],hta,htc⟩
+
+private theorem branch_ruleFmt_match {ctx : Ctx} {r : Rule} {fT : Nat}
+    (format : ruleFmt r = some fT) (lo : 2447 ≤ fT) (hi : fT < 2447 + 36)
+    {fuel ti : Nat} {rest : List V} {st next : State × Array RuleId} {env : Isle.Interp.Env V}
+    (matched : (matchRule program (Stock.sem ctx) {} fuel r (.inst ti :: rest)).run st =
+      .ok (some env, next)) :
+    ∃ info fs, ctx.insts[ti]? = some info ∧ info.data = .data 152 (fT - 2447) fs := by
+  have bound : fT - 2447 < 36 := by omega
+  obtain ⟨term, lookup, kind⟩ := fmtKinds_program (fT - 2447) bound
+  rw [show 2447 + (fT - 2447) = fT by omega] at lookup
+  cases fuel with
+  | zero => rw [matchRule.eq_1] at matched; cases matched
+  | succ fuel =>
+    obtain ⟨env0, args, _⟩ := matchRule_some_inv matched
+    rw [stock_matchArgs] at args
+    unfold ruleFmt at format
+    split at format
+    · rename_i q qs shape
+      rw [shape] at args
+      obtain ⟨env1, head, _⟩ := matchArgs_cons_inv args
+      exact rootFmt_match_k data_program format lookup kind head
+    · cases format
+
+private theorem other_format {ctx : Ctx} {i fT tag : Nat} {fields : List V}
+    (slot : ctx.insts[i]? = some ⟨.data 152 tag fields,[],[],none⟩) {r : Rule}
+    (format : ruleFmt r = some fT) (lo : 2447 ≤ fT) (hi : fT < 2447+36) (different : fT ≠ 2447+tag)
+    {fuel : Nat} {st next : State × Array RuleId} {labels : List Label} {env : Isle.Interp.Env V}
+    (matched : (matchRule program (Stock.sem ctx) {} fuel r [.inst i,.labels labels]).run st =
+      .ok (some env,next)) : False := by
+  obtain ⟨info,fs,source,shape⟩ := branch_ruleFmt_match format lo hi matched
+  rw [slot] at source
+  cases source
+  simp only [V.data.injEq] at shape
+  omega
+
+/-- The `tbz` rule (3257) needs an `icmp` condition, which `PlainSource'` excludes. -/
+private theorem zero_test_absurd {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i c : Nat} {targets : V} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨.data 152 5 [.data 151 1 [],.value c,targets],[],[],none⟩)
+    (plain : PlainSource' ctx c)
+    {fuel : Nat} {before next : State × Array RuleId} {env : Isle.Interp.Env V}
+    (matched : (matchRule program (Stock.sem ctx) {} fuel rule_lower_3257 [.inst i,.labels labels]).run before =
+        .ok (some env,next)) : False := by
+  cases fuel with
+  | zero => rw [matchRule.eq_1] at matched; cases matched
+  | succ fuel =>
+    obtain ⟨env0,args,_⟩ := matchRule_some_inv matched
+    rw [stock_matchArgs] at args
+    have hp := data_program
+    isel_inv' hp [rule_lower_3257,slot] at args
+    obtain ⟨defined⟩ : Nonempty (ctx.defInst? c = some _) := ⟨‹_›⟩
+    obtain ⟨found⟩ : Nonempty (ctx.insts[_]? = some _) := ⟨‹_›⟩
+    obtain ⟨cl,clif,raw⟩ := ctxInv_clif inv.identityView defined found
+    obtain ⟨shape⟩ : Nonempty (V.data 152 14 _ = _) := ⟨‹_›⟩
+    rw [← shape] at raw
+    obtain ⟨cc,ty,a,b,rfl,_,_⟩ := instData_icmp_inv raw
+    exact plain.2 cc ty a b (Or.inl (by simp [Ctx.defClif?,defined,found,clif]))
+
+/-- **The actual first matching rule of a brif on a `PlainSource'` condition is ordinary brif
+(3231).** Other formats are excluded by the real terminator slot; an actual match of `tbnz`
+(3251) would be a one-bit test, and `tbz` (3257) needs a comparison. -/
+theorem plain_selected' {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i c : Nat} {targets : V} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨.data 152 5 [.data 151 1 [],.value c,targets],[],[],none⟩)
+    (plain : PlainSource' ctx c)
+    {before next : State} {out : V} {trace : List RuleId}
+    (selected : BranchSelection ctx i labels before out next trace) :
+    selected.rule = rule_lower_3231 := by
+  have member : selected.rule ∈ program.rulesOf T.lower_branch.id := by rw [selected.candidates]; simp
+  have bound := selected.fuelBound
+  rw [show T.lower_branch.id = 687 from rfl,data_program.r687] at member bound
+  simp only [List.length_cons,List.length_nil] at bound
+  simp only [List.mem_cons,List.not_mem_nil,or_false] at member
+  rcases member with root | root | root | root | root | root | root | root
+  all_goals try exact root
+  all_goals
+    have matched := selected.matchedRun
+    rw [root] at matched
+  · exact False.elim (other_format slot (fT := 2474) rfl (by decide) (by decide) (by decide) matched)
+  · exact False.elim (plain.1 (test_bit_metadata_of_match inv slot (by omega) matched))
+  · exact False.elim (zero_test_absurd inv slot plain matched)
+  · exact False.elim (other_format slot (fT := 2474) rfl (by decide) (by decide) (by decide) matched)
+  · exact False.elim (other_format slot (fT := 2475) rfl (by decide) (by decide) (by decide) matched)
+  · exact False.elim (other_format slot (fT := 2462) rfl (by decide) (by decide) (by decide) matched)
+  · exact False.elim (other_format slot (fT := 2451) rfl (by decide) (by decide) (by decide) matched)
+
+/-- `plain_named_calls` under `PlainSource'`: a real named branch on such a condition derives its
+ordinary helper-call packet and original condition provenance. -/
+theorem plain_named_calls' {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i c : Nat} {targets : V} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨.data 152 5 [.data 151 1 [],.value c,targets],[],[],none⟩)
+    (plain : PlainSource' ctx c)
+    {before next : State} {out : V} {trace : List RuleId}
+    (run : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels] before = .ok (some out,next,trace)) :
+    ∃ calls : ConditionalCalls.Calls ctx i labels before out next,calls.source = .value c := by
+  obtain ⟨selected⟩ := stock_named_branch_selection run
+  have root := plain_selected' inv slot plain selected
+  obtain ⟨calls⟩ := ConditionalCalls.selected_calls selected root
+  obtain ⟨info,targetData,found,data⟩ := calls.sourceData
+  rw [slot] at found
+  cases found
+  simp only [V.data.injEq,List.cons.injEq,and_true,true_and] at data
+  exact ⟨calls,data.1.symm⟩
+
+end Backend.Stock.Proof.PlainBranch
