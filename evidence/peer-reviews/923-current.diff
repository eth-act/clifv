+import FV.Backend.Proof.StockGeneralArgsLoopDomain2
+import FV.Backend.Proof.StockGeneralArgsLoopClass3
+
+/-! The loop class with plain `i8` conditions and block arguments satisfies the per-successor
+production domain (#140, CB-12).
+
+`StockGeneralArgsLoopDomain2` (CB-11) with the `GeneralArgsTerms` of `GeneralArgsLoopCfg3`. A
+branch entry establishes `GuardedScanRel` at the entry scan with the prelude of its condition
+(`branch_entry_prelude`): the CB-11 prelude for a condition of `GeneralArgsLoopCfg2`, and
+`narrow_entry_prelude` for a narrow condition, whose actual two-instruction emission (`tst` and
+`b.ne`) gives nonempty core code. A branch of any block composes by
+`returning/trapping_selected_general_cond_carry_below` on its `GeneralCondMetadata`
+(`branch_args_carry_returns/traps`). The induction on the source fuel over all nonentry original
+blocks (`general_args_loop_returns_below`, `general_args_loop_traps_below`) and the entry cases are
+those of CB-11. The result is `Scalar.DomainAt`. -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.PlainBranch
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The entry prelude of a branch on a plain `i8` condition: the actual two-instruction emission
+(`tst` and `b.ne`) derives nonempty core code. -/
+theorem narrow_entry_prelude {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} {isem : Backend.Proof.Sem}
+    {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b 0 0 c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (narrow : NarrowCondMetadata result.ctx c)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) (driver : DriverSem isem)
+    {F : BitVec 64 → Prop} {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w) :
+    ∃ ρ' w',Star (VStepAt result.code result.edgeArgs isem)
+      (.run ⟨0,0,entrySeed spec.core.scan.ctx fr,w⟩)
+      (.run ⟨0,spec.preludeCode.size,ρ',w'⟩) ∧
+      GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR
+        spec.core.scan.output.state (0,fr,cm) ρ' w' ∧
+      ValuesHeld (fun _ => True) spec.core.scan.ctx fr
+        (fun key => ρ' (aliasNum result.final.alias key)) ∧ SameWorld F w' w := by
+  have block : f.blocks[0]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  have count := spec.narrow8_emission_size run scope block termShape narrow.1 narrow.2
+  have nonempty : 0 < spec.core.code.size := by
+    rw [spec.bodyCode]
+    simp only [Array.size_append,count]
+    omega
+  let entry : Control.EntryCoreSpec f result b := {
+    ranges := spec.ranges
+    params := spec.params
+    core := spec.core
+    raw := spec.raw
+    preludeCode := spec.preludeCode
+    build := spec.build
+    sizes := spec.sizes
+    assembled := spec.assembled
+    events := spec.events
+    block := block
+    rawCode := spec.rawCode
+    placed := spec.placed
+    nonempty := nonempty }
+  exact Control.original_entry_prelude run scope dominated entry entered driver memorySem stable memory arguments
+
+end Backend.Stock.Proof.ConditionalValues
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg3
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+  Backend.Stock.Proof.ForwardSource Backend.Stock.Proof.LoopCarry Backend.Stock.Proof.ParameterCfg
+  Backend.Stock.Proof.ParameterLoopCfg Backend.Stock.Proof.ComparisonLoopCfg
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The entry prelude of a branch on a condition of the class. -/
+theorem branch_entry_prelude {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} {isem : Backend.Proof.Sem}
+    {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b 0 0 c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondition f c)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) (driver : DriverSem isem)
+    {F : BitVec 64 → Prop} {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w) :
+    ∃ ρ' w',Star (VStepAt result.code result.edgeArgs isem)
+      (.run ⟨0,0,entrySeed spec.core.scan.ctx fr,w⟩)
+      (.run ⟨0,spec.preludeCode.size,ρ',w'⟩) ∧
+      GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR
+        spec.core.scan.output.state (0,fr,cm) ρ' w' ∧
+      ValuesHeld (fun _ => True) spec.core.scan.ctx fr
+        (fun key => ρ' (aliasNum result.final.alias key)) ∧ SameWorld F w' w := by
+  rcases condition with wide | narrow
+  · exact GeneralArgsLoopCfg2.branch_entry_prelude run scope dominated spec termShape wide
+      entered driver memorySem stable memory arguments
+  · exact narrow_entry_prelude run scope dominated spec termShape (narrow.metadata scope dominated spec.build)
+      entered driver memorySem stable memory arguments
+
+/-- A branch of the class, with any block arguments, entry or not, for returns. -/
+theorem branch_args_carry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program} {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (term : b.term = .brif c yes no) (condition : GeneralCondition f c)
+    {fuel : Nat}
+    (continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+      result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+      next ∈ result.blockScans.toList → next.block = tl →
+      CarryReturnsBelow f result targetLabel tl targetBlock next isem MR env cp fuel)
+    {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx bi 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (defCarry f result bi)
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ w) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,w⟩ (.returned vals cm) :=
+  spec.returning_selected_general_cond_carry_below run scope dominated family refines driver stable
+    tag term (condition_metadata condition scope dominated spec.build)
+    (fun x kept => by rw [spec.atBlock]; exact defCarry_available x kept)
+    (conditional_carry_successors run scope dominated spec tag continued)
+    callers remaining atTerm (by simpa only [spec.atBlock] using defined) returned held
+
+/-- A branch of the class, with any block arguments, entry or not, for first traps. -/
+theorem branch_args_carry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program} {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (term : b.term = .brif c yes no) (condition : GeneralCondition f c)
+    {fuel : Nat}
+    (continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+      result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+      next ∈ result.blockScans.toList → next.block = tl →
+      CarryTrapsBelow f result targetLabel tl targetBlock next isem MR env cp fuel)
+    {s : Clif.State} {code : Clif.TrapCode} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx bi 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (defCarry f result bi)
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ w) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,w⟩ (.trapped code) :=
+  spec.trapping_selected_general_cond_carry_below run scope dominated family refines driver stable
+    tag term (condition_metadata condition scope dominated spec.build)
+    (fun x kept => by rw [spec.atBlock]; exact defCarry_available x kept)
+    (conditional_carry_trap_successors run scope dominated spec tag continued)
+    callers remaining atTerm (by simpa only [spec.atBlock] using defined) trapped held
+
+/-- **Loop returns below every fuel bound, with block arguments on branches on any condition of
+the class.** By strong induction on the bound, every nonentry original block returns as its
+machine code from `CarryRel` of its definition carry. No rank or forward premise is used. -/
+theorem general_args_loop_returns_below {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    (env : Clif.Env) (cp : Clif.Program) (bound : Nat) :
+    ∀ {label bi : Nat} {b : Clif.Block} {event : BlockScanEvent},
+      result.order.nodes[label]? = some (.original bi) → f.blocks[bi]? = some b → bi ≠ 0 →
+      event ∈ result.blockScans.toList → event.block = bi →
+      CarryReturnsBelow f result label bi b event isem MR env cp bound := by
+  induction bound using Nat.strongRecOn with
+  | ind bound ih =>
+    intro label bi b event tag block nonentry member atBlock
+    intro fuel lt s vals cm ρ w func callers remaining atTerm defined returned held
+    have continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+        result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+        next ∈ result.blockScans.toList → next.block = tl →
+        CarryReturnsBelow f result targetLabel tl targetBlock next isem MR env cp fuel :=
+      fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+        ih fuel lt targetTag targetSource targetNonentry nextEvent nextBlock
+    rcases terms bi b block with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨leafCode,trap⟩
+    · obtain ⟨spec⟩ := Control.stock_lower_jump_body_spec run scope dominated family tag block jump
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := jump_carry_returns run scope dominated family refines driver stable spec tag jump
+        continued callers remaining atTerm defined returned held
+      simpa only [jump_nonentry_prelude spec nonentry] using finished
+    · obtain ⟨spec⟩ := CfgReturn.stock_lower_return_block_spec run scope dominated abi family tag block ret
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := CfgReturnAt.return_block_returns_at run scope dominated abi family ret refines driver
+        stable spec func callers remaining atTerm (by simpa only [spec.atBlock] using defined) returned held.1
+      simpa only [spec.noPrelude nonentry] using finished
+    · obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag block term
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := branch_args_carry_returns run scope dominated family refines driver stable spec
+        tag term condition continued callers remaining atTerm defined returned held
+      simpa only [conditional_nonentry_prelude spec nonentry] using finished
+    · exact absurd returned (TrapBody.trap_source_noreturn (local_family family block) (j := 0)
+        (by simpa using remaining) (atTerm.trans trap))
+
+/-- **Loop first traps below every fuel bound, with block arguments on branches on any condition
+of the class**, by strong induction on the bound over every nonentry original block. -/
+theorem general_args_loop_traps_below {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    (env : Clif.Env) (cp : Clif.Program) (bound : Nat) :
+    ∀ {label bi : Nat} {b : Clif.Block} {event : BlockScanEvent},
+      result.order.nodes[label]? = some (.original bi) → f.blocks[bi]? = some b → bi ≠ 0 →
+      event ∈ result.blockScans.toList → event.block = bi →
+      CarryTrapsBelow f result label bi b event isem MR env cp bound := by
+  induction bound using Nat.strongRecOn with
+  | ind bound ih =>
+    intro label bi b event tag block nonentry member atBlock
+    intro fuel lt s code ρ w func callers remaining atTerm defined trapped held
+    have continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+        result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+        next ∈ result.blockScans.toList → next.block = tl →
+        CarryTrapsBelow f result targetLabel tl targetBlock next isem MR env cp fuel :=
+      fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+        ih fuel lt targetTag targetSource targetNonentry nextEvent nextBlock
+    rcases terms bi b block with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨leafCode,trap⟩
+    · obtain ⟨spec⟩ := Control.stock_lower_jump_body_spec run scope dominated family tag block jump
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := jump_carry_traps run scope dominated family refines driver stable spec tag jump
+        continued callers remaining atTerm defined trapped held
+      simpa only [jump_nonentry_prelude spec nonentry] using finished
+    · obtain ⟨spec⟩ := CfgReturn.stock_lower_return_block_spec run scope dominated abi family tag block ret
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := CfgReturnAt.return_block_traps_at run scope dominated family ret refines driver
+        stable spec callers remaining atTerm trapped held.1
+      simpa only [spec.noPrelude nonentry] using finished
+    · obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag block term
+        refines driver stable env cp
+      have same : spec.core.scan = event :=
+        CfgTrace.actual_scan_unique run scope spec.events member (spec.atBlock.trans atBlock.symm)
+      subst same
+      have finished := branch_args_carry_traps run scope dominated family refines driver stable spec
+        tag term condition continued callers remaining atTerm defined trapped held
+      simpa only [conditional_nonentry_prelude spec nonentry] using finished
+    · obtain ⟨leaf,raw,preludeCode,events,leafBlock,rawCode,noPrelude,placed⟩ :=
+        ConditionalValues.stock_lower_trap_block_code run tag block trap
+      have same : leaf = event := CfgTrace.actual_scan_unique run scope events member (leafBlock.trans atBlock.symm)
+      subst same
+      have finished := ConditionalValues.trap_block_traps_at run scope dominated family block trap
+        refines driver stable events leafBlock rawCode placed remaining atTerm trapped held.1
+      simpa only [noPrelude nonentry] using finished
+
+/-- Instruction-zero ABI return simulation of a function of the class whose entry jumps. -/
+theorem general_args_loop_jump_entry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {bc : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (jump : entry.term = .jump bc)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {vals : List Clif.Val} {outMem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals outMem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.returned vals outMem) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := Control.stock_lower_jump_body_spec run scope dominated family tag source jump
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := Control.jump_entry_prelude run scope dominated spec
+    entered driver memorySem stable memory arguments
+  have finished := jump_carry_returns run scope dominated family refines driver stable spec tag jump
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_returns_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    returned (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI first-trap simulation of a function of the class whose entry jumps. -/
+theorem general_args_loop_jump_entry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {bc : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (jump : entry.term = .jump bc)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.trapped code) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := Control.stock_lower_jump_body_spec run scope dominated family tag source jump
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := Control.jump_entry_prelude run scope dominated spec
+    entered driver memorySem stable memory arguments
+  have finished := jump_carry_traps run scope dominated family refines driver stable spec tag jump
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_traps_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    trapped (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI return simulation of a function of the class whose entry branches on a
+condition of the class, with any block arguments. -/
+theorem general_args_loop_branch_entry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (term : entry.term = .brif c yes no) (condition : GeneralCondition f c)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {vals : List Clif.Val} {outMem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals outMem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.returned vals outMem) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := branch_entry_prelude run scope dominated spec
+    term condition entered driver memorySem stable memory arguments
+  have finished := branch_args_carry_returns run scope dominated family refines driver stable spec tag
+    term condition
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_returns_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    returned (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- Instruction-zero ABI first-trap simulation of a function of the class whose entry branches
+on a condition of the class, with any block arguments. -/
+theorem general_args_loop_branch_entry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) (terms : GeneralArgsTerms f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {entry : Clif.Block} {c : Nat} {yes no : Clif.BlockCall} (source : f.blocks[0]? = some entry)
+    (term : entry.term = .brif c yes no) (condition : GeneralCondition f c)
+    {env : Clif.Env} {cp : Clif.Program} {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr) {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w0 : Arm.ArmState} (memory : MR fr.slots cm w0) (arguments : ArgsAtEntry F f.sig args w0) :
+    ∃ ρ0,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ0,w0⟩ (.trapped code) := by
+  have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term
+    refines driver stable env cp
+  obtain ⟨_,remaining,atTerm⟩ := entry_frame_parts source entered
+  obtain ⟨ρentry,wentry,path,guarded,allValues,sameWorld⟩ := branch_entry_prelude run scope dominated spec
+    term condition entered driver memorySem stable memory arguments
+  have finished := branch_args_carry_traps run scope dominated family refines driver stable spec tag
+    term condition
+    (fun targetTag targetSource targetNonentry nextEvent nextBlock =>
+      general_args_loop_traps_below run scope dominated abi terms family refines driver stable env cp fuel
+        targetTag targetSource targetNonentry nextEvent nextBlock)
+    (s := ⟨fr,[],cm⟩) rfl remaining atTerm (Control.source_defined_entry_frame dominated result.ctx entered)
+    trapped (entry_carry source guarded)
+  exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+/-- **The loop class with plain `i8` conditions and block arguments satisfies the per-successor
+production domain.** Every block jumps (with any arguments), returns, branches with any arguments
+on a condition of `GeneralArgsLoopCfg2` or on a narrow condition (`NarrowCondition`: an `i8`
+parameter, or an `i8` result of a statement that is not an `icmp`, a `band` or a `uextend`), or,
+outside the entry, ends in `trap`. No rank: targets may be loop headers, and back edges and self
+loops are allowed, also when a branch passes block arguments on them. -/
+theorem domainAt_of_general_args_loop_cfg {f : Clif.Function}
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false)
+    (terms : GeneralArgsTerms f)
+    (entryKind : ∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) : Scalar.DomainAt f := by
+  have entry : ∃ (b : Clif.Block),f.blocks[0]? = some b := by
+    cases blocks : f.blocks with
+    | nil => exact False.elim (scope.nonempty blocks)
+    | cons b rest => exact ⟨b,by simp only [List.getElem?_cons_zero]⟩
+  obtain ⟨b,source⟩ := entry
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    rcases terms 0 b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨leafCode,trap⟩
+    · exact general_args_loop_jump_entry_returns run scope dominated abi terms family source jump
+        entered returned refines driver memorySem stable memory arguments
+    · exact parameter_return_entry_frame run scope dominated abi family source ret
+        entered returned refines driver memorySem stable memory arguments
+    · exact general_args_loop_branch_entry_returns run scope dominated abi terms family
+        source term condition entered returned refines driver memorySem stable memory arguments
+    · exact False.elim (entryKind b source leafCode trap)
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    rcases terms 0 b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,condition⟩ | ⟨leafCode,trap⟩
+    · exact general_args_loop_jump_entry_traps run scope dominated abi terms family source jump
+        entered trapped refines driver memorySem stable memory arguments
+    · exact parameter_return_entry_trap_frame run scope dominated abi family source ret
+        entered trapped refines driver memorySem stable memory arguments
+    · exact general_args_loop_branch_entry_traps run scope dominated abi terms family
+        source term condition entered trapped refines driver memorySem stable memory arguments
+    · exact False.elim (entryKind b source leafCode trap)
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg3
diff --git a/FV/Backend/Proof/StockGeneralLoopCheck3.lean b/FV/Backend/Proof/StockGeneralLoopCheck3.lean
new file mode 100644
index 000000000..2812cd611
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopCheck3.lean
@@ -0,0 +1,83 @@
+import FV.Backend.Proof.StockGeneralLoopCheck2
+import FV.Backend.Proof.StockGeneralLoopDomain3
+
+/-! The selectors and checkers of the two loop classes with plain `i8` conditions are sound
+(#140, CB-12).
+
+`GeneralArgsLoopCfg3.sourceOk` derives the facts of `domainAt_of_general_args_loop_cfg`
+(`source_leaf_eligible_facts`), and its checker accepts the edge split of the actual lowering, so
+it derives the code domain of the published split code, as `GeneralArgsLoopCfg2.check_sound`.
+`GeneralLoopCfg3.sourceOk` derives the facts of `domain_of_general_loop_cfg`, and its checker
+accepts the unsplit code of the actual lowering, as `GeneralLoopCfg2.check_sound`. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg3
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original input conditions and the split selector derive the per-successor production
+domain. -/
+theorem domainAt_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.DomainAt f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg3.domainAt_of_general_args_loop_cfg scope dominated abi
+    (GeneralArgsLoopCfg2.ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The split selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.DomainAt f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domainAt_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The split checker is sound.** The executable check derives the code domain of the published
+split code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    Scalar.CodeDomain f vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run] at lowered
+    cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+    | error message => simp [splitRun] at lowered
+    | ok split =>
+      simp only [splitRun,decide_eq_true_eq] at lowered
+      subst vc
+      exact (source_ok_sound source).code run splitRun
+
+end Backend.Stock.GeneralArgsLoopCfg3
+
+namespace Backend.Stock.GeneralLoopCfg3
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original input conditions and the legacy selector derive the unchanged production domain. -/
+theorem domain_of_source_leaf_eligible {f : Clif.Function} (checked : sourceLeafEligible f = true)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true) : Scalar.Domain f := by
+  obtain ⟨terms,entryKind,family,params,returns⟩ := source_leaf_eligible_facts checked
+  exact Proof.GeneralArgsLoopCfg3.domain_of_general_loop_cfg scope dominated abi
+    (GeneralArgsLoopCfg2.ordinary_of_narrow params returns) terms entryKind family
+
+/-- **The legacy selector is sound.** -/
+theorem source_ok_sound {f : Clif.Function} (checked : sourceOk f = true) : Scalar.Domain f := by
+  simp only [sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨eligible,scope⟩,dominated⟩,abi⟩ := checked
+  exact domain_of_source_leaf_eligible eligible (lowerScope_of scope) (dominated_of dominated) abi
+
+/-- **The legacy checker is sound.** The executable check derives the unchanged production domain
+of the published unsplit code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    ∃ result,Scalar.Domain f ∧ Stock.lower f = .ok result ∧ result.code = vc := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error message => simp [run] at lowered
+  | ok result =>
+    simp only [run,decide_eq_true_eq] at lowered
+    exact ⟨result,source_ok_sound source,rfl,lowered⟩
+
+end Backend.Stock.GeneralLoopCfg3
diff --git a/FV/Backend/Proof/StockGeneralLoopDomain3.lean b/FV/Backend/Proof/StockGeneralLoopDomain3.lean
new file mode 100644
index 000000000..839753630
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopDomain3.lean
@@ -0,0 +1,181 @@
+import FV.Backend.Proof.StockGeneralLoopDomain2
+import FV.Backend.Proof.StockGeneralArgsLoopDomain3
+
+/-! The legacy loop class with plain `i8` conditions satisfies the unchanged production domain
+(#140, CB-12).
+
+The CB-11 transport (`StockGeneralLoopDomain2`) with the condition `GeneralCondition` of
+`GeneralArgsLoopCfg3`. A branch on a condition of the class has two successors in the actual block
+order: its named call packet (`general_cond_branch_calls`) names them (`branch_target_count`). Its
+arguments are empty, so its original and critical-edge vectors are empty, and the actual code keeps
+exact per-edge/single-vector agreement (`general_loop_legacy_compatible`). The class is the split
+class `GeneralArgsLoopCfg3` with empty `brif` arguments (`GeneralTerms.args`), so its returns and
+first traps hold over the actual per-successor vectors (`domainAt_of_general_args_loop_cfg`), and
+`RunOkABIAt.legacyCompatible` and `EdgeLegacyCompatible.star` transport them to the legacy
+observations of the unsplit code (`domain_of_general_loop_cfg`, `Scalar.Domain`). -/
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg3
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+  Backend.Stock.Proof.ForwardSource Backend.Stock.Proof.ParameterCfg
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem selected_empty {b : Clif.Block} {c index id : Nat} {yes no : Clif.BlockCall} {args : List Clif.TryArg}
+    (term : b.term = .brif c yes no) (yesEmpty : yes.args = []) (noEmpty : no.args = [])
+    (selected : (destinations b.term)[index]? = some (id,args)) :
+    ∃ bc,(dests b.term)[index]? = some bc ∧ bc.args = [] := by
+  cases index with
+  | zero => exact ⟨yes,by simp [term,dests],yesEmpty⟩
+  | succ index =>
+    cases index with
+    | zero => exact ⟨no,by simp [term,dests],noEmpty⟩
+    | succ index => simp [term,destinations] at selected
+
+private theorem assembled_arguments {ctx : Ctx} {f : Clif.Function} {b : Clif.Block}
+    {bi label : Nat} {targets : Array Nat} {outgoing : Array (Array Reg)}
+    {params : List Nat} {uses : Array UseState} {code : Array MInst} {block : VBlock}
+    (run : assembleOriginalBlock ctx f b bi label targets outgoing params uses code = .ok block) :
+    block.branchArgs = (if targets.size == 1 then outgoing[0]! else #[]) := by
+  unfold assembleOriginalBlock at run
+  dsimp only at run
+  repeat' first
+    | (solve | cases run)
+    | simp only [bind,Except.bind,pure,Except.pure] at run
+    | split at run
+  all_goals cases run; simp_all
+
+/-- A branch on a condition of the class has two successors in the actual block order. -/
+theorem branch_target_count {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (term : b.term = .brif c yes no) (condition : GeneralCondition f c) :
+    result.order.successors[label]!.size = 2 := by
+  obtain ⟨calls⟩ := spec.general_cond_branch_calls run scope term (condition_metadata condition scope dominated spec.build)
+  have size := congrArg List.length calls.labels_eq
+  simpa only [Array.length_toList,List.length_cons,List.length_nil] using size
+
+/-- **The legacy loop class with plain `i8` conditions keeps exact per-edge/single-vector
+agreement** of the actual code: jumps carry their arguments, branches carry none, and returns and
+traps have no outgoing edge. -/
+theorem general_loop_legacy_compatible {f : Clif.Function} {result : Result}
+    (terms : GeneralTerms f) (run : Stock.lower f = .ok result)
+    (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR) (env : Clif.Env) (cp : Clif.Program) :
+    EdgeLegacyCompatible result.code result.edgeArgs := by
+  have built : ∃ ranges,Stock.buildCtx f = .ok (result.ctx,ranges,result.initial) := by
+    unfold Stock.lower at run
+    dsimp only at run
+    repeat' first
+      | (solve | cases run)
+      | simp only [bind,Except.bind,pure,Except.pure] at run
+      | split at run
+    cases run
+    exact ⟨_,by assumption⟩
+  obtain ⟨ranges,build⟩ := built
+  have inv := buildCtx_mappedInv scope build
+  obtain ⟨ps,cfg⟩ := stock_lower_computed_cfg run scope
+  have sizes := (stock_lower_graph_bounds run).1
+  have nodes : result.code.blocks.size = result.order.nodes.size :=
+    (stock_prepare_dimensions run).1.symm.trans (stock_prepare_dimensions run).2.1
+  intro label index target selected
+  simp only [succOf,cfg] at selected
+  cases row : result.order.successors[label]? with
+  | none => simp only [row,Option.bind_none] at selected; cases selected
+  | some ss =>
+    simp only [row,Option.bind_some] at selected
+    have labelBound : label < result.order.nodes.size := by
+      have bound := (Array.getElem?_eq_some_iff.mp row).1
+      omega
+    cases tag : result.order.nodes[label]? with
+    | none => have absent := Array.getElem?_eq_none_iff.mp tag; omega
+    | some node =>
+      cases node with
+      | original bi =>
+        obtain ⟨b,id,args,ti,source,destination,found,targetNode⟩ := stock_lower_indexed_successor_origin run tag row selected
+        rcases terms bi b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ | ⟨leafCode,trap⟩
+        · have only : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [jump,destinations] at destination
+          subst index
+          obtain ⟨tl,targetLabel,identified,nonentry,successors,targetTag⟩ := CriticalOwners.jump_successor run scope tag source jump
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have sameTarget : targetLabel = target := by simpa [sameRow] using selected
+          subst targetLabel
+          have successorsBang : result.order.successors[label]! = #[target] := by simp only [getElem!_def,successors,Option.getD_some]
+          obtain ⟨vb,placed,labelled,arguments⟩ := stock_lower_original_jump_args run scope tag source jump successorsBang targetTag
+          have vector := stock_lower_selected_outgoing run scope tag source (bc := bc) (index := 0)
+            (by simp [jump,dests]) (by simpa only [getElem!_def,row,Option.getD_some] using selected) targetTag
+          exact ⟨vb,placed,by simpa only [outgoingAt,arguments] using vector⟩
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated family tag source term refines driver stable env cp
+          have targetCount := branch_target_count run scope dominated spec term condition
+          have rawArgs : spec.raw.branchArgs = #[] := by
+            have args := assembled_arguments spec.assembled
+            simpa only [targetCount,show (2 == 1) = false from rfl,Bool.false_eq_true,ite_false] using args
+          obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          have successor : result.order.successors[label]![index]? = some target := by
+            simpa only [getElem!_def,row,Option.getD_some] using selected
+          have vector : outgoingAt result label index = some #[] := by
+            rcases targetNode with original | synthetic
+            · have actual := stock_lower_selected_outgoing run scope tag source selectedBc successor original
+              simpa only [edgeArgumentNumbers,empty,List.map_nil] using actual
+            · exact stock_lower_deferred_outgoing run tag successor synthetic
+          refine ⟨_,spec.placed,?_⟩
+          simpa only [outgoingAt,rawArgs,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+      | edge pred k ti =>
+        obtain ⟨b,id,args,source,destination,found⟩ := stock_lower_critical_source run tag
+        rcases terms pred b source with ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c,yes,no,term,yesEmpty,noEmpty,condition⟩ | ⟨leafCode,trap⟩
+        · exact False.elim (CriticalOwners.jump_no_edge (stock_lower_order run) source jump k ti
+            (Array.mem_toList_iff.mpr (Array.mem_of_getElem? tag)))
+        · simp only [ret,destinations,List.getElem?_nil] at destination; cases destination
+        · obtain ⟨bc,selectedBc,empty⟩ := selected_empty term yesEmpty noEmpty destination
+          obtain ⟨input,next,registers,targetLabel,call,successors,targetTag,placed⟩ := stock_lower_critical_code run tag
+          have sameRow : ss = #[targetLabel] := Option.some.inj (row.symm.trans successors)
+          have zero : index = 0 := by
+            cases index with
+            | zero => rfl
+            | succ index => simp [sameRow] at selected
+          subst index
+          have mapping := stock_branchArgs_selected_mapping inv.func source selectedBc call
+          have noRegisters : registers = #[] := by
+            rw [empty] at mapping
+            simp only [List.mapM_nil,Option.pure_def,Option.some.injEq] at mapping
+            exact Array.toList_inj.mp mapping.symm
+          have vector := stock_lower_critical_argument_vector run scope tag source selectedBc
+          refine ⟨_,placed,?_⟩
+          simpa only [outgoingAt,edgeArgumentNumbers,empty,List.map_nil,noRegisters,Array.map_empty] using vector
+        · simp only [trap,destinations,List.getElem?_nil] at destination; cases destination
+
+/-- **The legacy loop class with plain `i8` conditions satisfies the unchanged production
+domain.** Every block jumps (with any arguments), returns, branches with empty arguments on a
+condition of `GeneralArgsLoopCfg2` or on a narrow condition (`NarrowCondition`: an `i8` parameter,
+or an `i8` result of a statement that is not an `icmp`, a `band` or a `uextend`), or, outside the
+entry, ends in `trap`. No rank: jump and branch targets may be loop headers. -/
+theorem domain_of_general_loop_cfg {f : Clif.Function}
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false)
+    (terms : GeneralTerms f)
+    (entryKind : ∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) : Scalar.Domain f := by
+  have domainAt := domainAt_of_general_args_loop_cfg scope dominated abi ordinary terms.args entryKind family
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,simulation⟩ := domainAt.returns run entered returned refines driver memorySem stable memory arguments
+    exact ⟨ρ,simulation.legacyCompatible compatible⟩
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have compatible := general_loop_legacy_compatible terms run scope dominated family refines driver stable env cp
+    obtain ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',path,tail⟩ :=
+      domainAt.traps run entered trapped refines driver memorySem stable memory arguments
+    exact ⟨ρ,b,k,ρ',w,vb,i,ops,outs,w',compatible.star path,tail⟩
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg3
diff --git a/FV/Backend/Proof/StockGeneralLoopWitness3.lean b/FV/Backend/Proof/StockGeneralLoopWitness3.lean
new file mode 100644
index 000000000..a156b79bd
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralLoopWitness3.lean
@@ -0,0 +1,134 @@
+import FV.Clif.Parse
+import FV.Backend.Proof.StockGeneralLoopCheck3
+import FV.Backend.Proof.StockGeneralSubsumption3
+
+/-! Non-vacuity of the legacy loop class with plain `i8` conditions (#140, CB-12) on a loop whose
+header branches on a computed `i8` value and whose branch passes no block arguments:
+
+```
+function %countdown_narrow(i8) -> i8 {
+block0(v0: i8):
+    jump block1(v0)
+
+block1(v1: i8):
+    v2 = iconst.i8 -1
+    v3 = iadd v1, v2
+    brif v3, block2, block3
+
+block2:
+    jump block1(v3)
+
+block3:
+    return v1
+}
+```
+
+The header `block1` counts down until `v1 - 1 = 0`. Its condition is the computed `i8` value `v3`
+itself: the lowering is `add w, w, #255`, `tst w, #0xff` and `b.ne` (`lower_brif` 3231,
+`is_nonzero` 4988). The back edge `block2 → block1` is a jump with an argument. The CB-11 legacy
+class `GeneralLoopCfg2` and the CB-11 split class `GeneralArgsLoopCfg2` reject the function
+(`earlier_classes_reject`): an `i8` value is not one of their conditions. The new selector accepts
+it, and the checker accepts the actual unsplit code, whose per-edge vectors agree with the legacy
+branch arguments.
+
+The source run from `3` takes the back edge twice and returns `1` with fuel `13`. -/
+
+namespace Backend.Stock.GeneralLoopCfg3.Fixture
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- The text of `%countdown_narrow`. -/
+def countdownSource : String := "function %countdown_narrow(i8) -> i8 {
+block0(v0: i8):
+    jump block1(v0)
+
+block1(v1: i8):
+    v2 = iconst.i8 -1
+    v3 = iadd v1, v2
+    brif v3, block2, block3
+
+block2:
+    jump block1(v3)
+
+block3:
+    return v1
+}
+"
+
+/-- `%countdown_narrow` as a `Clif.Function` literal. -/
+def countdownNarrow : Clif.Function := {
+  name := "countdown_narrow"
+  sig := { params := [⟨.i8,.none,.normal⟩], returns := [⟨.i8,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i8)], body := [], term := .jump ⟨1,[0]⟩ },
+    { id := 1, params := [(1,.i8)],
+      body := [⟨[2],.iconst .i8 (-1)⟩,⟨[3],.binary .iadd .i8 1 2⟩],
+      term := .brif 3 ⟨2,[]⟩ ⟨3,[]⟩ },
+    { id := 2, params := [], body := [], term := .jump ⟨1,[3]⟩ },
+    { id := 3, params := [], body := [], term := .ret [1] }] }
+
+/-- The CB-11 legacy and split classes reject `%countdown_narrow`; its condition is a narrow
+condition of the CB-12 classes. -/
+theorem earlier_classes_reject :
+    GeneralLoopCfg2.sourceOk countdownNarrow = false ∧
+    GeneralArgsLoopCfg2.sourceOk countdownNarrow = false ∧
+    GeneralArgsLoopCfg3.narrowEligible countdownNarrow 3 = true := by
+  decide
+
+/-- The source outcome from the entry with fuel `fuel`, for the argument `start`. -/
+def sourceOutcome (fuel : Nat) (start : BitVec 8) : Option Clif.Outcome :=
+  match Clif.enterFunc countdownNarrow [⟨.i8,start⟩] Clif.Mem.empty with
+  | .ok (fr,cm) => some (Clif.runLoop Clif.Env.empty {funcs := []} fuel ⟨fr,[],cm⟩)
+  | _ => none
+
+private def checks : Bool :=
+  decide ((Clif.parseFile countdownSource).funcs.map (·.func.toOption) = [some countdownNarrow]) &&
+  (match sourceOutcome 13 3 with | some (.returned vals _) => decide (vals = [⟨.i8,1⟩]) | _ => false) &&
+  match Stock.lower countdownNarrow with
+  | .error _ => false
+  | .ok result => edgeLegacyCompatibleB result.code result.edgeArgs && check countdownNarrow result.code
+
+-- witness: native_decide (the fixed function's parse, source run, lowering, compatibility check and checker only)
+private theorem checks_true : checks = true := by native_decide
+
+/-- **`%countdown_narrow` is in the checked legacy loop class with plain `i8` conditions.** The
+literal is the parse of the text; the source run from `3` returns `1`; its actual unsplit lowering
+keeps the legacy per-edge vectors and passes the checker, which derives `Scalar.Domain`; and the
+CB-11 legacy checker rejects it (`earlier_classes_reject`). -/
+theorem countdown_narrow_witness :
+    (Clif.parseFile countdownSource).funcs.map (·.func.toOption) = [some countdownNarrow] ∧
+    Scalar.Domain countdownNarrow ∧
+    (∃ mem,sourceOutcome 13 3 = some (.returned [⟨.i8,1⟩] mem)) ∧
+    ∃ result,Stock.lower countdownNarrow = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = true ∧ check countdownNarrow result.code = true ∧
+      GeneralLoopCfg2.check countdownNarrow result.code = false := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨parsed,returns⟩,lowered⟩ := h
+  refine ⟨of_decide_eq_true parsed,?_,?_,?_⟩
+  · cases run : Stock.lower countdownNarrow with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      obtain ⟨result',domain,_,_⟩ := check_sound lowered.2
+      exact domain
+  · cases outcome : sourceOutcome 13 3 with
+    | none => rw [outcome] at returns; cases returns
+    | some o =>
+      rw [outcome] at returns
+      cases o with
+      | returned vals mem =>
+        simp only [decide_eq_true_eq] at returns
+        exact ⟨mem,by rw [returns]⟩
+      | _ => cases returns
+  · cases run : Stock.lower countdownNarrow with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run] at lowered
+      simp only [Bool.and_eq_true] at lowered
+      refine ⟨result,rfl,lowered.1,lowered.2,?_⟩
+      simp [GeneralLoopCfg2.check,earlier_classes_reject.1]
+
+end Backend.Stock.GeneralLoopCfg3.Fixture
diff --git a/FV/Backend/Proof/StockGeneralSubsumption3.lean b/FV/Backend/Proof/StockGeneralSubsumption3.lean
new file mode 100644
index 000000000..d6d43cde8
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralSubsumption3.lean
@@ -0,0 +1,184 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg3
+
+/-! Subsumption of the CB-11 classes by the two classes of CB-12 (#140).
+
+The legacy class `GeneralLoopCfg3` accepts every function of the legacy class `GeneralLoopCfg2`
+(CB-11), and the split class `GeneralArgsLoopCfg3` accepts every function of the split class
+`GeneralArgsLoopCfg2` (CB-11) and of `GeneralLoopCfg3`. The legacy checkers publish the unsplit
+code of the actual Stock lowering and the split checkers its edge split, so the subsumption also
+holds for the checkers. With the CB-11 subsumption lemmas (`StockGeneralSubsumption2`), every
+earlier legacy loop and branch class is in `GeneralLoopCfg3`, and every earlier split class is in
+`GeneralArgsLoopCfg3`.
+
+All proofs are Boolean reasoning over the `all`/`any` structure of the selectors. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg3
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- The conditions of `GeneralArgsLoopCfg2` are conditions of the class. -/
+theorem condition_of_general_args {f : Clif.Function} {b : Clif.Block} {c : Nat}
+    (computed : GeneralArgsLoopCfg2.conditionEligible f b c = true) :
+    conditionEligible f b c = true := by
+  simp only [conditionEligible,computed,Bool.true_or]
+
+/-- A narrow condition is a condition of the class. -/
+theorem condition_of_narrow {f : Clif.Function} {b : Clif.Block} {c : Nat}
+    (plain : narrowEligible f c = true) : conditionEligible f b c = true := by
+  simp only [conditionEligible,plain,Bool.or_true]
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **`GeneralArgsLoopCfg2` (CB-11) is in the class at the selector level.** -/
+theorem source_leaf_eligible_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg2.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralArgsLoopCfg2.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralArgsLoopCfg2.controlLeafEligible,GeneralArgsLoopCfg2.controlEligible,
+      Bool.and_eq_true] at old
+    obtain ⟨⟨condition,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,condition_of_general_args condition,yesNonentry,noNonentry,
+      Bool.and_self]
+  all_goals
+    simp only [GeneralArgsLoopCfg2.controlLeafEligible,GeneralArgsLoopCfg2.controlEligible] at old
+    cases old
+
+/-- **`GeneralArgsLoopCfg2` (CB-11) is in the class.** -/
+theorem source_ok_of_general_args_loop {f : Clif.Function}
+    (checked : GeneralArgsLoopCfg2.sourceOk f = true) : sourceOk f = true := by
+  simp only [GeneralArgsLoopCfg2.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_args_loop leaf) scope dominated abi
+
+/-- **The legacy class `GeneralLoopCfg3` is in the class at the selector level**: it is this class
+with empty `brif` arguments. -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg3.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg3.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg3.controlLeafEligible,GeneralLoopCfg3.controlEligible,Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,_⟩,_⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,condition,yesNonentry,noNonentry,Bool.and_self]
+  all_goals
+    simp only [GeneralLoopCfg3.controlLeafEligible,GeneralLoopCfg3.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg3` is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg3.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg3.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-! ### Split checkers -/
+
+private theorem check_of_source {f : Clif.Function} {vc : VCode} (source : sourceOk f = true)
+    (lowered : (match Stock.lower f with
+      | .error _ => false
+      | .ok result => match splitEdgesChecked result.code result.edgeArgs with
+        | .ok split => decide (split.code = vc)
+        | .error _ => false) = true) :
+    check f vc = true := by
+  simp only [check,source,Bool.true_and]
+  exact lowered
+
+/-- **The checker of `GeneralArgsLoopCfg2` (CB-11) is in the checker of the class**: both
+publish the edge split of the actual Stock lowering. -/
+theorem check_of_general_args_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralArgsLoopCfg2.check f vc = true) : check f vc = true := by
+  simp only [GeneralArgsLoopCfg2.check,Bool.and_eq_true] at checked
+  exact check_of_source (source_ok_of_general_args_loop checked.1) checked.2
+
+end Backend.Stock.GeneralArgsLoopCfg3
+
+namespace Backend.Stock.GeneralLoopCfg3
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `sourceLeafEligible` from the control check of every block, the bodies and the ABI. -/
+theorem source_leaf_eligible_of_blocks {f : Clif.Function}
+    (controls : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true)
+    (bodies : f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) = true)
+    (params : f.sig.params.all Scalar.narrowAbiEligible = true)
+    (returns : f.sig.returns.all Scalar.narrowAbiEligible = true) : sourceLeafEligible f = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true]
+  refine ⟨⟨⟨?_,bodies⟩,params⟩,returns⟩
+  apply List.all_eq_true.mpr
+  rintro ⟨b,bi⟩ member
+  exact controls bi b (List.mk_mem_zipIdx_iff_getElem?.mp member)
+
+/-- `sourceOk` from `sourceLeafEligible` and the driver checks. -/
+theorem source_ok_of_leaf {f : Clif.Function} (leaf : sourceLeafEligible f = true) (scope : lowerScopeB f = true)
+    (dominated : dominatedB f = true) (abi : sigAbiOk f.sig = true) : sourceOk f = true := by
+  simp only [sourceOk,leaf,scope,dominated,abi,Bool.and_self]
+
+/-- **The legacy class `GeneralLoopCfg2` (CB-11) is in the class at the selector
+level.** -/
+theorem source_leaf_eligible_of_general_loop {f : Clif.Function}
+    (checked : GeneralLoopCfg2.sourceLeafEligible f = true) : sourceLeafEligible f = true := by
+  simp only [GeneralLoopCfg2.sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  refine source_leaf_eligible_of_blocks ?_ bodies params returns
+  intro bi b found
+  have old := List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  cases term : b.term <;> rw [term] at old
+  case trap c => exact old
+  case jump bc => exact old
+  case ret xs => rfl
+  case brif c yes no =>
+    simp only [GeneralLoopCfg2.controlLeafEligible,GeneralLoopCfg2.controlEligible,
+      Bool.and_eq_true] at old
+    obtain ⟨⟨⟨⟨condition,yesEmpty⟩,noEmpty⟩,yesNonentry⟩,noNonentry⟩ := old
+    simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg3.condition_of_general_args condition,
+      yesEmpty,noEmpty,yesNonentry,noNonentry,Bool.and_self]
+  all_goals
+    simp only [GeneralLoopCfg2.controlLeafEligible,GeneralLoopCfg2.controlEligible] at old
+    cases old
+
+/-- **The legacy class `GeneralLoopCfg2` (CB-11) is in the class.** -/
+theorem source_ok_of_general_loop {f : Clif.Function} (checked : GeneralLoopCfg2.sourceOk f = true) :
+    sourceOk f = true := by
+  simp only [GeneralLoopCfg2.sourceOk,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨leaf,scope⟩,dominated⟩,abi⟩ := checked
+  exact source_ok_of_leaf (source_leaf_eligible_of_general_loop leaf) scope dominated abi
+
+/-- **The checker of `GeneralLoopCfg2` (CB-11) is in the checker of the class**: both
+publish the unsplit code of the actual Stock lowering. -/
+theorem check_of_general_loop {f : Clif.Function} {vc : VCode}
+    (checked : GeneralLoopCfg2.check f vc = true) : check f vc = true := by
+  simp only [GeneralLoopCfg2.check,Bool.and_eq_true] at checked
+  simp only [check,source_ok_of_general_loop checked.1,Bool.true_and]
+  exact checked.2
+
+end Backend.Stock.GeneralLoopCfg3
diff --git a/FV/Backend/Proof/StockNarrowCondCarry.lean b/FV/Backend/Proof/StockNarrowCondCarry.lean
new file mode 100644
index 000000000..136c1bde3
--- /dev/null
+++ b/FV/Backend/Proof/StockNarrowCondCarry.lean
@@ -0,0 +1,232 @@
+import FV.Backend.Proof.StockNarrowConditionCores
+import FV.Backend.Proof.StockGeneralCondCarry
+
+/-! Branches on a plain `i8` condition or a condition of `CondMetadata`, with carry sets (#140,
+CB-12).
+
+`NarrowCondMetadata` is the context metadata of a plain `i8` condition (`PlainSource` and type
+`i8`). It contains every `i8` parameter (`NarrowCondMetadata.of_parameter`).
+`GeneralCondMetadata` adds it to the forms of `CondMetadata` (CB-11). A branch on a condition in
+any form of `GeneralCondMetadata` has the named call packet (`general_cond_branch_calls`) and the
+carry cores `returning/trapping_general_cond_carry_core`. With them a branch composes below the
+fuel whose selected successor may take block arguments
+(`returning/trapping_selected_general_cond_carry_below`) or whose successors take none
+(`returning/trapping_empty_general_cond_carry_below`). -/
+
+namespace Backend.Stock.Proof.ConditionalValues
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.LoopCarry Backend.Stock.Proof.PlainBranch
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Context metadata of a plain `i8` condition: no lowering rule looks through its definition,
+and it has type `i8`. -/
+def NarrowCondMetadata (ctx : Ctx) (c : Nat) : Prop :=
+  PlainSource ctx c ∧ ctx.valueType? c = some (.int 8)
+
+/-- An `i8` parameter is a plain `i8` condition. -/
+theorem NarrowCondMetadata.of_parameter {ctx : Ctx} {c : Nat} (parameter : ctx.defInst? c = none)
+    (conditionTy : ctx.valueType? c = some (.int 8)) : NarrowCondMetadata ctx c :=
+  ⟨plain_of_parameter parameter,conditionTy⟩
+
+/-- Context metadata of a branch condition: a plain `i8` condition, or a condition in a form of
+`CondMetadata` (a plain wide condition or a comparison in one of the six forms). -/
+def GeneralCondMetadata (ctx : Ctx) (c : Nat) : Prop :=
+  NarrowCondMetadata ctx c ∨ CondMetadata ctx c
+
+/-- A branch on a condition in any form of `GeneralCondMetadata` has the named call packet. -/
+theorem ConditionalBodySpec.general_cond_branch_calls {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c) :
+    spec.BranchCalls := by
+  have block : f.blocks[bi]? = some b := by simpa only [spec.atBlock] using spec.split.block
+  rcases condition with ⟨plain,_⟩ | condition
+  · obtain ⟨calls,_⟩ := spec.plain_calls run scope block termShape plain
+    exact ⟨calls⟩
+  · exact spec.cond_branch_calls run scope termShape condition
+
+/-- The carry return core of a branch on a condition in any form of `GeneralCondMetadata`. -/
+theorem ConditionalBodySpec.returning_general_cond_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    ReturningCarryCore spec needed fuel s vals cm ρ world := by
+  rcases condition with ⟨plain,narrow⟩ | condition
+  · exact spec.returning_narrow8_carry_core run scope dominated family refines driver stable termShape plain
+      narrow available remaining atTerm defined returned held
+  · exact spec.returning_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held
+
+/-- The carry first-trap core of a branch on a condition in any form of `GeneralCondMetadata`. -/
+theorem ConditionalBodySpec.trapping_general_cond_carry_core {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {fuel : Nat} {s : Clif.State} {code : Clif.TrapCode}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    TrappingCarryCore spec needed fuel s code ρ world := by
+  rcases condition with ⟨plain,narrow⟩ | condition
+  · exact spec.trapping_narrow8_carry_core run scope dominated family refines driver stable termShape plain
+      narrow available remaining atTerm defined trapped held
+  · exact spec.trapping_cond_any_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata`, with block arguments, composes below
+the fuel, for returns.** The selected successor may take arguments, through an original or a
+critical-edge successor. -/
+theorem ConditionalBodySpec.returning_selected_general_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_selected_carry_below_of_core run scope dominated driver tag termShape
+    (spec.general_cond_branch_calls run scope termShape condition) successors callers
+    (spec.returning_general_cond_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata`, with block arguments, composes below
+the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_selected_general_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_selected_carry_below_of_core run scope dominated driver tag termShape
+    (spec.general_cond_branch_calls run scope termShape condition) successors callers
+    (spec.trapping_general_cond_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata`, with empty block arguments, composes
+below the fuel, for returns.** -/
+theorem ConditionalBodySpec.returning_empty_general_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {vals : List Clif.Val} {cm : Clif.Mem} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryReturnBelow f result bc spec.term.output.state carry isem MR env cp vals cm fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.returned vals cm) :=
+  spec.returning_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.returning_general_cond_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined returned held)
+
+/-- **A branch on a condition in any form of `GeneralCondMetadata`, with empty block arguments, composes
+below the fuel, for first traps.** -/
+theorem ConditionalBodySpec.trapping_empty_general_cond_carry_below
+    {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {b : Clif.Block} {label bi c : Nat} {yes no : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result b label bi c yes no isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (termShape : b.term = .brif c yes no) (condition : GeneralCondMetadata result.ctx c)
+    (emptyArgs : yes.args = [] ∧ no.args = [])
+    {carry : Nat → Prop}
+    (available : ∀ x,carry x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    {trapCode : Clif.TrapCode} {fuel : Nat}
+    (successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests b.term)[index]? = some bc →
+      Nonempty (SuccessorCarryTrapBelow f result bc spec.term.output.state carry isem MR env cp trapCode fuel))
+    {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped trapCode)
+    {ρ : Nat → CV} {world : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR carry
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ world) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,world⟩ (.trapped trapCode) :=
+  spec.trapping_empty_carry_below_of_core run scope dominated driver tag termShape emptyArgs successors callers
+    (spec.trapping_general_cond_carry_core run scope dominated family refines driver stable termShape
+      condition available remaining atTerm defined trapped held)
+
