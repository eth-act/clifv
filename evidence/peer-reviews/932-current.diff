diff --git a/FV/Backend/Lowering/StockGeneralArgsLoopCfg6.lean b/FV/Backend/Lowering/StockGeneralArgsLoopCfg6.lean
new file mode 100644
index 000000000..978f765dd
--- /dev/null
+++ b/FV/Backend/Lowering/StockGeneralArgsLoopCfg6.lean
@@ -0,0 +1,55 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg5
+
+/-! The loop class with `br_table` terminators, with block arguments (#140, CB-14c).
+
+`GeneralArgsLoopCfg5` (CB-13) admits jumps, returns, `brif` on its conditions and nonentry traps.
+Here a block may also end in `br_table x, dc, [tbl]` (`tableEligible`) when
+
+* the index `x` is declared with type `i32` (a parameter or a result of a statement); the table
+  rule passes an `i32` index to `put_in_reg_zext32` unchanged, so no definition is looked through;
+* the table has fewer than 4096 entries, so the bound check is `subs wzr, ridx, #n` with an
+  immediate (rule 5450);
+* the default and every table entry enter an existing nonentry block.
+
+The successors may take block arguments. The checker publishes the edge split of the actual Stock
+lowering. -/
+
+namespace Backend.Stock.GeneralArgsLoopCfg6
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- A `br_table x, dc, [tbl]` of the class: an `i32` index, fewer than 4096 table entries, and
+every target an existing nonentry block. -/
+def tableEligible (f : Clif.Function) (x : Nat) (dc : Clif.BlockCall) (tbl : List Clif.BlockCall) : Bool :=
+  GeneralArgsLoopCfg5.declaredOf f x .i32 && decide (tbl.length < 4096) &&
+    (dc :: tbl).all (ParameterLoopCfg.targetNonentry f)
+
+/-- `GeneralArgsLoopCfg5.controlEligible` with `br_table` terminators of `tableEligible`. -/
+def controlEligible (f : Clif.Function) (b : Clif.Block) : Clif.Terminator → Bool
+  | .brTable x dc tbl => tableEligible f x dc tbl
+  | term => GeneralArgsLoopCfg5.controlEligible f b term
+
+/-- As `controlEligible`, and a nonentry block may also end in `trap`. -/
+def controlLeafEligible (f : Clif.Function) (bi : Nat) (b : Clif.Block) : Clif.Terminator → Bool
+  | .trap _ => bi != 0
+  | term => controlEligible f b term
+
+/-- `GeneralArgsLoopCfg5.sourceLeafEligible` with the terminators of `controlLeafEligible`. Bodies
+and ABI are as there. -/
+def sourceLeafEligible (f : Clif.Function) : Bool :=
+  f.blocks.zipIdx.all (fun (b,bi) => controlLeafEligible f bi b b.term) &&
+  f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) &&
+  f.sig.params.all Scalar.narrowAbiEligible && f.sig.returns.all Scalar.narrowAbiEligible
+
+def sourceOk (f : Clif.Function) : Bool :=
+  sourceLeafEligible f && lowerScopeB f && dominatedB f && sigAbiOk f.sig
+
+/-- The published code is the actual edge split of the actual Stock lowering. -/
+def check (f : Clif.Function) (vc : VCode) : Bool :=
+  sourceOk f && match Stock.lower f with
+  | .error _ => false
+  | .ok result => match splitEdgesChecked result.code result.edgeArgs with
+    | .ok split => decide (split.code = vc)
+    | .error _ => false
+
+end Backend.Stock.GeneralArgsLoopCfg6
diff --git a/FV/Backend/Lowering/StockGeneralLoopCfg6.lean b/FV/Backend/Lowering/StockGeneralLoopCfg6.lean
new file mode 100644
index 000000000..2c4861ed5
--- /dev/null
+++ b/FV/Backend/Lowering/StockGeneralLoopCfg6.lean
@@ -0,0 +1,40 @@
+import FV.Backend.Lowering.StockGeneralArgsLoopCfg6
+
+/-! The legacy loop class with `br_table` terminators (#140, CB-14c).
+
+`GeneralLoopCfg5` (CB-13) with the `br_table` terminators of `GeneralArgsLoopCfg6.tableEligible`
+whose default and table entries take no block arguments. Jumps may pass any arguments; `brif`
+successors take none. The checker publishes the unsplit code of the actual Stock lowering, so the
+class keeps the legacy single-vector interface (`Scalar.Domain`). -/
+
+namespace Backend.Stock.GeneralLoopCfg6
+open Backend.Proof.Driver
+set_option autoImplicit false
+
+/-- `GeneralLoopCfg5.controlEligible` with the `br_table` terminators of
+`GeneralArgsLoopCfg6.tableEligible` whose successors take no arguments. -/
+def controlEligible (f : Clif.Function) (b : Clif.Block) : Clif.Terminator → Bool
+  | .brTable x dc tbl => GeneralArgsLoopCfg6.tableEligible f x dc tbl && (dc :: tbl).all (·.args.isEmpty)
+  | term => GeneralLoopCfg5.controlEligible f b term
+
+/-- As `controlEligible`, and a nonentry block may also end in `trap`. -/
+def controlLeafEligible (f : Clif.Function) (bi : Nat) (b : Clif.Block) : Clif.Terminator → Bool
+  | .trap _ => bi != 0
+  | term => controlEligible f b term
+
+/-- `GeneralLoopCfg5.sourceLeafEligible` with the terminators of `controlLeafEligible`. -/
+def sourceLeafEligible (f : Clif.Function) : Bool :=
+  f.blocks.zipIdx.all (fun (b,bi) => controlLeafEligible f bi b b.term) &&
+  f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) &&
+  f.sig.params.all Scalar.narrowAbiEligible && f.sig.returns.all Scalar.narrowAbiEligible
+
+def sourceOk (f : Clif.Function) : Bool :=
+  sourceLeafEligible f && lowerScopeB f && dominatedB f && sigAbiOk f.sig
+
+/-- The published code is the unsplit code of the actual Stock lowering. -/
+def check (f : Clif.Function) (vc : VCode) : Bool :=
+  sourceOk f && match Stock.lower f with
+  | .error _ => false
+  | .ok result => decide (result.code = vc)
+
+end Backend.Stock.GeneralLoopCfg6
diff --git a/FV/Backend/Proof/StockGeneralArgsLoopClass6.lean b/FV/Backend/Proof/StockGeneralArgsLoopClass6.lean
new file mode 100644
index 000000000..97517529e
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralArgsLoopClass6.lean
@@ -0,0 +1,209 @@
+import FV.Backend.Lowering.StockGeneralLoopCfg6
+import FV.Backend.Proof.StockGeneralArgsLoopClass5
+import FV.Backend.Proof.StockTableLoop
+
+/-! Source facts of the loop classes with `br_table` terminators (#140, CB-14c).
+
+A `br_table` of the classes (`TableBranch`) has an index declared with type `i32` and fewer than
+4096 table entries; its context type is `i32` (`TableBranch.index_type`). `GeneralArgsTerms` are
+the terminators of the split class `GeneralArgsLoopCfg6`: those of `GeneralArgsLoopCfg5` and the
+table branches with any block arguments. `GeneralTerms` are those of the legacy class
+`GeneralLoopCfg6`: those of `GeneralLoopCfg5` and the table branches whose successors take no
+arguments (`EmptyTableBranch`). The selectors derive the terminators, the entry kind, the body
+families and the ABI (`source_leaf_eligible_facts`). -/
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg6
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- A `br_table` of the classes: the index is declared with type `i32`, and the table has fewer than
+4096 entries. -/
+def TableBranch (f : Clif.Function) (b : Clif.Block) : Prop :=
+  ∃ x dc tbl,b.term = .brTable x dc tbl ∧ GeneralArgsLoopCfg5.Declared f x .i32 ∧ tbl.length < 4096
+
+/-- A `br_table` of the legacy class: a `TableBranch` whose successors take no arguments. -/
+def EmptyTableBranch (f : Clif.Function) (b : Clif.Block) : Prop :=
+  ∃ x dc tbl,b.term = .brTable x dc tbl ∧ GeneralArgsLoopCfg5.Declared f x .i32 ∧ tbl.length < 4096 ∧
+    ∀ bc ∈ dc :: tbl,bc.args = []
+
+/-- Every block jumps, returns, branches as `GeneralArgsBranch` of `GeneralArgsLoopCfg5`, branches
+as `TableBranch`, or ends in `trap`. -/
+def GeneralArgsTerms (f : Clif.Function) : Prop :=
+  ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b →
+    (∃ bc,b.term = .jump bc) ∨ (∃ xs,b.term = .ret xs) ∨ GeneralArgsLoopCfg5.GeneralArgsBranch f b ∨
+      TableBranch f b ∨ ∃ c,b.term = .trap c
+
+/-- Every block jumps, returns, branches as `GeneralBranch` of `GeneralArgsLoopCfg5`, branches as
+`EmptyTableBranch`, or ends in `trap`. -/
+def GeneralTerms (f : Clif.Function) : Prop :=
+  ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b →
+    (∃ bc,b.term = .jump bc) ∨ (∃ xs,b.term = .ret xs) ∨ GeneralArgsLoopCfg5.GeneralBranch f b ∨
+      EmptyTableBranch f b ∨ ∃ c,b.term = .trap c
+
+/-- The terminators of the legacy class are terminators of the split class. -/
+theorem GeneralTerms.args {f : Clif.Function} (terms : GeneralTerms f) : GeneralArgsTerms f := by
+  intro bi b found
+  rcases terms bi b found with jump | ret | ⟨c,yes,no,term,_,_,condition⟩ | ⟨x,dc,tbl,term,declared,small,_⟩ | trap
+  · exact Or.inl jump
+  · exact Or.inr (Or.inl ret)
+  · exact Or.inr (Or.inr (Or.inl ⟨c,yes,no,term,condition⟩))
+  · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨x,dc,tbl,term,declared,small⟩)))
+  · exact Or.inr (Or.inr (Or.inr (Or.inr trap)))
+
+/-- The terminators of `GeneralArgsLoopCfg5` are terminators of the split class. -/
+theorem general_args_terms_of_cfg5 {f : Clif.Function} (terms : GeneralArgsLoopCfg5.GeneralArgsTerms f) :
+    GeneralArgsTerms f := by
+  intro bi b found
+  rcases terms bi b found with jump | ret | branch | trap
+  · exact Or.inl jump
+  · exact Or.inr (Or.inl ret)
+  · exact Or.inr (Or.inr (Or.inl branch))
+  · exact Or.inr (Or.inr (Or.inr (Or.inr trap)))
+
+/-- The terminators of `GeneralLoopCfg5` are terminators of the legacy class. -/
+theorem general_terms_of_cfg5 {f : Clif.Function} (terms : GeneralArgsLoopCfg5.GeneralTerms f) :
+    GeneralTerms f := by
+  intro bi b found
+  rcases terms bi b found with jump | ret | branch | trap
+  · exact Or.inl jump
+  · exact Or.inr (Or.inl ret)
+  · exact Or.inr (Or.inr (Or.inl branch))
+  · exact Or.inr (Or.inr (Or.inr (Or.inr trap)))
+
+/-- **The index of a table branch has the context type `i32`.** -/
+theorem TableBranch.index_type {f : Clif.Function} {x : Nat}
+    (declared : GeneralArgsLoopCfg5.Declared f x .i32) (scope : LowerScope f) (dominated : Dominated f)
+    {ctx : Ctx} {ranges : Array (Nat × Nat)} {initial : State}
+    (build : Stock.buildCtx f = .ok (ctx,ranges,initial)) : ctx.valueType? x = some (.int 32) :=
+  declared.metadata scope dominated build
+
+end Backend.Stock.Proof.GeneralArgsLoopCfg6
+
+namespace Backend.Stock.GeneralArgsLoopCfg6
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof Backend.Stock.Proof.GeneralArgsLoopCfg6
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The executable table check derives the declared `i32` index and the table bound. -/
+theorem table_sound {f : Clif.Function} {x : Nat} {dc : Clif.BlockCall} {tbl : List Clif.BlockCall}
+    (checked : tableEligible f x dc tbl = true) :
+    Proof.GeneralArgsLoopCfg5.Declared f x .i32 ∧ tbl.length < 4096 := by
+  simp only [tableEligible,Bool.and_eq_true,decide_eq_true_eq] at checked
+  exact ⟨GeneralArgsLoopCfg5.declared_of_sound checked.1.1,checked.1.2⟩
+
+private theorem control_leaf_facts {f : Clif.Function} {bi : Nat} {b : Clif.Block}
+    (block : f.blocks[bi]? = some b) (checked : controlLeafEligible f bi b b.term = true) :
+    (∃ bc,b.term = .jump bc) ∨ (∃ xs,b.term = .ret xs) ∨ Proof.GeneralArgsLoopCfg5.GeneralArgsBranch f b ∨
+      TableBranch f b ∨ (∃ c,b.term = .trap c ∧ bi ≠ 0) := by
+  cases term : b.term <;> rw [term] at checked
+  case trap c =>
+    simp only [controlLeafEligible,bne_iff_ne,ne_eq] at checked
+    exact Or.inr (Or.inr (Or.inr (Or.inr ⟨c,rfl,checked⟩)))
+  case jump bc => exact Or.inl ⟨bc,rfl⟩
+  case ret xs => exact Or.inr (Or.inl ⟨xs,rfl⟩)
+  case brif c yes no =>
+    simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg5.controlEligible,Bool.and_eq_true] at checked
+    obtain ⟨⟨condition,_⟩,_⟩ := checked
+    exact Or.inr (Or.inr (Or.inl ⟨c,yes,no,term,GeneralArgsLoopCfg5.condition_sound block condition⟩))
+  case brTable x dc tbl =>
+    simp only [controlLeafEligible,controlEligible] at checked
+    obtain ⟨declared,small⟩ := table_sound checked
+    exact Or.inr (Or.inr (Or.inr (Or.inl ⟨x,dc,tbl,term,declared,small⟩)))
+  all_goals simp only [controlLeafEligible,controlEligible,GeneralArgsLoopCfg5.controlEligible] at checked; cases checked
+
+/-- **The split selector's source facts.** The selector derives the terminators, the entry kind,
+the body families and the ABI. -/
+theorem source_leaf_eligible_facts {f : Clif.Function} (checked : sourceLeafEligible f = true) :
+    GeneralArgsTerms f ∧ (∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c) ∧
+    (∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) ∧
+    f.sig.params.all Scalar.narrowAbiEligible = true ∧ f.sig.returns.all Scalar.narrowAbiEligible = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  have each : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true := by
+    intro bi b found
+    exact List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  refine ⟨?_,?_,?_,params,returns⟩
+  · intro bi b found
+    rcases control_leaf_facts found (each bi b found) with jump | ret | branch | table | ⟨c,trap,_⟩
+    · exact Or.inl jump
+    · exact Or.inr (Or.inl ret)
+    · exact Or.inr (Or.inr (Or.inl branch))
+    · exact Or.inr (Or.inr (Or.inr (Or.inl table)))
+    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨c,trap⟩)))
+  · intro b found c trap
+    rcases control_leaf_facts found (each 0 b found) with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c',yes,no,branch,_⟩ | ⟨x,dc,tbl,table,_⟩ | ⟨c',trap',entry⟩
+    · rw [trap] at jump; cases jump
+    · rw [trap] at ret; cases ret
+    · rw [trap] at branch; cases branch
+    · rw [trap] at table; cases table
+    · exact entry rfl
+  · intro b member stm present
+    exact Scalar.maskMixedBodyEligible_sound (List.all_eq_true.mp (List.all_eq_true.mp bodies b member) stm present)
+
+end Backend.Stock.GeneralArgsLoopCfg6
+
+namespace Backend.Stock.GeneralLoopCfg6
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof Backend.Stock.Proof.GeneralArgsLoopCfg6
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem control_leaf_facts {f : Clif.Function} {bi : Nat} {b : Clif.Block}
+    (block : f.blocks[bi]? = some b) (checked : controlLeafEligible f bi b b.term = true) :
+    (∃ bc,b.term = .jump bc) ∨ (∃ xs,b.term = .ret xs) ∨ Proof.GeneralArgsLoopCfg5.GeneralBranch f b ∨
+      EmptyTableBranch f b ∨ (∃ c,b.term = .trap c ∧ bi ≠ 0) := by
+  cases term : b.term <;> rw [term] at checked
+  case trap c =>
+    simp only [controlLeafEligible,bne_iff_ne,ne_eq] at checked
+    exact Or.inr (Or.inr (Or.inr (Or.inr ⟨c,rfl,checked⟩)))
+  case jump bc => exact Or.inl ⟨bc,rfl⟩
+  case ret xs => exact Or.inr (Or.inl ⟨xs,rfl⟩)
+  case brif c yes no =>
+    simp only [controlLeafEligible,controlEligible,GeneralLoopCfg5.controlEligible,Bool.and_eq_true] at checked
+    obtain ⟨⟨⟨⟨condition,yesEmpty⟩,noEmpty⟩,_⟩,_⟩ := checked
+    exact Or.inr (Or.inr (Or.inl ⟨c,yes,no,term,List.isEmpty_iff.mp yesEmpty,List.isEmpty_iff.mp noEmpty,
+      GeneralArgsLoopCfg5.condition_sound block condition⟩))
+  case brTable x dc tbl =>
+    simp only [controlLeafEligible,controlEligible,Bool.and_eq_true] at checked
+    obtain ⟨table,empty⟩ := checked
+    obtain ⟨declared,small⟩ := GeneralArgsLoopCfg6.table_sound table
+    refine Or.inr (Or.inr (Or.inr (Or.inl ⟨x,dc,tbl,term,declared,small,?_⟩)))
+    intro bc member
+    exact List.isEmpty_iff.mp (List.all_eq_true.mp empty bc member)
+  all_goals simp only [controlLeafEligible,controlEligible,GeneralLoopCfg5.controlEligible] at checked; cases checked
+
+/-- **The legacy selector's source facts.** The selector derives the terminators, the entry kind,
+the body families and the ABI. -/
+theorem source_leaf_eligible_facts {f : Clif.Function} (checked : sourceLeafEligible f = true) :
+    GeneralTerms f ∧ (∀ b,f.blocks[0]? = some b → ∀ c,b.term ≠ .trap c) ∧
+    (∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst) ∧
+    f.sig.params.all Scalar.narrowAbiEligible = true ∧ f.sig.returns.all Scalar.narrowAbiEligible = true := by
+  simp only [sourceLeafEligible,Bool.and_eq_true] at checked
+  obtain ⟨⟨⟨controls,bodies⟩,params⟩,returns⟩ := checked
+  have each : ∀ (bi : Nat) (b : Clif.Block),f.blocks[bi]? = some b → controlLeafEligible f bi b b.term = true := by
+    intro bi b found
+    exact List.all_eq_true.mp controls (b,bi) (List.mk_mem_zipIdx_iff_getElem?.mpr found)
+  refine ⟨?_,?_,?_,params,returns⟩
+  · intro bi b found
+    rcases control_leaf_facts found (each bi b found) with jump | ret | branch | table | ⟨c,trap,_⟩
+    · exact Or.inl jump
+    · exact Or.inr (Or.inl ret)
+    · exact Or.inr (Or.inr (Or.inl branch))
+    · exact Or.inr (Or.inr (Or.inr (Or.inl table)))
+    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨c,trap⟩)))
+  · intro b found c trap
+    rcases control_leaf_facts found (each 0 b found) with
+      ⟨bc,jump⟩ | ⟨xs,ret⟩ | ⟨c',yes,no,branch,_⟩ | ⟨x,dc,tbl,table,_⟩ | ⟨c',trap',entry⟩
+    · rw [trap] at jump; cases jump
+    · rw [trap] at ret; cases ret
+    · rw [trap] at branch; cases branch
+    · rw [trap] at table; cases table
+    · exact entry rfl
+  · intro b member stm present
+    exact Scalar.maskMixedBodyEligible_sound (List.all_eq_true.mp (List.all_eq_true.mp bodies b member) stm present)
+
+end Backend.Stock.GeneralLoopCfg6
diff --git a/FV/Backend/Proof/StockGeneralArgsLoopDomain6.lean b/FV/Backend/Proof/StockGeneralArgsLoopDomain6.lean
new file mode 100644
index 000000000..1f9074640
--- /dev/null
+++ b/FV/Backend/Proof/StockGeneralArgsLoopDomain6.lean
@@ -0,0 +1,444 @@
+import FV.Backend.Proof.StockGeneralArgsLoopDomain5
+import FV.Backend.Proof.StockGeneralArgsLoopClass6
+
+/-! The loop class with `br_table` terminators, with block arguments, satisfies the
+per-successor production domain (#140, CB-14c).
+
+`StockGeneralArgsLoopDomain5` (CB-13) with the `GeneralArgsTerms` of `GeneralArgsLoopCfg6`. A
+`br_table` block of any label composes by `returning/trapping_selected_table_carry_below` with the
+definition carry of each selected successor (`table_args_carry_returns/traps`); a nonentry table
+block has no prelude, and an entry table block has the prelude of an original entry core
+(`table_entry_prelude`). The other arms and the induction on the source fuel over all nonentry
+original blocks are those of CB-13. The result is `Scalar.DomainAt`. -/
+
+namespace Backend.Stock.Proof.GeneralArgsLoopCfg6
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof.ConditionalValues
+  Backend.Stock.Proof.ForwardSource Backend.Stock.Proof.LoopCarry Backend.Stock.Proof.ParameterCfg
+  Backend.Stock.Proof.ParameterLoopCfg Backend.Stock.Proof.ComparisonLoopCfg
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- A `br_table` block of the class, with any block arguments, entry or not, for returns. -/
+theorem table_args_carry_returns {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program} {b : Clif.Block} {label bi x : Nat}
+    {dc : Clif.BlockCall} {tbl : List Clif.BlockCall}
+    (spec : TableBodySpec f result b label bi x dc tbl isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (term : b.term = .brTable x dc tbl) (declared : GeneralArgsLoopCfg5.Declared f x .i32)
+    (small : tbl.length < 4096)
+    {fuel : Nat}
+    (continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+      result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+      next ∈ result.blockScans.toList → next.block = tl →
+      CarryReturnsBelow f result targetLabel tl targetBlock next isem MR env cp fuel)
+    {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx bi 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm)
+    {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (defCarry f result bi)
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ w) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,w⟩ (.returned vals cm) :=
+  spec.returning_selected_table_carry_below run scope dominated family refines driver stable tag term
+    (TableBranch.index_type declared scope dominated spec.build) small
+    (fun y kept => by rw [spec.atBlock]; exact defCarry_available y kept)
+    (table_carry_successors run scope dominated spec tag continued)
+    callers remaining atTerm (by simpa only [spec.atBlock] using defined) returned held
+
+/-- A `br_table` block of the class, with any block arguments, entry or not, for first traps. -/
+theorem table_args_carry_traps {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program} {b : Clif.Block} {label bi x : Nat}
+    {dc : Clif.BlockCall} {tbl : List Clif.BlockCall}
+    (spec : TableBodySpec f result b label bi x dc tbl isem MR env cp)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (term : b.term = .brTable x dc tbl) (declared : GeneralArgsLoopCfg5.Declared f x .i32)
+    (small : tbl.length < 4096)
+    {fuel : Nat}
+    (continued : ∀ {targetLabel tl : Nat} {targetBlock : Clif.Block} {next : BlockScanEvent},
+      result.order.nodes[targetLabel]? = some (.original tl) → f.blocks[tl]? = some targetBlock → tl ≠ 0 →
+      next ∈ result.blockScans.toList → next.block = tl →
+      CarryTrapsBelow f result targetLabel tl targetBlock next isem MR env cp fuel)
+    {s : Clif.State} {code : Clif.TrapCode} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx bi 0 s.frame)
+    (trapped : Clif.runLoop env cp fuel s = .trapped code)
+    {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (defCarry f result bi)
+      spec.core.scan.output.state (0,s.frame,s.mem) ρ w) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,w⟩ (.trapped code) :=
+  spec.trapping_selected_table_carry_below run scope dominated family refines driver stable tag term
+    (TableBranch.index_type declared scope dominated spec.build) small
+    (fun y kept => by rw [spec.atBlock]; exact defCarry_available y kept)
+    (table_carry_trap_successors run scope dominated spec tag continued)
+    callers remaining atTerm (by simpa only [spec.atBlock] using defined) trapped held
+
