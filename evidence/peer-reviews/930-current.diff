+/-- The exact code of a `br_table` on the index register `r` with default `d` and table `ts`,
+whose two temporaries are the fresh registers `n` and `n+1`: the island, the bound check and the
+dispatch. -/
+def tableCode (d : Label) (ts : List Label) (r : Reg) (n : Nat) : List MInst :=
+  [.emitIsland (4*(8+ts.length)),.aluRRImm12 .subS .size32 .xzr r ⟨ts.length,false⟩,
+    .jtSequence d ts r (.vreg n .int) (.vreg (n+1) .int)]
+
+/-- The code-generation state after the code `tableCode d ts r st.nextVreg` from `st`. -/
+def tableState (st : LState) (d : Label) (ts : List Label) (r : Reg) : LState :=
+  ((((st.emit (.emitIsland (4*(8+ts.length)))).fresh .int).2.fresh .int).2.emit
+    (.aluRRImm12 .subS .size32 .xzr r ⟨ts.length,false⟩)).emit
+    (.jtSequence d ts r (.vreg st.nextVreg .int) (.vreg (st.nextVreg+1) .int))
+
+theorem tableState_emitted (st : LState) (d : Label) (ts : List Label) (r : Reg) :
+    (tableState st d ts r).emitted = st.emitted ++ (tableCode d ts r st.nextVreg).toArray := by
+  simp only [tableState,tableCode,LState.emit,LState.fresh]
+  apply Array.ext'
+  simp
+
+theorem tableState_nextVreg (st : LState) (d : Label) (ts : List Label) (r : Reg) :
+    (tableState st d ts r).nextVreg = st.nextVreg+2 := by
+  simp only [tableState,LState.emit,LState.fresh]
+
+/-- **The emission of a `br_table` on an `i32` index with fewer than 4096 targets.** The index
+passes through `put_in_reg_zext32` as the register `r` of `x` (`x` is marked demanded), and the
+dispatch helper takes its immediate rule: the code is exactly `tableCode`, with the next two fresh
+registers as temporaries. -/
+theorem TableCalls.code {ctx : Ctx} {i : Nat} {labels : List Label} {before next : State} {out : V}
+    (calls : TableCalls ctx i labels before out next) {x : Nat} (source : calls.source = .value x)
+    (typeX : ctx.valueType? x = some (.int 32)) (small : calls.table.length < 4096) :
+    ∃ r,ctx.valueReg? x = some r ∧ DemandAllowed ctx before x ∧
+      calls.extended.1 = {before.mark x with
+        base := before.base.emit (.emitIsland (4*(8+calls.table.length)))} ∧
+      next.base = tableState before.base calls.default calls.table r := by
+  have extendRun := calls.extendRun
+  rw [source] at extendRun
+  obtain ⟨t,typed,safe,rx,mapped,form⟩ := ScalarShift.stock_zext32_out data_program rfl calls.extendEnough extendRun
+  rw [typeX] at typed
+  cases typed
+  rcases form with ⟨_,output,state⟩ | ⟨notPass,_⟩
+  · have implRun := calls.implRun
+    rw [output] at implRun
+    have legacy := impl_call implRun
+    have code := legacy_impl_small data_program rfl calls.implEnough small legacy
+    rw [state,calls.islandEq] at code
+    rw [calls.islandEq] at state safe
+    exact ⟨rx,mapped,safe,state,code⟩
+  · exact absurd (by simp) notPass
+
+/-- **A real named `br_table` on an `i32` index with fewer than 4096 targets emits exactly
+`tableCode`.** The labels are the default followed by the table, `r` is the register of `x`, `x` is
+marked demanded, and the frontier grows by the two temporaries. -/
+theorem table_named_code {ctx : Ctx} {i x : Nat} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨tableData x,[],[],none⟩)
+    (typeX : ctx.valueType? x = some (.int 32)) (small : labels.length ≤ 4096)
+    {before next : State} {out : V} {trace : List RuleId}
+    (run : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels] before = .ok (some out,next,trace)) :
+    ∃ d ts r,labels = d :: ts ∧ ctx.valueReg? x = some r ∧ DemandAllowed ctx before x ∧
+      next.base = tableState before.base d ts r ∧
+      next.base.emitted = before.base.emitted ++ (tableCode d ts r before.base.nextVreg).toArray ∧
+      next.base.nextVreg = before.base.nextVreg+2 := by
+  obtain ⟨calls,source⟩ := table_named_calls slot run
+  have short : calls.table.length < 4096 := by
+    have equal := congrArg List.length calls.labels_eq
+    simp only [List.length_cons] at equal
+    omega
+  obtain ⟨r,mapped,safe,_,code⟩ := calls.code source typeX short
+  refine ⟨calls.default,calls.table,r,calls.labels_eq,mapped,safe,code,?_,?_⟩
+  · rw [code]; exact tableState_emitted _ _ _ _
+  · rw [code]; exact tableState_nextVreg _ _ _ _
+
+end Backend.Stock.Proof.TableBranch
diff --git a/FV/Backend/Proof/StockTableValues.lean b/FV/Backend/Proof/StockTableValues.lean
new file mode 100644
index 000000000..dd357b612
--- /dev/null
+++ b/FV/Backend/Proof/StockTableValues.lean
@@ -0,0 +1,232 @@
+import FV.Backend.Proof.StockTableSelection
+import FV.Backend.Proof.StockConditionalResolved
+import FV.Backend.Proof.StockDemandMono
+import FV.Backend.Proof.StockDemandExtent
+
+/-! The Stock `br_table` terminator: branch values (#140, CB-14a).
+
+The actual code of a `br_table` on an `i32` index with fewer than 4096 targets is `tableCode`
+(`table_named_code`). Through the final aliases, it reads the resolved register of the index;
+its two temporaries are fresh, so the resolver keeps them. If that register holds the source
+index, the resolved code stops at the `jt_sequence` (its last instruction) on the edge of
+`branchIdx`: the table entry `x + 1` when `x` is less than the table size, else the default `0`
+(`table_code_runs`). The stop is before the `jt_sequence` writes its temporaries, so the register
+file at the stop is the initial one, and the world differs only in the flags
+(`TableCalls.values`, `table_named_values`). This is the table analog of
+`comparison_branch_values_last`, stated on the actual named branch call. -/
+
+namespace Backend.Stock.Proof.TableBranch
+open Backend.Proof Backend.Proof.Driver Isle Isle.Interp Isle.Aarch64
+set_option autoImplicit false
+set_option maxRecDepth 20000
+
+/-- The branch index of a table of `n` targets on index `v`: the entry `v + 1` in range, else the
+default `0` (`branchIdx`). -/
+def tableTarget (v n : Nat) : Nat := if v < n then v+1 else 0
+
+/-- A run of `code` that stops at its last instruction, a terminator with targets `labels`, on the
+edge `target`, with the initial register file and the same world but for the flags. -/
+def LastTableExecution (F : BitVec 64 → Prop) (isem : Backend.Proof.Sem) (labels : List Label)
+    (code : List MInst) (target : Nat) (ρ : Nat → CV) (world : Arm.ArmState) : Prop :=
+  ∃ index inst ops prefixWorld outs endWorld,
+    seqRun isem code ρ world = some (.stop index inst ops ρ prefixWorld outs endWorld (.goto target)) ∧
+    index+1 = code.length ∧ SameWorldNF F endWorld world ∧
+    inst.targets = labels ∧ inst.isTerminator = true
+
+/-- The resolved `tableCode`: the index register is resolved through the aliases, and the two
+temporaries, at or above the alias extent, are kept. -/
+theorem tableCode_resolved {aliases : Array (Option Nat)} {n : Nat} (bounded : aliases.size ≤ n)
+    (d : Label) (ts : List Label) (key : Nat) :
+    (tableCode d ts (.vreg key .int) n).map (·.mapRegs (Backend.lowerFunction.resolve aliases (aliases.size+1))) =
+      tableCode d ts (.vreg (aliasNum aliases key) .int) n := by
+  have first : aliasNum aliases n = n := by
+    apply chaseF_none
+    rw [Array.getElem?_eq_none bounded]
+    rfl
+  have second : aliasNum aliases (n+1) = n+1 := by
+    apply chaseF_none
+    rw [Array.getElem?_eq_none (by omega)]
+    rfl
+  simp only [tableCode,List.map_cons,List.map_nil,MInst.mapRegs,resolve_vreg]
+  change [MInst.emitIsland (4*(8+ts.length)),
+    MInst.aluRRImm12 .subS .size32 (Backend.lowerFunction.resolve aliases (aliases.size+1) .xzr)
+      (.vreg (aliasNum aliases key) .int) ⟨ts.length,false⟩,
+    MInst.jtSequence d ts (.vreg (aliasNum aliases key) .int) (.vreg (aliasNum aliases n) .int)
+      (.vreg (aliasNum aliases (n+1)) .int)] = _
+  rw [first,second]
+  rfl
+
+/-- **`tableCode` takes the edge of the index.** If the low 32 bits of the index register are `v`
+and the table has fewer than 4096 targets, the code stops at its `jt_sequence` on the edge
+`tableTarget v ts.length`, with the initial register file. -/
+theorem table_code_runs {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (d : Label) {ts : List Label} (small : ts.length < 4096) (key n : Nat) {ρ : Nat → CV} {v : Nat}
+    (index : ((lo64 (ρ key)).setWidth 32).toNat = v) (world : Arm.ArmState) :
+    LastTableExecution F isem (d :: ts) (tableCode d ts (.vreg key .int) n) (tableTarget v ts.length) ρ world := by
+  have island : Runs F isem [MInst.emitIsland (4*(8+ts.length))] ρ world (fun ρ1 _ => ρ1 = ρ) :=
+    Runs.one refines (operands_emitIsland _) (by rfl) rfl (SameWorldNF.refl F world)
+      fun _ _ => vdefUpd_nil _ _
+  have compare : ∀ ρ1 w1,ρ1 = ρ → Runs F isem [MInst.aluRRImm12 .subS .size32 .xzr (.vreg key .int) ⟨ts.length,false⟩]
+      ρ1 w1 (fun ρ2 w2 => ρ2 = ρ ∧
+        Arm.ConditionHolds Cond.hs.bits w2 = decide (ts.length ≤ v)) := by
+    rintro ρ1 w1 rfl
+    have bits : (⟨ts.length,false⟩ : Imm12).bits < 4096 := small
+    refine (Runs.flags refines ⟨_,rfl,rfl,fun w => ispec_cmpImm32 key bits (ρ1 key) w⟩ w1).imp ?_
+    rintro ρ2 w2 - ⟨rfl,condition⟩
+    refine ⟨rfl,?_⟩
+    rw [condition]
+    refine (hs_cmp32 (opnd .size32 (ρ2 key)) (BitVec.ofNat 32 (⟨ts.length,false⟩ : Imm12).value)).trans ?_
+    have size : (BitVec.ofNat 32 (⟨ts.length,false⟩ : Imm12).value).toNat = ts.length := by
+      simp only [Imm12.value,Bool.false_eq_true,ite_false,BitVec.toNat_ofNat]
+      omega
+    rw [size]
+    change decide (ts.length ≤ ((lo64 (ρ2 key)).setWidth 32).toNat) = _
+    rw [index]
+  obtain ⟨ρ2,w2,prefixRun,prefixWorld,rfl,condition⟩ := island.append compare
+  have dispatch : ispec (MInst.jtSequence d ts (.vreg key .int) (.vreg n .int) (.vreg (n+1) .int)) [ρ2 key] w2 =
+      some ([ofX 0,ofX 0],w2,.goto (tableTarget v ts.length)) := by
+    simp only [ispec,condition,index,tableTarget]
+    by_cases inside : v < ts.length
+    · have outside : ¬ ts.length ≤ v := by omega
+      simp [inside,outside]
+    · have above : ts.length ≤ v := by omega
+      simp [inside,above]
+  obtain ⟨endWorld,stopRun,same⟩ := seqRun_one_stop refines (operands_jtSeq d ts key n (n+1))
+    (by unfold tableTarget; split <;> simp) dispatch rfl
+  have joined := seqRun_append_fall_stop isem prefixRun stopRun
+  simp only [List.cons_append,List.nil_append,List.length_cons,List.length_nil] at joined
+  exact ⟨_,_,_,_,_,endWorld,joined,rfl,(SameWorld.nf same).trans prefixWorld,rfl,rfl⟩
+
+/-- The selected table code defines only its two temporaries, the next two fresh registers. -/
+theorem tableCode_defs (d : Label) (ts : List Label) (key n : Nat) :
+    ∀ m ∈ tableCode d ts (.vreg key .int) n,∀ k ∈ vdefs m,n ≤ k ∧ k < n+2 := by
+  intro m member k defined
+  simp only [tableCode,List.mem_cons,List.not_mem_nil,or_false] at member
+  rcases member with rfl | rfl | rfl
+  · simp [vdefs,operands_emitIsland] at defined
+  · have none : vdefs (MInst.aluRRImm12 .subS .size32 .xzr (.vreg key .int) ⟨ts.length,false⟩) = [] := rfl
+    rw [none] at defined
+    simp at defined
+  · have actual : vdefs (MInst.jtSequence d ts (.vreg key .int) (.vreg n .int) (.vreg (n+1) .int)) = [n,n+1] := by
+      simp [vdefs,operands_jtSeq,Operand.isDef]
+    rw [actual] at defined
+    simp only [List.mem_cons,List.not_mem_nil,or_false] at defined
+    omega
+
+/-- **The selected calls of a `br_table` on an `i32` index take the edge of the source index.**
+From values held for the values demanded at the output state, the resolved actual code stops at
+its `jt_sequence` on the edge `tableTarget bits.toNat n` of the source index `bits`, with the
+initial register file and the same world but for the flags. -/
+theorem TableCalls.values {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i : Nat} {labels : List Label} {before next : State} {out : V}
+    (calls : TableCalls ctx i labels before out next) {x : Nat} (source : calls.source = .value x)
+    (typeX : ctx.valueType? x = some (.int 32)) (small : calls.table.length < 4096)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    {fr : Clif.Frame} {bits : BitVec 32} (getX : fr.getAs x .i32 = .ok bits)
+    {aliases : Array (Option Nat)} {ρ : Nat → CV} (bounded : aliases.size ≤ before.base.nextVreg)
+    (extent : ∀ value r,ctx.valueReg? value = some r → value < before.demand.size)
+    (held : ValuesHeld (Demanded next) ctx fr (fun key => ρ (aliasNum aliases key))) :
+    ∃ code : List MInst,next.base.emitted = before.base.emitted ++ code.toArray ∧
+      (∀ m ∈ code,∀ k ∈ vdefs m,before.base.nextVreg ≤ k ∧ k < next.base.nextVreg) ∧
+      ∀ world,LastTableExecution F isem labels (code.map
+        (·.mapRegs (Backend.lowerFunction.resolve aliases (aliases.size+1))))
+        (tableTarget bits.toNat calls.table.length) ρ world := by
+  obtain ⟨r,mapped,_,extended,code⟩ := calls.code source typeX small
+  obtain ⟨key,rfl⟩ := inv.valueReg x r mapped
+  have marked : Demanded next x := by
+    have implRun := calls.implRun
+    unfold ApplyInternal at implRun
+    have mono := stock_apply_demand_mono implRun x
+    rw [extended] at mono
+    change (before.mark x).demand[x]! ≤ next.demand[x]! at mono
+    rw [(mark_demand before x (extent x _ mapped)).1] at mono
+    unfold Demanded
+    omega
+  have holds := held.read marked (getAs_ok getX) mapped
+  have index : ((lo64 (ρ (aliasNum aliases key))).setWidth 32).toNat = bits.toNat := by
+    change (ρ (aliasNum aliases key)).setWidth 32 = bits at holds
+    rw [lo64,BitVec.setWidth_setWidth_of_le _ (by decide),holds]
+  refine ⟨tableCode calls.default calls.table (.vreg key .int) before.base.nextVreg,?_,?_,fun world => ?_⟩
+  · rw [code]; exact tableState_emitted _ _ _ _
+  · rw [code,tableState_nextVreg]
+    exact tableCode_defs _ _ _ _
+  · rw [tableCode_resolved bounded]
+    have execution := table_code_runs refines calls.default small (aliasNum aliases key) before.base.nextVreg index world
+    rw [← calls.labels_eq] at execution
+    exact execution
+
+/-- **A real named `br_table` on an `i32` index with fewer than 4096 targets takes the edge of the
+source index.** The rule, its calls and its exact code are derived from the actual named call; the
+resolved code stops at its last instruction, the `jt_sequence` with targets `labels`, on the edge
+`tableTarget bits.toNat ts.length` (`branchIdx`), with the initial register file and the same world
+but for the flags. -/
+theorem table_named_values {f : Clif.Function} {ctx : Ctx} (inv : MappedCtxInv f ctx)
+    {i x : Nat} {labels : List Label} (slot : ctx.insts[i]? = some ⟨tableData x,[],[],none⟩)
+    (typeX : ctx.valueType? x = some (.int 32)) (small : labels.length ≤ 4096)
+    {before next : State} {out : V} {trace : List RuleId}
+    (run : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels] before = .ok (some out,next,trace))
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    {fr : Clif.Frame} {bits : BitVec 32} (getX : fr.getAs x .i32 = .ok bits)
+    {aliases : Array (Option Nat)} {ρ : Nat → CV} (bounded : aliases.size ≤ before.base.nextVreg)
+    (extent : ∀ value r,ctx.valueReg? value = some r → value < before.demand.size)
+    (held : ValuesHeld (Demanded next) ctx fr (fun key => ρ (aliasNum aliases key))) :
+    ∃ (d : Label) (ts : List Label) (code : List MInst),labels = d :: ts ∧ next.base.emitted = before.base.emitted ++ code.toArray ∧
+      next.base.nextVreg = before.base.nextVreg+2 ∧
+      (∀ m ∈ code,∀ k ∈ vdefs m,before.base.nextVreg ≤ k ∧ k < next.base.nextVreg) ∧
+      ∀ world,LastTableExecution F isem labels (code.map
+        (·.mapRegs (Backend.lowerFunction.resolve aliases (aliases.size+1))))
+        (tableTarget bits.toNat ts.length) ρ world := by
+  obtain ⟨calls,source⟩ := table_named_calls slot run
+  have short : calls.table.length < 4096 := by
+    have equal := congrArg List.length calls.labels_eq
+    simp only [List.length_cons] at equal
+    omega
+  obtain ⟨_,_,_,_,code⟩ := calls.code source typeX short
+  obtain ⟨actual,emitted,defs,execution⟩ := calls.values inv source typeX short refines getX bounded extent held
+  refine ⟨calls.default,calls.table,actual,calls.labels_eq,emitted,?_,defs,execution⟩
+  rw [code]
+  exact tableState_nextVreg _ _ _ _
+
+/-- **The bounds of a real named `br_table` on an `i32` index with fewer than 4096 targets.** The
+frontier grows by the two temporaries, the demand array keeps its extent, and the index is
+demanded at the output state. -/
+theorem table_named_bounds {ctx : Ctx} {i x : Nat} {labels : List Label}
+    (slot : ctx.insts[i]? = some ⟨tableData x,[],[],none⟩)
+    (typeX : ctx.valueType? x = some (.int 32)) (small : labels.length ≤ 4096)
+    {before next : State} {out : V} {trace : List RuleId}
+    (run : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels] before = .ok (some out,next,trace))
+    (extent : x < before.demand.size) :
+    next.base.nextVreg = before.base.nextVreg+2 ∧ next.demand.size = before.demand.size ∧
+      Demanded next x := by
+  obtain ⟨calls,source⟩ := table_named_calls slot run
+  have short : calls.table.length < 4096 := by
+    have equal := congrArg List.length calls.labels_eq
+    simp only [List.length_cons] at equal
+    omega
+  obtain ⟨_,_,_,extended,code⟩ := calls.code source typeX short
+  refine ⟨by rw [code]; exact tableState_nextVreg _ _ _ _,Extent.named_demand_size run,?_⟩
+  have implRun := calls.implRun
+  unfold ApplyInternal at implRun
+  have mono := stock_apply_demand_mono implRun x
+  rw [extended] at mono
+  change (before.mark x).demand[x]! ≤ next.demand[x]! at mono
+  rw [(mark_demand before x extent).1] at mono
+  unfold Demanded
+  omega
+
+/-- **A `br_table` on an `i32` index with fewer than 4096 targets has a fixed allocation**: any two
+real named runs at the same slot, from any inputs and with any such labels, allocate the same
+number of registers (the form of `ConditionalBodySpec.FixedAllocation`). -/
+theorem table_fixed_allocation {ctx : Ctx} {i x : Nat}
+    (slot : ctx.insts[i]? = some ⟨tableData x,[],[],none⟩)
+    (typeX : ctx.valueType? x = some (.int 32)) {labels labels' : List Label}
+    (small : labels.length ≤ 4096) (small' : labels'.length ≤ 4096)
+    {before before' next next' : State} {out out' : V} {trace trace' : List RuleId}
+    (run : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels] before = .ok (some out,next,trace))
+    (run' : Stock.runTerm ctx "lower_branch" [.inst i,.labels labels'] before' = .ok (some out',next',trace')) :
+    next'.base.nextVreg + before.base.nextVreg = before'.base.nextVreg + next.base.nextVreg := by
+  obtain ⟨_,_,_,_,_,_,_,frontier⟩ := table_named_code slot typeX small run
+  obtain ⟨_,_,_,_,_,_,_,frontier'⟩ := table_named_code slot typeX small' run'
+  omega
+
+end Backend.Stock.Proof.TableBranch
diff --git a/FV/Backend/Proof/StockTableWitness.lean b/FV/Backend/Proof/StockTableWitness.lean
new file mode 100644
index 000000000..580173cab
--- /dev/null
+++ b/FV/Backend/Proof/StockTableWitness.lean
@@ -0,0 +1,294 @@
+import FV.Clif.Parse
+import FV.Backend.Proof.StockTableCore
+import FV.Backend.Proof.LowerDecide
+
+/-! Non-vacuity of the Stock `br_table` theorems on the real `%f` of
+`third_party/wasmtime/cranelift/filetests/filetests/isa/aarch64/jumptable.clif` (#140, CB-14a).
+
+```
+function %f(i32) -> i32 {
+block0(v0: i32):
+  br_table v0, block4, [block1, block2, block3]
+...
+```
+
+The text of `%f` parses to `function`. Its Stock lowering gives block 0 the successors
+`[4, 3, 2, 1]` (the default, then the table in layout labels), and the final code of block 0 is the
+entry argument move followed by `tableCode 4 [3, 2, 1] v192 204`: `emit_island 44`,
+`subs wzr, v192, #3` and `jt_sequence` with the temporaries `v204`, `v205`, as in the filetest's
+expected VCode (`jumptable_lowered`). In the real built context, the terminator slot of block 0
+with its prepared data satisfies every premise of `table_named_code` and `table_named_values`, and
+the actual named branch run succeeds (`jumptable_table_values`). The actual retained core of
+block 0 satisfies the premises of `stock_lower_table_core` and `CoreOrigin.table_values`: its
+retained emission is `tableCode 4 [3, 2, 1] r n` at the frontier `n` of its actual input, and it
+takes the `branchIdx` edge of the source index (`jumptable_core`). One marked `native_decide`
+evaluates the parse, the scope check, the context build, the named branch run and the lowering of
+this fixed function. -/
+
+namespace Backend.Stock.Proof.TableBranch.Witness
+open Backend.Proof Backend.Proof.Driver Isle Isle.Interp Isle.Aarch64 ConditionalValues
+set_option autoImplicit false
+set_option maxRecDepth 20000
+attribute [local irreducible] Isle.Aarch64.program
+
+/-- The text of `%f` in `jumptable.clif`. -/
+def source : String := "function %f(i32) -> i32 {
+block0(v0: i32):
+  br_table v0, block4, [block1, block2, block3]
+
+block1:
+  v1 = iconst.i32 1
+  jump block5(v1)
+
+block2:
+  v2 = iconst.i32 2
+  jump block5(v2)
+
+block3:
+  v3 = iconst.i32 3
+  jump block5(v3)
+
+block4:
+  v4 = iconst.i32 4
+  jump block5(v4)
+
+block5(v5: i32):
+  v6 = iadd.i32 v0, v5
+  return v6
+}
+"
+
+/-- `%f` as a `Clif.Function` literal. -/
+def function : Clif.Function := {
+  name := "f"
+  sig := { params := [⟨.i32,.none,.normal⟩], returns := [⟨.i32,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i32)], body := [], term := .brTable 0 ⟨4,[]⟩ [⟨1,[]⟩,⟨2,[]⟩,⟨3,[]⟩] },
+    { id := 1, params := [], body := [⟨[1],.iconst .i32 1⟩], term := .jump ⟨5,[1]⟩ },
+    { id := 2, params := [], body := [⟨[2],.iconst .i32 2⟩], term := .jump ⟨5,[2]⟩ },
+    { id := 3, params := [], body := [⟨[3],.iconst .i32 3⟩], term := .jump ⟨5,[3]⟩ },
+    { id := 4, params := [], body := [⟨[4],.iconst .i32 4⟩], term := .jump ⟨5,[4]⟩ },
+    { id := 5, params := [(5,.i32)], body := [⟨[6],.binary .iadd .i32 0 5⟩], term := .ret [6] }] }
+
+/-- The successor labels of block 0: the default, then the table. -/
+def labels : List Label := [4,3,2,1]
+
+/-- The final code of block 0: the entry argument move, then the resolved table code. -/
+def blockCode : Array MInst :=
+  #[.args [(.vreg 192 .int,.x 0)]] ++ (tableCode 4 [3,2,1] (.vreg 192 .int) 204).toArray
+
+@[irreducible] private def built : Ctx × Array (Nat × Nat) × State :=
+  (Stock.buildCtx function).toOption.getD (sinkCtx,#[],sinkState)
+private def ctx : Ctx := Driver.termCtx built.1 0 (tableData 0)
+
+/-- The executable facts of the witness. -/
+private def checks : Bool :=
+  decide ((Clif.parseFile source).funcs.map (·.func.toOption) = [some function]) &&
+  lowerScopeB function &&
+  (Stock.buildCtx function).toOption.isSome &&
+  decide (built.1.valueType? 0 = some (.int 32)) &&
+  (match Stock.runTerm ctx "lower_branch" [.inst 0,.labels labels] built.2.2 with
+    | .ok (some _,_,_) => true
+    | _ => false) &&
+  match Stock.lower function with
+  | .ok result => decide (result.order.successors[0]? = some labels.toArray) &&
+      decide (result.code.blocks[0]?.map (·.insts) = some blockCode) &&
+      decide (result.order.nodes[0]? = some (.original 0))
+  | .error _ => false
+
+-- witness: native_decide (the parse, scope check, context build, named branch run and lowering of the fixed function %f only)
+private theorem checks_true : checks = true := by native_decide -- witness: native_decide
+
+private theorem parts :
+    decide ((Clif.parseFile source).funcs.map (·.func.toOption) = [some function]) = true ∧
+    lowerScopeB function = true ∧ (Stock.buildCtx function).toOption.isSome = true ∧
+    decide (built.1.valueType? 0 = some (.int 32)) = true ∧
+    (match Stock.runTerm ctx "lower_branch" [.inst 0,.labels labels] built.2.2 with
+      | .ok (some _,_,_) => true
+      | _ => false) = true ∧
+    (match Stock.lower function with
+      | .ok result => decide (result.order.successors[0]? = some labels.toArray) &&
+          decide (result.code.blocks[0]?.map (·.insts) = some blockCode) &&
+          decide (result.order.nodes[0]? = some (.original 0))
+      | .error _ => false) = true := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨⟨⟨⟨parse,scope⟩,build⟩,typed⟩,branch⟩,lowered⟩ := h
+  exact ⟨parse,scope,build,typed,branch,lowered⟩
+
+private theorem scope : LowerScope function := lowerScope_of parts.2.1
+
+private theorem build : Stock.buildCtx function = .ok (built.1,built.2.1,built.2.2) := by
+  have present := parts.2.2.1
+  unfold built
+  cases actual : Stock.buildCtx function with
+  | error message => rw [actual] at present; cases present
+  | ok value => rfl
+
+private theorem placeholder : built.1.insts[0]? = some ⟨.op .unit,[],[],none⟩ := by
+  obtain ⟨original,st0,_,ctxSpec,view⟩ := buildCtx_source build
+  rw [view.insts]
+  exact ctxSpec.facts.term 0 _ rfl
+
+private theorem inv : MappedCtxInv function ctx := (buildCtx_mappedInv scope build).termCtx placeholder _
+
+private theorem slot : ctx.insts[0]? = some ⟨tableData 0,[],[],none⟩ := by
+  have inside := (Array.getElem?_eq_some_iff.mp placeholder).1
+  change (built.1.insts.set! 0 ⟨tableData 0,[],[],none⟩)[0]? = _
+  simp only [Array.set!_eq_setIfInBounds,Array.getElem?_setIfInBounds_self_of_lt inside]
+
+private theorem typed : ctx.valueType? 0 = some (.int 32) := of_decide_eq_true parts.2.2.2.1
+
+private theorem lower_build {f : Clif.Function} {result : Result} (run : Stock.lower f = .ok result) :
+    ∃ ranges,Stock.buildCtx f = .ok (result.ctx,ranges,result.initial) := by
+  unfold Stock.lower at run
+  dsimp only at run
+  repeat' first
+    | (solve | cases run)
+    | simp only [bind,Except.bind,pure,Except.pure] at run
+    | split at run
+  cases run
+  exact ⟨_,by assumption⟩
+
+/-- The prepared data of the terminator of block 0 is `tableData 0`. -/
+theorem prepared : Coverage.blockData function (function.blocks[0]!.term) = .ok (tableData 0) := by
+  with_unfolding_all rfl
+
+/-- **The real `%f` of `jumptable.clif` lowers to the table code.** The text parses to `function`,
+which is in the lowering scope; Stock lowering succeeds, block 0 has the successors `[4, 3, 2, 1]`,
+and its final code is the entry argument move followed by `tableCode 4 [3, 2, 1] v192 204`. -/
+theorem jumptable_lowered :
+    (Clif.parseFile source).funcs.map (·.func.toOption) = [some function] ∧ LowerScope function ∧
+    ∃ result,Stock.lower function = .ok result ∧ result.order.successors[0]? = some labels.toArray ∧
+      result.code.blocks[0]?.map (·.insts) = some blockCode := by
+  have lowered := parts.2.2.2.2.2
+  refine ⟨of_decide_eq_true parts.1,scope,?_⟩
+  cases run : Stock.lower function with
+  | error message => rw [run] at lowered; cases lowered
+  | ok result =>
+    rw [run] at lowered
+    simp only [Bool.and_eq_true,decide_eq_true_eq] at lowered
+    exact ⟨result,rfl,lowered.1.1,lowered.1.2⟩
+
+/-- **The table theorems apply to the real terminator of `%f`.** In the built context of the real
+lowering, the slot of the `br_table` of block 0 with its prepared data `tableData 0` satisfies the
+premises of `table_named_code` and `table_named_values`, and the actual named branch run from the
+initial state succeeds. Its code is exactly `tableCode 4 [3, 2, 1] r` at the initial frontier, and
+from values held at its output it stops at the `jt_sequence` on the `branchIdx` edge of the source
+index `bits` (`tableTarget bits.toNat 3`). -/
+theorem jumptable_table_values :
+    ∃ result,Stock.lower function = .ok result ∧ result.order.successors[0]? = some labels.toArray ∧
+      MappedCtxInv function (Driver.termCtx result.ctx 0 (tableData 0)) ∧
+      (Driver.termCtx result.ctx 0 (tableData 0)).insts[0]? = some ⟨tableData 0,[],[],none⟩ ∧
+      (Driver.termCtx result.ctx 0 (tableData 0)).valueType? 0 = some (.int 32) ∧
+      ∃ out next trace r,
+        Stock.runTerm (Driver.termCtx result.ctx 0 (tableData 0)) "lower_branch"
+          [.inst 0,.labels labels] result.initial = .ok (some out,next,trace) ∧
+        (Driver.termCtx result.ctx 0 (tableData 0)).valueReg? 0 = some r ∧
+        next.base = tableState result.initial.base 4 [3,2,1] r ∧
+        next.base.emitted = result.initial.base.emitted ++
+          (tableCode 4 [3,2,1] r result.initial.base.nextVreg).toArray ∧
+        ∀ {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem},Refines F isem →
+          ∀ {fr : Clif.Frame} {bits : BitVec 32},fr.getAs 0 .i32 = .ok bits →
+          ∀ {aliases : Array (Option Nat)} {ρ : Nat → CV},aliases.size ≤ result.initial.base.nextVreg →
+          (∀ value r,(Driver.termCtx result.ctx 0 (tableData 0)).valueReg? value = some r →
+            value < result.initial.demand.size) →
+          ValuesHeld (Demanded next) (Driver.termCtx result.ctx 0 (tableData 0)) fr
+            (fun key => ρ (aliasNum aliases key)) →
+          ∃ code : List MInst,next.base.emitted = result.initial.base.emitted ++ code.toArray ∧
+            ∀ world,LastTableExecution F isem labels (code.map
+              (·.mapRegs (Backend.lowerFunction.resolve aliases (aliases.size+1))))
+              (tableTarget bits.toNat 3) ρ world := by
+  have lowered := parts.2.2.2.2.2
+  have success := parts.2.2.2.2.1
+  cases run : Stock.lower function with
+  | error message => rw [run] at lowered; cases lowered
+  | ok result =>
+    rw [run] at lowered
+    simp only [Bool.and_eq_true,decide_eq_true_eq] at lowered
+    obtain ⟨ranges,created⟩ := lower_build run
+    have same := Except.ok.inj (created.symm.trans build)
+    have context : result.ctx = built.1 := congrArg Prod.fst same
+    have initial : result.initial = built.2.2 := congrArg (fun p => p.2.2) same
+    cases branch : Stock.runTerm ctx "lower_branch" [.inst 0,.labels labels] built.2.2 with
+    | error e => rw [branch] at success; cases success
+    | ok q =>
+      obtain ⟨out,next,trace⟩ := q
+      cases out with
+      | none => rw [branch] at success; cases success
+      | some out =>
+        obtain ⟨d,ts,r,labelsEq,mapped,_,state,emitted,_⟩ := table_named_code slot typed (by decide) branch
+        simp only [labels,List.cons.injEq] at labelsEq
+        obtain ⟨rfl,rfl⟩ := labelsEq
+        refine ⟨result,rfl,lowered.1.1,?_⟩
+        rw [context,initial]
+        refine ⟨inv,slot,typed,out,next,trace,r,branch,mapped,state,emitted,?_⟩
+        intro F isem refines fr bits getX aliases ρ bounded extent held
+        obtain ⟨d',ts',code,labelsEq',codeEq,_,_,execution⟩ :=
+          table_named_values inv slot typed (by decide) branch refines getX bounded extent held
+        simp only [labels,List.cons.injEq] at labelsEq'
+        obtain ⟨rfl,rfl⟩ := labelsEq'
+        exact ⟨code,codeEq,execution⟩
+
+/-- **The table theorems apply to the actual retained core of `%f`.** Block 0 is the original
+block at label 0 of the real lowering. Its actual core retains its named branch run in the actual
+terminator context, which satisfies `MappedCtxInv`; the retained code is exactly
+`tableCode 4 [3, 2, 1] r n` at the frontier `n` of the actual core input, with `r` the register of
+`v0`; and from values held at the emission output, the resolved retained code stops at its
+`jt_sequence` on the `branchIdx` edge `tableTarget bits.toNat 3` of the source index `bits`. -/
+theorem jumptable_core :
+    ∃ result,Stock.lower function = .ok result ∧ result.order.nodes[0]? = some (.original 0) ∧
+      result.code.blocks[0]?.map (·.insts) = some blockCode ∧
+      ∃ (ranges : Array (Nat × Nat)) (input : State) (core : LoweredBlockCore)
+        (origin : CoreOrigin {Driver.termCtx result.ctx (ranges[0]!.2-1) (tableData 0) with
+            tryRegs := input.tryRegs[ranges[0]!.2-1]!}
+          function 0 (ranges[0]!.2-1) result.order.successors[0]! input core),
+        lowerBlockCore result.ctx result.order function function.blocks[0]! 0 ranges[0]!.1 ranges[0]!.2
+          (tableData 0) result.order.successors[0]! input = .ok core ∧
+        core.scan ∈ result.blockScans.toList ∧ MappedCtxInv function core.scan.ctx ∧
+        ∃ r,result.ctx.valueReg? 0 = some r ∧
+          origin.emission.code = (tableCode 4 [3,2,1] r input.base.nextVreg).toArray ∧
+          origin.emission.state.base.nextVreg = input.base.nextVreg+2 ∧
+          ∀ {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem},Refines F isem →
+            ∀ {fr : Clif.Frame} {bits : BitVec 32},fr.getAs 0 .i32 = .ok bits →
+            ∀ {aliases : Array (Option Nat)} {ρ : Nat → CV},aliases.size ≤ input.base.nextVreg →
+            (∀ value r,core.scan.ctx.valueReg? value = some r → value < input.demand.size) →
+            ValuesHeld (Demanded origin.emission.state) core.scan.ctx fr
+              (fun key => ρ (aliasNum aliases key)) →
+            ∀ world,LastTableExecution F isem labels (origin.emission.code.toList.map
+              (·.mapRegs (Backend.lowerFunction.resolve aliases (aliases.size+1))))
+              (tableTarget bits.toNat 3) ρ world := by
+  have lowered := parts.2.2.2.2.2
+  cases run : Stock.lower function with
+  | error message => rw [run] at lowered; cases lowered
+  | ok result =>
+    rw [run] at lowered
+    simp only [Bool.and_eq_true,decide_eq_true_eq] at lowered
+    obtain ⟨⟨successors,code⟩,tag⟩ := lowered
+    obtain ⟨ranges,created⟩ := lower_build run
+    have same := Except.ok.inj (created.symm.trans build)
+    have context : result.ctx = built.1 := congrArg Prod.fst same
+    have typeX : result.ctx.valueType? 0 = some (.int 32) := by rw [context]; exact typed
+    have successorsEq : result.order.successors[0]! = labels.toArray := by
+      rw [getElem!_def,successors]
+    have small : result.order.successors[0]!.size ≤ 4096 := by rw [successorsEq]; decide
+    obtain ⟨ranges',input,core,origin,_,coreRun,events,_,scanCtx,inv',slot',typeHere,d,ts,r,labelsEq,
+      mapped,emitted,frontier⟩ :=
+      stock_lower_table_core run scope tag rfl rfl typeX small
+    rw [successorsEq] at labelsEq
+    simp only [labels,List.cons.injEq] at labelsEq
+    obtain ⟨rfl,rfl⟩ := labelsEq
+    refine ⟨result,rfl,tag,code,ranges',input,core,origin,coreRun,events,inv',r,mapped,emitted,frontier,?_⟩
+    intro F isem refines fr bits getX aliases ρ bounded extent held world
+    rw [scanCtx] at inv' slot' typeHere extent held
+    obtain ⟨d,ts,labelsEq,_,_,execution⟩ :=
+      origin.table_values inv' slot' typeHere small refines getX bounded extent held
+    have labelsActual : labels = result.order.successors[0]!.toList := by rw [successorsEq]
+    rw [successorsEq] at labelsEq
+    simp only [labels,List.cons.injEq] at labelsEq
+    obtain ⟨rfl,rfl⟩ := labelsEq
+    rw [labelsActual]
+    exact execution world
+
+end Backend.Stock.Proof.TableBranch.Witness
