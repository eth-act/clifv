+    (run : ApplyInternal program (Stock.sem ctx) {} fuel 25 243 [.data 46 0 [i]] st out next) :
+    ∃ m,MInst.ofV i = some m ∧ next.1 = {st.1 with base := st.1.base.emit m} ∧ out = .regsVec [] := by
+  obtain ⟨legacy,frame⟩ := pure_call (by decide) run
