+private theorem small_imm12 {k : Nat} (small : k < 4096) :
+    Imm12.ofNat? (u64 (k : Int)) = some ⟨k,false⟩ := by
+  rw [u64_natCast (by omega)]
+  unfold Imm12.ofNat?
+  have masked : mask64 k = k := by unfold mask64; omega
