i✝ : Insn
s✝ : VectorSize
rd✝ : Reg
imm8✝ : Nat
heq✝ : Insn.bfm op wide dest pointer immr imms = Insn.movi s✝ rd✝ imm8✝
encoded :
  (have __do_jp := fun cmode => do
      let imm ← uField "movi immediate" 8 imm8✝
      let __do_lift ← rd✝.encV
      pure
          (Arm.ArmInst.DPSFP
            (Arm.DataProcSFPInst.Advanced_simd_modified_immediate
              { Q := s✝.qsize.fst, op := 0, a := BitVec.extractLsb' 7 1 imm, b := BitVec.extractLsb' 6 1 imm,
                c := BitVec.extractLsb' 5 1 imm, cmode := cmode, o2 := 0, d := BitVec.extractLsb' 4 1 imm,
                e := BitVec.extractLsb' 3 1 imm, f := BitVec.extractLsb' 2 1 imm, g := BitVec.extractLsb' 1 1 imm,
                h := BitVec.extractLsb' 0 1 imm, Rd := __do_lift }));
    match s✝ with
    | VectorSize.size8x8 => do
      let cmode ← pure 14
      __do_jp cmode
    | VectorSize.size8x16 => do
      let cmode ← pure 14
      __do_jp cmode
    | VectorSize.size16x4 => do
      let cmode ← pure 8
      __do_jp cmode
    | VectorSize.size16x8 => do
      let cmode ← pure 8
      __do_jp cmode
    | VectorSize.size32x2 => do
      let cmode ← pure 0
      __do_jp cmode
    | VectorSize.size32x4 => do
      let cmode ← pure 0
      __do_jp cmode
    | VectorSize.size64x2 => do
      let cmode ← throw "movi arrangement 2d"
      __do_jp cmode) =
    Except.ok sorry
