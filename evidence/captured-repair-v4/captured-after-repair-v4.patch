new file mode 100644
index 00000000..774c9f62
--- /dev/null
+++ b/FV/E2E/StockMemoryCfgPairedFunction.lean
@@ -0,0 +1,46 @@
+import FV.E2E.StockMemoryTwoBlockPaired
+import FV.Backend.Proof.StockMemoryCfgClass
+
+namespace E2E.StockMemoryCfg
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The source-only CFG class supplies the complete paired ABI execution. -/
+theorem paired_returns {f : Clif.Function} {result : Result}
+    (family : Backend.Stock.MemoryCfg.TwoBlockClass f) (run : Stock.lower f = .ok result)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame} (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {vals : List Clif.Val} {mem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals mem)
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    (slot : fc.slotBase = Γ.slotOff)
+    (symbols : ∀ n a,Γ.syms n = some a → X.sym n 0 = BitVec.ofNat 64 a)
+    (tls : XTls Γ.F X)
+    {w w' : Arm.ArmState} (memory : MRP Γ f c D fr.slots cm (w,w'))
+    (arguments : ArgsAtEntry Γ.F f.sig args w) (otherArguments : ArgsAtEntry Γ.F f.sig args w')
+    (registers : ∀ pin v,(.reg pin,v) ∈ (locsOf f.sig).zip args → regVal w' pin = regVal w pin) :
+    RunOkABI f result.code (pairSem (csem Γ.F fc X)) (MRP Γ f c D) fr.slots
+      ⟨0,0,entrySeed result.ctx fr,(w,w')⟩ (.returned vals mem) := by
+  obtain ⟨entry,target,x,z,flags,blocks,entryBody,targetBody,jump,ret,parameter,notrap⟩ := family.shape
+  have nops : ∀ stm ∈ entry.body,stm.inst = .nop := by
+    intro stm member
+    have equal : stm = ⟨[],.nop⟩ := by simpa only [entryBody,List.mem_singleton] using member
+    subst stm
+    rfl
+  have shape : ∀ j stm,target.body[j]? = some stm → j = 1 ∨ stm.inst = .nop := by
+    intro j stm found
+    cases j with
+    | zero =>
+      simp [targetBody] at found
+      subst stm
+      exact .inr rfl
+    | succ j =>
+      cases j with
+      | zero => exact .inl rfl
+      | succ j => simp [targetBody] at found
+  exact StockMemory.stock_two_block_load_return_paired_function run family.scope family.dominated family.abi
+    blocks nops jump (loadIndex := 1) (by rw [targetBody]; rfl) shape ret parameter entered family.registers
+    slot symbols tls returned memory arguments otherArguments registers
+
+end E2E.StockMemoryCfg
diff --git a/FV/E2E/StockMemoryCfgTls.lean b/FV/E2E/StockMemoryCfgTls.lean
new file mode 100644
index 00000000..b21d6d69
--- /dev/null
+++ b/FV/E2E/StockMemoryCfgTls.lean
@@ -0,0 +1,51 @@
+import FV.E2E.StockMemoryCfgValue
+
+namespace E2E.StockMemoryCfg
+open Backend Backend.Proof Backend.Proof.Driver
+set_option autoImplicit false
+set_option Elab.async false
+
+/-- TLS flags are irrelevant to the checked CFG effects. -/
+def fixedTlsFlags (X : ExtSem) : ExtSem := {X with tlsFlags := fun _ _ => Arm.PState.zero}
+
+theorem fixedTlsFlags_ok (F : BitVec 64 → Prop) (X : ExtSem) : XTls F (fixedTlsFlags X) := by
+  intro Z n w w' subset same
+  rfl
+
+private theorem instruction_tls {vc : VCode} (checked : effectsOnly vc = true)
+    {b k : Nat} {vb : VBlock} {i : MInst}
+    (block : vc.blocks[b]? = some vb) (inst : vb.insts[k]? = some i)
+    (F : BitVec 64 → Prop) (fc : FnCtx) (X : ExtSem) :
+    csem F fc (fixedTlsFlags X) i = csem F fc X i := by
+  have blocks := List.all_eq_true.mp checked vb (by simpa using Array.mem_of_getElem? block)
+  have good := List.all_eq_true.mp blocks i (by simpa using Array.mem_of_getElem? inst)
+  cases i <;> simp only [Backend.Stock.MemoryCfg.effectInstruction] at good <;> try cases good
+  all_goals rfl
+
+private theorem step_tls {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {s t : VConf CV Arm.ArmState}
+    (step : VStep vc (csem F fc (fixedTlsFlags X)) s t) : VStep vc (csem F fc X) s t := by
+  cases step with
+  | step block inst operands run arity next =>
+    refine .step block inst operands ?_ arity next
+    rwa [instruction_tls checked block inst F fc X] at run
+
+private theorem star_tls {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {s t : VConf CV Arm.ArmState}
+    (steps : Star (VStep vc (csem F fc (fixedTlsFlags X))) s t) :
+    Star (VStep vc (csem F fc X)) s t := by
+  induction steps with
+  | refl => exact .refl _
+  | step first rest ih => exact .step (step_tls checked first) ih
+
+/-- The actual code returns identically with the original TLS flags, for any external semantics. -/
+theorem return_original_tls {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {vs : VState CV Arm.ArmState}
+    {us : List (Reg × Reg)} {outs : List CV} {world : Arm.ArmState}
+    (returned : VRetFrom vc (csem F fc (fixedTlsFlags X)) vs us outs world) :
+    VRetFrom vc (csem F fc X) vs us outs world := by
+  obtain ⟨b,k,ρ,w,vb,ops,results,path,block,inst,operands,values,run⟩ := returned
+  refine ⟨b,k,ρ,w,vb,ops,results,star_tls checked path,block,inst,operands,values,?_⟩
+  rwa [instruction_tls checked block inst F fc X] at run
+
+end E2E.StockMemoryCfg
diff --git a/FV/E2E/StockMemoryCfgValue.lean b/FV/E2E/StockMemoryCfgValue.lean
new file mode 100644
index 00000000..ab81d004
--- /dev/null
+++ b/FV/E2E/StockMemoryCfgValue.lean
@@ -0,0 +1,58 @@
+import FV.E2E.StockMemoryValue
+import FV.Backend.StockMemoryCfgCheck
+
+namespace E2E.StockMemoryCfg
+open Backend Backend.Proof Backend.Proof.Driver Backend.DeadCleanup
+set_option autoImplicit false
+set_option Elab.async false
+
+/-- The memory CFG adapter only needs effects whose value semantics is their
+concrete semantics. This property is checked on the actual emitted artifact. -/
+abbrev effectsOnly := Backend.Stock.MemoryCfg.effectsOnly
+
+theorem effectsOnly_instruction {vc : VCode} (checked : effectsOnly vc = true)
+    {b k : Nat} {vb : VBlock} {i : MInst}
+    (block : vc.blocks[b]? = some vb) (inst : vb.insts[k]? = some i) :
+    pureForm i = false := by
+  have blocks := List.all_eq_true.mp checked vb (by simpa using Array.mem_of_getElem? block)
+  have instruction := List.all_eq_true.mp blocks i (by simpa using Array.mem_of_getElem? inst)
+  cases i <;> simp_all [Backend.Stock.MemoryCfg.effectInstruction,pureForm]
+
+/-- The checked effect whitelist also excludes the compare specifications added
+by the current cleanup semantics. The preserved pure-only variant stays above. -/
+private theorem effectsOnly_spec_instruction {vc : VCode} (checked : effectsOnly vc = true)
+    {b k : Nat} {vb : VBlock} {i : MInst}
+    (block : vc.blocks[b]? = some vb) (inst : vb.insts[k]? = some i) :
+    specForm i = false := by
+  have blocks := List.all_eq_true.mp checked vb (by simpa using Array.mem_of_getElem? block)
+  have instruction := List.all_eq_true.mp blocks i (by simpa using Array.mem_of_getElem? inst)
+  cases i <;> simp_all [Backend.Stock.MemoryCfg.effectInstruction,specForm,pureForm,cmpForm]
+
+private theorem value_step {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {s t : VConf CV Arm.ArmState}
+    (step : VStep vc (csem F fc X) s t) : VStep vc (valueSem F fc X) s t := by
+  cases step with
+  | step block inst operands run arity next =>
+    refine .step block inst operands ?_ arity next
+    simpa only [valueSem,effectsOnly_spec_instruction checked block inst,Bool.false_eq_true,ite_false] using run
+
+private theorem value_star {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {s t : VConf CV Arm.ArmState}
+    (path : Star (VStep vc (csem F fc X)) s t) : Star (VStep vc (valueSem F fc X)) s t := by
+  induction path with
+  | refl => exact .refl _
+  | step first rest ih => exact .step (value_step checked first) ih
+
+/-- On checked actual effect-only code, the production value consumer executes
+exactly the concrete run, including its final world and ABI output tuple. -/
+theorem return_value {vc : VCode} (checked : effectsOnly vc = true)
+    {F : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem} {vs : VState CV Arm.ArmState}
+    {us : List (Reg × Reg)} {outs : List CV} {world : Arm.ArmState}
+    (returned : VRetFrom vc (csem F fc X) vs us outs world) :
+    VRetFrom vc (valueSem F fc X) vs us outs world := by
+  obtain ⟨b,k,ρ,w,vb,ops,results,path,block,inst,operands,values,run⟩ := returned
+  have transferred := value_star checked path
+  refine ⟨b,k,ρ,w,vb,ops,results,transferred,block,inst,operands,values,?_⟩
+  simpa only [valueSem,effectsOnly_spec_instruction checked block inst,Bool.false_eq_true,ite_false] using run
+
+end E2E.StockMemoryCfg
