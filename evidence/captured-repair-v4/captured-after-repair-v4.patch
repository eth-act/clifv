+import FV.Backend.Proof.StockMemoryCapturedFixture
+import FV.Backend.Proof.StockSourceEntry
+
+namespace Backend.Stock.Memory.CapturedFixture
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+def initial : Clif.Frame := { LoadFixture.frame with
+  func := function
+  body := function.blocks[0]!.body
+  term := function.blocks[0]!.term }
+
+/-- The original ABI arguments enter the actual captured function. -/
+theorem source_entered :
+    Clif.enterFunc function [⟨.i64,4096⟩] LoadFixture.heap =
+      .ok (initial,LoadFixture.heap) := rfl
+
+/-- Five original source steps cross the jump and read the initialized heap. -/
+theorem source_returned :
+    Clif.runLoop Clif.Env.empty {funcs := []} 5 ⟨initial,[],LoadFixture.heap⟩ =
+      .returned [⟨.i32,2779096485⟩] LoadFixture.heap := rfl
+
+theorem source_entry : SourceEntry function [⟨.i64,4096⟩] initial :=
+  SourceEntry.of_enterFunc source_entered
+
+end Backend.Stock.Memory.CapturedFixture
diff --git a/FV/Backend/Proof/StockMemoryCfgClass.lean b/FV/Backend/Proof/StockMemoryCfgClass.lean
new file mode 100644
index 00000000..3f702560
--- /dev/null
+++ b/FV/Backend/Proof/StockMemoryCfgClass.lean
@@ -0,0 +1,71 @@
+import FV.Backend.StockMemoryCfgCheck
+import FV.Backend.Proof.LowerDecide
+import FV.Backend.Proof.StockMemoryClass
+
+namespace Backend.Stock.MemoryCfg
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original source conditions for the captured memory CFG class. -/
+structure TwoBlockClass (f : Clif.Function) : Prop where
+  scope : LowerScope f
+  dominated : Dominated f
+  abi : sigAbiOk f.sig = true
+  ordinary : (sigRets f.sig).any (·.purpose == .sret) = false
+  registers : ∀ loc ∈ locsOf f.sig,∃ pin,loc = .reg pin
+  shape : ∃ (entry target : Clif.Block) (x z : Nat) (flags : Clif.MemFlags),
+    f.blocks = [entry,target] ∧ entry.body = [⟨[],.nop⟩] ∧
+      target.body = [⟨[],.nop⟩,⟨[z],.load .load .i32 flags x 0⟩] ∧
+      entry.term = .jump ⟨target.id,[]⟩ ∧ target.term = .ret [z] ∧
+      x ∈ entry.params.map (·.1) ∧ flags.trapCode = none
+
+/-- Source checks derive the class without requiring a compiled artifact. -/
+theorem sourceOk_sound {f : Clif.Function} (checked : sourceOk f = true) : TwoBlockClass f := by
+  simp only [sourceOk,Bool.and_eq_true,Bool.not_eq_true'] at checked
+  obtain ⟨⟨⟨⟨⟨shapeOk,scope⟩,dominated⟩,abi⟩,ordinary⟩,registers⟩ := checked
+  refine ⟨lowerScope_of scope,dominated_of dominated,abi,ordinary,?_,?_⟩
+  · intro loc member
+    have good := List.all_eq_true.mp registers loc member
+    cases loc with
+    | reg pin => exact ⟨pin,rfl⟩
+    | stack off => cases good
+  · unfold eligible at shapeOk
+    split at shapeOk
+    next entry target blocks =>
+      split at shapeOk
+      next z flags x dst ret entryBody targetBody jump terminal =>
+        simp only [Bool.and_eq_true,beq_iff_eq] at shapeOk
+        obtain ⟨⟨⟨destination,same⟩,parameter⟩,notrap⟩ := shapeOk
+        subst dst
+        subst ret
+        exact ⟨entry,target,x,z,flags,blocks,entryBody,targetBody,jump,terminal,
+          List.contains_iff_mem.mp parameter,Option.isNone_iff_eq_none.mp notrap⟩
+      next => cases shapeOk
+    next => cases shapeOk
+
+/-- Artifact validation binds the source class to the actual returned Stock code. -/
+theorem check_sound {f : Clif.Function} {vc : VCode} (checked : check f vc = true) :
+    ∃ result,TwoBlockClass f ∧ Stock.lower f = .ok result ∧ result.code = vc ∧ effectsOnly vc = true := by
+  simp only [check,Bool.and_eq_true] at checked
+  obtain ⟨source,lowered⟩ := checked
+  cases run : Stock.lower f with
+  | error error => rw [run] at lowered; cases lowered
+  | ok result =>
+    rw [run] at lowered
+    obtain ⟨equal,effects⟩ := Bool.and_eq_true_iff.mp lowered
+    exact ⟨result,sourceOk_sound source,rfl,of_decide_eq_true equal,effects⟩
+
+/-- The CFG whitelist excludes TLS helpers from the actual code. -/
+theorem effectsOnly_noTls {vc : VCode} (checked : effectsOnly vc = true) : vc.hasTls = false := by
+  rw [VCode.hasTls,Array.any_eq_false']
+  intro vb member
+  apply Bool.eq_false_iff.mp
+  apply Array.any_eq_false'.mpr
+  intro i present
+  have blocks := List.all_eq_true.mp checked vb (Array.mem_toList_iff.mpr member)
+  have good := List.all_eq_true.mp blocks i (Array.mem_toList_iff.mpr present)
+  cases i <;> simp_all [effectInstruction]
+
+end Backend.Stock.MemoryCfg
diff --git a/FV/Backend/Proof/StockMemoryCfgCompatibility.lean b/FV/Backend/Proof/StockMemoryCfgCompatibility.lean
new file mode 100644
index 00000000..f9d8bbfd
--- /dev/null
+++ b/FV/Backend/Proof/StockMemoryCfgCompatibility.lean
@@ -0,0 +1,39 @@
+import FV.Backend.MemoryCfgNIProduction
+
+namespace Backend.Stock.MemoryCfg
+set_option autoImplicit false
+set_option maxRecDepth 20000
+set_option maxHeartbeats 4000000
+
+/-- Programs outside the optional memory selector use exactly the previous
+pipeline, including allocator effects, identities, output bytes and stages.
+This is a compatibility fact; it adds no compiler input requirement. -/
+theorem previous_file_exact {m : Type → Type} [Monad m]
+    (enabled : Bool) (allocate : Array VCode → m (Array (Except String AFunc)))
+    (pf : Clif.ParsedFile) (prior : List (String × String)) (cleanup : Bool)
+    (none : (pf.funcs.any fun p => p.func.toOption.any eligible) = false) :
+    compileFileMemoryCfgNIWhen enabled allocate pf prior cleanup =
+      compileFileMemoryNIWhen enabled allocate pf prior cleanup := by
+  cases enabled <;> simp [compileFileMemoryCfgNIWhen,none]
+
+/-- A nonempty ordinary return input inhabits the
+compatibility premise. The theorem holds for every allocator, not only this
+witness's choice. -/
+theorem previous_file_exact_witness :
+    ∃ pf : Clif.ParsedFile,
+      pf.funcs.length = 1 ∧ pf.funcs.all (·.func.isOk) = true ∧
+      (pf.funcs.any fun p => p.func.toOption.any eligible) = false ∧
+      compileFileMemoryCfgNIWhen (m := Id) true (fun _ => pure #[]) pf [] true =
+        compileFileMemoryNIWhen (m := Id) true (fun _ => pure #[]) pf [] true := by
+  let f : Clif.Function := {
+    name := "retained"
+    sig := { params := [⟨.i64,.none,.normal⟩], returns := [⟨.i64,.none,.normal⟩] }
+    blocks := [{ id := 0, params := [(0,.i64)], term := .ret [0] }] }
+  let pf : Clif.ParsedFile := {
+    header := [], funcs := [{ name := f.name, func := .ok f, runLines := 0 }] }
+  have count : pf.funcs.length = 1 := by rfl
+  have parsed : pf.funcs.all (·.func.isOk) = true := by rfl
+  have absent : (pf.funcs.any fun p => p.func.toOption.any eligible) = false := by rfl
+  exact ⟨pf,count,parsed,absent,previous_file_exact true (fun _ => pure #[]) pf [] true absent⟩
+
+end Backend.Stock.MemoryCfg
diff --git a/FV/Backend/Proof/StockMemoryCfgJumpDefined.lean b/FV/Backend/Proof/StockMemoryCfgJumpDefined.lean
new file mode 100644
index 00000000..de237e70
--- /dev/null
+++ b/FV/Backend/Proof/StockMemoryCfgJumpDefined.lean
@@ -0,0 +1,56 @@
+import FV.Backend.Proof.StockInheritedJumpDefined
+
+/-! UNVALIDATED next-batch source. The frozen production packet excludes this file.
+Reuse the existing local jump composition without excluding memory instructions
+in other blocks. The caller must derive the entry body proof from actual records.
+Keep every existing public and private variant unchanged. -/
+namespace Backend.Stock.Proof.Inherited
+open Backend.Proof Backend.Proof.Driver
+set_option autoImplicit false
+set_option Elab.async false
+
+/-- Compose a proved local body and the actual jump while preserving source definedness. -/
+theorem local_jump_carry_returns_defined_of_body {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} {label bi : Nat} {bc : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : Control.JumpBodySpec f result b label bi bc isem MR env cp)
+    (jump : b.term = .jump bc)
+    (localFamily : ∀ stm ∈ b.body,LocalBody.LocalInst stm.inst)
+    {needed : Nat → Prop}
+    (available : ∀ x,needed x → x ∈ availOf f (availIn f result.ctx) spec.core.scan.block 0)
+    (bodyRefines : ∀ a a',SourceSteps (IndexedSourceInst env cp f spec.core.scan.ctx spec.core.scan.block)
+      (sourceBodyIndices f spec.core.scan.block b).reverse a a' → ∀ ρ w,
+      CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed spec.body.state a ρ w → ∃ ρ' w',
+        seqRun isem (spec.body.code.toList.map (·.mapRegs
+          (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ w =
+            some (.fall ρ' w') ∧ CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed
+              spec.term.output.state a' ρ' w')
+    {fuel : Nat} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (returned : Clif.runLoop env cp fuel s = .returned vals cm) {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ w)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame) :
+    ∃ t left ρ' w',left+b.body.length = fuel ∧ Clif.runLoop env cp left t = .returned vals cm ∧
+      t.frame.body = [] ∧ LocalBody.SourceFrameEq s t ∧
+      (∀ x,needed x → t.frame.regs x = s.frame.regs x) ∧ t.frame.term = .jump bc ∧
+      seqRun isem (spec.core.code.toList.map (·.mapRegs
+        (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ w =
+          some (.stop spec.body.code.size (.jump spec.target) #[] ρ' w' [] w' (.goto 0)) ∧
+      CarryRel f result spec.core.scan.ctx spec.core.scan.block MR needed spec.term.output.state
+        (b.body.length,t.frame,t.mem) ρ' w' ∧
+      SourceDefinedAt f result.ctx spec.core.scan.block b.body.length t.frame := by
+  obtain ⟨t,left,total,continued,empty,steps,frame⟩ := LocalBody.actual_local_source_execution_frame
+    run spec.events spec.split localFamily (j := 0) (by omega) (by simpa using remaining) returned
+  obtain ⟨ρ',w',bodyRun,post⟩ := bodyRefines (0,s.frame,s.mem) (b.body.length,t.frame,t.mem)
+    (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range,sourceBodyIndices,List.reverse_reverse] using steps)
+    ρ w (by simpa only [spec.split.state] using held)
+  obtain ⟨sourceFrame,atJump,executed,tDefined⟩ := jump_continuation_defined run scope dominated driver spec jump
+    available (by simpa only [Nat.add_zero,Nat.sub_zero] using steps) frame atTerm bodyRun defined
+  exact ⟨t,left,ρ',w',by simpa using total,continued,empty,frame,sourceFrame,atJump,executed,post,tDefined⟩
+
+
+end Backend.Stock.Proof.Inherited
diff --git a/FV/Backend/Proof/StockMemoryCfgJumpReturnAt.lean b/FV/Backend/Proof/StockMemoryCfgJumpReturnAt.lean
new file mode 100644
index 00000000..18d78e54
--- /dev/null
+++ b/FV/Backend/Proof/StockMemoryCfgJumpReturnAt.lean
@@ -0,0 +1,129 @@
+import FV.Backend.Proof.StockCfgSuccessorDemand
+import FV.Backend.Proof.StockMemoryCfgJumpDefined
+import FV.Backend.Proof.StockCfgDemandValues
+import FV.Backend.Proof.StockInheritedJumpDefined
+import FV.Backend.Proof.StockCfgReturnBlockAt
+import FV.Backend.Proof.LowerShapeOkFacts
+import FV.Backend.Proof.StockComputedCfg
+
+namespace Backend.Stock.Proof.Control
+open Backend.Proof Backend.Proof.Driver
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Compose an independently proved actual jump body with a source-correct continuation at
+its successor. Only successor-demanded values cross the machine edge. -/
+theorem jump_body_returns_at_of_body {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b targetBlock : Clif.Block} {label bi tl : Nat} {bc : Clif.BlockCall}
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {MR : MemRelT} (stable : MRStable F MR)
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : JumpBodySpec f result b label bi bc isem MR env cp)
+    (localFamily : ∀ stm ∈ b.body,LocalBody.LocalInst stm.inst)
+    (bodyRefines : ∀ a a',SourceSteps (IndexedSourceInst env cp f spec.core.scan.ctx spec.core.scan.block)
+      (sourceBodyIndices f spec.core.scan.block b).reverse a a' → ∀ ρ w,
+      Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (fun _ => False)
+        spec.body.state a ρ w → ∃ ρ' w',
+        seqRun isem (spec.body.code.toList.map (·.mapRegs
+          (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ w =
+            some (.fall ρ' w') ∧
+        Inherited.CarryRel f result spec.core.scan.ctx spec.core.scan.block MR (fun _ => False)
+          spec.term.output.state a' ρ' w')
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (jump : b.term = .jump bc)
+    (targetTag : result.order.nodes[spec.target]? = some (.original tl))
+    (targetIndex : blockIdx? f bc.block = some tl)
+    (target : f.block? bc.block = some targetBlock)
+    {next : BlockScanEvent} (nextEvent : next ∈ result.blockScans.toList) (nextBlock : next.block = tl)
+    (demand : ∀ (x : Nat),next.output.state.demand[x]! ≤ spec.term.output.state.demand[x]!)
+    {vals : List Clif.Val} {outMem : Clif.Mem}
+    (continuation : ∀ (fuel : Nat) (s : Clif.State) (ρ : Nat → CV) (w : Arm.ArmState),
+      s.frame.func = f → s.callers = [] → s.frame.body = targetBlock.body →
+      s.frame.term = targetBlock.term → SourceDefinedAt f result.ctx tl 0 s.frame →
+      Clif.runLoop env cp fuel s = .returned vals outMem →
+      GuardedScanRel f result next.ctx next.block MR next.output.state (0,s.frame,s.mem) ρ w →
+      RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+        ⟨spec.target,0,ρ,w⟩ (.returned vals outMem))
+    {fuel : Nat} {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals outMem)
+    {ρ : Nat → CV} {w : Arm.ArmState}
+    (held : GuardedScanRel f result spec.core.scan.ctx spec.core.scan.block MR spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ w) :
+    RunOkABIAt f result.code result.edgeArgs isem MR s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,w⟩ (.returned vals outMem) := by
+  have source := spec.split.block
+  rw [spec.atBlock] at source
+  obtain ⟨t,left,ρ',w',total,continued,empty,frame,sourceFrame,atJump,executed,post,tDefined⟩ :=
+    Inherited.local_jump_carry_returns_defined_of_body run scope dominated refines driver stable spec jump
+      localFamily (needed := fun _ => False) (by intro x h; cases h) bodyRefines remaining atTerm returned
+      ⟨held,by intro x h; cases h⟩ defined
+  cases left with
+  | zero => cases continued
+  | succ left =>
+    have crossing : ∃ fr',Clif.enterBlock t.frame bc = .ok fr' := by
+      cases call : Clif.enterBlock t.frame bc with
+      | ok fr' => exact ⟨fr',rfl⟩
+      | trap code =>
+        rw [Clif.runLoop_succ] at continued
+        simp only [Clif.step,empty,atJump,Clif.stepTerm,call,Clif.StepResult.ofRes] at continued
+        cases continued
+      | stuck message =>
+        rw [Clif.runLoop_succ] at continued
+        simp only [Clif.step,empty,atJump,Clif.stepTerm,call,Clif.StepResult.ofRes] at continued
+        cases continued
+    obtain ⟨fr',crossed⟩ := crossing
+    have successor : result.order.successors[label]![0]? = some spec.target := by
+      have targets : result.order.successors[label]! = #[spec.target] := Array.toList_inj.mp spec.targets
+      rw [targets]; rfl
+    obtain ⟨ρnext,copied,nextDefined,nextHeld⟩ := direct_successor_guarded_of_demand run scope dominated
+      spec.events nextEvent tag source (by simp [jump,dests]) successor targetTag targetIndex target
+      spec.atBlock nextBlock post.1 (by simpa only [spec.atBlock] using tDefined) crossed
+      (jump_successor_values_of_demand run scope dominated spec jump targetTag targetIndex target nextBlock demand post.1)
+    have nextReturned : Clif.runLoop env cp left ⟨fr',[],t.mem⟩ = .returned vals outMem := by
+      rw [Clif.runLoop_succ] at continued
+      have tc : t.callers = [] := frame.1.trans callers
+      simpa only [Clif.step,empty,atJump,Clif.stepTerm,crossed,Clif.StepResult.ofRes,tc] using continued
+    have tFunc := post.1.1
+    obtain ⟨destination,args,regs,found,read,types,set,frEq⟩ := enterBlock_spec crossed
+    have destinationEq : destination = targetBlock := by
+      rw [tFunc] at found
+      exact Option.some.inj (found.symm.trans target)
+    have bodyEq : fr'.body = targetBlock.body := by rw [frEq,destinationEq]
+    have termEq : fr'.term = targetBlock.term := by rw [frEq,destinationEq]
+    have slotsEq : fr'.slots = s.frame.slots := by rw [frEq]; exact frame.2.2.1
+    have finished := continuation left ⟨fr',[],t.mem⟩ ρnext w' nextHeld.1 rfl bodyEq termEq
+      nextDefined nextReturned nextHeld
+    let resolve := Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+    have segment : SegAt {spec.raw with
+        insts := spec.raw.insts.map (·.mapRegs resolve)
+        params := spec.raw.params.map resolve
+        branchArgs := spec.raw.branchArgs.map resolve}
+        spec.preludeCode.size (spec.core.code.toList.map (·.mapRegs resolve)) := by
+      intro k hk
+      have bound : k < spec.core.code.size := by simpa using hk
+      simp only [spec.rawCode,Array.map_append]
+      rw [Array.getElem?_append_right (by simpa only [Array.size_map] using Nat.le_add_right spec.preludeCode.size k)]
+      simp only [Array.size_map,Nat.add_sub_cancel_left]
+      simp [bound]
+    have last : spec.preludeCode.size+spec.body.code.size+1 =
+        (spec.raw.insts.map (·.mapRegs resolve)).size := by
+      simp only [spec.rawCode,spec.bodyCode,Array.size_map,Array.size_append,Array.size_singleton]
+      omega
+    obtain ⟨ps,cfg⟩ := stock_lower_computed_cfg run scope
+    have actualSuccessor : succOf result.code label 0 = some spec.target := by
+      cases row : result.order.successors[label]? with
+      | none =>
+        simp only [getElem!_def,row,Option.getD_none] at successor
+        change (#[] : Array Nat)[0]? = some spec.target at successor
+        cases successor
+      | some values => simpa [succOf,cfg,getElem!_def,row] using successor
+    have path := seqRun_goto_starAt spec.placed segment executed last actualSuccessor
+      (by simpa only [vdefUpd,writeV,List.foldl_nil,Array.toList_empty,List.filter_nil,List.zip_nil_left] using copied)
+    have whole := RunOkABIAt.prefix path finished
+    simpa only [slotsEq] using whole
+
+end Backend.Stock.Proof.Control
