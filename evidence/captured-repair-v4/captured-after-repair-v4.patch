+import FV.Backend.Proof.StockOriginalEntryPrelude
+import FV.E2E.StockMemoryPairedEntry
+
+namespace E2E.StockMemory
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock Backend.Stock.Proof Backend.Stock.Proof.Control
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The chosen actual entry core supplies its paired ABI prefix and guarded values.
+Both worlds execute the same prefix with one shared virtual register file. -/
+theorem original_entry_prelude_paired {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b : Clif.Block} (spec : EntryCoreSpec f result b)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    (registerOnly : ∀ loc ∈ locsOf f.sig,∃ pin,loc = .reg pin)
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    (slot : fc.slotBase = Γ.slotOff)
+    (symbols : ∀ n a,Γ.syms n = some a → X.sym n 0 = BitVec.ofNat 64 a)
+    {w w' : Arm.ArmState} (memory : MRP Γ f c D fr.slots cm (w,w'))
+    (arguments : ArgsAtEntry Γ.F f.sig args w) (otherArguments : ArgsAtEntry Γ.F f.sig args w')
+    (registers : ∀ pin v,(.reg pin,v) ∈ (locsOf f.sig).zip args → regVal w' pin = regVal w pin) :
+    ∃ ρ',Star (VStepAt result.code result.edgeArgs (pairSem (csem Γ.F fc X)))
+      (.run ⟨0,0,entrySeed spec.core.scan.ctx fr,(w,w')⟩)
+      (.run ⟨0,spec.preludeCode.size,ρ',(w,w')⟩) ∧
+      PairedScanRel f result spec.core.scan.ctx spec.core.scan.block Γ c D
+        spec.core.scan.output.state (0,fr,cm) ρ' (w,w') := by
+  have inv := buildCtx_mappedInv scope spec.build
+  obtain ⟨locs,stack,rows,locations,mapped,ordered,lookups,rawCode⟩ :=
+    assemble_entry_source_rows spec.assembled
+  let prelude := entryPrelude (mappedEntryPairs rows) (mappedEntryLoads rows)
+  let resolve := Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+  have fixed : prelude.map (·.mapRegs resolve) = prelude := by
+    apply mapped_entry_prelude_fixed resolve
+    intro row member
+    have original : row.input ∈ (b.params.zip locs).zip spec.params :=
+      ordered.subset (List.mem_map.mpr ⟨row,member,rfl⟩)
+    have parameter : row.input.1.1.1 ∈ b.params.map (·.1) :=
+      List.mem_map.mpr ⟨row.input.1.1,(List.of_mem_zip (List.of_mem_zip original).1).1,rfl⟩
+    obtain ⟨rowReg,rowMap⟩ := mapped_entry_reg inv mapped member
+    have alias := stock_lower_parameter_resolves run dominated.ssa spec.block parameter rowMap
+    rw [rowReg]
+    change Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+      (.vreg (entryRowKey row) .int) = .vreg (entryRowKey row) .int
+    rw [resolve_vreg]
+    change Reg.vreg (aliasNum result.final.alias (entryRowKey row)) .int = _
+    rw [alias]
+  have maps := (stock_lower_record_context run scope spec.events).2.1
+  have held : ValuesHeld (fun _ => True) result.ctx fr (entrySeed spec.core.scan.ctx fr) := by
+    intro x _ v found
+    obtain ⟨key,mapped,value⟩ := entrySeed_entered_values_frame run scope dominated spec.events entered x trivial v found
+    exact ⟨key,by rwa [maps] at mapped,value⟩
+  obtain ⟨ρ',execution,values⟩ := mapped_entry_register_prelude_paired_frame inv entered dominated.ssa
+    spec.block locations spec.sizes mapped registerOnly slot symbols held memory arguments otherArguments registers
+  have preludeEq : spec.preludeCode = prelude :=
+    (Array.append_left_inj spec.core.code).mp (spec.rawCode.symm.trans (congrArg VBlock.insts rawCode))
+  let vb : VBlock := {spec.raw with
+    insts := spec.raw.insts.map (·.mapRegs resolve)
+    params := spec.raw.params.map resolve
+    branchArgs := spec.raw.branchArgs.map resolve}
+  have parts : vb.insts = prelude ++ spec.core.code.map (·.mapRegs resolve) := by
+    dsimp only [vb]
+    rw [rawCode]
+    change (prelude ++ spec.core.code).map (·.mapRegs resolve) = _
+    rw [Array.map_append,fixed]
+  have segment : SegAt vb 0 prelude.toList := by
+    intro k hk
+    have bound : k < prelude.size := by simpa using hk
+    simp only [Nat.zero_add,parts]
+    rw [Array.getElem?_append_left bound]
+    simp [bound]
+  have room : 0+prelude.toList.length < vb.insts.size := by
+    simp only [parts,Array.length_toList,Array.size_append,Array.size_map]
+    have nonempty := spec.nonempty
+    omega
+  have path := seqRun_fall_starAt (edges := result.edgeArgs) spec.placed segment room execution
+  have values' : ValuesHeld (fun _ => True) spec.core.scan.ctx fr ρ' := by
+    intro x needed v found
+    obtain ⟨key,mapped,value⟩ := values x needed v found
+    exact ⟨key,by rwa [← maps] at mapped,value⟩
+  refine ⟨ρ',?_,stock_lower_entered_values_guarded_frame run scope dominated spec.events entered
+    values' spec.core.scan.output.state w memory.1,
+    stock_lower_entered_values_guarded_frame run scope dominated spec.events entered
+    values' spec.core.scan.output.state w' memory.2.1,memory.2.2⟩
+  simpa only [preludeEq,Nat.zero_add,Array.length_toList] using path
+
+end E2E.StockMemory
diff --git a/FV/E2E/StockMemoryPairedJump.lean b/FV/E2E/StockMemoryPairedJump.lean
new file mode 100644
index 00000000..03df88fd
--- /dev/null
+++ b/FV/E2E/StockMemoryPairedJump.lean
@@ -0,0 +1,163 @@
+import FV.Backend.Proof.StockMemoryCfgJumpReturnAt
+import FV.E2E.StockMemoryPairedScan
+import FV.E2E.PairDriver
+import FV.Backend.Proof.VCodeSemISeq
+
+namespace E2E.StockMemory
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock Backend.Stock.Proof Backend.Stock.Proof.Control
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+private theorem pair_fall_first {sem : Sem} {ms : List MInst}
+    {ρ ρ' : Nat → CV} {q q' : W2}
+    (executed : seqRun (pairSem sem) ms ρ q = some (.fall ρ' q')) :
+    seqRun sem ms ρ q.1 = some (.fall ρ' q'.1) := by
+  exact seqRun_mapW (π := Prod.fst) (P := fun _ => True)
+    (fun i _ us w outs next ctl ran => (pairSem_inv ran).1)
+    ms (fun _ _ => True.intro) ρ q (.fall ρ' q') executed
+
+private theorem paired_jump_seq (Γ : Rel) (fc : FnCtx) (X : ExtSem)
+    (label : Nat) (ρ : Nat → CV) (q : W2) :
+    seqRun (pairSem (csem Γ.F fc X)) [.jump label] ρ q =
+      some (.stop 0 (.jump label) #[] ρ q [] q (.goto 0)) := by
+  simp only [seqRun,show (MInst.jump label).operands = .ok #[] from rfl,
+    show vuses (#[] : Array Operand) ρ = [] from rfl,(driverSemG_pair Γ.F fc X).jump]
+  rfl
+
+/-- A proved paired body crosses the actual jump with one shared virtual register file. -/
+theorem paired_jump_body_returns_at_of_body {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b targetBlock : Clif.Block} {label bi tl : Nat} {bc : Clif.BlockCall}
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : JumpBodySpec f result b label bi bc (csem Γ.F fc X) (RelW Γ f c) env cp)
+    (localFamily : ∀ stm ∈ b.body,LocalBody.LocalInst stm.inst)
+    (bodyRefines : ∀ a a',SourceSteps (IndexedSourceInst env cp f spec.core.scan.ctx spec.core.scan.block)
+      (sourceBodyIndices f spec.core.scan.block b).reverse a a' → ∀ ρ q,
+      PairedScanRel f result spec.core.scan.ctx spec.core.scan.block Γ c D spec.body.state a ρ q → ∃ ρ' q',
+        seqRun (pairSem (csem Γ.F fc X)) (spec.body.code.toList.map (·.mapRegs
+          (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ q =
+            some (.fall ρ' q') ∧
+        PairedScanRel f result spec.core.scan.ctx spec.core.scan.block Γ c D spec.term.output.state a' ρ' q')
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (jump : b.term = .jump bc)
+    (targetTag : result.order.nodes[spec.target]? = some (.original tl))
+    (targetIndex : blockIdx? f bc.block = some tl)
+    (target : f.block? bc.block = some targetBlock)
+    {next : BlockScanEvent} (nextEvent : next ∈ result.blockScans.toList) (nextBlock : next.block = tl)
+    (demand : ∀ (x : Nat),next.output.state.demand[x]! ≤ spec.term.output.state.demand[x]!)
+    {vals : List Clif.Val} {outMem : Clif.Mem}
+    (continuation : ∀ (fuel : Nat) (s : Clif.State) (ρ : Nat → CV) (q : W2),
+      s.frame.func = f → s.callers = [] → s.frame.body = targetBlock.body →
+      s.frame.term = targetBlock.term → SourceDefinedAt f result.ctx tl 0 s.frame →
+      Clif.runLoop env cp fuel s = .returned vals outMem →
+      PairedScanRel f result next.ctx next.block Γ c D next.output.state (0,s.frame,s.mem) ρ q →
+      RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D) s.frame.slots
+        ⟨spec.target,0,ρ,q⟩ (.returned vals outMem))
+    {fuel : Nat} {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals outMem)
+    {ρ : Nat → CV} {q : W2}
+    (held : PairedScanRel f result spec.core.scan.ctx spec.core.scan.block Γ c D spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ q) :
+    RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D) s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,q⟩ (.returned vals outMem) := by
+  have source := spec.split.block
+  rw [spec.atBlock] at source
+  obtain ⟨t,left,total,continued,empty,steps,frame⟩ := LocalBody.actual_local_source_execution_frame
+    run spec.events spec.split localFamily (j := 0) (by omega) (by simpa using remaining) returned
+  obtain ⟨ρ',q',bodyRun,postPair⟩ := bodyRefines (0,s.frame,s.mem) (b.body.length,t.frame,t.mem)
+    (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range,sourceBodyIndices,List.reverse_reverse] using steps)
+    ρ q (by simpa only [spec.split.state] using held)
+  obtain ⟨sourceFrame,atJump,firstRun,tDefined⟩ := Inherited.jump_continuation_defined run scope dominated
+    (driverSem_csem Γ.F fc X) spec jump (needed := fun _ => False)
+    (by intro x impossible; cases impossible) (by simpa only [Nat.add_zero,Nat.sub_zero] using steps)
+    frame atTerm (pair_fall_first bodyRun) defined
+  have coreCode : spec.core.code.toList.map (·.mapRegs
+      (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1))) =
+      spec.body.code.toList.map (·.mapRegs
+        (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1))) ++ [.jump spec.target] := by
+    rw [spec.bodyCode,Array.toList_append,List.map_append]
+    rfl
+  have executed := seqRun_append_fall_stop (pairSem (csem Γ.F fc X)) bodyRun
+    (paired_jump_seq Γ fc X spec.target ρ' q')
+  have executed : seqRun (pairSem (csem Γ.F fc X)) (spec.core.code.toList.map (·.mapRegs
+      (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))) ρ q =
+        some (.stop spec.body.code.size (.jump spec.target) #[] ρ' q' [] q' (.goto 0)) := by
+    rw [coreCode]
+    simpa only [List.length_map,Array.length_toList,Nat.zero_add] using executed
+  cases left with
+  | zero => cases continued
+  | succ left =>
+    have crossing : ∃ fr',Clif.enterBlock t.frame bc = .ok fr' := by
+      cases call : Clif.enterBlock t.frame bc with
+      | ok fr' => exact ⟨fr',rfl⟩
+      | trap code =>
+        rw [Clif.runLoop_succ] at continued
+        simp only [Clif.step,empty,atJump,Clif.stepTerm,call,Clif.StepResult.ofRes] at continued
+        cases continued
+      | stuck message =>
+        rw [Clif.runLoop_succ] at continued
+        simp only [Clif.step,empty,atJump,Clif.stepTerm,call,Clif.StepResult.ofRes] at continued
+        cases continued
+    obtain ⟨fr',crossed⟩ := crossing
+    have successor : result.order.successors[label]![0]? = some spec.target := by
+      have targets : result.order.successors[label]! = #[spec.target] := Array.toList_inj.mp spec.targets
+      rw [targets]; rfl
+    obtain ⟨ρnext,copied,nextDefined,nextHeld⟩ := direct_successor_guarded_of_demand run scope dominated
+      spec.events nextEvent tag source (by simp [jump,dests]) successor targetTag targetIndex target
+      spec.atBlock nextBlock postPair.1 (by simpa only [spec.atBlock] using tDefined) crossed
+      (jump_successor_values_of_demand run scope dominated spec jump targetTag targetIndex target nextBlock demand postPair.1)
+    obtain ⟨otherNext,copiedOther,otherDefined,otherHeld⟩ := direct_successor_guarded_of_demand run scope dominated
+      spec.events nextEvent tag source (by simp [jump,dests]) successor targetTag targetIndex target
+      spec.atBlock nextBlock postPair.2.1 (by simpa only [spec.atBlock] using tDefined) crossed
+      (jump_successor_values_of_demand run scope dominated spec jump targetTag targetIndex target nextBlock demand postPair.2.1)
+    have copiedEq : otherNext = ρnext := Option.some.inj (copiedOther.symm.trans copied)
+    subst otherNext
+    have nextReturned : Clif.runLoop env cp left ⟨fr',[],t.mem⟩ = .returned vals outMem := by
+      rw [Clif.runLoop_succ] at continued
+      have tc : t.callers = [] := frame.1.trans callers
+      simpa only [Clif.step,empty,atJump,Clif.stepTerm,crossed,Clif.StepResult.ofRes,tc] using continued
+    have tFunc := postPair.1.1
+    obtain ⟨destination,args,regs,found,read,types,set,frEq⟩ := enterBlock_spec crossed
+    have destinationEq : destination = targetBlock := by
+      rw [tFunc] at found
+      exact Option.some.inj (found.symm.trans target)
+    have bodyEq : fr'.body = targetBlock.body := by rw [frEq,destinationEq]
+    have termEq : fr'.term = targetBlock.term := by rw [frEq,destinationEq]
+    have slotsEq : fr'.slots = s.frame.slots := by rw [frEq]; exact frame.2.2.1
+    have finished := continuation left ⟨fr',[],t.mem⟩ ρnext q' nextHeld.1 rfl bodyEq termEq
+      nextDefined nextReturned ⟨nextHeld,otherHeld,postPair.2.2⟩
+    let resolve := Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+    have segment : SegAt {spec.raw with
+        insts := spec.raw.insts.map (·.mapRegs resolve)
+        params := spec.raw.params.map resolve
+        branchArgs := spec.raw.branchArgs.map resolve}
+        spec.preludeCode.size (spec.core.code.toList.map (·.mapRegs resolve)) := by
+      intro k hk
+      have bound : k < spec.core.code.size := by simpa using hk
+      simp only [spec.rawCode,Array.map_append]
+      rw [Array.getElem?_append_right (by simpa only [Array.size_map] using Nat.le_add_right spec.preludeCode.size k)]
+      simp only [Array.size_map,Nat.add_sub_cancel_left]
+      simp [bound]
+    have last : spec.preludeCode.size+spec.body.code.size+1 =
+        (spec.raw.insts.map (·.mapRegs resolve)).size := by
+      simp only [spec.rawCode,spec.bodyCode,Array.size_map,Array.size_append,Array.size_singleton]
+      omega
+    obtain ⟨ps,cfg⟩ := stock_lower_computed_cfg run scope
+    have actualSuccessor : succOf result.code label 0 = some spec.target := by
+      cases row : result.order.successors[label]? with
+      | none =>
+        simp only [getElem!_def,row,Option.getD_none] at successor
+        change (#[] : Array Nat)[0]? = some spec.target at successor
+        cases successor
+      | some values => simpa [succOf,cfg,getElem!_def,row] using successor
+    have path := seqRun_goto_starAt spec.placed segment executed last actualSuccessor
+      (by simpa only [vdefUpd,writeV,List.foldl_nil,Array.toList_empty,List.filter_nil,List.zip_nil_left] using copied)
+    have whole := RunOkABIAt.prefix path finished
+    simpa only [slotsEq] using whole
+
+
+end E2E.StockMemory
diff --git a/FV/E2E/StockMemoryPairedNopJump.lean b/FV/E2E/StockMemoryPairedNopJump.lean
new file mode 100644
index 00000000..8e685669
--- /dev/null
+++ b/FV/E2E/StockMemoryPairedNopJump.lean
@@ -0,0 +1,59 @@
+import FV.E2E.StockMemoryPairedJump
+import FV.E2E.StockMemoryNopPairedPrelude
+import FV.Backend.Proof.StockCfgTraversalDemand
+
+namespace E2E.StockMemory
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock Backend.Stock.Proof Backend.Stock.Proof.Control
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Original NOP syntax supplies the paired body required by the actual jump.
+The successor can contain memory instructions. No body-execution certificate is an input. -/
+theorem paired_nop_jump_body_returns_at {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    {b targetBlock : Clif.Block} {label bi tl : Nat} {bc : Clif.BlockCall}
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    {env : Clif.Env} {cp : Clif.Program}
+    (spec : JumpBodySpec f result b label bi bc (csem Γ.F fc X) (RelW Γ f c) env cp)
+    (nops : ∀ stm ∈ b.body,stm.inst = .nop)
+    (tag : result.order.nodes[label]? = some (.original bi))
+    (jump : b.term = .jump bc)
+    (targetTag : result.order.nodes[spec.target]? = some (.original tl))
+    (targetIndex : blockIdx? f bc.block = some tl)
+    (target : f.block? bc.block = some targetBlock)
+    {next : BlockScanEvent} (nextEvent : next ∈ result.blockScans.toList) (nextBlock : next.block = tl)
+    (forward : label < spec.target)
+    {vals : List Clif.Val} {outMem : Clif.Mem}
+    (continuation : ∀ (fuel : Nat) (s : Clif.State) (ρ : Nat → CV) (q : W2),
+      s.frame.func = f → s.callers = [] → s.frame.body = targetBlock.body →
+      s.frame.term = targetBlock.term → SourceDefinedAt f result.ctx tl 0 s.frame →
+      Clif.runLoop env cp fuel s = .returned vals outMem →
+      PairedScanRel f result next.ctx next.block Γ c D next.output.state (0,s.frame,s.mem) ρ q →
+      RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D) s.frame.slots
+        ⟨spec.target,0,ρ,q⟩ (.returned vals outMem))
+    {fuel : Nat} {s : Clif.State} (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (atTerm : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 s.frame)
+    (returned : Clif.runLoop env cp fuel s = .returned vals outMem)
+    {ρ : Nat → CV} {q : W2}
+    (held : PairedScanRel f result spec.core.scan.ctx spec.core.scan.block Γ c D spec.core.scan.output.state
+      (0,s.frame,s.mem) ρ q) :
+    RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D) s.frame.slots
+      ⟨label,spec.preludeCode.size,ρ,q⟩ (.returned vals outMem) := by
+  have localFamily : ∀ stm ∈ b.body,LocalBody.LocalInst stm.inst := by
+    intro stm member
+    simp [LocalBody.LocalInst,nops stm member]
+  have demand := CfgDemand.ordered_scan_demand_of_labels run scope
+    (Array.getElem?_eq_some_iff.mp targetTag).1 forward
+    (by simp only [getElem!_def,targetTag,Option.getD_some,nextBlock])
+    (by simp only [getElem!_def,tag,Option.getD_some,spec.atBlock]) nextEvent spec.events spec.split
+  apply paired_jump_body_returns_at_of_body run scope dominated spec localFamily
+    ?_ tag jump targetTag targetIndex target nextEvent nextBlock demand continuation
+    callers remaining atTerm defined returned held
+  intro a a' steps ρ q relation
+  exact stock_nop_paired_body_of_split run scope dominated spec.events spec.split.block nops spec.split a a'
+    (by simpa only [sourceBodyIndices,List.reverse_reverse] using steps) ρ q
+    (by simpa only [spec.split.state] using relation)
+
+end E2E.StockMemory
diff --git a/FV/E2E/StockMemoryPairedReturnEdge.lean b/FV/E2E/StockMemoryPairedReturnEdge.lean
new file mode 100644
index 00000000..46d2bb96
--- /dev/null
+++ b/FV/E2E/StockMemoryPairedReturnEdge.lean
@@ -0,0 +1,74 @@
+import FV.E2E.StockMemoryPairedBody
+import FV.Backend.Proof.StockPerEdgeReturnContract
+
+namespace E2E.StockMemory
+open Backend Backend.Stock Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+set_option maxHeartbeats 4000000
+
+/-- The original actual source return supplies a paired ABI-aware observation.
+Existing source demand, pinning and value proofs are reused with guarded return
+semantics and the original initialized-memory pairing framework. -/
+theorem stock_lower_return_record_paired_runOkAt {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) {event : BlockScanEvent} (events : event ∈ result.blockScans.toList)
+    {b : Clif.Block} (block : f.blocks[event.block]? = some b)
+    {xs : List Nat} (ret : b.term = .ret xs)
+    {record : ScanRecord} (records : record ∈ event.output.records) (terminal : record.inst = event.termInst)
+    {env : Clif.Env} {cp : Clif.Program} {s : Clif.State} {vals : List Clif.Val} {cm : Clif.Mem}
+    (func : s.frame.func = f) (callers : s.callers = [])
+    (done : Clif.stepTerm env cp s (.ret xs) = .done vals cm)
+    (defined : SourceDefinedAt f result.ctx event.block b.body.length s.frame)
+    {ρ : Nat → CV} (held : ValuesHeld (fun x => Demanded record.output.state x ∧
+      x ∈ availOf f (availIn f result.ctx) event.block b.body.length) event.ctx s.frame
+      (fun key => ρ (aliasNum result.final.alias key)))
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    (tls : XTls Γ.F X)
+    {label k : Nat} {vb : VBlock} (placed : result.code.blocks[label]? = some vb)
+    (segment : SegAt vb k (record.output.emitted.toList.map (·.mapRegs
+      (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)))))
+    (q : W2) (memory : MRP Γ f c D s.frame.slots s.mem q) :
+    RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D)
+      s.frame.slots ⟨label,k,ρ,q⟩ (.returned vals cm) := by
+  let guarded := csemG Γ.F fc X (fun b => ¬ Zof Γ.F D s.mem b) Γ.syms [] [] 0 (fun _ _ _ _ => False)
+  obtain ⟨step,rs,ps,extra,recorded,emitted,code,root,mapped,pinned,count,read,execution⟩ :=
+    stock_lower_return_record_source_run_auto run scope dominated abi events block ret records terminal
+      func callers done defined held (isem := guarded) (MR := RelW Γ f c)
+      refines_csemG (mrStable_relW Γ f c)
+  let resolve := Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+  let us : List (Reg × Reg) := (rs.zip ps).map (fun q => (resolve q.1,q.2))
+  have length : us.length = rs.length := by simp [us,List.length_zip,count]
+  have selected : ReturnABI f us := by
+    have second : us.map (·.2) = ps := by
+      simp only [us,List.map_map,Function.comp_def]
+      exact List.map_snd_zip (by omega)
+    unfold ReturnABI
+    rw [length,second]
+    exact pinned
+  have requested := stock_lower_return_guarded_operands run scope dominated events block ret records terminal
+    recorded emitted held
+  have sourceValues := requested_values_hold requested read mapped
+  have valueCount : (vals ++ extra).length = rs.length := by
+    simpa only [List.length_map] using sourceValues.1
+  obtain ⟨left,right,worlds⟩ := memory
+  obtain ⟨ops,t,first,values,memory'⟩ := execution q.1 left
+  obtain ⟨ops',t',second,otherValues,otherMemory'⟩ := execution q.2 right
+  have instruction : ((.rets (rs.zip ps) : MInst).mapRegs resolve) = .rets us := rfl
+  rw [instruction] at first second
+  let ms := record.output.emitted.toList.map (·.mapRegs resolve)
+  obtain ⟨otherPre,otherPost,equal,paired,relatedPre,relatedPost⟩ := pair_stop
+    (fun _ _ _ _ h => (csemG_sub h).2.2)
+    (guardedStep0 (D := D) (syms := Γ.syms) tls fc s.mem ms [] []) worlds first second
+  have preEq : q.2 = otherPre := congrArg (fun e => match e with
+    | .fall _ w => w | .stop _ _ _ _ w _ _ _ => w) equal
+  have postEq : t' = otherPost := congrArg (fun e => match e with
+    | .fall _ w => w | .stop _ _ _ _ _ _ w _ => w) equal
+  rw [← preEq,← postEq] at paired
+  rw [← postEq] at relatedPost
+  exact runOkABIAt_of_return_stop placed segment paired selected
+    (by have := values.1; omega) values.prefix_append ⟨memory',otherMemory',relatedPost⟩
+    ((stepTerm_ret callers).2.2 vals cm done).2
+
+end E2E.StockMemory
diff --git a/FV/E2E/StockMemoryPairedReturnEdgeBody.lean b/FV/E2E/StockMemoryPairedReturnEdgeBody.lean
new file mode 100644
index 00000000..5e0227a9
--- /dev/null
+++ b/FV/E2E/StockMemoryPairedReturnEdgeBody.lean
@@ -0,0 +1,116 @@
+import FV.E2E.StockMemoryPairedReturnEdge
+import FV.Backend.Proof.StockMemoryReturnRefines
+
+namespace E2E.StockMemory
+open Backend Backend.Stock Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+set_option maxHeartbeats 4000000
+
+private theorem return_done_of_runLoop {env : Clif.Env} {cp : Clif.Program}
+    {s : Clif.State} {xs : List Nat} {fuel : Nat} {vals : List Clif.Val} {mem : Clif.Mem}
+    (empty : s.frame.body = []) (callers : s.callers = []) (term : s.frame.term = .ret xs)
+    (returned : Clif.runLoop env cp fuel s = .returned vals mem) :
+    Clif.stepTerm env cp s (.ret xs) = .done vals mem := by
+  cases fuel with
+  | zero => cases returned
+  | succ fuel =>
+    rw [Clif.runLoop_succ,Clif.step_term env cp s empty,term] at returned
+    cases step : Clif.stepTerm env cp s (.ret xs) with
+    | next t => exact False.elim ((stepTerm_ret callers).1 t step)
+    | done vs cm =>
+      simp only [step,Clif.Outcome.returned.injEq] at returned
+      obtain ⟨rfl,rfl⟩ := returned
+      rfl
+    | trapped c => simp only [step] at returned; cases returned
+    | stuck message => simp only [step] at returned; cases returned
+
+private theorem factor_seg {vb : VBlock} {pre code post : Array MInst}
+    (parts : vb.insts = pre ++ code ++ post) : SegAt vb pre.size code.toList := by
+  intro k hk
+  have bound : k < code.size := by simpa using hk
+  rw [parts,Array.append_assoc,Array.getElem?_append_right (by omega)]
+  simp only [Nat.add_sub_cancel_left]
+  rw [Array.getElem?_append_left bound]
+  simp [bound]
+
+/-- Compose a proved ordinary body with its actual placed return segment. -/
+theorem actual_ordinary_paired_return_refines_at_block {f : Clif.Function} {result : Result}
+    (run : Stock.lower f = .ok result) (scope : LowerScope f) (dominated : Dominated f)
+    (abi : sigAbiOk f.sig = true) {b : Clif.Block}
+    (family : ∀ stm ∈ b.body, OrdinaryBody.OrdinaryInst stm.inst)
+    {xs : List Nat} (ret : b.term = .ret xs)
+    {event : BlockScanEvent} (events : event ∈ result.blockScans.toList)
+    {term : ScanRecord} {body : BlockScan} (split : SourceBodySplit f event b term body)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {s : Clif.State}
+    (func : s.frame.func = f) (callers : s.callers = [])
+    (remaining : s.frame.body = b.body) (terminal : s.frame.term = b.term)
+    (defined : SourceDefinedAt f result.ctx event.block 0 s.frame)
+    {vals : List Clif.Val} {mem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel s = .returned vals mem)
+    {Γ : Rel} {c : BitVec 64} {D : BitVec 64 → Prop} {fc : FnCtx} {X : ExtSem}
+    (tls : XTls Γ.F X)
+    (bodyRun : ∀ s s', SourceSteps (IndexedSourceInst env cp f event.ctx event.block)
+        ((List.range b.body.length).map (blockStart f event.block + ·)) s s' →
+        ∀ ρ w, PairedScanRel f result event.ctx event.block Γ c D event.output.state s ρ w → ∃ ρ' w',
+          seqRun (pairSem (csem Γ.F fc X)) (body.code.toList.map (·.mapRegs
+            (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size + 1)))) ρ w =
+            some (.fall ρ' w') ∧
+          PairedScanRel f result event.ctx event.block Γ c D term.output.state s' ρ' w')
+    {label : Nat} {vb : VBlock} {pre post : Array MInst}
+    (placed : result.code.blocks[label]? = some vb)
+    (code : vb.insts = pre ++ event.output.code.map (·.mapRegs
+      (Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1))) ++ post) :
+    ∀ ρ w, PairedScanRel f result event.ctx event.block Γ c D event.output.state
+      (0,s.frame,s.mem) ρ w →
+      RunOkABIAt f result.code result.edgeArgs (pairSem (csem Γ.F fc X)) (MRP Γ f c D) s.frame.slots ⟨label,pre.size,ρ,w⟩ (.returned vals mem) := by
+  have start : s.frame.body = b.body.drop 0 := by simpa using remaining
+  obtain ⟨t,left,total,ends,empty,steps,frame⟩ := OrdinaryBody.actual_ordinary_source_execution_frame
+    run events split family (j := 0) (by omega) start returned
+  have tDefined : SourceDefinedAt f result.ctx event.block b.body.length t.frame := by
+    apply ArithmeticBody.arithmetic_steps_defined run scope dominated events split.block
+      (env := env) (cp := cp) (s := (0,s.frame,s.mem)) (t := (b.body.length,t.frame,t.mem))
+      (j := 0) (n := b.body.length) (by omega) rfl ?_ defined
+    simpa only [Nat.add_zero,Nat.sub_zero] using steps
+  have tFunc : t.frame.func = f := frame.2.1.trans func
+  have tCallers : t.callers = [] := frame.1.trans callers
+  have tTerm : t.frame.term = .ret xs := frame.2.2.2.trans (terminal.trans ret)
+  have done := return_done_of_runLoop empty tCallers tTerm ends
+  let resolve := Backend.lowerFunction.resolve result.final.alias (result.final.alias.size+1)
+  have pieces : vb.insts = pre ++ body.code.map (·.mapRegs resolve) ++
+      (term.output.emitted.map (·.mapRegs resolve) ++ post) := by
+    simp only [code,split.code,Array.map_append,Array.append_assoc,resolve]
+  have bodySeg : SegAt vb pre.size (body.code.toList.map (·.mapRegs resolve)) := by
+    simpa only [Array.toList_map] using factor_seg pieces
+  have termPieces : vb.insts = (pre ++ body.code.map (·.mapRegs resolve)) ++
+      term.output.emitted.map (·.mapRegs resolve) ++ post := by
+    simpa only [Array.append_assoc] using pieces
+  have termSeg : SegAt vb (pre.size+body.code.size)
+      (term.output.emitted.toList.map (·.mapRegs resolve)) := by
+    simpa only [Array.size_append,Array.size_map,Array.toList_map] using factor_seg termPieces
+  have termMember : term ∈ event.output.records := by rw [split.records]; exact List.mem_cons_self
+  intro ρ w held
+  obtain ⟨ρ',w',executed,postHeld⟩ := bodyRun (0,s.frame,s.mem) (b.body.length,t.frame,t.mem)
+    (by simpa only [Nat.add_zero,Nat.sub_zero,List.range'_eq_map_range] using steps) ρ w held
+  obtain ⟨sourceGuard,otherGuard,worlds⟩ := postHeld
+  obtain ⟨heldFunc,dfg,memory,values⟩ := sourceGuard
+  have pairedMemory : MRP Γ f c D t.frame.slots t.mem w' := ⟨memory,otherGuard.2.2.1,worlds⟩
+  obtain ⟨step,rs,ps,extra,recorded,emitted,termCode,rest⟩ :=
+    stock_lower_return_record_source_run_auto run scope dominated abi events split.block ret
+      termMember split.termInst tFunc tCallers done tDefined values
+      (refines_csem Γ.F fc X) (mrStable_relW Γ f c)
+  have nonempty : 0 < term.output.emitted.size := by rw [termCode]; exact Nat.zero_lt_succ 0
+  have room : pre.size + (body.code.toList.map (·.mapRegs resolve)).length < vb.insts.size := by
+    have sizes := congrArg Array.size pieces
+    simp only [Array.size_append,Array.size_map] at sizes
+    simp only [List.length_map,Array.length_toList]
+    omega
+  have path := seqRun_fall_starAt (edges := result.edgeArgs) (vc := result.code) (sem := pairSem (csem Γ.F fc X)) placed bodySeg room executed
+  have finished := stock_lower_return_record_paired_runOkAt run scope dominated abi events split.block ret
+    termMember split.termInst tFunc tCallers done tDefined values (fc := fc) tls placed termSeg w' pairedMemory
+  have combined := RunOkABIAt.prefix path (by simpa only [List.length_map,Array.length_toList] using finished)
+  simpa only [frame.2.2.1] using combined
+
+
+end E2E.StockMemory
