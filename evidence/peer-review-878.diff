diff --git a/FV/Backend/Lowering/StockConditionalArgsCfg.lean b/FV/Backend/Lowering/StockConditionalArgsCfg.lean
new file mode 100644
index 000000000..d12558d72
--- /dev/null
+++ b/FV/Backend/Lowering/StockConditionalArgsCfg.lean
@@ -0,0 +1,28 @@
+import FV.Backend.Lowering.StockScalar
+import FV.Backend.StockArithmeticCheck
+
+namespace Backend.Stock.ConditionalArgsCfg
+set_option autoImplicit false
+
+/-- The lowered block order keeps every node an original block: no edge is critical, so
+each `brif` argument vector stays with its original successor. -/
+def originalOrder (f : Clif.Function) : Bool :=
+  match blockOrder f with
+  | .ok order => order.nodes.all fun | .original _ => true | .edge .. => false
+  | .error _ => false
+
+/-- Wide entry-parameter branches that may pass block arguments to blocks that return or end
+in `trap`. Nonentry blocks may have parameters. -/
+def leafEligible (f : Clif.Function) : Bool :=
+  match f.blocks with
+  | entry :: rest => match entry.term with
+    | .brif condition _ _ =>
+      entry.params.any (fun (value,ty) => value == condition && (ty == .i32 || ty == .i64)) &&
+      rest.all (fun b => match b.term with | .ret _ | .trap _ => true | _ => false) &&
+      f.blocks.all (fun b => b.body.all Scalar.maskMixedBodyEligible) &&
+      f.sig.params.all Scalar.narrowAbiEligible && f.sig.returns.all Scalar.narrowAbiEligible &&
+      originalOrder f
+    | _ => false
+  | _ => false
+
+end Backend.Stock.ConditionalArgsCfg
diff --git a/FV/Backend/Proof/StockConditionalArgsClass.lean b/FV/Backend/Proof/StockConditionalArgsClass.lean
new file mode 100644
index 000000000..3c3743d0e
--- /dev/null
+++ b/FV/Backend/Proof/StockConditionalArgsClass.lean
@@ -0,0 +1,107 @@
+import FV.Backend.Lowering.StockConditionalArgsCfg
+import FV.Backend.Proof.StockScalarCheck
+
+namespace Backend.Stock.ConditionalArgsCfg
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- Source facts for the conditional class whose branch may pass block arguments. All describe
+original source syntax and the source-only block order. -/
+structure ArgsLeafShape (f : Clif.Function) where
+  entry : Clif.Block
+  condition : Nat
+  yes : Clif.BlockCall
+  no : Clif.BlockCall
+  source : f.blocks[0]? = some entry
+  term : entry.term = .brif condition yes no
+  parameter : ∃ ty,(condition,ty) ∈ entry.params ∧ (ty = .i32 ∨ ty = .i64)
+  leaves : ∀ bi b,f.blocks[bi]? = some b → bi ≠ 0 → (∃ xs,b.term = .ret xs) ∨ ∃ c,b.term = .trap c
+  family : ∀ b ∈ f.blocks,∀ stm ∈ b.body,MaskBody.Family stm.inst
+  abiParams : f.sig.params.all Scalar.narrowAbiEligible = true
+  abiReturns : f.sig.returns.all Scalar.narrowAbiEligible = true
+  original : ∀ order,blockOrder f = .ok order → ∀ (label : Nat) (node : Node),order.nodes[label]? = some node →
+    ∃ bi,node = .original bi
+
+theorem originalOrder_sound {f : Clif.Function} (checked : originalOrder f = true) :
+    ∀ order,blockOrder f = .ok order → ∀ (label : Nat) (node : Node),order.nodes[label]? = some node →
+      ∃ bi,node = .original bi := by
+  intro order run label node found
+  simp only [originalOrder,run] at checked
+  have good := (Array.all_eq_true_iff_forall_mem.mp checked) node (Array.mem_of_getElem? found)
+  cases node with
+  | original bi => exact ⟨bi,rfl⟩
+  | edge => cases good
+
+/-- The executable selector derives its source facts, without adding any machine-code,
+source-state, selected-rule or semantic-result certificate. -/
+theorem leafEligible_shape {f : Clif.Function} (checked : leafEligible f = true) :
+    Nonempty (ArgsLeafShape f) := by
+  cases blocks : f.blocks with
+  | nil => simp [leafEligible,blocks] at checked
+  | cons entry rest =>
+    cases term : entry.term <;> simp only [leafEligible,blocks,term] at checked
+    case brif c yes no =>
+      simp only [Bool.and_eq_true] at checked
+      obtain ⟨⟨⟨⟨⟨parameter,leaves⟩,bodies⟩,params⟩,returns⟩,ordered⟩ := checked
+      obtain ⟨pair,member,good⟩ := List.any_eq_true.mp parameter
+      obtain ⟨value,ty⟩ := pair
+      change (value == c && (ty == .i32 || ty == .i64)) = true at good
+      simp only [Bool.and_eq_true,Bool.or_eq_true,beq_iff_eq] at good
+      obtain ⟨same,wide⟩ := good
+      subst value
+      refine ⟨{
+        entry := entry
+        condition := c
+        yes := yes
+        no := no
+        source := by simp only [blocks,List.getElem?_cons_zero]
+        term := term
+        parameter := ⟨ty,member,wide⟩
+        leaves := ?_
+        family := ?_
+        abiParams := params
+        abiReturns := returns
+        original := originalOrder_sound ordered }⟩
+      · intro bi b found nonentry
+        have member : b ∈ rest := by
+          cases bi with
+          | zero => exact False.elim (nonentry rfl)
+          | succ bi =>
+            rw [blocks,List.getElem?_cons_succ] at found
+            exact List.mem_of_getElem? found
+        have good := List.all_eq_true.mp leaves b member
+        cases term : b.term <;> simp only [term] at good
+        case ret xs => exact Or.inl ⟨xs,rfl⟩
+        case trap c => exact Or.inr ⟨c,rfl⟩
+        all_goals cases good
+      · intro b member stm present
+        have member' : b ∈ entry :: rest := by simpa only [blocks] using member
+        exact Scalar.maskMixedBodyEligible_sound
+          (List.all_eq_true.mp (List.all_eq_true.mp bodies b member') stm present)
+    all_goals cases checked
+
+/-- Original entry-parameter membership and SSA derive the real built context's parameter
+status and width. -/
+theorem ArgsLeafShape.condition_metadata {f : Clif.Function} (shape : ArgsLeafShape f)
+    (dominated : Dominated f) {ctx : Ctx} {ranges : Array (Nat × Nat)} {initial : State}
+    (build : Stock.buildCtx f = .ok (ctx,ranges,initial)) :
+    ctx.defInst? shape.condition = none ∧
+      (ctx.valueType? shape.condition = some (.int 32) ∨ ctx.valueType? shape.condition = some (.int 64)) := by
+  obtain ⟨original,st,oldBuild,spec,view⟩ := buildCtx_source build
+  obtain ⟨ty,parameter,wide⟩ := shape.parameter
+  have parameterId : shape.condition ∈ shape.entry.params.map (·.1) :=
+    List.mem_map.mpr ⟨(shape.condition,ty),parameter,rfl⟩
+  have noDefinition := defInst_par spec.facts dominated.ssa shape.source parameterId
+  have originalType := (spec.facts.types dominated.ssa).2 shape.entry (List.mem_of_getElem? shape.source)
+    (shape.condition,ty) parameter
+  refine ⟨?_,?_⟩
+  · simpa only [Ctx.defInst?,view.valDef] using noDefinition
+  · have typed : ctx.valueType? shape.condition = some (CTy.ofClif ty) := by
+      simpa only [Ctx.valueType?,view.valTy] using originalType
+    rcases wide with rfl | rfl
+    · exact Or.inl typed
+    · exact Or.inr typed
+
+end Backend.Stock.ConditionalArgsCfg
diff --git a/FV/Backend/Proof/StockConditionalArgsDomain.lean b/FV/Backend/Proof/StockConditionalArgsDomain.lean
new file mode 100644
index 000000000..46335a33b
--- /dev/null
+++ b/FV/Backend/Proof/StockConditionalArgsDomain.lean
@@ -0,0 +1,131 @@
+import FV.Backend.Proof.StockConditionalArgsClass
+import FV.Backend.Proof.StockConditionalArgsAt
+import FV.Backend.Proof.StockConditionalLeaf
+import FV.Backend.Proof.StockConditionalTrapLeaf
+import FV.Backend.Proof.StockConditionalEntryPrelude
+import FV.Backend.Proof.StockScalarDomainAt
+
+namespace Backend.Stock.ConditionalArgsCfg
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof Backend.Stock.Proof.ConditionalValues
+set_option autoImplicit false
+set_option Elab.async false
+set_option maxRecDepth 20000
+
+/-- The selected successor of an argument shape is an original return or trap block, at the
+selected position of the entry's actual successor labels. -/
+private theorem selected_original {f : Clif.Function} {result : Result}
+    (shape : ArgsLeafShape f) (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {index : Nat} {bc : Clif.BlockCall} (selected : (dests shape.entry.term)[index]? = some bc) :
+    ∃ tl targetLabel b,blockIdx? f bc.block = some tl ∧ f.block? bc.block = some b ∧
+      f.blocks[tl]? = some b ∧ result.order.successors[0]![index]? = some targetLabel ∧
+      result.order.nodes[targetLabel]? = some (.original tl) ∧ tl ≠ 0 ∧ 0 < targetLabel ∧
+      ((∃ xs,b.term = .ret xs) ∨ ∃ c,b.term = .trap c) := by
+  have entryTag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+  obtain ⟨tl,targetLabel,lookup,nonentry,successor,node⟩ :=
+    stock_lower_selected_successor run scope entryTag shape.source selected
+  have targetTag : result.order.nodes[targetLabel]? = some (.original tl) := by
+    rcases node with original | synthetic
+    · exact original
+    · obtain ⟨_,same⟩ := shape.original _ (stock_lower_order run) _ _ synthetic
+      cases same
+  obtain ⟨b,found,source⟩ := block?_of_idx lookup
+  have leaf := shape.leaves tl b source nonentry
+  have different : targetLabel ≠ 0 := by
+    intro equal
+    subst targetLabel
+    exact nonentry (Node.original.inj (Option.some.inj (targetTag.symm.trans entryTag)))
+  exact ⟨tl,targetLabel,b,lookup,found,source,successor,targetTag,nonentry,
+    Nat.pos_of_ne_zero different,leaf⟩
+
+/-- The entry's actual successor labels are two original blocks. -/
+private theorem successor_labels {f : Clif.Function} {result : Result}
+    (shape : ArgsLeafShape f) (run : Stock.lower f = .ok result) (scope : LowerScope f)
+    {isem : Backend.Proof.Sem} {MR : MemRelT} {env : Clif.Env} {cp : Clif.Program}
+    (spec : ConditionalBodySpec f result shape.entry 0 0 shape.condition shape.yes shape.no isem MR env cp)
+    (parameter : result.ctx.defInst? shape.condition = none) :
+    ∃ first second yesBlock noBlock,result.order.successors[0]! = #[first,second] ∧
+      result.order.nodes[first]? = some (.original yesBlock) ∧
+      result.order.nodes[second]? = some (.original noBlock) := by
+  obtain ⟨calls,_⟩ := spec.parameter_calls shape.source shape.term parameter
+  have labels : result.order.successors[0]! = #[calls.yes,calls.no] := Array.toList_inj.mp calls.labels_eq
+  obtain ⟨yesBlock,first,_,_,_,_,firstSuccessor,firstTag,_⟩ :=
+    selected_original shape run scope (index := 0) (bc := shape.yes) (by simp [shape.term,dests])
+  obtain ⟨noBlock,second,_,_,_,_,secondSuccessor,secondTag,_⟩ :=
+    selected_original shape run scope (index := 1) (bc := shape.no) (by simp [shape.term,dests])
+  rw [labels] at firstSuccessor secondSuccessor
+  simp only [List.getElem?_toArray,List.getElem?_cons_zero,List.getElem?_cons_succ,
+    Option.some.injEq] at firstSuccessor secondSuccessor
+  subst first second
+  exact ⟨calls.yes,calls.no,yesBlock,noBlock,labels,firstTag,secondTag⟩
+
+private theorem source_entry_parts {f : Clif.Function} (shape : ArgsLeafShape f)
+    {args : List Clif.Val} {fr : Clif.Frame} (entered : SourceEntry f args fr) :
+    fr.body = shape.entry.body ∧ fr.term = shape.entry.term := by
+  obtain ⟨b,regs,entry,types,paramTypes,set,frame⟩ := entered
+  have source : f.blocks[0]? = some b := by
+    simpa only [Clif.Function.entry?,List.head?_eq_getElem?] using entry
+  cases Option.some.inj (source.symm.trans shape.source)
+  exact ⟨congrArg Clif.Frame.body frame,congrArg Clif.Frame.term frame⟩
+
+/-- The conditional class whose branch passes block arguments to return or trap leaves
+satisfies the per-successor production domain, with actual ABI entry, selected copies of the
+actual argument vectors, return and first-trap semantics. All compiler facts are derived. -/
+theorem domainAt_of_argsLeafShape {f : Clif.Function} (shape : ArgsLeafShape f)
+    (scope : LowerScope f) (dominated : Dominated f) (abi : sigAbiOk f.sig = true)
+    (ordinary : (sigRets f.sig).any (·.purpose == .sret) = false) : Scalar.DomainAt f := by
+  refine ⟨scope,dominated,abi,ordinary,?_,?_⟩
+  · intro result run args cm fr entered env cp fuel vals mem returned F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+    obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated shape.family tag shape.source shape.term
+      refines driver stable env cp
+    have metadata := shape.condition_metadata dominated spec.build
+    obtain ⟨first,second,yesBlock,noBlock,labels,firstTag,secondTag⟩ :=
+      successor_labels shape run scope spec metadata.1
+    have successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests shape.entry.term)[index]? = some bc →
+        Nonempty (SuccessorReturn f result 0 bc isem MR env cp vals mem) := by
+      intro index bc selected
+      obtain ⟨tl,targetLabel,b,lookup,found,source,_,targetTag,nonentry,forward,⟨xs,ret⟩ | ⟨c,trap⟩⟩ :=
+        selected_original shape run scope selected
+      · exact SuccessorReturn.of_return_block run scope dominated abi shape.family refines driver stable
+          lookup found source targetTag ret nonentry forward
+      · exact SuccessorReturn.of_trap_block run shape.family lookup found source targetTag trap forward
+    obtain ⟨remaining,atTerm⟩ := source_entry_parts shape entered
+    obtain ⟨ρ,w,path,guarded,values,sameWorld⟩ := conditional_entry_prelude run scope dominated spec
+      shape.term metadata.1 metadata.2 entered driver memorySem stable memory arguments
+    have defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 fr := by
+      rw [spec.atBlock]
+      exact source_defined_entry_frame dominated result.ctx entered
+    have finished := spec.returning_original_parameter_at run scope dominated shape.family refines driver
+      stable tag shape.term metadata.1 metadata.2 labels firstTag secondTag
+      successors rfl remaining atTerm defined returned guarded
+    exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+  · intro result run args cm fr entered env cp fuel code trapped F isem refines driver
+      sb syms memorySem MR stable world memory arguments
+    have tag := stock_blockOrder_entry (stock_lower_order run) scope.nonempty
+    obtain ⟨spec⟩ := stock_lower_conditional_body_spec run scope dominated shape.family tag shape.source shape.term
+      refines driver stable env cp
+    have metadata := shape.condition_metadata dominated spec.build
+    obtain ⟨first,second,yesBlock,noBlock,labels,firstTag,secondTag⟩ :=
+      successor_labels shape run scope spec metadata.1
+    have successors : ∀ (index : Nat) (bc : Clif.BlockCall),(dests shape.entry.term)[index]? = some bc →
+        Nonempty (SuccessorTrap f result 0 bc isem MR env cp code) := by
+      intro index bc selected
+      obtain ⟨tl,targetLabel,b,lookup,found,source,_,targetTag,nonentry,forward,⟨xs,ret⟩ | ⟨c,trap⟩⟩ :=
+        selected_original shape run scope selected
+      · exact SuccessorTrap.of_return_block run scope dominated abi shape.family refines driver stable
+          lookup found source targetTag ret nonentry forward
+      · exact SuccessorTrap.of_trap_block run scope dominated shape.family refines driver stable
+          lookup found source targetTag trap nonentry forward
+    obtain ⟨remaining,atTerm⟩ := source_entry_parts shape entered
+    obtain ⟨ρ,w,path,guarded,values,sameWorld⟩ := conditional_entry_prelude run scope dominated spec
+      shape.term metadata.1 metadata.2 entered driver memorySem stable memory arguments
+    have defined : SourceDefinedAt f result.ctx spec.core.scan.block 0 fr := by
+      rw [spec.atBlock]
+      exact source_defined_entry_frame dominated result.ctx entered
+    have finished := spec.trapping_original_parameter_at run scope dominated shape.family refines driver
+      stable tag shape.term metadata.1 metadata.2 labels firstTag secondTag
+      successors rfl remaining atTerm defined trapped guarded
+    exact ⟨entrySeed spec.core.scan.ctx fr,RunOkABIAt.prefix path finished⟩
+
+end Backend.Stock.ConditionalArgsCfg
diff --git a/FV/Backend/Proof/StockConditionalArgsWitness.lean b/FV/Backend/Proof/StockConditionalArgsWitness.lean
new file mode 100644
index 000000000..3b82573ac
--- /dev/null
+++ b/FV/Backend/Proof/StockConditionalArgsWitness.lean
@@ -0,0 +1,88 @@
+import FV.Backend.Proof.StockConditionalArgsDomain
+
+/-! Non-vacuity of the argument-passing conditional class: a real function whose `brif` passes
+different block arguments to a return leaf and to a trap leaf meets the selector and the source
+input conditions; its source runs both return and trap; actual Stock lowering keeps nonempty
+per-successor vectors (not legacy-compatible), and actual edge splitting accepts the code. -/
+
+namespace Backend.Stock.ConditionalArgsCfg.Fixture
+open Backend Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- The entry branches on its parameter; the true side returns the square of the sum it
+receives, the false side receives the parameter and traps. -/
+def function : Clif.Function := {
+  name := "conditional_args_leaves"
+  sig := { params := [⟨.i64,.none,.normal⟩], returns := [⟨.i64,.none,.normal⟩] }
+  blocks := [
+    { id := 0, params := [(0,.i64)], body := [⟨[1],.binary .iadd .i64 0 0⟩],
+      term := .brif 0 ⟨1,[1]⟩ ⟨2,[0]⟩ },
+    { id := 1, params := [(2,.i64)], body := [⟨[3],.binary .imul .i64 2 2⟩], term := .ret [3] },
+    { id := 2, params := [(4,.i64)], body := [], term := .trap (.user 3) }] }
+
+/-- The source outcome from the entry, for one argument word. -/
+def sourceOutcome (word : BitVec 64) : Option Clif.Outcome :=
+  match Clif.enterFunc function [⟨.i64,word⟩] Clif.Mem.empty with
+  | .ok (fr,cm) => some (Clif.runLoop Clif.Env.empty {funcs := []} 8 ⟨fr,[],cm⟩)
+  | _ => none
+
+private def checks : Bool :=
+  leafEligible function && lowerScopeB function && dominatedB function && sigAbiOk function.sig &&
+  !((sigRets function.sig).any (·.purpose == .sret)) &&
+  (match sourceOutcome 1 with | some (.returned _ _) => true | _ => false) &&
+  (match sourceOutcome 0 with | some (.trapped (.user 3)) => true | _ => false) &&
+  match Stock.lower function with
+  | .error _ => false
+  | .ok result =>
+    !edgeLegacyCompatibleB result.code result.edgeArgs &&
+    match splitEdgesChecked result.code result.edgeArgs with
+    | .ok _ => true
+    | .error _ => false
+
+-- witness: native_decide (the fixed function's selector, input checks, source runs, lowering and split only)
+private theorem checks_true : checks = true := by native_decide
+
+theorem conditional_args_witness : Scalar.DomainAt function ∧
+    (∃ vals mem,sourceOutcome 1 = some (.returned vals mem)) ∧
+    sourceOutcome 0 = some (.trapped (.user 3)) ∧
+    ∃ result split,Stock.lower function = .ok result ∧
+      edgeLegacyCompatibleB result.code result.edgeArgs = false ∧
+      splitEdgesChecked result.code result.edgeArgs = .ok split := by
+  have h := checks_true
+  unfold checks at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨⟨⟨⟨⟨⟨selected,scope⟩,dominated⟩,abi⟩,ordinary⟩,returns⟩,traps⟩,lowered⟩ := h
+  obtain ⟨shape⟩ := leafEligible_shape selected
+  refine ⟨domainAt_of_argsLeafShape shape (lowerScope_of scope) (dominated_of dominated) abi
+    (by simpa using ordinary),?_,?_,?_⟩
+  · cases outcome : sourceOutcome 1 with
+    | none => rw [outcome] at returns; cases returns
+    | some o =>
+      rw [outcome] at returns
+      cases o with
+      | returned vals mem => exact ⟨vals,mem,rfl⟩
+      | _ => cases returns
+  · cases outcome : sourceOutcome 0 with
+    | none => rw [outcome] at traps; cases traps
+    | some o =>
+      rw [outcome] at traps
+      cases o with
+      | trapped code =>
+        cases code with
+        | user n =>
+          by_cases same : n = 3
+          · subst same
+            rfl
+          · simp [same] at traps
+        | _ => cases traps
+      | _ => cases traps
+  · cases run : Stock.lower function with
+    | error message => rw [run] at lowered; cases lowered
+    | ok result =>
+      rw [run,Bool.and_eq_true] at lowered
+      obtain ⟨incompatible,rest⟩ := lowered
+      cases splitRun : splitEdgesChecked result.code result.edgeArgs with
+      | error message => rw [splitRun] at rest; cases rest
+      | ok split => exact ⟨result,split,rfl,by simpa using incompatible,splitRun⟩
+
+end Backend.Stock.ConditionalArgsCfg.Fixture
diff --git a/FV/Backend/Proof/StockScalarDomainAt.lean b/FV/Backend/Proof/StockScalarDomainAt.lean
new file mode 100644
index 000000000..cd60a9fcb
--- /dev/null
+++ b/FV/Backend/Proof/StockScalarDomainAt.lean
@@ -0,0 +1,76 @@
+import FV.Backend.Proof.StockScalarContract
+import FV.Backend.Proof.EdgeSplitSound
+
+/-! The per-successor form of the scalar production domain. Its observations use the actual
+code together with its actual per-successor vectors (`result.edgeArgs`). After a successful
+edge split, they are the legacy observations of the split code. -/
+
+namespace Backend.Stock.Scalar
+open Backend.Proof Backend.Proof.Driver Backend.Stock.Proof
+set_option autoImplicit false
+
+/-- `Domain` over the actual per-successor vectors of the lowered code. -/
+structure DomainAt (f : Clif.Function) : Prop where
+  scope : LowerScope f
+  dominated : Dominated f
+  abi : sigAbiOk f.sig = true
+  ordinary : (sigRets f.sig).any (·.purpose == .sret) = false
+  returns : ∀ {result : Stock.Result} (run : Stock.lower f = .ok result)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {vals : List Clif.Val} {mem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals mem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w),
+    ∃ ρ,RunOkABIAt f result.code result.edgeArgs isem MR fr.slots ⟨0,0,ρ,w⟩ (.returned vals mem)
+  traps : ∀ {result : Stock.Result} (run : Stock.lower f = .ok result)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w),
+    ∃ ρ,PerEdgePrep.VTrapFromAt result.code result.edgeArgs isem ⟨0,0,ρ,w⟩ code
+
+/-- Returns of the per-successor domain are legacy returns of the split code. -/
+theorem DomainAt.split_returns {f : Clif.Function} (domain : DomainAt f)
+    {result : Stock.Result} (run : Stock.lower f = .ok result) {split : EdgeVCode}
+    (splitRun : splitEdgesChecked result.code result.edgeArgs = .ok split)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {vals : List Clif.Val} {mem : Clif.Mem}
+    (returned : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .returned vals mem)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w) :
+    ∃ ρ,RunOkABI f split.code isem MR fr.slots ⟨0,0,ρ,w⟩ (.returned vals mem) := by
+  obtain ⟨ρ,source⟩ := domain.returns run entered returned refines driver memorySem stable memory arguments
+  exact ⟨ρ,RunOkABIAt.split driver.toDriverSemG splitRun source⟩
+
+/-- Traps of the per-successor domain are legacy traps of the split code. -/
+theorem DomainAt.split_traps {f : Clif.Function} (domain : DomainAt f)
+    {result : Stock.Result} (run : Stock.lower f = .ok result) {split : EdgeVCode}
+    (splitRun : splitEdgesChecked result.code result.edgeArgs = .ok split)
+    {args : List Clif.Val} {cm : Clif.Mem} {fr : Clif.Frame}
+    (entered : SourceEntry f args fr)
+    {env : Clif.Env} {cp : Clif.Program} {fuel : Nat} {code : Clif.TrapCode}
+    (trapped : Clif.runLoop env cp fuel ⟨fr,[],cm⟩ = .trapped code)
+    {F : BitVec 64 → Prop} {isem : Backend.Proof.Sem} (refines : Refines F isem)
+    (driver : DriverSem isem) {sb : Nat} {syms : String → Option Nat}
+    (memorySem : MemRefines F sb syms isem) {MR : MemRelT} (stable : MRStable F MR)
+    {w : Arm.ArmState} (memory : MR fr.slots cm w)
+    (arguments : ArgsAtEntry F f.sig args w) :
+    ∃ ρ,VTrapFrom split.code isem ⟨0,0,ρ,w⟩ code := by
+  obtain ⟨ρ,source⟩ := domain.traps run entered trapped refines driver memorySem stable memory arguments
+  exact ⟨ρ,RunOkABIAt.split (f := f) (MR := MR) (slots := fr.slots) (o := .trapped code)
+    driver.toDriverSemG splitRun source⟩
+
+end Backend.Stock.Scalar
