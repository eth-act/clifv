; Compiled, unverified (#35 layer 2): the move-only `f16` values, lowered as stock Cranelift
; does without FEAT_FP16 (`lowerFunctionH`): `load.f16`/`store.f16` as `ldr h`/`str h`,
; `bitcast.f16` of an `i16` as `fmov s, w`, `bitcast.i16` of an `f16` as `umov w, v.h[0]`,
; `f16const` as `constant_f32` of its bits (`movz w` + `fmov s, w`), `f16` arguments and results
; in v0..v7. The first functions are those of Cranelift's own compile tests
; (`filetests/isa/aarch64/{load-f16-f128,store-f16-f128,bitcast,constants,call}.clif`); the runs
; agree with Cranelift-native (`scripts/lean-backend-filetests.sh
; corpus/clif-regress/f16_moves.clif`), and the encoding with llvm-mc
; (`scripts/lean-backend-encode-check.sh`).
test interpret
test run
target aarch64

function %load_f16(i64) -> f16 {
block0(v0: i64):
    v1 = load.f16 v0
    return v1
}

function %store_f16(f16, i64) {
block0(v0: f16, v1: i64):
    store.f16 v0, v1
    return
}

function %bitcast_f16_to_i16(f16) -> i16 {
block0(v0: f16):
    v1 = bitcast.i16 v0
    return v1
}
; run: %bitcast_f16_to_i16(0x1.000p-14) == 1024
; run: %bitcast_f16_to_i16(-0x1.8p1) == -15872
; run: %bitcast_f16_to_i16(-0.0) == -32768

function %bitcast_i16_to_f16(i16) -> f16 {
block0(v0: i16):
    v1 = bitcast.f16 v0
    return v1
}
; run: %bitcast_i16_to_f16(1024) == 0x1.000p-14
; run: %bitcast_i16_to_f16(15360) == 0x1.000p0
; run: %bitcast_i16_to_f16(-1024) == -Inf

function %const_one() -> f16 {
block0:
    v0 = f16const 0x1.0
    return v0
}
; run: %const_one() == 0x1.0

function %const_fifty() -> f16 {
block0:
    v0 = f16const 0x32.0
    return v0
}
; run: %const_fifty() == 0x32.0

function %second_f16(f16, f16) -> f16 system_v {
block0(v0: f16, v1: f16):
    return v1
}
; run: %second_f16(0x1.0, 0x1.8p1) == 0x1.8p1

function %store_load_offset(f16, f16) -> f16, f16 {
    ss0 = explicit_slot 8

block0(v0: f16, v1: f16):
    v2 = stack_addr.i64 ss0
    store.f16 notrap v0, v2+2
    store.f16 notrap v1, v2+6
    v3 = load.f16 notrap v2+6
    v4 = load.f16 notrap v2+2
    return v3, v4
}
; run: %store_load_offset(0x1.0, -Inf) == [-Inf, 0x1.0]

function %pick(i8, f16, f16) -> f16 {
block0(v0: i8, v1: f16, v2: f16):
    brif v0, block1(v1), block1(v2)

block1(v3: f16):
    return v3
}
; run: %pick(1, 0x1.0, 0x1.8p1) == 0x1.0
; run: %pick(0, 0x1.0, 0x1.8p1) == 0x1.8p1

function %call_f16(f16, i16) -> f16, i16 {
    fn0 = %second_f16(f16, f16) -> f16
    fn1 = %bitcast_i16_to_f16(i16) -> f16
    fn2 = %bitcast_f16_to_i16(f16) -> i16

block0(v0: f16, v1: i16):
    v2 = call fn1(v1)
    v3 = call fn0(v2, v0)
    v4 = call fn2(v2)
    return v3, v4
}
; run: %call_f16(0x1.8p1, 15360) == [0x1.8p1, 15360]
