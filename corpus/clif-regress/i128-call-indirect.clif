; Indirect calls at an i128 call-site signature (S4, #28): `Opt.Legal.checkW` validates a
; `call_indirect` (`Plan.callInd128`) or `try_call_indirect` (`termOk`) whose signature has i128
; parameters or returns: each pair is passed and returned as two i64 values, after a pad where
; AAPCS64 aligns the pair, at the expanded signature `g` declares under the same `sigN`.
; scripts/lean-backend-filetests.sh FILE runs it natively against Cranelift's own code. It is not in
; FVTest/Clif/fixtures: Clif.run resolves func_addr through the link-time image's symbols, and
; scripts/clif-filetests.sh has none (as for call_indirect.clif here).
test interpret
test run
target aarch64

function %addk(i128, i64) -> i128 {
block0(v0: i128, v1: i64):
    v2 = uextend.i128 v1
    v3 = iadd v0, v2
    return v3
}

; the pair in x0/x1, the i64 in x2; the result in x0/x1
function %ind_add(i128) -> i128 {
    sig0 = (i128, i64) -> i128
    fn0 = %addk(i128, i64) -> i128

block0(v0: i128):
    v1 = func_addr.i64 fn0
    v2 = iconst.i64 5
    v3 = call_indirect sig0, v1(v0, v2)
    return v3
}
; run: %ind_add(0x00000000_00000001_FFFFFFFF_FFFFFFFF) == 0x00000000_00000002_00000000_00000004
; run: %ind_add(-5) == 0

function %subk(i64, i128) -> i128 {
block0(v0: i64, v1: i128):
    v2 = uextend.i128 v0
    v3 = isub v1, v2
    return v3
}

; the i64 in x0, a pad in x1, the pair in x2/x3
function %ind_pad(i128) -> i128 {
    sig0 = (i64, i128) -> i128
    fn0 = %subk(i64, i128) -> i128

block0(v0: i128):
    v1 = func_addr.i64 fn0
    v2 = iconst.i64 3
    v3 = call_indirect sig0, v1(v2, v0)
    return v3
}
; run: %ind_pad(0x00000000_00000001_00000000_00000000) == 0x00000000_00000000_FFFFFFFF_FFFFFFFD
; run: %ind_pad(3) == 0

; try_call_indirect: the arguments split as for call_indirect, the i128 normal return as the
; two parameters of the successor's pair
function %ind_try(i128) -> i128 {
    sig0 = (i128, i64) -> i128
    fn0 = %addk(i128, i64) -> i128

block0(v0: i128):
    v1 = func_addr.i64 fn0
    v2 = iconst.i64 7
    try_call_indirect v1(v0, v2), sig0, block1(ret0), []

block1(v3: i128):
    return v3
}
; run: %ind_try(0x00000000_00000001_FFFFFFFF_FFFFFFFF) == 0x00000000_00000002_00000000_00000006
; run: %ind_try(-7) == 0
