function %Corpus__meanSquare(i32, i32, i32, i32, i64) -> i8, i64 {
    fn0 = %Corpus__sumSquares(i32, i32, i32, i32) -> i8, i32
    fn1 = %Corpus__safeDiv(i64, i64) -> i8, i64

block0(v0: i32, v1: i32, v2: i32, v3: i32, v4: i64):
    v6, v7 = call fn0(v0, v1, v2, v3)
    brif.i8 v6, block1(v6), block3

block3:
    jump block2(v7)

block2(v5: i32):
    v8 = uextend.i64 v5
    v9, v10 = call fn1(v8, v4)
    brif.i8 v9, block1(v9), block4

block4:
    v11 = iconst.i8 0
    return v11, v10

block1(v12: i8):
    v13 = iconst.i64 0
    return v12, v13
}
; run: %Corpus__meanSquare(1, 2, 3, 4, 3) == [0, 10]
; run: %Corpus__meanSquare(1, 2, 3, 4, 0) == [63, 0]

function %Corpus__sumSquares(i32, i32, i32, i32) -> i8, i32 {
    fn0 = %Corpus__square(i32) -> i8, i32

block0(v0: i32, v1: i32, v2: i32, v3: i32):
