block6(v31: i32):
    v32 = iconst.i64 1
    v33 = iadd.i64 v6, v32
    jump block3(v33, v31)

block5:
    jump block2(v7)

block2(v5: i32):
    v34 = iconst.i8 0
    return v34, v5

block1(v35: i8):
    v36 = iconst.i32 0
    return v35, v36
}

function %Corpus__square(i32) -> i8, i32 {
block0(v0: i32):
    v1 = imul.i32 v0, v0
    v2 = umulhi.i32 v0, v0
    v3 = iconst.i32 0
    v4 = icmp.i32 ne v2, v3
    v5 = iconst.i8 1
    brif.i8 v4, block1(v5), block2

block2:
    v6 = iconst.i8 0
    return v6, v1

block1(v7: i8):
    v8 = iconst.i32 0
    return v7, v8
}

function %Corpus__safeDiv(i64, i64) -> i8, i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3 = icmp.i64 eq v1, v2
    brif.i8 v3, block3, block4

block3:
    v4 = iconst.i8 63
    jump block1(v4)

block4:
    jump block2

block2:
    v5 = iconst.i64 0
    v6 = icmp.i64 eq v1, v5
    v7 = iconst.i8 2
    brif.i8 v6, block1(v7), block5

block5:
    v8 = udiv.i64 v0, v1
    v9 = iconst.i8 0
    return v9, v8

block1(v10: i8):
    v11 = iconst.i64 0
    return v10, v11
}
