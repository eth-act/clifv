target aarch64

function %cas32(i64, i32, i32) -> i32, i32 {
    ss0 = explicit_slot 8
block0(v0: i64, v1: i32, v2: i32):
    v3 = stack_addr.i64 ss0
    store.i32 v1, v3
    v4 = ireduce.i32 v0
    v5 = atomic_cas.i32 v3, v4, v2
    v6 = load.i32 v3
    return v5, v6
}
; run: %cas32(0x100000005, 5, 7) == [5, 7]
; run: %cas32(5, 5, 7) == [5, 7]

function %smin8(i8, i8) -> i8, i8 {
    ss0 = explicit_slot 8
block0(v0: i8, v1: i8):
    v3 = stack_addr.i64 ss0
    store.i8 v0, v3
    v5 = atomic_rmw.i8 smin v3, v1
    v6 = load.i8 v3
    return v5, v6
}
