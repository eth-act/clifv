test run
set opt_level=speed
target aarch64

function %sshr_ishl_neg8(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i64 -8
    v2 = ishl v0, v1
    v3 = sshr v2, v1
    return v3
}
; run: %sshr_ishl_neg8(0x7f) == 0x7f
; run: %sshr_ishl_neg8(0x80) == 0x80

function %ushr_ishl_neg8(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i64 -8
    v2 = ishl v0, v1
    v3 = ushr v2, v1
    return v3
}
; run: %ushr_ishl_neg8(0x7f) == 0x7f
; run: %ushr_ishl_neg8(0x80) == 0x80

function %sshr_ishl_neg16(i16) -> i16 {
block0(v0: i16):
    v1 = iconst.i64 -16
    v2 = ishl v0, v1
    v3 = sshr v2, v1
    return v3
}
; run: %sshr_ishl_neg16(0x8001) == 0x8001
