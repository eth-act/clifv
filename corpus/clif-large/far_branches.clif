; V6 branch relaxation regression (docs/contracts/encoder.md, branch-range policy): a jump
; table of 270000 words (> 1 MiB) between the short conditional branches and their targets, so
; the tbnz (bit test, +-32 KiB), the b.eq of a brif and the cbz of a udiv's zero check (+-1 MiB) and the
; jump table's default b.hs (+-1 MiB) are out of range and emitFunc relaxes them to the
; inverted branch over a `b` (block3 repeated 270000 times).
; In corpus/clif-large (not scanned by the default gates): the Lean backend takes ~20 min on it
; (270000 split jump-table edges); run with scripts/lean-backend-filetests.sh corpus/clif-large/far_branches.clif.
test interpret
test run
target aarch64

function %far(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 4
    v2 = band v0, v1
    brif v2, block4, block1

block1:
    v9 = iconst.i64 3
    v3 = iadd v0, v9
    v11 = udiv v0, v3
    v10 = iconst.i64 1
    v4 = icmp eq v0, v10
    brif v4, block4, block2

block2:
    v5 = ireduce.i32 v0
    br_table v5, block5, [block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3, block3