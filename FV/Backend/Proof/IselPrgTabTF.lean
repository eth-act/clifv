/-- The root entry of a statement form of the float scope. -/
def stmtRootOkTF (F : PA) : Bool :=
  match tabFind prgTabTF TId.lower [F] with
  | some e => e.osome && PA.le e.out (stmtOut F) && decide (e.fu ≤ 1000000)
  | none => false

/-- The root entry of a terminator of the float scope. -/
def termRootOkTF (q : TermId × List PA) : Bool :=
  match tabFind prgTabTF q.1 q.2 with
  | some e => e.osome && decide (e.fu ≤ 1000000)
  | none => false

/-- **Every statement root of the float scope checks.** -/
theorem stmtRootsTF_ok : stmtFormsTF.all stmtRootOkTF = true := by
  decide +kernel

/-- **Every terminator root checks in the float scope's table.** -/
theorem termRootsTF_ok : termRootsT.all termRootOkTF = true := by
  decide +kernel

