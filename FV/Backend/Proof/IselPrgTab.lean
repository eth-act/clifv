/-- The root entry of a statement form: surely a value, one single register per ABI result,
within the interpreter's fuel. -/
def stmtRootOk (F : PA) : Bool :=
  match tabFind prgTab TId.lower [F] with
  | some e => e.osome && PA.le e.out (stmtOut F) && decide (e.fu ≤ 1000000)
  | none => false

/-- The root entry of a terminator: surely a value within the interpreter's fuel. -/
def termRootOk (q : TermId × List PA) : Bool :=
  match tabFind prgTab q.1 q.2 with
  | some e => e.osome && decide (e.fu ≤ 1000000)
  | none => false

/-- **Every statement root checks.** -/
theorem stmtRoots_ok : stmtForms.all stmtRootOk = true := by
  decide +kernel

/-- **Every terminator root checks.** -/
theorem termRoots_ok : termRoots.all termRootOk = true := by
  decide +kernel

