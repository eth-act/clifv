  | .error _ => false

theorem premises : premisesB = true := by native_decide

/-- **`compileExe_total_ldIn`'s premises hold together on real link inputs**: `lean-ld` links
them and `Link.DeadCleanup.compileExe` succeeds on its output. -/
theorem compileExe_total_ldIn_witness :
    ∃ st g, ∃ r, link o ins = .ok r ∧ ∃ file, compileExe (ldSpec S0 o st g) r.img.write = .ok file := by
  have h := premises
  unfold premisesB at h
  split at h
  · rename_i st hres
    split at h
    · rename_i g hgc
      simp only [Bool.and_eq_true] at h
      obtain ⟨⟨⟨⟨⟨⟨hrefs, hrels⟩, hfit⟩, hsp⟩, hin⟩, hl⟩, hreach⟩ := h
      obtain ⟨r, hr, hc⟩ := compileExe_total_ldIn (S := S0) hres hgc hrefs hrels hfit hsp hin hl hreach
      exact ⟨st, g, r, hr, _, hc⟩
    · cases h
  · cases h

end Link.DeadCleanup.LdInWitness
