test run
target aarch64

; The S11f scalar float arithmetic roots (`fadd fsub fmul fdiv fmin fmax sqrt fneg fabs fpromote
; fdemote`, lower.isle:485-559) behind integer signatures (bit patterns in, bit patterns out via
; `bitcast`): NaN propagation and quietening (`FPProcessNaNs`, signalling first), the default NaN
; of invalid operations, infinities, signed zeros, subnormals (FZ = 0) and round-to-nearest-even
; ties.

function %fadd32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fadd v2, v3
    v5 = bitcast.i32 v4
    return v5
}
; run: %fadd32(0x3f800000, 0x33800000) == 0x3f800000
; run: %fadd32(0x3f800000, 0x34400000) == 0x3f800002
; run: %fadd32(0x7f800000, 0xff800000) == 0x7fc00000
; run: %fadd32(0x7fc00001, 0x3f800000) == 0x7fc00001
; run: %fadd32(0x7f800001, 0x3f800000) == 0x7fc00001
; run: %fadd32(0x7fc00003, 0x7f800002) == 0x7fc00002
; run: %fadd32(0x80000000, 0x80000000) == 0x80000000
; run: %fadd32(0x00000000, 0x80000000) == 0x00000000
; run: %fadd32(0x00000001, 0x00000001) == 0x00000002
; run: %fadd32(0x7f7fffff, 0x7f7fffff) == 0x7f800000

function %fsub32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fsub v2, v3
    v5 = bitcast.i32 v4
    return v5
}
; run: %fsub32(0x3f800000, 0x3f800000) == 0x00000000
; run: %fsub32(0x00800000, 0x00000001) == 0x007fffff
; run: %fsub32(0x7f800000, 0x7f800000) == 0x7fc00000
; run: %fsub32(0x80000000, 0x00000000) == 0x80000000
; run: %fsub32(0x40400000, 0x3f800000) == 0x40000000

function %fmul32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fmul v2, v3
    v5 = bitcast.i32 v4
    return v5
}
; run: %fmul32(0x7f7fffff, 0x40000000) == 0x7f800000
; run: %fmul32(0x00000000, 0x7f800000) == 0x7fc00000
; run: %fmul32(0x80000000, 0x3f800000) == 0x80000000
; run: %fmul32(0x00800000, 0x3f000000) == 0x00400000
; run: %fmul32(0x00000001, 0x3f000000) == 0x00000000
; run: %fmul32(0x00000003, 0x3f000000) == 0x00000002
; run: %fmul32(0xff800001, 0x3f800000) == 0xffc00001

