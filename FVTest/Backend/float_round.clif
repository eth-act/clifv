test run
target aarch64

; The S11f scalar float rounding roots (`ceil floor trunc nearest`, lower.isle:567-603, via
; `fpu_round`/`frintp/frintm/frintz/frintn`) behind integer signatures (bit patterns in, bit
; patterns out via `bitcast`): signed zeros (round to integral preserves the sign of zero),
; half-integer ties (including the largest f64 half-integer 2^52 - 0.5, a tie for `nearest`
; resolved to even), integral and huge values unchanged, infinities, and quiet NaNs.

function %ceil32(i32) -> i32 {
block0(v0: i32):
    v1 = bitcast.f32 v0
    v2 = ceil v1
    v3 = bitcast.i32 v2
    return v3
}
; run: %ceil32(0x00000000) == 0x00000000
; run: %ceil32(0x80000000) == 0x80000000
; run: %ceil32(0x3f000000) == 0x3f800000
; run: %ceil32(0xbf000000) == 0x80000000
; run: %ceil32(0x3fc00000) == 0x40000000
; run: %ceil32(0xbfc00000) == 0xbf800000
; run: %ceil32(0x7f800000) == 0x7f800000
; run: %ceil32(0xff800000) == 0xff800000
; run: %ceil32(0x7fc00000) == 0x7fc00000
; run: %ceil32(0x5f000000) == 0x5f000000

function %floor32(i32) -> i32 {
block0(v0: i32):
    v1 = bitcast.f32 v0
    v2 = floor v1
    v3 = bitcast.i32 v2
    return v3
}
; run: %floor32(0x00000000) == 0x00000000
; run: %floor32(0x80000000) == 0x80000000
; run: %floor32(0x3f000000) == 0x00000000
; run: %floor32(0xbf000000) == 0xbf800000
; run: %floor32(0x3fc00000) == 0x3f800000
; run: %floor32(0xbfc00000) == 0xc0000000
; run: %floor32(0x7f800000) == 0x7f800000
; run: %floor32(0xff800000) == 0xff800000
; run: %floor32(0x7fc00000) == 0x7fc00000
; run: %floor32(0x5f000000) == 0x5f000000

