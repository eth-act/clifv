test run
target aarch64

; The #35 scalar `fcopysign` root (`lower.isle:685`, `fcopy_sign`'s scalar rule `inst.isle:4612`:
; `ushr v.2s, #31` + `sli v.2s, #31` at f32, `ushr d, #63` + `sli d, #63` at f64) behind integer
; signatures (bit patterns in, bit patterns out via `bitcast`): signed zeros, NaNs of both signs
; (as the magnitude operand: payload kept, sign replaced; as the sign operand: only its sign
; bit), infinities, negative and positive sign operands, equal signs (unchanged).

function %copysign32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fcopysign v2, v3
    v5 = bitcast.i32 v4
    return v5
}
; run: %copysign32(0x3f800000, 0x80000000) == 0xbf800000
; run: %copysign32(0xbf800000, 0x00000000) == 0x3f800000
; run: %copysign32(0x00000000, 0x80000000) == 0x80000000
; run: %copysign32(0x80000000, 0x00000000) == 0x00000000
; run: %copysign32(0x80000000, 0x80000000) == 0x80000000
; run: %copysign32(0x7fc00000, 0xbf800000) == 0xffc00000
; run: %copysign32(0xffc00000, 0x3f800000) == 0x7fc00000
; run: %copysign32(0x7f800001, 0x80000000) == 0xff800001
; run: %copysign32(0x40490fdb, 0xffc00000) == 0xc0490fdb
; run: %copysign32(0xc0490fdb, 0x7fc00001) == 0x40490fdb
; run: %copysign32(0x7f800000, 0xc0000000) == 0xff800000
; run: %copysign32(0xff800000, 0x7f800000) == 0x7f800000
; run: %copysign32(0x3f800000, 0x40000000) == 0x3f800000
; run: %copysign32(0xbf800000, 0xc0000000) == 0xbf800000
; run: %copysign32(0x00000001, 0x80000000) == 0x80000001

function %copysign64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = bitcast.f64 v0
    v3 = bitcast.f64 v1
    v4 = fcopysign v2, v3
    v5 = bitcast.i64 v4
    return v5
}
; run: %copysign64(0x3ff0000000000000, 0x8000000000000000) == 0xbff0000000000000
; run: %copysign64(0xbff0000000000000, 0x0000000000000000) == 0x3ff0000000000000
; run: %copysign64(0x0000000000000000, 0x8000000000000000) == 0x8000000000000000
; run: %copysign64(0x8000000000000000, 0x0000000000000000) == 0x0000000000000000
; run: %copysign64(0x8000000000000000, 0x8000000000000000) == 0x8000000000000000
; run: %copysign64(0x7ff8000000000000, 0xbff0000000000000) == 0xfff8000000000000
; run: %copysign64(0xfff8000000000000, 0x3ff0000000000000) == 0x7ff8000000000000
; run: %copysign64(0x7ff0000000000001, 0x8000000000000000) == 0xfff0000000000001
; run: %copysign64(0x400921fb54442d18, 0xfff8000000000000) == 0xc00921fb54442d18
; run: %copysign64(0xc00921fb54442d18, 0x7ff8000000000001) == 0x400921fb54442d18
; run: %copysign64(0x7ff0000000000000, 0xc000000000000000) == 0xfff0000000000000
; run: %copysign64(0xfff0000000000000, 0x7ff0000000000000) == 0x7ff0000000000000
; run: %copysign64(0x3ff0000000000000, 0x4000000000000000) == 0x3ff0000000000000
; run: %copysign64(0xbff0000000000000, 0xc000000000000000) == 0xbff0000000000000
; run: %copysign64(0x0000000000000001, 0x8000000000000000) == 0x8000000000000001

; f32 operands produced by other float instructions (`fdemote`/`fneg`) and the result used by
; another one (`fpromote`): the upper lane `ushr`/`sli` leave behind is never read.
function %copysign32_chain(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = bitcast.f64 v0
    v3 = bitcast.f64 v1
    v4 = fdemote.f32 v2
    v5 = fdemote.f32 v3
    v6 = fneg v5
    v7 = fcopysign v4, v6
    v8 = fpromote.f64 v7
    v9 = bitcast.i64 v8
    return v9
}
; run: %copysign32_chain(0x3ff0000000000000, 0x3ff0000000000000) == 0xbff0000000000000
; run: %copysign32_chain(0xbff8000000000000, 0xbff0000000000000) == 0x3ff8000000000000
; run: %copysign32_chain(0x4000000000000000, 0x8000000000000000) == 0x4000000000000000
