test run
target aarch64

; The S11f-cvt float <-> integer conversion roots (lower.isle:724-794): `fcvt_from_{u,s}int`
; (scvtf/ucvtf, i8/i16 through put_in_reg_{z,s}ext32) and the saturating
; `fcvt_to_{u,s}int_sat` at i32/i64 (fcvtzs/fcvtzu), behind integer signatures (float bit
; patterns via `bitcast`): NaN -> 0, +-inf and out-of-range values saturate, -0.0 -> 0,
; truncation toward zero, round-to-nearest-even ties of the integer -> float direction.
; Trapping `fcvt_to_{u,s}int` is not emitted by cg_clif and not proven (not here).

function %u32_f32(i32) -> i32 {
block0(v0: i32):
    v1 = bitcast.f32 v0
    v2 = fcvt_to_uint_sat.i32 v1
    return v2
}
; run: %u32_f32(0x7fc00000) == 0
; run: %u32_f32(0x7f800001) == 0
; run: %u32_f32(0x7f800000) == 0xffffffff
; run: %u32_f32(0xff800000) == 0
; run: %u32_f32(0x80000000) == 0
; run: %u32_f32(0x3fc00000) == 1
; run: %u32_f32(0xbfc00000) == 0
; run: %u32_f32(0x4f800000) == 0xffffffff
; run: %u32_f32(0x4f7fffff) == 0xffffff00

