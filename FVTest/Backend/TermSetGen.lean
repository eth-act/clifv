import FV.Backend.Proof.TermSetRoots
import FV.Backend.Proof.DefGenDom
import Std.Data.HashSet

/-!
# Generator of the certified ISLE term sets (`FV/Backend/Proof/TermSetData.lean`)

Untrusted: computes the fuel-bounded worklist closures for the unchanged root and stop policies,
then writes sorted literal term IDs. No computed closure is trusted: the consuming proof modules
independently check closure, root coverage and safety in the kernel. This generator imports the
policies and abstract interpreter, not the modules proving obligations for these term sets.

Regenerate (after building `FV.Backend.Proof.TermSetRoots` and `FV.Backend.Proof.DefGenDom`):

    lake env lean --run FVTest/Backend/TermSetGen.lean FV/Backend/Proof/TermSetData.lean
-/

namespace TermSetGen

open Isle Isle.Aarch64

/-- Fuel bounds only the untrusted search; consumers must still certify its result. -/
private def close (stop : TermId → Bool) : Nat → List TermId → Std.HashSet TermId → Std.HashSet TermId
  | 0, _, seen => seen
  | _ + 1, [], seen => seen
  | k + 1, t :: ts, seen =>
    if seen.contains t then close stop k ts seen
    else if stop t then close stop k ts (seen.insert t)
    else close stop k ((program.rulesOf t).flatMap ruleTerms ++ ts) (seen.insert t)

private def termSet (stop : TermId → Bool) (roots : List TermId) : List TermId :=
  ((close stop 10000000 roots {}).toArray.qsort (· < ·)).toList

private def header : String := "import FV.Isle.Syntax

/-!
# Certified ISLE term sets: literal data

GENERATED by `FVTest/Backend/TermSetGen.lean` (untrusted; regenerate with
`lake env lean --run FVTest/Backend/TermSetGen.lean FV/Backend/Proof/TermSetData.lean`).
Do not edit by hand.

Sorted term IDs proposed by worklist search. Closure, root coverage and safety are proved
independently by the consuming proof modules; this module contains data only.
-/

set_option maxRecDepth 100000

"

private def renderSet (name : String) (terms : List TermId) : String :=
  s!"def {name} : List Isle.TermId := [\n  " ++
    ",\n  ".intercalate (terms.map toString) ++ "]\n\n"

private def render : String :=
  let killStop := Backend.Proof.Kill.killOracles.contains
  let defStop := fun t => Backend.Proof.DefGen.oracles.contains t ||
    (Backend.Proof.DefGen.wrapper program t).isSome
  header ++
    renderSet "Backend.Proof.Kill.killTabS"
      (termSet killStop (Backend.Proof.Kill.killOracles ++ Backend.Proof.Kill.killRootsS)) ++
    renderSet "Backend.Proof.Kill.killTabB"
      (termSet killStop (Backend.Proof.Kill.killOracles ++ Backend.Proof.Kill.killRootsB)) ++
    renderSet "Backend.Proof.DefGen.defTab"
      (termSet defStop (Backend.Proof.DefGen.oracles ++ Backend.Proof.DefGen.defRoots)) ++
    renderSet "E2E.LinkCheck.callTab" (termSet (fun _ => false) E2E.LinkCheck.callRoots) ++
    renderSet "E2E.LinkCheck.retTab" (termSet (fun _ => false) E2E.LinkCheck.retRoots)

end TermSetGen

def main (args : List String) : IO Unit := do
  match args with
  | [path] =>
    IO.FS.writeFile path TermSetGen.render
    IO.println s!"wrote {path}"
  | _ => throw (IO.userError "usage: lake env lean --run FVTest/Backend/TermSetGen.lean OUTPUT")
