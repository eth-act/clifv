test run
target aarch64

; S11e5 Stage C slice 5a: functions with `f32`/`f64` parameters and returns of their own (float
; `Args`/`Rets` in v0..v7, `ctlCheck`'s `argPairOk`/`retPairOk`). Before the slice `lowerRFunc`
; rejected them ("control-form check (ctlCheck) failed").

function %pick(f64, i64, f32) -> f64 {
block0(v0: f64, v1: i64, v2: f32):
    return v0
}
; run: %pick(0x1.8p1, 7, 0x1.0p0) == 0x1.8p1
; run: %pick(-0x0.0p0, 0, 0x1.0p0) == -0x0.0p0

function %second(f64, i64, f32) -> f32 {
block0(v0: f64, v1: i64, v2: f32):
    return v2
}
; run: %second(0x1.8p1, 7, 0x1.4p2) == 0x1.4p2

function %add(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fadd v0, v1
    return v2
}
; run: %add(0x1.0p0, 0x1.0p1) == 0x1.8p1

function %mix(i64, f32, i64, f64) -> i64, f64, f32 {
block0(v0: i64, v1: f32, v2: i64, v3: f64):
    v4 = iadd v0, v2
    return v4, v3, v1
}
; run: %mix(2, 0x1.0p0, 3, 0x1.0p2) == [5, 0x1.0p2, 0x1.0p0]

function %bits(f64) -> i64 {
block0(v0: f64):
    v1 = bitcast.i64 v0
    return v1
}
; run: %bits(0x1.0p0) == 0x3ff0000000000000

function %frombits(i32) -> f32 {
block0(v0: i32):
    v1 = bitcast.f32 v0
    return v1
}
; run: %frombits(0x40400000) == 0x1.8p1
