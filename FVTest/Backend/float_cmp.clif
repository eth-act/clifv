test run
target aarch64

; The S11f scalar float comparison root (`fcmp`, lower.isle:2176, and `uextend (fcmp)`,
; lower.isle:1283) behind integer signatures (bit patterns in, the `i8` condition out, either
; returned directly or zero-extended to `i32`): all twelve conditions on NaN, infinities,
; signed zeros and equal/unequal pairs.
;
; f32 bit patterns: 0x7fc00000 qNaN, 0x7f800000 +inf, 0xff800000 -inf, 0x00000000 +0,
; 0x80000000 -0, 0x3f800000 1.0, 0x40000000 2.0.

function %fcmp32_eq(i32, i32) -> i8 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fcmp eq v2, v3
    return v4
}
; run: %fcmp32_eq(0x3f800000, 0x3f800000) == 1
; run: %fcmp32_eq(0x7fc00000, 0x3f800000) == 0
; run: %fcmp32_eq(0x00000000, 0x80000000) == 1

function %fcmp32_ne(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fcmp ne v2, v3
    v5 = uextend.i32 v4
    return v5
}
; run: %fcmp32_ne(0x3f800000, 0x40000000) == 1
; run: %fcmp32_ne(0x7fc00000, 0x7fc00000) == 1
; run: %fcmp32_ne(0x3f800000, 0x3f800000) == 0

function %fcmp32_lt(i32, i32) -> i8 {
block0(v0: i32, v1: i32):
    v2 = bitcast.f32 v0
    v3 = bitcast.f32 v1
    v4 = fcmp lt v2, v3
    return v4
}
; run: %fcmp32_lt(0x3f800000, 0x40000000) == 1
; run: %fcmp32_lt(0x40000000, 0x3f800000) == 0
; run: %fcmp32_lt(0x7fc00000, 0x3f800000) == 0
; run: %fcmp32_lt(0xff800000, 0x7f800000) == 1

