; Mid-end oracle cases (`isle-trace-oracle --opt`, `FVTest/Isle/Opt.lean`). Each function's
; last pure instruction is the one under test; its operands are block parameters or constants,
; so Cranelift's e-classes for them are single nodes when it simplifies the instruction.

function %iadd_zero(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0
    v2 = iadd v0, v1
    return v2
}

function %iadd_const_left(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = iadd v1, v0
    return v2
}

function %iadd_consts(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 5
    v2 = iconst.i64 -7
    v3 = iadd v1, v2
    return v3
}

function %isub_self(i16) -> i16 {
block0(v0: i16):
    v1 = isub v0, v0
    return v1
}

function %imul_two(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 2
    v2 = imul v0, v1
    return v2
}

function %imul_pow2(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 16
    v2 = imul v0, v1
    return v2
}

function %band_self(i8) -> i8 {
block0(v0: i8):
    v1 = band v0, v0
    return v1
}

function %bxor_self(i64) -> i64 {
block0(v0: i64):
    v1 = bxor v0, v0
    return v1
}

function %bnot_bnot(i32) -> i32 {
block0(v0: i32):
    v1 = bnot v0
    v2 = bnot v1
    return v2
}

function %icmp_eq_self(i32) -> i8 {
block0(v0: i32):
    v1 = icmp eq v0, v0
    return v1
}

function %icmp_ult_consts(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 3
    v2 = iconst.i32 -1
    v3 = icmp ult v1, v2
    return v3
}

function %ishl_zero(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = ishl v0, v1
    return v2
}

function %sshr_const(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 -128
    v2 = iconst.i8 3
    v3 = sshr v1, v2
    return v3
}

function %uextend_uextend(i8) -> i64 {
block0(v0: i8):
    v1 = uextend.i32 v0
    v2 = uextend.i64 v1
    return v2
}

function %select_const(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = iconst.i8 1
    v3 = select v2, v0, v1
    return v3
}

function %select_same(i8, i32) -> i32 {
block0(v0: i8, v1: i32):
    v2 = select v0, v1, v1
    return v2
}

function %umin_self(i64) -> i64 {
block0(v0: i64):
    v1 = umin v0, v0
    return v1
}

function %ineg_const(i16) -> i16 {
block0(v0: i16):
    v1 = iconst.i16 5
    v2 = ineg v1
    return v2
}

function %ireduce_uextend(i32) -> i32 {
block0(v0: i32):
    v1 = uextend.i64 v0
    v2 = ireduce.i32 v1
    return v2
}

function %rotl_consts(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0x80000001
    v2 = iconst.i32 1
    v3 = rotl v1, v2
    return v3
}
