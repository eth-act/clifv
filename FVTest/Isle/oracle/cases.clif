; Inputs for FVTest/Isle/Interp.lean. The expected ISLE traces in cases.trace are the output
; of `isle-trace-oracle cases.clif` (rust/crates/isle2lean/oracle); see docs/contracts/isle.md.

function %iadd_iconst_left(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 5
    v2 = iadd v1, v0
    return v2
}

function %iadd_iconst_right_shifted(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0x5000
    v2 = iadd v0, v1
    return v2
}

function %iadd_regs_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = iadd v0, v1
    return v2
}

function %icmp_slt_i64(i64, i64) -> i8 {
block0(v0: i64, v1: i64):
    v2 = icmp slt v0, v1
    return v2
}

function %icmp_ult_imm_i32(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = icmp ult v0, v1
    return v2
}
