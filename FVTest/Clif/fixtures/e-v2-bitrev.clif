; clif-subset-v2: bitrev
test interpret
test run
target aarch64

function %bitrev_i8(i8) -> i8 {
block0(v0: i8):
    v1 = bitrev v0
    return v1
}
; run: %bitrev_i8(0) == 0
; run: %bitrev_i8(1) == -128
; run: %bitrev_i8(-1) == -1
; run: %bitrev_i8(-128) == 1
; run: %bitrev_i8(127) == -2
; run: %bitrev_i8(2) == 64
; run: %bitrev_i8(-2) == 127
; run: %bitrev_i8(-6) == 95
; run: %bitrev_i8(48) == 12

