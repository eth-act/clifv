; clif-subset-v2: bswap
test interpret
test run
target aarch64

function %bswap_i16(i16) -> i16 {
block0(v0: i16):
    v1 = bswap v0
    return v1
}
; run: %bswap_i16(0) == 0
; run: %bswap_i16(1) == 256
; run: %bswap_i16(-1) == -1
; run: %bswap_i16(-32768) == 128
; run: %bswap_i16(32767) == -129
; run: %bswap_i16(2) == 512
; run: %bswap_i16(-2) == -257
; run: %bswap_i16(29208) == 6258
; run: %bswap_i16(-32763) == 1408

