function %sat_add_u8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = iadd v0, v1
    v3 = icmp ult v2, v0
    v4 = iconst.i8 -1
    v5 = select v3, v4, v2
    return v5
}
