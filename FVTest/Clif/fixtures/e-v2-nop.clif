; clif-subset-v2: nop (cg_clif comment anchors) between instructions and before terminators
test interpret
test run
target aarch64

function %nop_i8(i8) -> i8 {
block0(v0: i8):
    nop
    v1 = iadd v0, v0
    nop
    brif v1, block1, block2

block1:
    nop
    return v1

block2:
    nop
    nop
    return v0
}
; run: %nop_i8(0) == 0
; run: %nop_i8(1) == 2
; run: %nop_i8(-1) == -2
; run: %nop_i8(-128) == -128
; run: %nop_i8(127) == -2
; run: %nop_i8(2) == 4

