; Regression (#1073): float instructions whose operand is defined later in the text, directly or
; through a value alias whose destination is defined in a later block (cg_clif writes blocks in
; creation order: plotters_backend::rasterizer::path::get_dir_vector).
test interpret
test run
target aarch64

function %late_fneg(f64) -> f64 {
block0(v0: f64):
    jump block2

block1:
    v1 = fneg.f64 v5
    return v1

block2:
    v6 = fadd v0, v0
    v5 -> v6
    jump block1
}
; run: %late_fneg(0x1.8p0) == -0x1.8p1
; run: %late_fneg(-0x1.0p-2) == 0x1.0p-1

function %late_fcvt(f64) -> i64 {
block0(v0: f64):
    jump block2

block1:
    v1 = fcvt_to_sint.i64 v5
    return v1

block2:
    v6 = fadd v0, v0
    v5 -> v6
    jump block1
}
; run: %late_fcvt(0x1.8p1) == 6
; run: %late_fcvt(-0x1.4p2) == -10

function %late_fpromote(f32) -> f64 {
block0(v0: f32):
    jump block2

block1:
    v1 = fpromote.f64 v6
    return v1

block2:
    v6 = fadd v0, v0
    jump block1
}
; run: %late_fpromote(0x1.0p0) == 0x1.0p1
